@page "/marketplace/order-confirmation/{Reference}"
@rendermode InteractiveServer
@inject AuthService Auth
@inject MarketplaceOrderService Orders
<PageTitle>Order confirmation | ShoppetCare</PageTitle>
<main class="owner-shell"><section class="owner-card">@if(!ready){<p>Loading your order…</p>}else if(order is null){<h1>Order unavailable.</h1><p>Sign in with the purchasing account to see its order confirmation.</p><a class="owner-button" href="/marketplace/orders">My orders</a>}else{<span class="owner-eyebrow">SIMULATED MARKETPLACE TRANSACTION</span><h1>Your order is completed.</h1><p>Your pre-loved finds have been marked sold. The order and mock payment are saved across Web and Mobile.</p><p><strong>@order.Reference</strong> · ₱@order.Total.ToString("N2")</p><p>Message the seller to arrange the exchange. You can leave a verified review from your order history.</p><p><small>No real funds were transferred by ShoppetCare.</small></p><div class="owner-actions"><a class="owner-button" href="/marketplace/orders">View orders</a><a class="owner-button" href="@($"/messages?contactId={order.SellerUserId}")">Message seller</a></div>}</section></main>
@code{[Parameter]public string Reference{get;set;}="";bool ready;Shoppet_VetClinic.Models.MarketplaceOrder? order;protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();if(Auth.IsPetOwner&&Auth.CurrentUser is not null)try{order=Orders.GetBuyerOrders(Auth.CurrentUser.Id).FirstOrDefault(o=>o.Reference==Reference);}catch(Exception){}ready=true;StateHasChanged();}}
