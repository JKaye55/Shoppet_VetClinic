@page "/announcements"
@inject DatabaseService Db

<PageTitle>Announcements</PageTitle>

<div class="container mt-4" style="max-width: 720px;">

    <h1 class="mb-4"><i class="bi bi-bell"></i> Announcements</h1>

    @if (list.Count == 0)
    {
        <div class="alert alert-light border">
            No announcements right now. Check back soon!
        </div>
    }
    else
    {
        @foreach (var a in list)
        {
            <div class="card mb-3 border-start border-4 @PriorityBorder(a.Priority)">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <h5 class="card-title mb-0">@a.Title</h5>
                        <span class="badge bg-secondary">@a.Category</span>
                    </div>
                    <p class="card-text mb-2">@a.Body</p>
                    <small class="text-muted">
                        Posted @Relative(a.PostedAt)
                        @if (a.ExpiresAt.HasValue)
                        {
                            <span> · expires @a.ExpiresAt.Value.ToString("MMM d")</span>
                        }
                    </small>
                </div>
            </div>
        }
    }

</div>

@code {
    List<Shoppet_VetClinic.Models.Announcement> list = new();

    protected override void OnParametersSet()
    {
        list = Db.GetActiveAnnouncements(null, 20);
    }

    string PriorityBorder(string priority) => priority switch
    {
        "High" => "border-danger",
        "Low" => "border-secondary",
        _ => "border-primary"
    };

    string Relative(DateTime dt)
    {
        var span = DateTime.Now - dt;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("MMM d");
    }
}