@page "/about"
@page "/home/about"
@layout InformationLayout
@inject NavigationManager Nav

<PageTitle>About ShoppetCare</PageTitle>

<div class="about-page">
    <section class="about-hero">
        <div class="about-shell">
            <span>ABOUT SHOPPETCARE</span>
            <h1>Connected pet care, local discovery, and practical e-commerce.</h1>
            <p>
                ShoppetCare is a student e-commerce pilot platform designed around pet owners,
                community interaction, digital pet identity, and a pre-loved pet-item marketplace.
            </p>
        </div>
    </section>

    <main class="about-shell about-main">
        <section class="about-grid">
            <article class="about-card feature">
                <span class="eyebrow">PURPOSE</span>
                <h2>Why ShoppetCare exists</h2>
                <p>
                    The platform brings pet information, Community, Marketplace, and Premium
                    digital services into one ShoppetCare ecosystem for Web and Mobile.
                </p>
            </article>

            <article class="about-card">
                <i class="bi bi-phone"></i>
                <h3>Mobile-first pet care</h3>
                <p>Mobile is the primary place for day-to-day pet profiles, vaccination records, health history, food tracking, and portable Digital Pet ID access.</p>
            </article>

            <article class="about-card">
                <i class="bi bi-window"></i>
                <h3>Web commerce &amp; management</h3>
                <p>Web supports pet care, Marketplace, lifetime Premium, mock payments, Community, account summaries, and administration.</p>
            </article>

            <article class="about-card">
                <i class="bi bi-shield-check"></i>
                <h3>Clear privacy boundaries</h3>
                <p>Public Pet ID views show pet identity while private owner contact and care information remain protected.</p>
            </article>

            <article class="about-card">
                <i class="bi bi-shop"></i>
                <h3>Simple local e-commerce</h3>
                <p>Marketplace supports pre-loved pet items, shared cart, simulated checkout, verified-purchase reviews, and review vouchers without pretending to provide real payment settlement or shipping.</p>
            </article>


        </section>

        <section class="about-roles">
            <div>
                <span class="eyebrow">SYSTEM ROLES</span>
                <h2>Built for pet owners and platform administrators.</h2>
            </div>

            <div class="role-grid">
                <article><strong>Guest</strong><span>Browse public Community and Marketplace content.</span></article>
                <article><strong>Pet Owner</strong><span>Persistent pets, Community, Marketplace, Premium and notifications.</span></article>
                <article><strong>Admin</strong><span>Platform oversight, moderation, users and transactions.</span></article>
            </div>
        </section>

        <section class="about-team">
            <div class="about-team-head">
                <span class="eyebrow">THE TEAM BEHIND SHOPPETCARE</span>
                <h2>Built by a multidisciplinary student development team.</h2>
                <p>
                    ShoppetCare was conceptualized and developed by a student team combining
                    full-stack development, mobile development, database management, product strategy,
                    digital marketing, business development, and collaborative software implementation.
                </p>
            </div>

            <div class="team-grid">
                <article class="team-card">
                    <div class="team-avatar" aria-hidden="true">JF</div>
                    <div class="team-copy">
                        <span class="team-role">Lead Full-Stack Developer &amp; Product Strategist</span>
                        <h3>Fernando, Jullianne Kaye</h3>
                        <p>
                            Leads ShoppetCare's Web development, database architecture and management,
                            system integration, product planning, and overall feature conceptualization.
                        </p>
                    </div>
                </article>

                <article class="team-card">
                    <div class="team-avatar" aria-hidden="true">JM</div>
                    <div class="team-copy">
                        <span class="team-role">Mobile Developer &amp; Digital Marketing Strategist</span>
                        <h3>Maines, John Marvic Brian</h3>
                        <p>
                            Develops the ShoppetCare Mobile application and contributes to digital marketing,
                            user engagement, and cross-platform product positioning.
                        </p>
                    </div>
                </article>

                <article class="team-card">
                    <div class="team-avatar" aria-hidden="true">DD</div>
                    <div class="team-copy">
                        <span class="team-role">Business Development &amp; Marketing Strategist</span>
                        <h3>De Guzman, Dexter John</h3>
                        <p>
                            Leads business communication, presentations, marketing strategy, stakeholder engagement,
                            and the communication of ShoppetCare's value proposition.
                        </p>
                    </div>
                </article>

                <article class="team-card">
                    <div class="team-avatar" aria-hidden="true">IT</div>
                    <div class="team-copy">
                        <span class="team-role">Software Development Partner</span>
                        <h3>Terrenal, Ian Isaac</h3>
                        <p>
                            Collaborates in ShoppetCare's technical development, feature implementation,
                            testing, and overall software development process.
                        </p>
                    </div>
                </article>
            </div>

            <div class="academic-note">
                <i class="bi bi-mortarboard"></i>
                <div>
                    <strong>Academic Project Context</strong>
                    <span>
                        ShoppetCare is currently developed as a student e-commerce and software project.
                        Payment integrations and selected commercial workflows are simulated for academic demonstration.
                    </span>
                </div>
            </div>
        </section>

        <section class="about-cta">
            <div>
                <span class="eyebrow">EXPLORE THE PLATFORM</span>
                <h2>See the system from the role that fits you.</h2>
            </div>
            <div>
                <a href="/home?guest=true">Explore as Guest</a>
                <a href="@InformationLink("help")" class="secondary">Open Help Center</a>
            </div>
        </section>
    </main>
</div>

<style>
    .about-page{min-height:100vh;background:#FAF9F6;color:#1E2D27}.about-page *{box-sizing:border-box}.about-shell{width:min(1160px,calc(100% - 40px));margin:auto}
    .about-hero{padding:64px 0;background:radial-gradient(circle at 80% 10%,rgba(47,144,152,.18),transparent 28%),linear-gradient(145deg,#173D3D,#102E2D);color:#fff}.about-hero span,.eyebrow{color:#7ED0D2;font-size:.66rem;font-weight:900;letter-spacing:.12em}.about-hero h1{max-width:900px;margin:8px 0 12px;font-size:clamp(2.8rem,5vw,4.8rem);line-height:.98;letter-spacing:-.055em}.about-hero p{max-width:820px;color:rgba(255,255,255,.68);line-height:1.7}
    .about-main{padding:34px 0 70px}.about-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.about-card{padding:22px;border:1px solid #DDE7E4;border-radius:18px;background:#fff;box-shadow:0 9px 25px rgba(23,61,61,.04)}.about-card.feature{grid-column:span 2;background:#EEF6F4}.about-card .eyebrow,.about-roles .eyebrow,.about-cta .eyebrow{color:#2F9098}.about-card>i{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;background:#EAF5F5;color:#2F9098}.about-card h2,.about-card h3{margin:9px 0 7px;letter-spacing:-.03em}.about-card p{margin:0;color:#6E7E78;font-size:.75rem;line-height:1.6}
    .about-roles{margin-top:22px;padding:28px;border:1px solid #DDE7E4;border-radius:18px;background:#fff}.about-roles h2{margin:6px 0 18px}.role-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.role-grid article{padding:15px;border-radius:12px;background:#F6F8F7}.role-grid strong,.role-grid span{display:block}.role-grid strong{font-size:.76rem}.role-grid span{margin-top:4px;color:#7C8984;font-size:.65rem;line-height:1.45}
    .about-team{margin-top:22px;padding:28px;border:1px solid #DDE7E4;border-radius:18px;background:#fff}.about-team-head{max-width:820px}.about-team-head h2{margin:6px 0 8px}.about-team-head p{margin:0;color:#6E7E78;font-size:.76rem;line-height:1.65}.team-grid{margin-top:20px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.team-card{padding:18px;display:grid;grid-template-columns:58px 1fr;gap:14px;border:1px solid #E1E8E5;border-radius:15px;background:#FAFCFB}.team-avatar{width:58px;height:58px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(145deg,#E3F3F0,#F1F8F6);color:#267C83;font-size:.85rem;font-weight:900;letter-spacing:.04em}.team-role{display:block;color:#2F9098;font-size:.59rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase;line-height:1.4}.team-copy h3{margin:5px 0 6px;font-size:.92rem;letter-spacing:-.02em}.team-copy p{margin:0;color:#6E7E78;font-size:.68rem;line-height:1.55}.academic-note{margin-top:16px;padding:14px 16px;display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:start;border-radius:12px;background:#EEF6F4}.academic-note i{width:34px;height:34px;display:grid;place-items:center;border-radius:9px;background:#DDEEEA;color:#267C83}.academic-note strong,.academic-note span{display:block}.academic-note strong{font-size:.72rem}.academic-note span{margin-top:3px;color:#6D7D77;font-size:.64rem;line-height:1.5}
    .about-cta{margin-top:22px;padding:25px;display:flex;align-items:center;justify-content:space-between;gap:25px;border-radius:18px;background:#173D3D;color:#fff}.about-cta h2{margin:5px 0 0}.about-cta>div:last-child{display:flex;gap:8px;flex-wrap:wrap}.about-cta a{min-height:42px;padding:0 14px;display:inline-flex;align-items:center;border-radius:9px;background:#2F9098;color:#fff;text-decoration:none;font-size:.7rem;font-weight:900}.about-cta a.secondary{border:1px solid rgba(255,255,255,.15);background:transparent}
    @@media(max-width:850px){.about-grid{grid-template-columns:1fr 1fr}.about-card.feature{grid-column:1/-1}.role-grid{grid-template-columns:1fr 1fr}.team-grid{grid-template-columns:1fr}.about-cta{align-items:flex-start;flex-direction:column}}@@media(max-width:560px){.about-grid,.role-grid{grid-template-columns:1fr}.team-card{grid-template-columns:50px 1fr}.team-avatar{width:50px;height:50px}}
</style>

@code {
    private string InformationLink(string page) => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("home/", StringComparison.OrdinalIgnoreCase) ? $"/home/{page}" : $"/{page}";
}
