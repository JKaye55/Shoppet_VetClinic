@page "/community"
@rendermode InteractiveServer
@implements IDisposable

@inject CommunityService Community
@inject DatabaseService Db
@inject FileStorageService FileStorage
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Community | ShoppetCare</PageTitle>


<div class="sc-community-page">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="sc-community-hero">

        <div class="sc-community-shell sc-community-hero-inner">

            <div>

                <span class="sc-community-kicker light">
                    SHOPPETCARE COMMUNITY
                </span>

                <h1>
                    Pet stories feel better
                    <em>when they're shared.</em>
                </h1>

                <p>
                    Share everyday moments, tag your pets,
                    and discover stories from fellow pet owners
                    in the ShoppetCare community.
                </p>

            </div>


            @if (!Auth.IsLoggedIn)
            {
                <div class="sc-community-hero-actions">

                    <a href="/register"
                       class="sc-community-primary">
                        Join the Community
                    </a>

                    <a href="/login"
                       class="sc-community-secondary light">
                        Sign In
                    </a>

                </div>
            }

        </div>

    </section>


    <!-- =========================================================
         GUEST MODE
         ========================================================= -->
    @if (Auth.IsGuest)
    {
        <section class="sc-community-guest">

            <div class="sc-community-shell">

                <div class="sc-community-guest-card">

                    <div class="sc-community-guest-icon">

                        <i class="bi bi-eye-fill"
                           aria-hidden="true"></i>

                    </div>

                    <div>

                        <strong>
                            Browsing Community Feed in Guest Mode
                        </strong>

                        <span>
                            You can read posts and leave up to 10 comments as a guest.
                            Sign in to join the conversation, like posts, and build your profile.
                        </span>

                    </div>

                    <a href="/register">
                        Create Account
                    </a>

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <section class="sc-community-content">

        <div class="sc-community-shell">

            <div class="sc-community-layout">


                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->

                <div class="sc-community-main">


                    <!-- =============================================
                         MESSAGE
                         ============================================= -->
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="@(isError
                                                                                    ? "sc-community-alert error"
                                                                                    : "sc-community-alert success")">

                            @statusMessage

                        </div>
                    }


                    <!-- =============================================
                         POST COMPOSER
                         ============================================= -->
                    @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                    {
                        <section class="sc-community-composer">

                            <div class="sc-community-composer-head">

                                <div class="sc-community-avatar">
                                    @{
                                        var currentPhoto = GetUserProfilePhotoUrl();
                                    }
                                    @if (!string.IsNullOrWhiteSpace(currentPhoto))
                                    {
                                        <img src="@currentPhoto" alt="Profile" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                        <span style="display:none;">@GetUserInitials()</span>
                                    }
                                    else
                                    {
                                        @GetUserInitials()
                                    }
                                </div>

                                <div>

                                    <strong>
                                        @(isEditing
                                            ? "Edit your post"
                                            : $"Share something, {GetFirstName()}")
                                    </strong>

                                    <span>
                                        @(isEditing
                                            ? "Update your story below."
                                            : "What's your pet up to today?")
                                    </span>

                                </div>

                            </div>


                            <textarea rows="4"
                                      maxlength="500"
                                      @bind="caption"
                                      placeholder="Share a moment with your pet...">
                            </textarea>


                            <div class="sc-community-composer-options">

                                <div class="sc-community-field">

                                    <label>
                                        Tag a Pet
                                    </label>

                                    <select @bind="selectedPetId">

                                        <option value="0">
                                            No pet tagged
                                        </option>

                                        @foreach (var pet in myPets)
                                        {
                                            <option value="@pet.Id">
                                                @pet.PetName
                                            </option>
                                        }

                                    </select>

                                </div>


                                <div class="sc-community-field photo-field">
                                    <label>Add Photo</label>
                                    <div class="sc-community-upload-btn-wrap">
                                        <label for="communityPhotoUpload" class="sc-upload-btn-custom">
                                            <i class="bi bi-camera-fill"></i>
                                            <span>@(selectedImageBytes is not null ? "Change Photo" : "Choose Photo")</span>
                                        </label>
                                        <InputFile id="communityPhotoUpload" OnChange="HandleImageSelected" accept=".jpg,.jpeg,.png,.webp" style="display:none;" />
                                        <small class="sc-upload-note">JPG, PNG or WEBP · Max 5 MB</small>
                                    </div>
                                </div>

                            </div>

                            @if (!string.IsNullOrEmpty(selectedImagePreviewDataUrl))
                            {
                                <div class="sc-community-preview-card">
                                    <div class="sc-preview-img-box">
                                        <img src="@selectedImagePreviewDataUrl" alt="Selected photo preview" />
                                    </div>
                                    <div class="sc-preview-details">
                                        <strong><i class="bi bi-image"></i> @selectedImageName</strong>
                                        <span>@(selectedImageBytes != null ? $"{selectedImageBytes.Length / 1024} KB" : "") · Ready to post</span>
                                    </div>
                                    <button type="button" class="sc-preview-remove-btn" @onclick="ClearSelectedImage" title="Remove photo">
                                        <i class="bi bi-x-circle-fill"></i> Remove
                                    </button>
                                </div>
                            }
                            else if (isEditing && !string.IsNullOrWhiteSpace(existingImageUrl) && !removeExistingImage)
                            {
                                <div class="sc-community-preview-card existing">
                                    <div class="sc-preview-img-box">
                                        <img src="@NormalizeImageUrl(existingImageUrl)" alt="Current post photo" />
                                    </div>
                                    <div class="sc-preview-details">
                                        <strong>Current Photo Attached</strong>
                                        <span>Upload a new photo to replace, or remove</span>
                                    </div>
                                    <button type="button" class="sc-preview-remove-btn" @onclick="RemoveExistingImage" title="Remove current photo">
                                        <i class="bi bi-trash3-fill"></i> Remove
                                    </button>
                                </div>
                            }


                            <div class="sc-community-composer-footer">

                                <span>
                                    @CharactersRemaining characters left
                                </span>

                                <div>

                                    @if (isEditing)
                                    {
                                        <button type="button"
                                                class="sc-community-cancel"
                                                disabled="@isSaving"
                                                @onclick="CancelEditing">

                                            Cancel

                                        </button>
                                    }

                                    <button type="button"
                                            class="sc-community-post-button"
                                            disabled="@isSaving"
                                            @onclick="SavePostAsync">

                                        @(isSaving
                                            ? "Saving..."
                                            : isEditing
                                                ? "Save Changes"
                                                : "Post Story")

                                    </button>

                                </div>

                            </div>

                        </section>
                    }
                    else if (!Auth.IsLoggedIn)
                    {
                        <section class="sc-community-signin-card">

                            <div>

                                <span class="sc-community-kicker">
                                    WANT TO SHARE?
                                </span>

                                <h2>
                                    Want to publish your own story?
                                </h2>

                                <p>
                                    Sign in or create a free account to create posts and use member features
                                    to post your own pet stories.
                                </p>

                            </div>

                            <div>

                                <a href="/login"
                                   class="sc-community-secondary">
                                    Sign In
                                </a>

                                <a href="/register"
                                   class="sc-community-primary">
                                    Create Account
                                </a>

                            </div>

                        </section>
                    }


                    <!-- =============================================
                         FEED HEADER
                         ============================================= -->

                    <div class="sc-community-feed-head">

                        <div>

                            <span class="sc-community-kicker">
                                COMMUNITY FEED
                            </span>

                            <h2>
                                Latest pet stories
                            </h2>

                        </div>


                        @if (Auth.IsLoggedIn &&
                             Auth.IsPetOwner)
                        {
                            <div class="sc-community-tabs">

                                <button type="button"
                                        class="@(!showMyPosts ? "active" : "")"
                                        @onclick="ShowAllPosts">

                                    All Posts

                                </button>

                                <button type="button"
                                        class="@(showMyPosts ? "active" : "")"
                                        @onclick="ShowMyPosts">

                                    My Posts (@MyPostCount)

                                </button>

                            </div>
                        }

                    </div>


                    <!-- =============================================
                         EMPTY FEED
                         ============================================= -->
                    @if (VisiblePosts.Count == 0)
                    {
                        <div class="sc-community-empty">

                            <div>
                                <i class="bi bi-chat-heart"
                                   aria-hidden="true"></i>
                            </div>

                            <h3>
                                @(showMyPosts
                                    ? "You haven't posted yet."
                                    : "No community posts yet.")
                            </h3>

                            <p>
                                @(showMyPosts
                                    ? "Share your first pet story with the ShoppetCare community."
                                    : "The first story can start right here.")
                            </p>

                        </div>
                    }
                    else
                    {
                        <!-- =========================================
                             FEED
                             ========================================= -->

                        <div class="sc-community-feed">

                            @foreach (var post in VisiblePosts)
                            {
                                <article class="sc-community-post">

                                    <!-- AUTHOR -->

                                    <header class="sc-community-post-header">

                                        <div class="sc-community-avatar small">
                                            @{
                                                var authorPhoto = GetAuthorAvatarUrl(post);
                                            }
                                            @if (!string.IsNullOrWhiteSpace(authorPhoto))
                                            {
                                                <img src="@authorPhoto" alt="@post.AuthorName" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                                <span style="display:none;">@GetInitials(post.AuthorName)</span>
                                            }
                                            else
                                            {
                                                <span>@GetInitials(post.AuthorName)</span>
                                            }
                                        </div>

                                        <div class="sc-community-post-author">

                                            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                                <strong>
                                                    @post.AuthorName
                                                </strong>
                                                @if (post.IsAuthorPremium)
                                                {
                                                    <span style="display:inline-flex;align-items:center;gap:3px;background:linear-gradient(135deg, #FFF4D4, #FFE399);color:#8F6000;font-size:.68rem;font-weight:800;padding:2px 7px;border-radius:12px;border:1px solid #FFD066;" title="Verified Premium Member">
                                                        🏅 Premium Pet Owner
                                                    </span>
                                                }
                                            </div>

                                            <span>

                                                @Relative(post.PostedAt)

                                                @if (post.IsEdited)
                                                {
                                                    <span> · edited</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    post.PetName))
                                                {
                                                    <span>
                                                        · with
                                                        <b>@post.PetName</b>
                                                    </span>
                                                }

                                            </span>

                                        </div>


                                        @if (IsOwnPost(post))
                                        {
                                            <div class="sc-community-post-actions">

                                                <button type="button"
                                                        title="Edit post"
                                                        @onclick="() => StartEditing(post)">

                                                    <i class="bi bi-pencil"
                                                       aria-hidden="true"></i>

                                                </button>

                                                <button type="button"
                                                        class="danger"
                                                        title="Delete post"
                                                        @onclick="() => DeletePost(post)">

                                                    <i class="bi bi-trash3"
                                                       aria-hidden="true"></i>

                                                </button>

                                            </div>
                                        }

                                    </header>


                                    <!-- CAPTION -->

                                    <p class="sc-community-caption">
                                        @post.Caption
                                    </p>


                                    <!-- IMAGE -->
                                    @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                                    {
                                        var imageUrls = post.ImageUrl.Split(new[] { ',', '|', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                                                     .Select(NormalizeImageUrl)
                                                                     .Where(u => !string.IsNullOrEmpty(u))
                                                                     .ToList();
                                        if (imageUrls.Count > 0)
                                        {
                                            <div class="sc-community-post-image @(imageUrls.Count > 1 ? "grid-" + Math.Min(imageUrls.Count, 3) : "single")">
                                                @foreach (var url in imageUrls)
                                                {
                                                    <div class="sc-img-wrapper">
                                                        <img src="@url" alt="Photo shared by @post.AuthorName" loading="lazy" onerror="this.parentElement.style.display='none';" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }


                                    <!-- META -->

                                    <footer class="sc-community-post-footer">

                                        @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                                        {
                                            <button type="button"
                                                    class="@(likedPostIds.Contains(post.Id)
                                                                                                                ? "sc-community-like liked"
                                                                                                                : "sc-community-like")"
                                                    @onclick="() => ToggleLike(post)">

                                                <i class="@(likedPostIds.Contains(post.Id)
                                                                                                                  ? "bi bi-heart-fill"
                                                                                                                  : "bi bi-heart")"
                                                   aria-hidden="true">
                                                </i>

                                                @post.LikeCount
                                                @(post.LikeCount == 1
                                                    ? "like"
                                                    : "likes")

                                            </button>
                                        }
                                        else
                                        {
                                            <span>

                                                <i class="bi bi-heart"
                                                   aria-hidden="true">
                                                </i>

                                                @post.LikeCount
                                                @(post.LikeCount == 1
                                                    ? "like"
                                                    : "likes")

                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(
                                            post.PetName))
                                        {
                                            <span>

                                                <i class="bi bi-heart-pulse"
                                                   aria-hidden="true"></i>

                                                @post.PetName

                                            </span>
                                        }

                                    </footer>

                                    @{
                                        var postComments = GetComments(post.Id);
                                    }

                                    <!-- UPDATED COMMENT SECTION -->
                                    <section class="sc-community-comments">
                                        <div class="sc-community-comments-head">
                                            <strong>Comments</strong>
                                            <span>@postComments.Count</span>
                                        </div>

                                        <div class="sc-community-comment-list">
                                            @foreach (var comment in postComments)
                                            {
                                                <div class="sc-community-comment">
                                                    <div class="sc-community-comment-avatar">
                                                        @GetInitials(comment.AuthorName)
                                                    </div>

                                                    <div class="sc-community-comment-body">
                                                        <div class="sc-community-comment-meta">
                                                            <div style="display:inline-flex;align-items:center;gap:5px;flex-wrap:wrap;">
                                                                <strong>@comment.AuthorName</strong>
                                                                @if (comment.IsAuthorPremium)
                                                                {
                                                                    <span style="display:inline-flex;align-items:center;gap:2px;background:#FFF4D4;color:#8F6000;font-size:.63rem;font-weight:800;padding:1px 5px;border-radius:10px;border:1px solid #FFD066;" title="Verified Premium Member">
                                                                        🏅 Premium
                                                                    </span>
                                                                }
                                                            </div>
                                                            @if (comment.IsGuest)
                                                            {
                                                                <span class="sc-community-guest-tag">Guest</span>
                                                            }
                                                            <small>@Relative(comment.CreatedAt)</small>
                                                        </div>

                                                        @if (comment.ParentCommentId.HasValue)
                                                        {
                                                            <div class="sc-community-comment-reply-indicator">
                                                                <i class="bi bi-arrow-return-right"></i> Replying to #@comment.ParentCommentId
                                                            </div>
                                                        }

                                                        <p class="sc-community-comment-text">@comment.Body</p>

                                                        <div class="sc-community-comment-actions">
                                                            <span class="sc-community-comment-likes">
                                                                <i class="bi bi-heart"></i> @comment.LikeCount
                                                            </span>

                                                            @if (Auth.IsPetOwner && Auth.CurrentUser is not null)
                                                            {
                                                                <button type="button" class="sc-community-action-link" @onclick="() => LikeComment(post.Id, comment.Id)">
                                                                    Like / unlike
                                                                </button>
                                                            }

                                                            @if (Auth.IsPetOwner && Auth.CurrentUser is not null)
                                                            {
                                                                <button type="button" class="sc-community-action-link" @onclick="() => Reply(post.Id, comment.Id)">
                                                                    Reply
                                                                </button>
                                                            }

                                                            @if (Auth.CurrentUser is not null && (comment.UserId == Auth.CurrentUser.Id || Auth.IsAdmin))
                                                            {
                                                                <button type="button" class="sc-community-action-link danger" @onclick="() => DeleteComment(post.Id, comment.Id)">
                                                                    Delete
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="sc-community-comment-form">
                                            @if (replyParents.TryGetValue(post.Id, out var replyParentId))
                                            {
                                                var replyTarget = GetComments(post.Id)
                                                    .FirstOrDefault(comment => comment.Id == replyParentId);

                                                <div class="sc-community-reply-context">
                                                    <span>
                                                        Replying to @(replyTarget?.AuthorName ?? "this comment")
                                                    </span>
                                                    <button type="button"
                                                            class="sc-community-action-link"
                                                            @onclick="() => CancelReply(post.Id)">
                                                        Cancel
                                                    </button>
                                                </div>
                                            }

                                            @if (Auth.IsGuest)
                                            {
                                                <div class="sc-community-comment-identity">
                                                    <span class="sc-community-guest-avatar">G</span>
                                                    <span>
                                                        <strong>Commenting as Guest</strong>
                                                        <small>
                                                            @if (GetGuestCommentCount(post.Id) >= 10)
                                                            {
                                                                <span style="color:#A04343; font-weight:bold;">Comment limit reached (10/10). Please sign in to comment more.</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@GetGuestCommentCount(post.Id)/10 comments used. Sign in for unlimited comments.</span>
                                                            }
                                                        </small>
                                                    </span>
                                                </div>
                                            }

                                            <div class="sc-community-comment-input-wrapper">
                                                <input type="text"
                                                       maxlength="300"
                                                       value="@GetCommentDraft(post.Id)"
                                                       @oninput="e => SetCommentDraft(post.Id, e.Value?.ToString() ?? string.Empty)"
                                                       placeholder="@(Auth.IsGuest && GetGuestCommentCount(post.Id) >= 10 ? "Sign in to comment..." : "Write a helpful comment...")"
                                                       disabled="@(Auth.IsGuest && GetGuestCommentCount(post.Id) >= 10)" />

                                                <button type="button"
                                                        @onclick="() => SubmitComment(post.Id)"
                                                        disabled="@(Auth.IsGuest && GetGuestCommentCount(post.Id) >= 10)">
                                                    <i class="bi bi-send"></i> Post
                                                </button>
                                            </div>
                                        </div>
                                    </section>

                                </article>
                            }

                        </div>
                    }

                </div>


                <!-- =================================================
                     RIGHT SIDEBAR
                     ================================================= -->

                <aside class="sc-community-sidebar">

                    <section class="sc-community-side-card sc-rankings-card">
                        <span class="sc-community-kicker">
                            COMMUNITY LEADERBOARD
                        </span>
                        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin:4px 0 6px;">
                            <h3 style="margin:0;">
                                🏆 Top Pet Champions
                            </h3>
                            <span style="font-size:0.7rem;font-weight:800;background:#E8F5F3;color:#175C59;padding:2px 8px;border-radius:999px;display:inline-flex;align-items:center;gap:4px;border:1px solid #C4E2DE;" title="Live activity score">
                                <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#10B981;"></span>
                                @(rankings.Sum(r => r.Score)) pts Live
                            </span>
                        </div>
                        <p style="margin-bottom: 12px;">
                            Most active and engaging members in our pet community.
                        </p>

                        @if (rankings.Count == 0)
                        {
                            <div style="font-size:0.75rem; color:#788782; padding:8px 0;">
                                Loading rankings...
                            </div>
                        }
                        else
                        {
                            <div class="sc-rankings-list">
                                @foreach (var ranker in rankings)
                                {
                                    <div class="sc-ranking-item">
                                        <div class="sc-ranking-badge">
                                            @if (ranker.Rank == 1)
                                            {
                                                <span title="Rank 1">🥇</span>
                                            }
                                            else if (ranker.Rank == 2)
                                            {
                                                <span title="Rank 2">🥈</span>
                                            }
                                            else if (ranker.Rank == 3)
                                            {
                                                <span title="Rank 3">🥉</span>
                                            }
                                            else
                                            {
                                                <span class="rank-num">#@ranker.Rank</span>
                                            }
                                        </div>
                                        <div class="sc-ranking-avatar">
                                            @if (!string.IsNullOrWhiteSpace(ranker.Avatar))
                                            {
                                                <img src="@ranker.Avatar" alt="@ranker.FullName" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                                <div class="sc-ranking-avatar-fallback" style="display:none;">@((ranker.FullName?.FirstOrDefault() ?? 'U').ToString().ToUpper())</div>
                                            }
                                            else
                                            {
                                                <div class="sc-ranking-avatar-fallback">@((ranker.FullName?.FirstOrDefault() ?? 'U').ToString().ToUpper())</div>
                                            }
                                        </div>
                                        <div class="sc-ranking-info">
                                            <strong class="sc-ranking-name">@ranker.FullName</strong>
                                            <div class="sc-ranking-stats">
                                                <span><i class="bi bi-file-post"></i> @ranker.PostCount posts</span>
                                                <span><i class="bi bi-heart-fill" style="color:#E05A47;"></i> @ranker.LikesReceived likes</span>
                                                <span><i class="bi bi-chat-dots"></i> @ranker.CommentCount cmts</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="sc-community-side-card">

                        <span class="sc-community-kicker">
                            COMMUNITY
                        </span>

                        <h3>
                            A space for pet owners.
                        </h3>

                        <p>
                            Share pet moments, helpful experiences,
                            milestones, and everyday stories with
                            the local ShoppetCare community.
                        </p>

                    </section>


                    <section class="sc-community-side-card">

                        <span class="sc-community-kicker">
                            KEEP IT HELPFUL
                        </span>

                        <ul>

                            <li>
                                Share respectful pet-related content.
                            </li>

                            <li>
                                Avoid posting private or sensitive information.
                            </li>

                            <li>
                                Keep marketplace selling inside Marketplace.
                            </li>

                            <li>
                                Veterinary concerns should still be discussed
                                with a qualified veterinarian.
                            </li>

                        </ul>

                    </section>


                    <section class="sc-community-side-card mobile-note">

                        <i class="bi bi-phone"
                           aria-hidden="true"></i>

                        <div>

                            <strong>
                                Web + Mobile
                            </strong>

                            <span>
                                Community content can use the same
                                centralized ShoppetCare data across
                                both platforms.
                            </span>

                        </div>

                    </section>

                </aside>

            </div>

        </div>

    </section>

</div>


<style>
    .sc-community-like {
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0;
        background: transparent;
        color: #75847F;
        font: inherit;
        cursor: pointer;
    }

        .sc-community-like:hover {
            color: #2F9098;
        }

        .sc-community-like.liked {
            color: #C65C68;
        }

    .sc-community-page {
        min-height: 100vh;
        background: #FAF9F6;
        color: #172A28;
    }


    .sc-community-shell {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }


    /* =========================================================
               HERO
               ========================================================= */

    .sc-community-hero {
        padding: 65px 0 56px;
        background: radial-gradient( circle at 86% 18%, rgba(243,210,122,.20), transparent 27% ), linear-gradient( 135deg, #173D3D, #102E2D );
        color: #FFFFFF;
    }


    .sc-community-hero-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 35px;
    }


    .sc-community-kicker {
        display: inline-block;
        color: #2F9098;
        font-size: .64rem;
        font-weight: 900;
        letter-spacing: .11em;
    }


        .sc-community-kicker.light {
            color: #9ADBDD;
        }


    .sc-community-hero h1 {
        max-width: 700px;
        margin: 9px 0 0;
        font-size: clamp(2.7rem, 5vw, 4.8rem);
        line-height: .95;
        letter-spacing: -.055em;
        font-weight: 900;
    }


        .sc-community-hero h1 em {
            display: block;
            color: #F3D27A;
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 500;
        }


    .sc-community-hero p {
        max-width: 620px;
        margin: 19px 0 0;
        color: rgba(255,255,255,.66);
        line-height: 1.65;
    }


    .sc-community-hero-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }


    .sc-community-primary,
    .sc-community-secondary {
        min-height: 44px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        font-size: .73rem;
        font-weight: 850;
        text-decoration: none;
    }


    .sc-community-primary {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


    .sc-community-secondary {
        border: 1px solid #CCDAD6;
        background: #FFFFFF;
        color: #173D3D;
    }


        .sc-community-secondary.light {
            border-color: rgba(255,255,255,.24);
            background: rgba(255,255,255,.08);
            color: #FFFFFF;
        }


    /* =========================================================
               GUEST
               ========================================================= */

    .sc-community-guest {
        padding-top: 20px;
    }


    .sc-community-guest-card {
        padding: 15px 17px;
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 12px;
        border: 1px solid #D6E5E1;
        border-radius: 14px;
        background: #EEF7F5;
    }


    .sc-community-guest-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #FFFFFF;
        color: #2F9098;
    }


    .sc-community-guest-card strong,
    .sc-community-guest-card span {
        display: block;
    }


    .sc-community-guest-card strong {
        color: #173D3D;
        font-size: .76rem;
    }


    .sc-community-guest-card span {
        margin-top: 3px;
        color: #71807B;
        font-size: .68rem;
        line-height: 1.45;
    }


    .sc-community-guest-card a {
        color: #267C83;
        font-size: .71rem;
        font-weight: 850;
        text-decoration: none;
    }


    /* =========================================================
               CONTENT
               ========================================================= */

    .sc-community-content {
        padding: 30px 0 80px;
    }


    .sc-community-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 285px;
        align-items: start;
        gap: 18px;
    }


    .sc-community-main {
        min-width: 0;
    }


    /* =========================================================
               ALERT
               ========================================================= */

    .sc-community-alert {
        margin-bottom: 13px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: .73rem;
    }


        .sc-community-alert.success {
            border: 1px solid #B8DDCF;
            background: #EFFAF5;
            color: #28664D;
        }


        .sc-community-alert.error {
            border: 1px solid #F2B8B8;
            background: #FFF3F3;
            color: #9B2C2C;
        }


    /* =========================================================
               COMPOSER
               ========================================================= */

    .sc-community-composer {
        padding: 20px;
        border: 1px solid #DDE7E4;
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: 0 10px 26px rgba(23,61,61,.055);
    }


    .sc-community-composer-head {
        display: flex;
        align-items: center;
        gap: 11px;
    }


        .sc-community-composer-head strong,
        .sc-community-composer-head span {
            display: block;
        }


        .sc-community-composer-head strong {
            color: #173D3D;
            font-size: .82rem;
        }


        .sc-community-composer-head span {
            margin-top: 2px;
            color: #85928E;
            font-size: .65rem;
        }


    .sc-community-avatar {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #173D3D;
        color: #FFFFFF;
        font-size: .72rem;
        font-weight: 900;
    }


        .sc-community-avatar.small {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            font-size: .65rem;
        }


    .sc-community-composer > textarea {
        width: 100%;
        margin-top: 15px;
        padding: 13px 14px;
        border: 1px solid #D5E0DD;
        border-radius: 11px;
        background: #FBFCFB;
        color: #172A28;
        resize: vertical;
        outline: none;
    }


        .sc-community-composer > textarea:focus {
            border-color: #2F9098;
            box-shadow: 0 0 0 3px rgba(47,144,152,.08);
        }


    .sc-community-composer-options {
        margin-top: 11px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }


    .sc-community-field label {
        display: block;
        margin-bottom: 6px;
        color: #53635E;
        font-size: .65rem;
        font-weight: 800;
    }


    .sc-community-field select {
        width: 100%;
        min-height: 42px;
        padding: 0 10px;
        border: 1px solid #D7E0DD;
        border-radius: 9px;
        background: #FFFFFF;
        color: #53635E;
        font-size: .7rem;
    }


    .sc-community-upload-btn-wrap {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .sc-upload-btn-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border: 1px dashed #2F9098;
        border-radius: 9px;
        background: #F0F8F7;
        color: #175C59;
        font-size: .72rem;
        font-weight: 800;
        cursor: pointer;
        transition: all .2s ease;
    }

    .sc-upload-btn-custom:hover {
        background: #E2F2EF;
        border-color: #267C83;
    }

    .sc-upload-note {
        color: #8C9995;
        font-size: .58rem;
    }

    .sc-community-preview-card {
        margin-top: 14px;
        padding: 12px;
        display: grid;
        grid-template-columns: 84px minmax(0, 1fr) auto;
        align-items: center;
        gap: 14px;
        border: 1px solid #CDE2DC;
        border-radius: 14px;
        background: #FAFCFB;
        box-shadow: 0 4px 12px rgba(47, 144, 152, 0.06);
    }

    .sc-preview-img-box {
        width: 84px;
        height: 84px;
        border-radius: 10px;
        overflow: hidden;
        background: #E8ECEB;
        border: 1px solid #D5E1DE;
    }

    .sc-preview-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .sc-preview-details strong {
        display: block;
        font-size: .75rem;
        color: #173D3D;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sc-preview-details span {
        display: block;
        margin-top: 3px;
        font-size: .62rem;
        color: #6C7D77;
    }

    .sc-preview-remove-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border: 1px solid #F5C6CB;
        border-radius: 8px;
        background: #FFF5F5;
        color: #A92424;
        font-size: .65rem;
        font-weight: 800;
        cursor: pointer;
        transition: background .2s ease;
    }

    .sc-preview-remove-btn:hover {
        background: #FFEAEA;
    }


    .sc-community-composer-footer {
        margin-top: 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }


        .sc-community-composer-footer > span {
            color: #909C98;
            font-size: .61rem;
        }


        .sc-community-composer-footer > div {
            display: flex;
            gap: 7px;
        }


    .sc-community-post-button,
    .sc-community-cancel {
        min-height: 40px;
        padding: 0 14px;
        border-radius: 9px;
        font-size: .69rem;
        font-weight: 850;
        cursor: pointer;
    }


    .sc-community-post-button {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


    .sc-community-cancel {
        border: 1px solid #D7E0DD;
        background: #FFFFFF;
        color: #66746F;
    }


    /* =========================================================
               SIGN IN CARD
               ========================================================= */

    .sc-community-signin-card {
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        border: 1px solid #DDE7E4;
        border-radius: 16px;
        background: #FFFFFF;
    }


        .sc-community-signin-card h2 {
            margin: 4px 0 0;
            color: #173D3D;
            font-size: 1rem;
        }


        .sc-community-signin-card p {
            margin: 5px 0 0;
            color: #85928E;
            font-size: .69rem;
        }


        .sc-community-signin-card > div:last-child {
            display: flex;
            gap: 7px;
            flex-shrink: 0;
        }


    /* =========================================================
               FEED HEADER
               ========================================================= */

    .sc-community-feed-head {
        margin: 30px 0 14px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
    }


        .sc-community-feed-head h2 {
            margin: 5px 0 0;
            color: #173D3D;
            font-size: 1.4rem;
            font-weight: 900;
        }


    .sc-community-tabs {
        display: flex;
        gap: 5px;
    }


        .sc-community-tabs button {
            min-height: 36px;
            padding: 0 11px;
            border: 1px solid #DDE7E4;
            border-radius: 999px;
            background: #FFFFFF;
            color: #73817C;
            font-size: .63rem;
            font-weight: 800;
            cursor: pointer;
        }


            .sc-community-tabs button.active {
                border-color: #173D3D;
                background: #173D3D;
                color: #FFFFFF;
            }


    /* =========================================================
               COMMENTS (UPDATED FOR MODERN UI)
               ========================================================= */

    .sc-community-comments {
        margin-top: 16px;
        padding: 16px 18px 18px;
        border-top: 1px solid #E9EFED;
        background: #FAFBFA;
    }

    .sc-community-comments-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #53645E;
        font-size: .72rem;
        font-weight: 700;
    }

        .sc-community-comments-head span {
            padding: 2px 7px;
            border-radius: 999px;
            background: #EEF1F0;
            color: #8A9793;
            font-size: .6rem;
        }

    .sc-community-comment-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sc-community-comment {
        display: flex;
        gap: 10px;
    }

    .sc-community-comment-avatar {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #E6EFEC;
        color: #667772;
        font-size: .6rem;
        font-weight: 900;
    }

    .sc-community-comment-body {
        flex: 1;
        min-width: 0;
    }

    .sc-community-comment-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

        .sc-community-comment-meta strong {
            color: #42544E;
            font-size: .68rem;
        }

        .sc-community-comment-meta small {
            color: #98A39F;
            font-size: .58rem;
        }

    .sc-community-guest-tag {
        padding: 1px 6px;
        border-radius: 999px;
        background: #EEF1F0;
        color: #72807C;
        font-size: .52rem;
        font-weight: 850;
    }

    .sc-community-comment-reply-indicator {
        margin-bottom: 4px;
        color: #8A9793;
        font-size: .6rem;
        font-style: italic;
    }

    .sc-community-comment-text {
        margin: 0 0 6px;
        color: #5D6D67;
        font-size: .7rem;
        line-height: 1.5;
        white-space: pre-wrap;
    }

    .sc-community-comment-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sc-community-comment-likes {
        color: #98A39F;
        font-size: .6rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .sc-community-action-link {
        padding: 0;
        border: 0;
        background: transparent;
        color: #2F9098;
        font-size: .62rem;
        font-weight: 700;
        cursor: pointer;
        transition: color 0.2s;
    }

        .sc-community-action-link:hover {
            color: #173D3D;
            text-decoration: underline;
        }

        .sc-community-action-link.danger {
            color: #A04343;
        }

            .sc-community-action-link.danger:hover {
                color: #7A2E2E;
            }

    /* Comment Form */
    .sc-community-comment-form {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px dashed #D5E0DD;
    }

    .sc-community-comment-identity {
        margin-bottom: 10px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #E0E8E5;
        border-radius: 10px;
        background: #FFFFFF;
    }

    .sc-community-guest-avatar {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #E6EFEC;
        color: #667772;
        font-size: .64rem;
        font-weight: 900;
    }

    .sc-community-comment-identity strong,
    .sc-community-comment-identity small {
        display: block;
    }

    .sc-community-comment-identity strong {
        color: #4F615B;
        font-size: .64rem;
    }

    .sc-community-comment-identity small {
        margin-top: 1px;
        color: #909B97;
        font-size: .56rem;
    }

    .sc-community-comment-input-wrapper {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .sc-community-comment-input-wrapper input {
            flex: 1;
            min-height: 42px;
            padding: 0 14px;
            border: 1px solid #D5E0DD;
            border-radius: 12px;
            background: #FFFFFF;
            color: #42544E;
            font-size: .7rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .sc-community-comment-input-wrapper input:focus {
                border-color: #2F9098;
                box-shadow: 0 0 0 3px rgba(47,144,152,.08);
            }

            .sc-community-comment-input-wrapper input:disabled {
                background: #F0F2F1;
                cursor: not-allowed;
            }

        .sc-community-comment-input-wrapper button {
            min-height: 42px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid #2F9098;
            border-radius: 12px;
            background: #2F9098;
            color: #FFFFFF;
            font-size: .68rem;
            font-weight: 800;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

            .sc-community-comment-input-wrapper button:hover:not(:disabled) {
                background: #267C83;
            }

            .sc-community-comment-input-wrapper button:active:not(:disabled) {
                transform: scale(0.97);
            }

            .sc-community-comment-input-wrapper button:disabled {
                background: #A9BDB9;
                border-color: #A9BDB9;
                cursor: not-allowed;
            }


    /* =========================================================
               POSTS
               ========================================================= */

    .sc-community-feed {
        display: grid;
        gap: 12px;
    }


    .sc-community-post {
        overflow: hidden;
        border: 1px solid #DDE7E4;
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: 0 8px 22px rgba(23,61,61,.045);
    }


    .sc-community-post-header {
        padding: 17px 18px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .sc-community-post-author {
        min-width: 0;
        flex: 1;
    }


        .sc-community-post-author strong,
        .sc-community-post-author > span {
            display: block;
        }


        .sc-community-post-author strong {
            color: #173D3D;
            font-size: .76rem;
        }


        .sc-community-post-author > span {
            margin-top: 2px;
            color: #909C98;
            font-size: .61rem;
        }


        .sc-community-post-author b {
            color: #267C83;
            font-weight: 800;
        }


    .sc-community-post-actions {
        display: flex;
        gap: 5px;
    }


        .sc-community-post-actions button {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border: 1px solid #E0E7E4;
            border-radius: 8px;
            background: #FFFFFF;
            color: #6F7C77;
            cursor: pointer;
        }


            .sc-community-post-actions button.danger {
                color: #A04343;
            }


    .sc-community-caption {
        margin: 0;
        padding: 15px 18px;
        color: #485853;
        font-size: .78rem;
        line-height: 1.62;
        white-space: pre-wrap;
    }


    .sc-community-post-image {
        width: 100%;
        background: #F4F7F6;
        border-top: 1px solid #EEF3F0;
        border-bottom: 1px solid #EEF3F0;
        overflow: hidden;
    }

    .sc-community-post-image.single .sc-img-wrapper img {
        width: 100%;
        max-height: 520px;
        display: block;
        object-fit: cover;
    }

    .sc-community-post-image.grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        background: #E5EDE9;
    }

    .sc-community-post-image.grid-2 .sc-img-wrapper img {
        width: 100%;
        height: 280px;
        display: block;
        object-fit: cover;
    }

    .sc-community-post-image.grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 4px;
        background: #E5EDE9;
    }

    .sc-community-post-image.grid-3 .sc-img-wrapper img {
        width: 100%;
        height: 220px;
        display: block;
        object-fit: cover;
    }


    .sc-community-post-footer {
        padding: 12px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-top: 1px solid #EDF1EF;
        color: #84918D;
        font-size: .62rem;
    }


        .sc-community-post-footer span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }


    /* =========================================================
               EMPTY
               ========================================================= */

    .sc-community-empty {
        padding: 60px 24px;
        text-align: center;
        border: 1px dashed #D6E0DD;
        border-radius: 16px;
        background: rgba(255,255,255,.7);
    }


        .sc-community-empty > div {
            width: 52px;
            height: 52px;
            margin: 0 auto;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: #EAF5F5;
            color: #2F9098;
            font-size: 1.15rem;
        }


        .sc-community-empty h3 {
            margin: 13px 0 0;
            color: #173D3D;
            font-size: .9rem;
        }


        .sc-community-empty p {
            margin: 5px 0 0;
            color: #899691;
            font-size: .67rem;
        }


    /* =========================================================
               SIDEBAR
               ========================================================= */

    .sc-community-sidebar {
        display: grid;
        gap: 11px;
        position: sticky;
        top: 130px;
    }


    .sc-community-side-card {
        padding: 18px;
        border: 1px solid #DDE7E4;
        border-radius: 15px;
        background: #FFFFFF;
    }

    .sc-rankings-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .sc-ranking-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 10px;
        background: #F8FAF9;
        border: 1px solid #E8EFEF;
        transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .sc-ranking-item:hover {
        background: #EEF7F5;
        transform: translateY(-1px);
    }

    .sc-ranking-badge {
        font-size: 1.1rem;
        min-width: 24px;
        text-align: center;
        font-weight: 800;
    }

    .sc-ranking-badge .rank-num {
        font-size: 0.75rem;
        color: #788782;
        font-weight: 800;
    }

    .sc-ranking-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        background: #236B69;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sc-ranking-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .sc-ranking-avatar-fallback {
        color: #FFFFFF;
        font-size: 0.85rem;
        font-weight: 800;
    }

    .sc-ranking-info {
        flex: 1;
        min-width: 0;
    }

    .sc-ranking-name {
        display: block;
        font-size: 0.82rem;
        color: #173D3D;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sc-ranking-stats {
        display: flex;
        gap: 8px;
        font-size: 0.68rem;
        color: #788782;
        margin-top: 2px;
    }

    .sc-ranking-stats span {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }


        .sc-community-side-card h3 {
            margin: 6px 0 0;
