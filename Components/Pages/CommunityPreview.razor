@code {

    // =========================================================
    // DATA
    // =========================================================

    private readonly Dictionary<int, List<CommunityComment>> commentsByPost = new();
    private readonly Dictionary<int,int> replyParents=new();
    private readonly Dictionary<int, string> commentDrafts = new();

    private List<CommunityPost> posts = new();

    private List<PetProfile> myPets = new();

    private HashSet<int> likedPostIds =
    new();
    // =========================================================
    // COMPOSER
    // =========================================================

    private string caption = string.Empty;

    private int selectedPetId;

    private IBrowserFile? selectedImage;


    private bool isSaving;

    private bool isEditing;

    private int? editingPostId;


    private string existingImageUrl = string.Empty;

    private bool removeExistingImage;


    // =========================================================
    // UI
    // =========================================================

    private bool showMyPosts;

    private int MyPostCount =>
        Auth.CurrentUser is null
            ? 0
            : posts.Count(x => x.UserId == Auth.CurrentUser.Id);

    private string statusMessage = string.Empty;

    private bool isError;


    // =========================================================
    // COMPUTED
    // =========================================================

    private int CharactersRemaining =>
        Math.Max(
            0,
            500 - caption.Length);


    private List<CommunityPost> VisiblePosts
    {
        get
        {
            if (!showMyPosts)
            {
                return posts;
            }


            if (Auth.CurrentUser is null)
            {
                return new List<CommunityPost>();
            }


            return posts
                .Where(
                    post =>
                        post.UserId ==
                        Auth.CurrentUser.Id)
                .ToList();
        }
    }


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override void OnInitialized()
    {
        Auth.RegisterListener(
            OnAuthStateChanged);


        LoadPosts();
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await Auth.InitializeAsync();


        LoadCurrentUserPets();
        LoadLikeState();

        await InvokeAsync(
            StateHasChanged);

    }
    private void LoadLikeState()
    {
        if (Auth.CurrentUser is null ||
            !Auth.IsPetOwner)
        {
            likedPostIds =
                new HashSet<int>();

            return;
        }


        try
        {
            likedPostIds =
                Community.GetLikedPostIds(
                    Auth.CurrentUser.Id);
        }
        catch
        {
            likedPostIds =
                new HashSet<int>();
        }
    }


    private void ToggleLike(
        CommunityPost post)
    {
        if (Auth.CurrentUser is null ||
            !Auth.IsPetOwner)
        {
            Nav.NavigateTo(
                "/login");

            return;
        }


        try
        {
            Community.ToggleLike(
                post.Id,
                Auth.CurrentUser.Id);


            LoadPosts();

            LoadLikeState();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Community Like] {ex}");


            ShowError(
                "Your like could not be updated.");
        }
    }

    private void OnAuthStateChanged()
    {
        _ =
            InvokeAsync(
                () =>
                {
                    LoadCurrentUserPets();

                    StateHasChanged();
                });
    }


    // =========================================================
    // LOAD
    // =========================================================

    private List<CommunityComment> GetComments(int postId)
    {
        if (!commentsByPost.TryGetValue(postId, out var comments))
        {
            try
            {
                comments = Community.GetComments(postId);
            }
            catch
            {
                comments = new List<CommunityComment>();
            }

            commentsByPost[postId] = comments;
        }

        return comments;
    }

    private string GetCommentDraft(int postId) =>
        commentDrafts.TryGetValue(postId, out var value) ? value : string.Empty;

    private void SetCommentDraft(int postId, string value) =>
        commentDrafts[postId] = value;

    private void Reply(int post,int comment){replyParents[post]=comment;statusMessage=$"Replying to comment #{comment}. Write your reply below.";}
    private void LikeComment(int post,int id){if(!Auth.IsPetOwner||Auth.CurrentUser is null)return;try{Community.ToggleCommentLike(id,Auth.CurrentUser.Id);commentsByPost[post]=Community.GetComments(post);}catch{ShowError("Could not update this like.");}}
    private void DeleteComment(int post,int id){if(Auth.CurrentUser is null)return;try{Community.DeleteComment(id,Auth.CurrentUser.Id,Auth.IsAdmin);commentsByPost[post]=Community.GetComments(post);}catch{ShowError("Could not delete this comment.");}}
    private void SubmitComment(int postId)
    {
        if(!Auth.IsPetOwner){ShowError("Sign in with a Pet Owner account to comment.");return;}
        var body = GetCommentDraft(postId).Trim();

        if (string.IsNullOrWhiteSpace(body))
        {
            ShowError("Write a comment before submitting.");
            return;
        }

        var isGuest = Auth.IsGuest || !Auth.IsLoggedIn;
        var userId = Auth.CurrentUser?.Id;
        var authorName = isGuest
            ? "Guest"
            : Auth.CurrentUser?.FullName ?? "Pet Owner";

        try
        {
            if (Community.AddComment(postId, userId, authorName, body, isGuest,replyParents.TryGetValue(postId,out var parent)?parent:null))
            {
                commentDrafts[postId] = string.Empty;replyParents.Remove(postId);
                commentsByPost[postId] = Community.GetComments(postId);
                statusMessage = "Comment posted.";
                isError = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Community Comment] {ex}");
            ShowError("Your comment could not be posted.");
        }
    }


    private void LoadPosts()
    {
        try
        {
            posts =
                Community
                    .GetRecentPosts(50);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Community] Load failed: {ex}");


            ShowError(
                "Community posts could not be loaded.");
        }
    }


    private void LoadCurrentUserPets()
    {
        if (Auth.CurrentUser is null ||
            !Auth.IsPetOwner)
        {
            myPets =
                new List<PetProfile>();


            return;
        }


        try
        {
            myPets =
                Db.GetPetsByUser(
                    Auth.CurrentUser.Id);
        }
        catch
        {
            myPets =
                new List<PetProfile>();
        }
    }


    // =========================================================
    // IMAGE
    // =========================================================

    private void HandleImageSelected(
        InputFileChangeEventArgs args)
    {
        var file =
            args.File;


        if (file.Size >
            5 * 1024 * 1024)
        {
            selectedImage =
                null;


            ShowError(
                "Please choose an image smaller than 5 MB.");


            return;
        }


        selectedImage =
            file;


        removeExistingImage =
            false;


        statusMessage =
            string.Empty;
    }


    private void ClearSelectedImage()
    {
        selectedImage =
            null;
    }


    private void RemoveExistingImage()
    {
        removeExistingImage =
            true;


        existingImageUrl =
            string.Empty;
    }


    // =========================================================
    // CREATE / UPDATE POST
    // =========================================================

    private async Task SavePostAsync()
    {
        statusMessage =
            string.Empty;


        isError =
            false;


        if (Auth.CurrentUser is null ||
            !Auth.IsPetOwner)
        {
            ShowError(
                "Please sign in with a pet owner account to post.");


            return;
        }


        caption =
            caption.Trim();


        if (string.IsNullOrWhiteSpace(caption))
        {
            ShowError(
                "Write something before posting.");


            return;
        }


        if (caption.Length > 500)
        {
            ShowError(
                "Community posts are limited to 500 characters.");


            return;
        }


        isSaving =
            true;


        try
        {
            var petId =
                selectedPetId > 0
                    ? selectedPetId
                    : (int?)null;


            // =================================================
            // EDIT
            // =================================================

            if (isEditing &&
                editingPostId.HasValue)
            {
                var postId =
                    editingPostId.Value;


                var updated =
                    Community.UpdatePost(
                        postId,
                        Auth.CurrentUser.Id,
                        petId,
                        caption);


                if (!updated)
                {
                    ShowError(
                        "The post could not be updated.");


                    return;
                }


                if (removeExistingImage)
                {
                    Community.ClearPostImage(
                        postId,
                        Auth.CurrentUser.Id);


                    FileStorage.DeleteImage(
                        "community",
                        postId);
                }


                if (selectedImage is not null)
                {
                    var imageUrl =
                        await FileStorage
                            .SaveImageAsync(
                                "community",
                                postId,
                                selectedImage);


                    Community.UpdatePostImage(
                        postId,
                        Auth.CurrentUser.Id,
                        imageUrl);
                }


                statusMessage =
                    "Your post was updated.";
            }

            // =================================================
            // CREATE
            // =================================================

            else
            {
                var postId =
                    Community.CreatePost(
                        Auth.CurrentUser.Id,
                        petId,
                        caption);


                if (selectedImage is not null)
                {
                    var imageUrl =
                        await FileStorage
                            .SaveImageAsync(
                                "community",
                                postId,
                                selectedImage);


                    Community.UpdatePostImage(
                        postId,
                        Auth.CurrentUser.Id,
                        imageUrl);
                }


                statusMessage =
                    "Your story is now part of the community.";
            }


            isError =
                false;


            ResetComposer();


            LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Community] Save failed: {ex}");


            ShowError(
                "Your post could not be saved. Please try again.");
        }
        finally
        {
            isSaving =
                false;
        }
    }


    // =========================================================
    // EDIT
    // =========================================================

    private void StartEditing(
        CommunityPost post)
    {
        if (!IsOwnPost(post))
            return;


        isEditing =
            true;


        editingPostId =
            post.Id;


        caption =
            post.Caption;


        selectedPetId =
            post.PetId ?? 0;


        existingImageUrl =
            post.ImageUrl;


        removeExistingImage =
            false;


        selectedImage =
            null;


        statusMessage =
            string.Empty;
    }


    private void CancelEditing()
    {
        ResetComposer();


        statusMessage =
            string.Empty;
    }


    // =========================================================
    // DELETE
    // =========================================================

    private void DeletePost(
        CommunityPost post)
    {
        if (!IsOwnPost(post) ||
            Auth.CurrentUser is null)
        {
            return;
        }


        try
        {
            var deleted =
                Community.DeletePost(
                    post.Id,
                    Auth.CurrentUser.Id);


            if (!deleted)
            {
                ShowError(
                    "The post could not be deleted.");


                return;
            }


            try
            {
                FileStorage.DeleteImage(
                    "community",
                    post.Id);
            }
            catch
            {
            }


            if (editingPostId ==
                post.Id)
            {
                ResetComposer();
            }


            statusMessage =
                "Post deleted.";


            isError =
                false;


            LoadPosts();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Community] Delete failed: {ex}");


            ShowError(
                "The post could not be deleted.");
        }
    }


    // =========================================================
    // FEED TABS
    // =========================================================

    private void ShowAllPosts()
    {
        showMyPosts =
            false;
    }


    private void ShowMyPosts()
    {
        showMyPosts =
            true;
    }


    // =========================================================
    // OWNERSHIP
    // =========================================================

    private bool IsOwnPost(
        CommunityPost post)
    {
        return
            Auth.CurrentUser is not null
            &&
            post.UserId ==
            Auth.CurrentUser.Id;
    }


    // =========================================================
    // NAME
    // =========================================================

    private string GetFirstName()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        if (string.IsNullOrWhiteSpace(name))
        {
            return "there";
        }


        return
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault()
            ??
            "there";
    }


    private string GetUserInitials()
    {
        return
            GetInitials(
                Auth.CurrentUser?.FullName
                ?? string.Empty);
    }


    private string GetInitials(
        string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "U";
        }


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return
                parts[0]
                    .Substring(
                        0,
                        Math.Min(
                            2,
                            parts[0].Length))
                    .ToUpperInvariant();
        }


        return
            (
                parts[0].Substring(0, 1)
                +
                parts[^1].Substring(0, 1)
            )
            .ToUpperInvariant();
    }


    // =========================================================
    // TIME
    // =========================================================

    private string Relative(
        DateTime date)
    {
        var span =
            DateTime.Now - date;


        if (span.TotalSeconds < 60)
        {
            return "just now";
        }


        if (span.TotalMinutes < 60)
        {
            return
                $"{(int)span.TotalMinutes}m ago";
        }


        if (span.TotalHours < 24)
        {
            return
                $"{(int)span.TotalHours}h ago";
        }


        if (span.TotalDays < 7)
        {
            return
                $"{(int)span.TotalDays}d ago";
        }


        return
            date.ToString(
                "MMM d, yyyy");
    }


    // =========================================================
    // ERROR
    // =========================================================

    private void ShowError(
        string message)
    {
        statusMessage =
            message;


        isError =
            true;
    }


    // =========================================================
    // RESET
    // =========================================================

    private void ResetComposer()
    {
        caption =
            string.Empty;


        selectedPetId =
            0;


        selectedImage =
            null;


        isEditing =
            false;


        editingPostId =
            null;


        existingImageUrl =
            string.Empty;


        removeExistingImage =
            false;
    }


    // =========================================================
    // CLEANUP
    // =========================================================

    public void Dispose()
    {
        Auth.UnregisterListener(
            OnAuthStateChanged);
    }
