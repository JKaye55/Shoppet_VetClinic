@page "/community"
@rendermode InteractiveServer
@implements IDisposable

@inject CommunityService Community
@inject DatabaseService Db
@inject FileStorageService FileStorage
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Community | ShoppetCare</PageTitle>


<div class="sc-community-page">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="sc-community-hero">

        <div class="sc-community-shell sc-community-hero-inner">

            <div>

                <span class="sc-community-kicker light">
                    SHOPPETCARE COMMUNITY
                </span>

                <h1>
                    Pet stories feel better
                    <em>when they're shared.</em>
                </h1>

                <p>
                    Share everyday moments, tag your pets,
                    and discover stories from fellow pet owners
                    in the ShoppetCare community.
                </p>

            </div>


            @if (!Auth.IsLoggedIn)
            {
                <div class="sc-community-hero-actions">

                    <a href="/register"
                       class="sc-community-primary">
                        Join the Community
                    </a>

                    <a href="/login"
                       class="sc-community-secondary light">
                        Sign In
                    </a>

                </div>
            }

        </div>

    </section>


    <!-- =========================================================
         GUEST MODE
         ========================================================= -->
    @if (Auth.IsGuest)
    {
        <section class="sc-community-guest">

            <div class="sc-community-shell">

                <div class="sc-community-guest-card">

                    <div class="sc-community-guest-icon">

                        <i class="bi bi-eye-fill"
                           aria-hidden="true"></i>

                    </div>

                    <div>

                        <strong>
                            Browsing Community Feed in Guest Mode
                        </strong>

                        <span>
                            You can read posts as a guest. Sign in to join the conversation.
                            Guest identity is fixed for clarity. Create an account
                            to publish stories, like posts, and build your profile.
                        </span>

                    </div>

                    <a href="/register">
                        Create Account
                    </a>

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         MAIN
         ========================================================= -->

    <section class="sc-community-content">

        <div class="sc-community-shell">

            <div class="sc-community-layout">


                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->

                <div class="sc-community-main">


                    <!-- =============================================
                         MESSAGE
                         ============================================= -->
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="@(isError
                                                        ? "sc-community-alert error"
                                                        : "sc-community-alert success")">

                            @statusMessage

                        </div>
                    }


                    <!-- =============================================
                         POST COMPOSER
                         ============================================= -->
                    @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                    {
                        <section class="sc-community-composer">

                            <div class="sc-community-composer-head">

                                <div class="sc-community-avatar">
                                    @GetUserInitials()
                                </div>

                                <div>

                                    <strong>
                                        @(isEditing
                                            ? "Edit your post"
                                            : $"Share something, {GetFirstName()}")
                                    </strong>

                                    <span>
                                        @(isEditing
                                            ? "Update your story below."
                                            : "What's your pet up to today?")
                                    </span>

                                </div>

                            </div>


                            <textarea rows="4"
                                      maxlength="500"
                                      @bind="caption"
                                      placeholder="Share a moment with your pet...">
                            </textarea>


                            <div class="sc-community-composer-options">

                                <div class="sc-community-field">

                                    <label>
                                        Tag a Pet
                                    </label>

                                    <select @bind="selectedPetId">

                                        <option value="0">
                                            No pet tagged
                                        </option>

                                        @foreach (var pet in myPets)
                                        {
                                            <option value="@pet.Id">
                                                @pet.PetName
                                            </option>
                                        }

                                    </select>

                                </div>


                                <div class="sc-community-field">

                                    <label>
                                        Add Photo
                                    </label>

                                    <div class="sc-community-upload">

                                        <InputFile OnChange="HandleImageSelected"
                                                   accept=".jpg,.jpeg,.png,.webp" />

                                        <small>
                                            JPG, PNG or WEBP · Max 5 MB
                                        </small>

                                    </div>

                                </div>

                            </div>


                            @if (selectedImage is not null)
                            {
                                <div class="sc-community-selected-image">

                                    <i class="bi bi-image"
                                       aria-hidden="true"></i>

                                    <span>
                                        @selectedImage.Name
                                    </span>

                                    <button type="button"
                                            @onclick="ClearSelectedImage">
                                        Remove
                                    </button>

                                </div>
                            }


                            @if (isEditing &&
                                 !string.IsNullOrWhiteSpace(existingImageUrl))
                            {
                                <div class="sc-community-existing-image">

                                    <img src="@existingImageUrl"
                                         alt="Current post image" />

                                    <div>

                                        <strong>
                                            Current photo
                                        </strong>

                                        <span>
                                            Upload another photo to replace it.
                                        </span>

                                        <button type="button"
                                                @onclick="RemoveExistingImage">
                                            Remove Current Photo
                                        </button>

                                    </div>

                                </div>
                            }


                            <div class="sc-community-composer-footer">

                                <span>
                                    @CharactersRemaining characters left
                                </span>

                                <div>

                                    @if (isEditing)
                                    {
                                        <button type="button"
                                                class="sc-community-cancel"
                                                disabled="@isSaving"
                                                @onclick="CancelEditing">

                                            Cancel

                                        </button>
                                    }

                                    <button type="button"
                                            class="sc-community-post-button"
                                            disabled="@isSaving"
                                            @onclick="SavePostAsync">

                                        @(isSaving
                                            ? "Saving..."
                                            : isEditing
                                                ? "Save Changes"
                                                : "Post Story")

                                    </button>

                                </div>

                            </div>

                        </section>
                    }
                    else if (!Auth.IsLoggedIn)
                    {
                        <section class="sc-community-signin-card">

                            <div>

                                <span class="sc-community-kicker">
                                    WANT TO SHARE?
                                </span>

                                <h2>
                                    Want to publish your own story?
                                </h2>

                                <p>
                                    Sign in or create a free account to create posts and use member features
                                    to post your own pet stories.
                                </p>

                            </div>

                            <div>

                                <a href="/login"
                                   class="sc-community-secondary">
                                    Sign In
                                </a>

                                <a href="/register"
                                   class="sc-community-primary">
                                    Create Account
                                </a>

                            </div>

                        </section>
                    }


                    <!-- =============================================
                         FEED HEADER
                         ============================================= -->

                    <div class="sc-community-feed-head">

                        <div>

                            <span class="sc-community-kicker">
                                COMMUNITY FEED
                            </span>

                            <h2>
                                Latest pet stories
                            </h2>

                        </div>


                        @if (Auth.IsLoggedIn &&
                             Auth.IsPetOwner)
                        {
                            <div class="sc-community-tabs">

                                <button type="button"
                                        class="@(!showMyPosts ? "active" : "")"
                                        @onclick="ShowAllPosts">

                                    All Posts

                                </button>

                                <button type="button"
                                        class="@(showMyPosts ? "active" : "")"
                                        @onclick="ShowMyPosts">

                                    My Posts (@MyPostCount)

                                </button>

                            </div>
                        }

                    </div>


                    <!-- =============================================
                         EMPTY FEED
                         ============================================= -->
                    @if (VisiblePosts.Count == 0)
                    {
                        <div class="sc-community-empty">

                            <div>
                                <i class="bi bi-chat-heart"
                                   aria-hidden="true"></i>
                            </div>

                            <h3>
                                @(showMyPosts
                                    ? "You haven't posted yet."
                                    : "No community posts yet.")
                            </h3>

                            <p>
                                @(showMyPosts
                                    ? "Share your first pet story with the ShoppetCare community."
                                    : "The first story can start right here.")
                            </p>

                        </div>
                    }
                    else
                    {
                        <!-- =========================================
                             FEED
                             ========================================= -->

                        <div class="sc-community-feed">

                            @foreach (var post in VisiblePosts)
                            {
                                <article class="sc-community-post">

                                    <!-- AUTHOR -->

                                    <header class="sc-community-post-header">

                                        <div class="sc-community-avatar small">
                                            @GetInitials(post.AuthorName)
                                        </div>

                                        <div class="sc-community-post-author">

                                            <strong>
                                                @post.AuthorName
                                            </strong>

                                            <span>

                                                @Relative(post.PostedAt)

                                                @if (post.IsEdited)
                                                {
                                                    <span> · edited</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                    post.PetName))
                                                {
                                                    <span>
                                                        · with
                                                        <b>@post.PetName</b>
                                                    </span>
                                                }

                                            </span>

                                        </div>


                                        @if (IsOwnPost(post))
                                        {
                                            <div class="sc-community-post-actions">

                                                <button type="button"
                                                        title="Edit post"
                                                        @onclick="() => StartEditing(post)">

                                                    <i class="bi bi-pencil"
                                                       aria-hidden="true"></i>

                                                </button>

                                                <button type="button"
                                                        class="danger"
                                                        title="Delete post"
                                                        @onclick="() => DeletePost(post)">

                                                    <i class="bi bi-trash3"
                                                       aria-hidden="true"></i>

                                                </button>

                                            </div>
                                        }

                                    </header>


                                    <!-- CAPTION -->

                                    <p class="sc-community-caption">
                                        @post.Caption
                                    </p>


                                    <!-- IMAGE -->
                                    @if (!string.IsNullOrWhiteSpace(
                                                                            post.ImageUrl))
                                    {
                                        <div class="sc-community-post-image">

                                            @foreach(var url in post.ImageUrl.Split(',',StringSplitOptions.RemoveEmptyEntries)){<img src="@url" alt="Photo shared by @post.AuthorName" loading="lazy" />}

                                        </div>
                                    }


                                    <!-- META -->

                                    <footer class="sc-community-post-footer">

                                        @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                                        {
                                            <button type="button"
                                                    class="@(likedPostIds.Contains(post.Id)
                                                                ? "sc-community-like liked"
                                                                : "sc-community-like")"
                                                    @onclick="() => ToggleLike(post)">

                                                <i class="@(likedPostIds.Contains(post.Id)
                                                               ? "bi bi-heart-fill"
                                                               : "bi bi-heart")"
                                                   aria-hidden="true">
                                                </i>

                                                @post.LikeCount
                                                @(post.LikeCount == 1
                                                    ? "like"
                                                    : "likes")

                                            </button>
                                        }
                                        else
                                        {
                                            <span>

                                                <i class="bi bi-heart"
                                                   aria-hidden="true">
                                                </i>

                                                @post.LikeCount
                                                @(post.LikeCount == 1
                                                    ? "like"
                                                    : "likes")

                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(
                                            post.PetName))
                                        {
                                            <span>

                                                <i class="bi bi-heart-pulse"
                                                   aria-hidden="true"></i>

                                                @post.PetName

                                            </span>
                                        }

                                    </footer>

                                    @{
                                        var postComments = GetComments(post.Id);
                                    }

                                    <section class="sc-community-comments">
                                        <div class="sc-community-comments-head">
                                            <strong>Comments</strong>
                                            <span>@postComments.Count</span>
                                        </div>

                                        @foreach (var comment in postComments)
                                        {
                                            <div class="sc-community-comment">
                                                <div>
                                                    <strong>@comment.AuthorName</strong>
                                                    @if (comment.IsGuest)
                                                    {
                                                        <span class="sc-community-guest-tag">Guest</span>
                                                    }
                                                    <small>@Relative(comment.CreatedAt)</small>
                                                </div>
                                                @if(comment.ParentCommentId.HasValue){<small>Reply to comment #@comment.ParentCommentId</small>}
                                                <p>@comment.Body</p>
                                                <small>@comment.LikeCount likes</small>
                                                @if(Auth.IsPetOwner&&Auth.CurrentUser is not null){<button type="button" class="secondary-link" @onclick="()=>LikeComment(post.Id,comment.Id)">Like / unlike</button><button type="button" class="secondary-link" @onclick="()=>Reply(post.Id,comment.Id)">Reply</button>}
                                                @if(Auth.CurrentUser is not null&&(comment.UserId==Auth.CurrentUser.Id||Auth.IsAdmin)){<button type="button" class="secondary-link" @onclick="()=>DeleteComment(post.Id,comment.Id)">Delete</button>}
                                            </div>
                                        }

                                        <div class="sc-community-comment-form">
                                            @if (Auth.IsGuest)
                                            {
                                                <div class="sc-community-comment-identity">
                                                    <span class="sc-community-guest-avatar">G</span>
                                                    <span>
                                                        <strong>Commenting as Guest</strong>
                                                        <small>Your guest name cannot be changed.</small>
                                                    </span>
                                                </div>
                                            }

                                            <div>
                                                <input type="text"
                                                       maxlength="300"
                                                       value="@GetCommentDraft(post.Id)"
                                                       @oninput="e => SetCommentDraft(post.Id, e.Value?.ToString() ?? string.Empty)"
                                                       placeholder="Write a helpful comment..." />
                                                <button type="button" @onclick="() => SubmitComment(post.Id)">Comment</button>
                                            </div>
                                        </div>
                                    </section>

                                </article>
                            }

                        </div>
                    }

                </div>


                <!-- =================================================
                     RIGHT SIDEBAR
                     ================================================= -->

                <aside class="sc-community-sidebar">

                    <section class="sc-community-side-card">

                        <span class="sc-community-kicker">
                            COMMUNITY
                        </span>

                        <h3>
                            A space for pet owners.
                        </h3>

                        <p>
                            Share pet moments, helpful experiences,
                            milestones, and everyday stories with
                            the local ShoppetCare community.
                        </p>

                    </section>


                    <section class="sc-community-side-card">

                        <span class="sc-community-kicker">
                            KEEP IT HELPFUL
                        </span>

                        <ul>

                            <li>
                                Share respectful pet-related content.
                            </li>

                            <li>
                                Avoid posting private or sensitive information.
                            </li>

                            <li>
                                Keep marketplace selling inside Marketplace.
                            </li>

                            <li>
                                Veterinary concerns should still be discussed
                                with a qualified clinic.
                            </li>

                        </ul>

                    </section>


                    <section class="sc-community-side-card mobile-note">

                        <i class="bi bi-phone"
                           aria-hidden="true"></i>

                        <div>

                            <strong>
                                Web + Mobile
                            </strong>

                            <span>
                                Community content can use the same
                                centralized ShoppetCare data across
                                both platforms.
                            </span>

                        </div>

                    </section>

                </aside>

            </div>

        </div>

    </section>

</div>


<style>
    .sc-community-like {
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0;
        background: transparent;
        color: #75847F;
        font: inherit;
        cursor: pointer;
    }

        .sc-community-like:hover {
            color: #2F9098;
        }

        .sc-community-like.liked {
            color: #C65C68;
        }

    .sc-community-page {
        min-height: 100vh;
        background: #FAF9F6;
        color: #172A28;
    }


    .sc-community-shell {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .sc-community-hero {
        padding: 65px 0 56px;
        background: radial-gradient( circle at 86% 18%, rgba(243,210,122,.20), transparent 27% ), linear-gradient( 135deg, #173D3D, #102E2D );
        color: #FFFFFF;
    }


    .sc-community-hero-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 35px;
    }


    .sc-community-kicker {
        display: inline-block;
        color: #2F9098;
        font-size: .64rem;
        font-weight: 900;
        letter-spacing: .11em;
    }


        .sc-community-kicker.light {
            color: #9ADBDD;
        }


    .sc-community-hero h1 {
        max-width: 700px;
        margin: 9px 0 0;
        font-size: clamp(2.7rem, 5vw, 4.8rem);
        line-height: .95;
        letter-spacing: -.055em;
        font-weight: 900;
    }


        .sc-community-hero h1 em {
            display: block;
            color: #F3D27A;
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 500;
        }


    .sc-community-hero p {
        max-width: 620px;
        margin: 19px 0 0;
        color: rgba(255,255,255,.66);
        line-height: 1.65;
    }


    .sc-community-hero-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }


    .sc-community-primary,
    .sc-community-secondary {
        min-height: 44px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        font-size: .73rem;
        font-weight: 850;
        text-decoration: none;
    }


    .sc-community-primary {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


    .sc-community-secondary {
        border: 1px solid #CCDAD6;
        background: #FFFFFF;
        color: #173D3D;
    }


        .sc-community-secondary.light {
            border-color: rgba(255,255,255,.24);
            background: rgba(255,255,255,.08);
            color: #FFFFFF;
        }


    /* =========================================================
           GUEST
           ========================================================= */

    .sc-community-guest {
        padding-top: 20px;
    }


    .sc-community-guest-card {
        padding: 15px 17px;
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 12px;
        border: 1px solid #D6E5E1;
        border-radius: 14px;
        background: #EEF7F5;
    }


    .sc-community-guest-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #FFFFFF;
        color: #2F9098;
    }


    .sc-community-guest-card strong,
    .sc-community-guest-card span {
        display: block;
    }


    .sc-community-guest-card strong {
        color: #173D3D;
        font-size: .76rem;
    }


    .sc-community-guest-card span {
        margin-top: 3px;
        color: #71807B;
        font-size: .68rem;
        line-height: 1.45;
    }


    .sc-community-guest-card a {
        color: #267C83;
        font-size: .71rem;
        font-weight: 850;
        text-decoration: none;
    }


    /* =========================================================
           CONTENT
           ========================================================= */

    .sc-community-content {
        padding: 30px 0 80px;
    }


    .sc-community-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 285px;
        align-items: start;
        gap: 18px;
    }


    .sc-community-main {
        min-width: 0;
    }


    /* =========================================================
           ALERT
           ========================================================= */

    .sc-community-alert {
        margin-bottom: 13px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: .73rem;
    }


        .sc-community-alert.success {
            border: 1px solid #B8DDCF;
            background: #EFFAF5;
            color: #28664D;
        }


        .sc-community-alert.error {
            border: 1px solid #F2B8B8;
            background: #FFF3F3;
            color: #9B2C2C;
        }


    /* =========================================================
           COMPOSER
           ========================================================= */

    .sc-community-composer {
        padding: 20px;
        border: 1px solid #DDE7E4;
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: 0 10px 26px rgba(23,61,61,.055);
    }


    .sc-community-composer-head {
        display: flex;
        align-items: center;
        gap: 11px;
    }


        .sc-community-composer-head strong,
        .sc-community-composer-head span {
            display: block;
        }


        .sc-community-composer-head strong {
            color: #173D3D;
            font-size: .82rem;
        }


        .sc-community-composer-head span {
            margin-top: 2px;
            color: #85928E;
            font-size: .65rem;
        }


    .sc-community-avatar {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #173D3D;
        color: #FFFFFF;
        font-size: .72rem;
        font-weight: 900;
    }


        .sc-community-avatar.small {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            font-size: .65rem;
        }


    .sc-community-composer > textarea {
        width: 100%;
        margin-top: 15px;
        padding: 13px 14px;
        border: 1px solid #D5E0DD;
        border-radius: 11px;
        background: #FBFCFB;
        color: #172A28;
        resize: vertical;
        outline: none;
    }


        .sc-community-composer > textarea:focus {
            border-color: #2F9098;
            box-shadow: 0 0 0 3px rgba(47,144,152,.08);
        }


    .sc-community-composer-options {
        margin-top: 11px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }


    .sc-community-field label {
        display: block;
        margin-bottom: 6px;
        color: #53635E;
        font-size: .65rem;
        font-weight: 800;
    }


    .sc-community-field select {
        width: 100%;
        min-height: 42px;
        padding: 0 10px;
        border: 1px solid #D7E0DD;
        border-radius: 9px;
        background: #FFFFFF;
        color: #53635E;
        font-size: .7rem;
    }


    .sc-community-upload {
        min-height: 42px;
        padding: 8px 10px;
        border: 1px dashed #C8D8D4;
        border-radius: 9px;
        background: #F8FBFA;
    }


        .sc-community-upload small {
            display: block;
            margin-top: 5px;
            color: #909C98;
            font-size: .57rem;
        }


    .sc-community-selected-image {
        margin-top: 10px;
        padding: 9px 11px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-radius: 9px;
        background: #EEF7F5;
        color: #667772;
        font-size: .66rem;
    }


        .sc-community-selected-image span {
            min-width: 0;
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        .sc-community-selected-image button {
            border: 0;
            background: transparent;
            color: #A04343;
            font-size: .62rem;
            font-weight: 800;
            cursor: pointer;
        }


    .sc-community-existing-image {
        margin-top: 11px;
        padding: 10px;
        display: grid;
        grid-template-columns: 80px minmax(0,1fr);
        align-items: center;
        gap: 12px;
        border: 1px solid #E0E8E5;
        border-radius: 11px;
        background: #FAFBFA;
    }


        .sc-community-existing-image img {
            width: 80px;
            height: 62px;
            object-fit: cover;
            border-radius: 8px;
        }


        .sc-community-existing-image strong,
        .sc-community-existing-image span {
            display: block;
        }


        .sc-community-existing-image strong {
            color: #173D3D;
            font-size: .68rem;
        }


        .sc-community-existing-image span {
            margin-top: 2px;
            color: #85928E;
            font-size: .6rem;
        }


        .sc-community-existing-image button {
            margin-top: 6px;
