@page "/notifications"
@inject AuthService Auth
@inject DatabaseService Db
@inject NavigationManager Nav

<PageTitle>Notifications</PageTitle>

<div class="container mt-4" style="max-width: 720px;">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-bell-fill"></i>
            Notifications
        </h2>

        @if (unreadCount > 0)
        {
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="MarkAllRead">
                Mark all read
            </button>
        }
    </div>

    @if (!Auth.IsLoggedIn)
    {
        <div class="alert alert-warning">
            Please <a href="/login">log in</a> to see your notifications.
        </div>
    }
    else if (list.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            <i class="bi bi-bell-slash" style="font-size: 2rem; color: #999;"></i>
            <p class="mb-0 mt-2">No notifications yet.</p>
            <small class="text-muted">They'll appear here as things happen.</small>
        </div>
    }
    else
    {
        @foreach (var n in list)
        {
            <div class="card mb-2 @(n.IsRead ? "" : "border-primary")"
                 @onclick="() => OpenNotification(n)"
                 style="cursor: pointer;">
                <div class="card-body py-3">
                    <div class="d-flex align-items-start gap-3">
                        <span class="sp-notification-icon-lg">
                            <i class="bi @n.Icon"></i>
                        </span>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@n.Title</div>
                            @if (!string.IsNullOrEmpty(n.Body))
                            {
                                <div class="text-muted small">@n.Body</div>
                            }
                            <div class="text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-clock"></i>
                                @n.RelativeTime
                            </div>
                        </div>
                        @if (!n.IsRead)
                        {
                            <span class="badge bg-primary">New</span>
                        }
                    </div>
                </div>
            </div>
        }
    }

</div>

@code {
    List<Shoppet_VetClinic.Models.Notification> list = new();
    int unreadCount = 0;

    protected override async Task OnParametersSetAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn) return;
        Load();
    }

    void Load()
    {
        var userId = Auth.CurrentUser!.Id;
        list = Db.GetNotifications(userId, 50);
        unreadCount = list.Count(n => !n.IsRead);
    }

    async Task OpenNotification(Shoppet_VetClinic.Models.Notification n)
    {
        if (!n.IsRead)
            Db.MarkNotificationRead(n.Id, Auth.CurrentUser!.Id);

        if (!string.IsNullOrEmpty(n.Link))
            Nav.NavigateTo(n.Link);
        else
            Load();

        await Task.CompletedTask;
    }

    async Task MarkAllRead()
    {
        Db.MarkAllNotificationsRead(Auth.CurrentUser!.Id);
        Load();
        await Task.CompletedTask;
    }
}