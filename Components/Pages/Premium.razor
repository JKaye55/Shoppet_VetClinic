@page "/premium"
@rendermode InteractiveServer
@inject AuthService Auth
@inject DatabaseService Db
<main class="owner-shell"><header class="owner-header"><span class="owner-eyebrow">MORE ROOM FOR THEIR STORY</span><h1>One upgrade. Two months of care.</h1><p>ShoppetCare Premium · ₱150 for 2 months</p></header><div class="owner-grid"><section class="owner-card"><h2>Free</h2><p>1 pet · 5 health records per pet · Up to 3 marketplace listings</p><p>Digital Pet ID, feeding routines, community, messaging, and pre-loved marketplace with 3 listings limit.</p></section><section class="owner-card"><h2>Premium · ₱150 / 2 Months</h2><p>Unlimited pets, unlimited health records, unlimited marketplace listings, advanced Pet ID customization, and health exports.</p><p>Premium gives you 2 months of full access.</p>@if(!ready){<p>Loading account…</p>}else if(Auth.IsPremium){<p class="owner-notice">Your Premium access is active.</p><a class="owner-button" href="/my-pets">My pets</a>}else if(Auth.IsPetOwner){<label>Demo payment outcome<select @bind="succeed"><option value="true">Simulated success</option><option value="false">Simulated failure</option></select></label><button @onclick="Activate" disabled="@busy">@(busy?"Processing…":"Activate Premium · ₱150")</button>}else{<a class="owner-button" href="/login">Sign in to upgrade</a>}</section></div>@if(message.Length>0){<p role="status" class="owner-notice">@message</p>}<p><small>Academic simulation. No real money is charged, and no payment credentials are requested.</small></p></main>
@code {bool ready,busy;string succeed="true",message="";protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();ready=true;StateHasChanged();}void Activate(){if(busy||!Auth.IsPetOwner||Auth.CurrentUser is null)return;busy=true;try{if(succeed!="true"){message="Simulated payment failed. Your account has not changed.";return;}if(Db.ActivatePremiumUpgrade(Auth.CurrentUser.Id,"PREM-"+Guid.NewGuid().ToString("N")[..12],150m)){Auth.RefreshCurrentUser();message="Premium (₱150 / 2 Months) is active on Web and Mobile.";}else{Auth.RefreshCurrentUser();message=Auth.IsPremium?"Your Premium is already active.":"Upgrade could not be completed.";}}catch(Exception){message="Could not save the upgrade. Check the database connection.";}finally{busy=false;}}}
