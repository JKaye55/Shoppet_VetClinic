@page "/premium"
@rendermode InteractiveServer
@inject AuthService Auth
@inject DatabaseService Db
<main class="owner-shell"><header class="owner-header"><span class="owner-eyebrow">MORE ROOM FOR THEIR STORY</span><h1>One upgrade. A lifetime of care.</h1><p>ShoppetCare Premium · ₱49 one-time</p></header><div class="owner-grid"><section class="owner-card"><h2>Free</h2><p>1 pet · 5 health records per pet</p><p>Digital Pet ID, feeding routines, community, messaging, and buying or selling pre-loved essentials.</p></section><section class="owner-card"><h2>Lifetime Premium · ₱49</h2><p>Unlimited pets and health records, advanced Pet ID customization, and health exports.</p><p>Premium has no expiry and no recurring charges.</p>@if(!ready){<p>Loading account…</p>}else if(Auth.IsPremium){<p class="owner-notice">Your lifetime Premium is active.</p><a class="owner-button" href="/my-pets">My pets</a>}else if(Auth.IsPetOwner){<label>Demo payment outcome<select @bind="succeed"><option value="true">Simulated success</option><option value="false">Simulated failure</option></select></label><button @onclick="Activate" disabled="@busy">@(busy?"Processing…":"Activate Premium · ₱49")</button>}else{<a class="owner-button" href="/login">Sign in to upgrade</a>}</section></div>@if(message.Length>0){<p role="status" class="owner-notice">@message</p>}<p><small>Academic simulation. No real money is charged, and no payment credentials are requested.</small></p></main>
@code {bool ready,busy;string succeed="true",message="";protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();ready=true;StateHasChanged();}void Activate(){if(busy||!Auth.IsPetOwner||Auth.CurrentUser is null)return;busy=true;try{if(succeed!="true"){message="Simulated payment failed. Your account has not changed.";return;}if(Db.ActivatePremiumUpgrade(Auth.CurrentUser.Id,"PREM-"+Guid.NewGuid().ToString("N")[..12],49m)){Auth.RefreshCurrentUser();message="Lifetime Premium is active on Web and Mobile.";}else{Auth.RefreshCurrentUser();message=Auth.IsPremium?"Your lifetime Premium is already active.":"Upgrade could not be completed.";}}catch(Exception){message="Could not save the upgrade. Check the database connection.";}finally{busy=false;}}}
