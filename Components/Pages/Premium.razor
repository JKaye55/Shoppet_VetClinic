@page "/premium"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Services
@using Shoppet_VetClinic.Models

@inject AuthService Auth
@inject CommerceService Commerce

<PageTitle>ShoppetCare Premium</PageTitle>

<div class="premium-page">
    <section class="premium-hero">
        <div class="premium-shell hero-inner">
            <div>
                <span class="eyebrow light">SHOPPETCARE PREMIUM</span>
                <h1>More value from your pet's connected identity.</h1>
                <p>
                    Premium enhances the private Digital Pet ID experience and selected web benefits while Mobile remains
                    the main pet-care management application.
                </p>
            </div>

            <div class="price-card">
                <span>PREMIUM PLAN</span>
                <strong>₱150</strong>
                <small>3 months</small>
            </div>
        </div>
    </section>

    <main class="premium-shell premium-content">
        @if (!ready)
        {
            <div class="loading">Loading Premium status...</div>
        }
        else if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
        {
            <section class="premium-panel centered">
                <span class="eyebrow">ACCOUNT REQUIRED</span>
                <h2>Sign in to activate Premium.</h2>
                <p>Your subscription must be attached to a ShoppetCare account.</p>
                <a class="primary-link" href="/login">Sign In</a>
            </section>
        }
        else
        {
            <div class="premium-grid">
                <section class="premium-panel">
                    <span class="eyebrow">YOUR PLAN</span>

                    @if (activeSubscription is not null || Auth.IsPremium)
                    {
                        <div class="active-status">
                            <i class="bi bi-star-fill"></i>
                            <div>
                                <strong>Premium Active</strong>
                                <span>
                                    @(activeSubscription is not null
                                        ? $"Active until {activeSubscription.ExpiresAt:MMM d, yyyy}"
                                        : $"Active until {Auth.CurrentUser.PremiumActivatedAt?.AddMonths(3):MMM d, yyyy}")
                                </span>
                            </div>
                        </div>

                        <h2>Keep your Premium access going.</h2>
                        <p>
                            Renewing while active extends your subscription period instead of replacing the remaining time.
                        </p>
                        <a class="primary-link" href="/checkout/PremiumSubscription">Extend Premium — ₱150</a>
                    }
                    else
                    {
                        <h2>Activate Premium for 3 months.</h2>
                        <p>
                            Complete the realistic mock checkout to activate Premium on your account. The current academic
                            payment flow does not transfer real money.
                        </p>
                        <a class="primary-link" href="/checkout/PremiumSubscription">Get Premium — ₱150</a>
                    }
                </section>

                <section class="premium-panel benefits">
                    <span class="eyebrow">PREMIUM BENEFITS</span>
                    <h2>Designed around your Digital Pet ID.</h2>

                    <div class="benefit-list">
                        <article><i class="bi bi-palette-fill"></i><div><strong>Premium Card Themes</strong><span>Ocean, Sunset, Mint and Royal themes in addition to Classic.</span></div></article>
                        <article><i class="bi bi-person-lines-fill"></i><div><strong>Private Owner Contact</strong><span>Owner mobile contact can appear on your private Premium card while the public QR view stays privacy-safe.</span></div></article>
                        <article><i class="bi bi-heart-pulse-fill"></i><div><strong>Care Summary</strong><span>Display selected vaccination, weight and health-summary information retrieved from your pet-care records.</span></div></article>
                        <article><i class="bi bi-file-earmark-arrow-down-fill"></i><div><strong>Health Record Export</strong><span>Export supported vaccination and health information where the web integration is available.</span></div></article>
                    </div>
                </section>
            </div>

            <section class="comparison">
                <div class="comparison-head">
                    <div><span class="eyebrow">FREE VS PREMIUM</span><h2>Clear, focused benefits.</h2></div>
                </div>

                <div class="comparison-table">
                    <div class="row head"><span>Feature</span><span>Free</span><span>Premium</span></div>
                    <div class="row"><span>Digital Pet ID + QR</span><span>Included</span><span>Included</span></div>
                    <div class="row"><span>Classic Pet ID Theme</span><span>Included</span><span>Included</span></div>
                    <div class="row"><span>Premium Pet ID Themes</span><span>—</span><span>Included</span></div>
                    <div class="row"><span>Private owner mobile on Premium card</span><span>—</span><span>Included</span></div>
                    <div class="row"><span>Selected care summaries</span><span>Basic</span><span>Expanded</span></div>
                    <div class="row"><span>Supported record export</span><span>—</span><span>Included</span></div>
                </div>
            </section>

            <div class="legal-note">
                <i class="bi bi-shield-check"></i>
                <span>
                    Premium does not make private health or owner information public. Public QR views remain intentionally limited.
                    See the <a href="/privacy">Data Privacy Notice</a>.
                </span>
            </div>
        }
    </main>
</div>

<style>
    .premium-page{min-height:100vh;background:#FAF9F6;color:#1E2D27}.premium-shell{width:min(1120px,calc(100% - 40px));margin:auto}.premium-hero{padding:56px 0;background:linear-gradient(145deg,#173D3D,#102E2D);color:#fff}.hero-inner{display:flex;align-items:end;justify-content:space-between;gap:28px}.eyebrow{color:#2F9098;font-size:.67rem;font-weight:900;letter-spacing:.12em}.eyebrow.light{color:#8FD9DA}.premium-hero h1{max-width:760px;margin:8px 0 12px;font-size:clamp(2.7rem,5vw,4.5rem);line-height:.98;font-weight:900;letter-spacing:-.055em}.premium-hero p{max-width:700px;margin:0;color:rgba(255,255,255,.68);line-height:1.68}.price-card{min-width:210px;padding:18px;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.07)}.price-card span,.price-card strong,.price-card small{display:block}.price-card span{color:#F3D27A;font-size:.63rem;font-weight:900;letter-spacing:.1em}.price-card strong{font-size:2.5rem;line-height:1;margin-top:8px}.price-card small{margin-top:4px;color:rgba(255,255,255,.62)}
    .premium-content{padding:32px 0 60px}.premium-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:18px}.premium-panel,.comparison,.legal-note{border:1px solid #DDE7E4;border-radius:20px;background:#fff;box-shadow:0 12px 34px rgba(30,45,39,.05)}.premium-panel{padding:28px}.premium-panel h2,.comparison h2{margin:7px 0 10px;font-weight:900;letter-spacing:-.04em}.premium-panel p{color:#6A7973;line-height:1.65}.centered{max-width:720px;margin:auto;text-align:center}.loading{padding:80px;text-align:center;color:#74817C}.active-status{display:flex;gap:11px;align-items:center;margin:16px 0;padding:13px;border-radius:12px;background:#FFF7D9;color:#6A5510}.active-status i{font-size:1.5rem}.active-status strong,.active-status span{display:block}.active-status span{margin-top:2px;font-size:.7rem}
    .primary-link{display:inline-flex;min-height:46px;margin-top:12px;padding:0 18px;align-items:center;justify-content:center;border-radius:10px;background:#2F9098;color:#fff;text-decoration:none;font-weight:900}.benefit-list{display:grid;gap:10px;margin-top:18px}.benefit-list article{display:flex;gap:12px;padding:12px;border:1px solid #E5ECE9;border-radius:12px}.benefit-list i{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:#EEF6F4;color:#267C83}.benefit-list strong,.benefit-list span{display:block}.benefit-list span{margin-top:3px;color:#7A8781;font-size:.7rem;line-height:1.5}
    .comparison{margin-top:18px;padding:28px}.comparison-table{margin-top:18px;border:1px solid #E3EAE7;border-radius:14px;overflow:hidden}.comparison-table .row{display:grid;grid-template-columns:1.7fr .7fr .8fr;padding:12px 14px;border-top:1px solid #EDF1EF;font-size:.74rem}.comparison-table .row:first-child{border-top:0}.comparison-table .head{background:#F6F9F8;font-weight:900}.comparison-table .row span:nth-child(n+2){text-align:center}.legal-note{margin-top:18px;padding:16px;display:flex;gap:10px;color:#68766F;font-size:.71rem;line-height:1.55}.legal-note a{color:#267C83;font-weight:850}
    @@media(max-width:800px){.hero-inner{align-items:start;flex-direction:column}.price-card{width:100%}.premium-grid{grid-template-columns:1fr}.comparison-table .row{grid-template-columns:1.3fr .6fr .7fr;font-size:.66rem}}
</style>

@code {
    private bool ready;
    private SubscriptionRecord? activeSubscription;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.InitializeAsync();

        if (Auth.CurrentUser is not null)
        {
            activeSubscription =
                Commerce.GetActiveSubscription(
                    CommerceService.PremiumType,
                    userId: Auth.CurrentUser.Id);
        }

        ready = true;
        await InvokeAsync(StateHasChanged);
    }
}
