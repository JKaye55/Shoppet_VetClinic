@page "/account"
@page "/account/{Mode}"

@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Shoppet_VetClinic.Services
@inject DatabaseService Db
@inject AuthService Auth
@inject DatabaseService DbService
@inject FileStorageService FileStorage
@inject NavigationManager Nav

<PageTitle>Account & Premium | ShoppetCare</PageTitle>


<div class="account-page">
@if (!isReady)
    {
        <div class="account-shell account-loading">
            Loading your ShoppetCare account...
        </div>
    }
    else if (Auth.IsGuest)
    {
        <section class="account-access">

            <div class="account-access-icon">
                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                </svg>
            </div>

            <span class="account-eyebrow">
                GUEST MODE
            </span>

            <h1>
                Your personal ShoppetCare
                space starts with an account.
            </h1>

            <p>
                Create a free account to save pet profiles,
                issue Digital Pet IDs, view connected care summaries,
                and connect your pet-care activity in one place.
            </p>

            <div class="access-actions">

                <a href="/register"
                   class="primary-button-link">
                    Create Free Account
                </a>

                <a href="/login"
                   class="secondary-button-link">
                    Sign In
                </a>

            </div>

        </section>
    }
    else if (!Auth.IsLoggedIn)
    {
        <section class="account-access">

            <div class="account-access-icon">
                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#person-circle"></use>
                </svg>
            </div>

            <span class="account-eyebrow">
                SHOPPETCARE ACCOUNT
            </span>

            <h1>
                Sign in to manage
                your connected pet account.
            </h1>

            <p>
                Your account keeps your pets, Digital Pet IDs,
                connected care summaries, Premium membership,
                and account security together.
            </p>

            <div class="access-actions">

                <a href="/login"
                   class="primary-button-link">
                    Sign In
                </a>

                <a href="/register"
                   class="secondary-button-link">
                    Create Account
                </a>

            </div>

        </section>
    }
    else
    {
        <main class="account-shell">

            <!-- =====================================================
                 ACCOUNT HERO
                 ===================================================== -->

            <section class="account-hero">

                <div class="account-hero-content">

                    <div class="hero-photo">

                        @if (!string.IsNullOrWhiteSpace(ProfilePhotoUrl))
                        {
                            <img src="@ProfilePhotoUrl"
                                 alt="@GetDisplayName()" />
                        }
                        else
                        {
                            <span>
                                @GetInitials()
                            </span>
                        }

                    </div>


                    <div class="hero-copy">

                        <span class="account-eyebrow light">
                            ACCOUNT &amp; MEMBERSHIP
                        </span>

                        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                            <h1 style="margin:0;">
                                @GetDisplayName()
                            </h1>
                            @if (Auth.IsPremium)
                            {
                                <span style="display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg, #FFE399, #FFD066);color:#734B00;font-size:.85rem;font-weight:900;padding:4px 12px;border-radius:999px;box-shadow:0 2px 6px rgba(0,0,0,0.12);" title="Verified Premium Member">
                                    🏅 Premium Pet Owner
                                </span>
                            }
                        </div>

                        <p>
                            Manage the identity, privacy,
                            security, and membership behind your
                            connected ShoppetCare experience.
                        </p>

                        <div class="hero-meta">

                            <span>
                                @Auth.CurrentUser?.Email
                            </span>

                            <i></i>

                            <span>
                                @GetRole()
                            </span>

                            <i></i>

                            <span>
                                Member since @GetMemberSince()
                            </span>

                        </div>

                    </div>

                </div>


                <div class="hero-membership">

                    <span class="hero-membership-label">
                        MEMBERSHIP
                    </span>

                    @if (HasActivePremium)
                    {
                        <strong>
                            Premium
                        </strong>

                        <span class="hero-plan">
                            ₱150 · 2 Months
                        </span>

                        <small>
                            2 Months access · @PremiumEndDisplay
                        </small>
                    }
                    else if (IsPremiumExpired)
                    {
                        <strong>
                            Premium Expired
                        </strong>

                        <span class="hero-plan expired">
                            Renewal available
                        </span>

                        <small>
                            Renew to restore Premium benefits.
                        </small>
                    }
                    else
                    {
                        <strong>
                            Free
                        </strong>

                        <span class="hero-plan">
                            Standard access
                        </span>

                        <small>
                            Upgrade when you need more.
                        </small>
                    }

                </div>

            </section>


            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@(messageIsError
                                                    ? "account-message error"
                                                    : "account-message success")">

                    @message

                </div>
            }


            <!-- =====================================================
                 MAIN ACCOUNT WORKSPACE
                 ===================================================== -->

            <section class="account-workspace">

                <!-- =================================================
                     LEFT
                     ================================================= -->

                <div class="account-left-column">


                    <!-- PROFILE -->

                    <article class="account-card profile-card">

                        <header class="card-heading">

                            <div>

                                <span class="account-eyebrow">
                                    PERSONAL INFORMATION
                                </span>

                                <h2>
                                    Your ShoppetCare profile
                                </h2>

                                <p>
                                    Keep the identity attached to your pets
                                    and ShoppetCare activity current.
                                </p>

                            </div>


                            @if (!editProfile)
                            {
                                <button type="button"
                                        class="outline-button"
                                        @onclick="OpenProfileEditor">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#pencil"></use>
                                    </svg>

                                    Edit Profile

                                </button>
                            }

                        </header>


                        <div class="profile-layout">

                            <!-- PHOTO -->

                            <section class="profile-photo-panel">

                                <div class="large-profile-photo">

                                    @if (!string.IsNullOrWhiteSpace(ProfilePhotoUrl))
                                    {
                                        <img src="@ProfilePhotoUrl"
                                             alt="@GetDisplayName()" />
                                    }
                                    else
                                    {
                                        <span>
                                            @GetInitials()
                                        </span>
                                    }

                                </div>


                                <div class="photo-copy">

                                    <span class="mini-label">
                                        PROFILE PHOTO
                                    </span>

                                    <strong>
                                        Put a face to your account
                                    </strong>

                                    <p>
                                        Optional JPG, PNG, or WEBP
                                        image up to 5 MB.
                                    </p>


                                    <div class="photo-actions">

                                        <label class="photo-picker">

                                            <svg aria-hidden="true">
                                                <use href="/icons/bootstrap-icons.svg#image"></use>
                                            </svg>

                                            Choose Photo

                                            <InputFile OnChange="HandleProfilePhotoSelected"
                                                       accept="image/jpeg,image/png,image/webp" />

                                        </label>


                                        @if (!string.IsNullOrWhiteSpace(ProfilePhotoUrl))
                                        {
                                            <button type="button"
                                                    class="remove-photo"
                                                    @onclick="RemoveProfilePhoto">

                                                Remove

                                            </button>
                                        }

                                    </div>

                                </div>

                            </section>


                            <!-- INFORMATION -->
                            @if (!editProfile)
                            {
                                <section class="identity-panel">

                                    <div class="identity-row">

                                        <span>
                                            Full Name
                                        </span>

                                        <strong>
                                            @GetDisplayName()
                                        </strong>

                                    </div>


                                    <div class="identity-row">

                                        <span>
                                            Email Address
                                        </span>

                                        <strong>
                                            @Auth.CurrentUser?.Email
                                        </strong>

                                    </div>

                                    <div class="identity-row">

                                        <span>
                                            Mobile Number
                                        </span>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(mobileNumber)
                                                ? "—"
                                                : FormatMobileNumber(mobileNumber))
                                        </strong>

                                    </div>

                                    <div class="identity-row">

                                        <span>
                                            Account Role
                                        </span>

                                        <strong>
                                            @GetRole()
                                        </strong>

                                    </div>






                                    <div class="identity-row">

                                        <span>
                                            Membership
                                        </span>

                                        <strong>
                                            @PremiumStatusDisplay
                                        </strong>

                                    </div>


                                    <div class="identity-row">

                                        <span>
                                            Member Since
                                        </span>

                                        <strong>
                                            @GetMemberSince()
                                        </strong>

                                    </div>

                                </section>
                            }
                            else
                            {
                                <section class="profile-editor">

                                    <div class="account-field">

                                        <label>
                                            Full Name
                                        </label>

                                        <input type="text"
                                               maxlength="150"
                                               autocomplete="name"
                                               @bind="editFullName" />

                                    </div>


                                    <div class="account-field">

                                        <label>
                                            Email Address
                                        </label>

                                        <input type="email"
                                               maxlength="150"
                                               autocomplete="email"
                                               @bind="editEmail" />

                                    </div>


                                    <div class="editor-actions">

                                        <button type="button"
                                                class="primary-button"
                                                disabled="@savingProfile"
                                                @onclick="SaveProfileAsync">

                                            @(savingProfile
                                                ? "Saving..."
                                                : "Save Changes")

                                        </button>


                                        <button type="button"
                                                class="outline-button"
                                                disabled="@savingProfile"
                                                @onclick="CancelProfileEditor">

                                            Cancel

                                        </button>

                                    </div>

                                </section>
                            }

                        </div>


                        <!-- PURPOSE -->

                        <div class="profile-purpose">

                            <span class="purpose-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    One account. One connected identity.
                                </strong>

                                <p>
                                    Your account connects pet profiles,
                                    Digital Pet IDs, connected care summaries,
                                    marketplace activity, and local-care interactions.
                                </p>

                            </div>


                            <a href="/my-pets">
                                Manage Pets →
                            </a>

                        </div>

                    </article>


                    <!-- BILLING -->

                    <article class="account-card billing-card">

                        <header class="card-heading billing-heading">

                            <div>

                                <span class="account-eyebrow">
                                    BILLING &amp; SUBSCRIPTION
                                </span>

                                <h2>
                                    Premium plan
                                </h2>

                                <p>
                                    Review your current plan,
                                    subscription period, and payment reference.
                                </p>

                            </div>


                            <span class="@GetSubscriptionStatusClass()">
                                @PremiumStatusDisplay
                            </span>

                        </header>


                        <div class="billing-feature">

                            <div class="billing-plan-main">

                                <span>
                                    SHOPPETCARE PREMIUM
                                </span>

                                <strong>
                                    ₱150
                                </strong>

                                <p>
                                    2 Months Premium access
                                </p>

                            </div>


                            <div class="billing-period">

                                <div>

                                    <span>
                                        Billing Cycle
                                    </span>

                                    <strong>
                                        Every 2 Months
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Activated
                                    </span>

                                    <strong>
                                        @PremiumStartDisplay
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Valid Until
                                    </span>

                                    <strong>
                                        @PremiumEndDisplay
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Reference
                                    </span>

                                    <strong class="billing-reference">
                                        @PremiumReferenceDisplay
                                    </strong>

                                </div>

                            </div>

                        </div>


                        @if (HasActivePremium)
                        {
                            <div class="billing-notice active">

                                <span class="billing-notice-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                    </svg>

                                </span>


                                <div>

                                    <strong>
                                        Your Premium subscription is active.
                                    </strong>

                                    <p>
                                        You currently have access to
                                        Premium Pet ID themes, eligible private card details,
                                        expanded care summaries, and supported export features.
                                    </p>

                                </div>


                                <a href="/premium">
                                    Manage Plan
                                </a>

                            </div>
                        }
                        else if (IsPremiumExpired)
                        {
                            <div class="billing-notice expired">

                                <span class="billing-notice-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#clock-history"></use>
                                    </svg>

                                </span>


                                <div>

                                    <strong>
                                        Your Premium period has ended.
                                    </strong>

                                    <p>
                                        Renew Premium for ₱150 (2 Months Access).
                                    </p>

                                </div>


                                <a href="/premium">
                                    View Premium
                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="billing-notice free">

                                <span class="billing-notice-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#star"></use>
                                    </svg>

                                </span>


                                <div>

                                    <strong>
                                        Ready for more?
                                    </strong>

                                    <p>
                                        Upgrade for ₱150 and receive
                                        two months of ShoppetCare Premium.
                                    </p>

                                </div>


                                <a href="/premium">
                                    View Premium
                                </a>

                            </div>
                        }

                    </article>


                    <!-- SECURITY -->

                    <article class="account-card security-card @(changePassword ? "editing" : "")">

                        <div class="security-main">

                            <span class="security-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                                </svg>

                            </span>


                            <div>

                                <span class="account-eyebrow">
                                    ACCOUNT SECURITY
                                </span>

                                <h2>
                                    Password &amp; access
                                </h2>

                                <p>
                                    Protect the account connected
                                    to your pets and private records.
                                </p>

                            </div>

                        </div>


                        @if (!changePassword)
                        {
                            <div class="security-actions">

                                <button type="button"
                                        class="primary-button"
                                        @onclick="OpenPasswordEditor">

                                    Change Password

                                </button>


                                <a href="/forgot-password">
                                    Forgot your password?
                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="password-editor">

                                <div class="account-field">

                                    <label>
                                        Current Password
                                    </label>

                                    <div style="position:relative;display:flex;align-items:center;">
                                        <input type="@(showCurrentPassword ? "text" : "password")"
                                               autocomplete="current-password"
                                               @bind="currentPassword"
                                               style="padding-right:42px;width:100%;" />
                                        <button type="button"
                                                @onclick="() => showCurrentPassword = !showCurrentPassword"
                                                style="position:absolute;right:12px;background:none;border:none;cursor:pointer;color:#7B8882;display:flex;align-items:center;justify-content:center;padding:4px;"
                                                aria-label="Toggle password visibility">
                                            <i class="bi @(showCurrentPassword ? "bi-eye-slash-fill" : "bi-eye-fill")" style="font-size:1.15rem;"></i>
                                        </button>
                                    </div>

                                </div>


                                <div class="password-grid">

                                    <div class="account-field">

                                        <label>
                                            New Password
                                        </label>

                                        <div style="position:relative;display:flex;align-items:center;">
                                            <input type="@(showNewPassword ? "text" : "password")"
                                                   autocomplete="new-password"
                                                   @bind="newPassword"
                                                   style="padding-right:42px;width:100%;" />
                                            <button type="button"
                                                    @onclick="() => showNewPassword = !showNewPassword"
                                                    style="position:absolute;right:12px;background:none;border:none;cursor:pointer;color:#7B8882;display:flex;align-items:center;justify-content:center;padding:4px;"
                                                    aria-label="Toggle password visibility">
                                                <i class="bi @(showNewPassword ? "bi-eye-slash-fill" : "bi-eye-fill")" style="font-size:1.15rem;"></i>
                                            </button>
                                        </div>

                                    </div>


                                    <div class="account-field">

                                        <label>
                                            Confirm New Password
                                        </label>

                                        <div style="position:relative;display:flex;align-items:center;">
                                            <input type="@(showConfirmPassword ? "text" : "password")"
                                                   autocomplete="new-password"
                                                   @bind="confirmPassword"
                                                   style="padding-right:42px;width:100%;" />
                                            <button type="button"
                                                    @onclick="() => showConfirmPassword = !showConfirmPassword"
                                                    style="position:absolute;right:12px;background:none;border:none;cursor:pointer;color:#7B8882;display:flex;align-items:center;justify-content:center;padding:4px;"
                                                    aria-label="Toggle password visibility">
                                                <i class="bi @(showConfirmPassword ? "bi-eye-slash-fill" : "bi-eye-fill")" style="font-size:1.15rem;"></i>
                                            </button>
                                        </div>

                                    </div>

                                </div>


                                <small class="password-rule">
                                    Use at least 8 characters with
                                    uppercase and lowercase letters
                                    and at least one number.
                                </small>


                                <div class="editor-actions">

                                    <button type="button"
                                            class="primary-button"
                                            disabled="@savingPassword"
                                            @onclick="SavePassword">

                                        @(savingPassword
                                            ? "Updating..."
                                            : "Update Password")

                                    </button>


                                    <button type="button"
                                            class="outline-button"
                                            disabled="@savingPassword"
                                            @onclick="CancelPasswordEditor">

                                        Cancel

                                    </button>

                                </div>

                            </div>
                        }

                    </article>

                </div>


                <!-- =================================================
                     RIGHT
                     ================================================= -->

                <div class="account-right-column">


                    <!-- PREMIUM VALUE -->

                    <article class="premium-card">

                        <div class="premium-card-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                            </svg>

                        </div>


                        <span class="account-eyebrow gold">
                            SHOPPETCARE PREMIUM
                        </span>


                        @if (HasActivePremium)
                        {
                            <h2>
                                Premium
                                <em>is active.</em>
                            </h2>

                            <p class="premium-description">
                                Your Premium membership gives you
                                expanded pet-management features
                                for 2 months.
                            </p>
                        }
                        else
                        {
                            <h2>
                                More care.
                                <em>More freedom.</em>
                            </h2>

                            <p class="premium-description">
                                Upgrade for expanded
                                ShoppetCare tools for ₱150 (2 Months).
                            </p>
                        }


                        <div class="premium-price">

                            <strong>
                                ₱150
                            </strong>

                            <span>
                                / 2 Months
                            </span>

                        </div>


                        <div class="premium-benefits">

                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                <span>
                                    Unlimited pet profiles
                                </span>

                            </div>


                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                <span>
                                    Expanded care summaries
                                </span>

                            </div>


                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                <span>
                                    Premium Digital Pet ID themes
                                </span>

                            </div>


                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                <span>
                                    Health document export
                                </span>

                            </div>

                        </div>


                        <a href="/premium"
                           class="premium-action">

                            @(HasActivePremium
                                ? "Manage Premium"
                                : IsPremiumExpired
                                    ? "View Premium"
                                    : "Explore Premium")

                            <span>
                                →
                            </span>

                        </a>

                    </article>


                    <!-- ACCOUNT CONNECTION -->

                    <article class="account-card value-card">

                        <header>

                            <span class="account-eyebrow">
                                CONNECTED ACCOUNT
                            </span>

                            <h2>
                                Everything follows
                                one pet-owner identity.
                            </h2>

                            <p>
                                Your profile is the account layer
                                behind ShoppetCare's connected features.
                            </p>

                        </header>


                        <div class="connected-list">

                            <a href="/my-pets">

                                <span class="connected-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#heart-fill"></use>
                                    </svg>

                                </span>


                                <span>

                                    <strong>
                                        Pet Profiles
                                    </strong>

                                    <small>
                                        Identity, photos, breed,
                                        diet, age, and weight.
                                    </small>

                                </span>


                                <b>→</b>

                            </a>


                            <a href="/my-pets">

                                <span class="connected-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                    </svg>

                                </span>


                                <span>

                                    <strong>
                                        Digital Pet IDs
                                    </strong>

                                    <small>
                                        Scannable pet identities
                                        with public privacy controls.
                                    </small>

                                </span>


                                <b>→</b>

                            </a>


                            <a href="/my-pets">

                                <span class="connected-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#clipboard2-pulse"></use>
                                    </svg>

                                </span>


                                <span>

                                    <strong>
                                        Care Summary
                                    </strong>

                                    <small>
                                        Review connected pet-care
                                        history connected.
                                    </small>

                                </span>


                                <b>→</b>

                            </a>


                            <a href="/marketplace">

                                <span class="connected-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#shop"></use>
                                    </svg>

                                </span>


                                <span>

                                    <strong>
                                        Marketplace
                                    </strong>

                                    <small>
                                        Buy and sell pre-loved
                                        pet items with other owners.
                                    </small>

                                </span>


                                <b>→</b>

                            </a>

                            <a href="/account/care">

                                <span class="connected-icon">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#heart-pulse"></use>
                                    </svg>

                                </span>


                                <span>

                                    <strong>
                                        Contacts &amp; Personal Care
                                    </strong>

                                    <small>
                                        Emergency contacts, personal vet reminders, and public phone privacy.
                                    </small>

                                </span>


                                <b>→</b>

                            </a>

                        </div>

                    </article>


                    <!-- PRIVACY -->

                    <article class="account-card privacy-card">

                        <div class="privacy-heading">

                            <span class="privacy-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#shield-check"></use>
                                </svg>

                            </span>


                            <div>

                                <span class="account-eyebrow">
                                    PRIVACY &amp; OWNERSHIP
                                </span>

                                <h2>
                                    Share the pet.
                                    Protect the owner.
                                </h2>

                            </div>

                        </div>


                        <p>
                            Public Digital Pet ID pages expose
                            useful pet identity information while
                            keeping private owner and health information
                            inside the authenticated account.
                        </p>


                        <div class="privacy-list">

                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#check-circle-fill"></use>
                                </svg>

                                Public card shows basic pet identity

                            </div>


                            <div>

                                <svg aria-hidden="true">
