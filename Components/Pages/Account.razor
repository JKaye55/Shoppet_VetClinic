    /* =========================================================
       INITIALIZATION
       ========================================================= */

    protected override async Task OnAfterRenderAsync(
    bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        await Auth.InitializeAsync();


        if (Auth.CurrentUser is not null)
        {
            mobileNumber =
                Db.GetUserMobileNumber(
                    Auth.CurrentUser.Id);
        }


        isReady =
            true;


        await InvokeAsync(
            StateHasChanged);
    }


    /* =========================================================
       PROFILE EDITING
       ========================================================= */

    private void OpenProfileEditor()
    {
        editFullName =
            Auth.CurrentUser?
                .FullName
            ??
            string.Empty;

        editMobileNumber =
mobileNumber;


        editEmail =
            Auth.CurrentUser?
                .Email
            ??
            string.Empty;


        editProfile =
            true;


        ClearMessage();
    }


    private void CancelProfileEditor()
    {
        editProfile =
            false;


        ClearMessage();
    }


    private async Task SaveProfileAsync()
    {
        editMobileNumber =
            new string(
                (editMobileNumber ?? string.Empty)
                    .Where(char.IsDigit)
                    .ToArray());

        if (editMobileNumber.Length == 12 &&
            editMobileNumber.StartsWith("63"))
        {
            editMobileNumber =
                "0" + editMobileNumber.Substring(2);
        }

        if (!string.IsNullOrWhiteSpace(editMobileNumber))
        {
            if (editMobileNumber.Length != 11 ||
                !editMobileNumber.StartsWith("09"))
            {
                ShowError(
                    "Please enter a valid Philippine mobile number.");
                return;
            }
        }

        if (Auth.CurrentUser is null ||
            savingProfile)
        {
            return;
        }


        editFullName =
            editFullName.Trim();


        editEmail =
            editEmail
                .Trim()
                .ToLowerInvariant();


        if (editFullName.Length < 2)
        {
            ShowError(
                "Please enter your full name.");

            return;
        }


        if (editFullName.Length > 150)
        {
            ShowError(
                "Your full name is too long.");

            return;
        }


        if (!new EmailAddressAttribute()
                .IsValid(editEmail))
        {
            ShowError(
                "Please enter a valid email address.");

            return;
        }


        if (DbService.EmailExistsForOtherUser(
            editEmail,
            Auth.CurrentUser.Id))
        {
            ShowError(
                "That email address is already used by another account.");

            return;
        }


        savingProfile =
            true;


        try
        {
            var updated =
    DbService.UpdateUserProfile(
        Auth.CurrentUser.Id,
        editFullName,
        editEmail,
        editMobileNumber);


            if (!updated)
            {
                ShowError(
                    "Your profile could not be updated.");

                return;
            }


            var refreshed =
                DbService.GetUserById(
                    Auth.CurrentUser.Id);


            if (refreshed is not null)
            {
                Auth.RefreshUser(
                    refreshed);
            }


            editProfile =
                false;


            ShowSuccess(
                "Your profile was updated successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Account Profile] {ex}");


            ShowError(
                "Your profile could not be saved.");
        }
        finally
        {
            savingProfile =
                false;
        }


        await InvokeAsync(
            StateHasChanged);
    }


    /* =========================================================
       PHOTO
       ========================================================= */

    private async Task HandleProfilePhotoSelected(
        InputFileChangeEventArgs e)
    {
        if (Auth.CurrentUser is null)
        {
            return;
        }


        var file =
            e.File;


        const long maxSize =
            5 * 1024 * 1024;


        var allowedTypes =
            new[]
            {
                "image/jpeg",
                "image/png",
                "image/webp"
            };


        if (file.Size <= 0 ||
            file.Size > maxSize)
        {
            ShowError(
                "Please choose an image smaller than 5 MB.");

            return;
        }


        if (!allowedTypes.Contains(
            file.ContentType,
            StringComparer.OrdinalIgnoreCase))
        {
            ShowError(
                "Only JPG, PNG, and WEBP images are allowed.");

            return;
        }


        try
        {
            await FileStorage.SaveImageAsync(
                "users",
                Auth.CurrentUser.Id,
                file);


            ShowSuccess(
                "Profile photo updated.");


            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Account Photo] {ex}");


            ShowError(
                "The profile photo could not be saved.");
        }
    }


