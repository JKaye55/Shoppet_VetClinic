@code {

    [Parameter]
    public string? Mode { get; set; }


    private bool isReady;


    private bool editProfile;


    private bool changePassword;


    private bool savingProfile;


    private bool savingPassword;


    private string editFullName =
        string.Empty;


    private string editEmail =
        string.Empty;


    private string currentPassword =
        string.Empty;


    private string newPassword =
        string.Empty;


    private string confirmPassword =
        string.Empty;


    private string message =
        string.Empty;


    private bool messageIsError;


    private string ProfilePhotoUrl =>
        Auth.CurrentUser is null
            ? string.Empty
            : FileStorage.GetImageUrl(
                "users",
                Auth.CurrentUser.Id)
              ??
              string.Empty;


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        await Auth.InitializeAsync();


        isReady =
            true;


        if (Auth.IsLoggedIn &&
            !string.IsNullOrWhiteSpace(Mode))
        {
            if (string.Equals(
                Mode,
                "edit",
                StringComparison.OrdinalIgnoreCase))
            {
                OpenProfileEditor();
            }


            if (string.Equals(
                Mode,
                "password",
                StringComparison.OrdinalIgnoreCase))
            {
                OpenPasswordEditor();
            }
        }


        await InvokeAsync(
            StateHasChanged);
    }


    /* =========================================================
       PROFILE
       ========================================================= */

    private void OpenProfileEditor()
    {
        editFullName =
            Auth.CurrentUser?
                .FullName
            ??
            string.Empty;


        editEmail =
            Auth.CurrentUser?
                .Email
            ??
            string.Empty;


        editProfile =
            true;


        ClearMessage();
    }


    private void CancelProfileEditor()
    {
        editProfile =
            false;


        ClearMessage();
    }


    private async Task SaveProfileAsync()
    {
        if (Auth.CurrentUser is null ||
            savingProfile)
        {
            return;
        }


        editFullName =
            editFullName.Trim();


        editEmail =
            editEmail
                .Trim()
                .ToLowerInvariant();


        if (editFullName.Length < 2)
        {
            ShowError(
                "Please enter your full name.");

            return;
        }


        if (editFullName.Length > 150)
        {
            ShowError(
                "Your full name is too long.");

            return;
        }


        if (!new EmailAddressAttribute()
                .IsValid(editEmail))
        {
            ShowError(
                "Please enter a valid email address.");

            return;
        }


        if (DbService.EmailExistsForOtherUser(
            editEmail,
            Auth.CurrentUser.Id))
        {
            ShowError(
                "That email address is already used by another account.");

            return;
        }


        savingProfile =
            true;


        try
        {
            var updated =
                DbService.UpdateUserProfile(
                    Auth.CurrentUser.Id,
                    editFullName,
                    editEmail);


            if (!updated)
            {
                ShowError(
                    "Your profile could not be updated.");

                return;
            }


            var refreshed =
                DbService.GetUserById(
                    Auth.CurrentUser.Id);


            if (refreshed is not null)
            {
                Auth.RefreshUser(
                    refreshed);
            }


            editProfile =
                false;


            ShowSuccess(
                "Your profile was updated successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Account Profile] {ex}");


            ShowError(
                "Your profile could not be saved.");
        }
        finally
        {
            savingProfile =
                false;
        }


        await InvokeAsync(
            StateHasChanged);
    }


    /* =========================================================
       PHOTO
       ========================================================= */

    private async Task HandleProfilePhotoSelected(
        InputFileChangeEventArgs e)
    {
        if (Auth.CurrentUser is null)
        {
            return;
        }


        var file =
            e.File;


        const long maxSize =
            5 * 1024 * 1024;


        var allowedTypes =
            new[]
            {
                "image/jpeg",
                "image/png",
                "image/webp"
            };


        if (file.Size <= 0 ||
            file.Size > maxSize)
        {
            ShowError(
                "Please choose an image smaller than 5 MB.");

            return;
        }


        if (!allowedTypes.Contains(
            file.ContentType,
            StringComparer.OrdinalIgnoreCase))
        {
            ShowError(
                "Only JPG, PNG, and WEBP images are allowed.");

            return;
        }


        try
        {
            await FileStorage.SaveImageAsync(
                "users",
                Auth.CurrentUser.Id,
                file);


            ShowSuccess(
                "Profile photo updated.");


            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Account Photo] {ex}");


            ShowError(
                "The profile photo could not be saved.");
        }
    }


    private void RemoveProfilePhoto()
    {
        if (Auth.CurrentUser is null)
        {
            return;
        }


        FileStorage.DeleteImage(
            "users",
            Auth.CurrentUser.Id);


        ShowSuccess(
            "Profile photo removed.");
    }


    /* =========================================================
       PASSWORD
       ========================================================= */

    private void OpenPasswordEditor()
    {
        currentPassword =
            string.Empty;


        newPassword =
            string.Empty;


        confirmPassword =
            string.Empty;


        changePassword =
            true;


        ClearMessage();
    }


    private void CancelPasswordEditor()
    {
        changePassword =
            false;


        currentPassword =
            string.Empty;


        newPassword =
            string.Empty;


        confirmPassword =
            string.Empty;


        ClearMessage();
    }


    private void SavePassword()
    {
        if (Auth.CurrentUser is null ||
            savingPassword)
        {
            return;
        }


        if (string.IsNullOrWhiteSpace(
            currentPassword))
        {
            ShowError(
                "Enter your current password.");

            return;
        }


        if (!IsStrongPassword(
            newPassword))
        {
            ShowError(
                "Your new password must contain at least 8 characters, uppercase and lowercase letters, and a number.");

            return;
        }


        if (!string.Equals(
            newPassword,
            confirmPassword,
            StringComparison.Ordinal))
        {
            ShowError(
                "The new password and confirmation do not match.");

            return;
        }


        if (string.Equals(
            currentPassword,
            newPassword,
            StringComparison.Ordinal))
        {
            ShowError(
                "Choose a new password that is different from your current password.");

            return;
        }


        savingPassword =
            true;


        try
        {
            var verifiedUser =
                DbService.AuthenticateUser(
                    Auth.CurrentUser.Email,
                    currentPassword);


            if (verifiedUser is null)
            {
                ShowError(
                    "The current password is incorrect.");

                return;
            }


            var changed =
                DbService.UpdateUserPassword(
                    Auth.CurrentUser.Id,
                    newPassword);


            if (!changed)
            {
                ShowError(
                    "Your password could not be updated.");

                return;
            }


            changePassword =
                false;


            currentPassword =
                string.Empty;


            newPassword =
                string.Empty;


            confirmPassword =
                string.Empty;


            ShowSuccess(
                "Your password was updated successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Change Password] {ex}");


            ShowError(
                "Your password could not be updated.");
        }
        finally
        {
            savingPassword =
                false;
        }
    }


    private static bool IsStrongPassword(
        string password)
    {
        return
            !string.IsNullOrWhiteSpace(password)
            &&
            password.Length >= 8
            &&
            password.Any(char.IsUpper)
            &&
            password.Any(char.IsLower)
            &&
            password.Any(char.IsDigit);
    }


    /* =========================================================
       DISPLAY
       ========================================================= */

    private string GetDisplayName()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        return
            string.IsNullOrWhiteSpace(name)
                ? "ShoppetCare User"
                : name;
    }


    private string GetRole()
    {
        var role =
            Auth.CurrentUser?
                .Role?
                .Trim();


        return
            string.IsNullOrWhiteSpace(role)
                ? "Account"
                : role;
    }


    private string GetMemberSince()
    {
        var date =
            Auth.CurrentUser?
                .CreatedAt;


        return
            date is null ||
            date == default
                ? "—"
                : date.Value
                    .ToString(
                        "MMMM yyyy");
    }


    private string GetInitials()
    {
        var parts =
            GetDisplayName()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 0)
        {
            return "U";
        }


        if (parts.Length == 1)
        {
            return
                parts[0][..Math.Min(
                    2,
                    parts[0].Length)]
                .ToUpperInvariant();
        }


        return
            $"{parts[0][0]}{parts[^1][0]}"
                .ToUpperInvariant();
    }


    /* =========================================================
       MESSAGES
       ========================================================= */

    private void ShowSuccess(
        string value)
    {
        message =
            value;


        messageIsError =
            false;
    }


    private void ShowError(
        string value)
    {
        message =
            value;


        messageIsError =
            true;
    }


    private void ClearMessage()
    {
        message =
            string.Empty;


        messageIsError =
            false;
    }


    /* =========================================================
       SESSION
       ========================================================= */

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();


        Nav.NavigateTo("/");
    }

}