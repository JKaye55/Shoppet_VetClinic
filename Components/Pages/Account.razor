@page "/account"
@page "/account/{Mode}"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>My Account | ShoppetCare</PageTitle>

<div class="sc-account-page">

    @if (!isReady)
    {
        <div class="sc-account-loading">
            Loading your account...
        </div>
    }
    else if (Auth.IsGuest)
    {
        <!-- =====================================================
             GUEST ACCOUNT VIEW
             ===================================================== -->

        <section class="sc-account-access-card">

            <span class="sc-account-lock-icon">

                <i class="bi bi-lock-fill"
                   aria-hidden="true">
                </i>

            </span>


            <span class="sc-account-eyebrow">
                GUEST MODE
            </span>


            <h1>
                Your personal account tools
                are locked in Guest Mode.
            </h1>


            <p>
                You can continue browsing public
                ShoppetCare features.

                Create a free account when you want
                to save pets, create a Digital Pet ID,
                or keep health records.
            </p>


            <div class="sc-account-access-actions">

                <a href="/register"
                   class="sc-account-primary">

                    Create Free Account

                </a>


                <a href="/login"
                   class="sc-account-secondary">

                    Sign In

                </a>


                <a href="/home"
                   class="sc-account-text-link">

                    Continue Guest Preview

                </a>

            </div>

        </section>
    }
    else if (!Auth.IsLoggedIn)
    {
        <!-- =====================================================
             SIGNED OUT VIEW
             ===================================================== -->

        <section class="sc-account-access-card">

            <span class="sc-account-lock-icon">

                <i class="bi bi-person-lock"
                   aria-hidden="true">
                </i>

            </span>


            <span class="sc-account-eyebrow">
                ACCOUNT REQUIRED
            </span>


            <h1>
                Sign in to open your
                ShoppetCare account.
            </h1>


            <p>
                Your profile, pet tools,
                and personal records are available
                after you sign in.
            </p>


            <div class="sc-account-access-actions">

                <a href="/login"
                   class="sc-account-primary">

                    Sign In

                </a>


                <a href="/register"
                   class="sc-account-secondary">

                    Create Account

                </a>

            </div>

        </section>
    }
    else
    {
        <!-- =====================================================
             REAL ACCOUNT
             ===================================================== -->

        <div class="sc-account-shell">

            <section class="sc-account-hero">

                <div class="sc-account-identity">

                    <div class="sc-account-avatar">
                        @GetInitials()
                    </div>


                    <div>

                        <span class="sc-account-eyebrow">
                            MY SHOPPETCARE
                        </span>

                        <h1>
                            @GetDisplayName()
                        </h1>

                        <p>
                            Manage your ShoppetCare
                            profile and jump back into
                            the tools connected to
                            your account.
                        </p>

                    </div>

                </div>


                <div class="sc-account-status">

                    <span class="sc-account-role">
                        @GetRole()
                    </span>


                    @if (Auth.IsPetOwner)
                    {
                        <span class="@(Auth.IsPremium
                                                        ? "sc-account-plan premium"
                                                        : "sc-account-plan")">

                            @(Auth.IsPremium
                                ? "Premium"
                                : "Free")

                        </span>
                    }

                </div>

            </section>


            <div class="sc-account-grid">

                <!-- =================================================
                     PROFILE DETAILS
                     ================================================= -->

                <section class="sc-account-card
                    sc-account-profile-card">

                    <div class="sc-account-card-head">

                        <div>

                            <span class="sc-account-card-kicker">
                                PROFILE
                            </span>

                            <h2>
                                Account details
                            </h2>

                        </div>


                        <i class="bi bi-person-circle"
                           aria-hidden="true">
                        </i>

                    </div>


                    <dl class="sc-account-details">

                        <div>

                            <dt>
                                Full Name
                            </dt>

                            <dd>
                                @GetDisplayName()
                            </dd>

                        </div>


                        <div>

                            <dt>
                                Email Address
                            </dt>

                            <dd>
                                @(Auth.CurrentUser?.Email ?? "—")
                            </dd>

                        </div>


                        <div>

                            <dt>
                                Account Role
                            </dt>

                            <dd>
                                @GetRole()
                            </dd>

                        </div>


                        <div>

                            <dt>
                                Member Since
                            </dt>

                            <dd>
                                @GetMemberSince()
                            </dd>

                        </div>

                    </dl>

                </section>


                <!-- =================================================
                     QUICK ACCESS
                     ================================================= -->

                <section class="sc-account-card">

                    <div class="sc-account-card-head">

                        <div>

                            <span class="sc-account-card-kicker">
                                QUICK ACCESS
                            </span>

                            <h2>
                                Your ShoppetCare
                            </h2>

                        </div>


                        <i class="bi bi-grid-1x2-fill"
                           aria-hidden="true">
                        </i>

                    </div>


                    <div class="sc-account-links">

                        @if (Auth.IsPetOwner)
                        {
                            <a href="/dashboard">

                                <i class="bi bi-speedometer2"
                                   aria-hidden="true">
                                </i>

                                <span>

                                    <strong>
                                        My Dashboard
                                    </strong>

                                    <small>
                                        Overview of your pet account.
                                    </small>

                                </span>

                            </a>


                            <a href="/my-pets">

                                <i class="bi bi-heart-fill"
                                   aria-hidden="true">
                                </i>

                                <span>

                                    <strong>
                                        My Pets
                                    </strong>

                                    <small>
                                        Pet profiles, cards,
                                        and records.
                                    </small>

                                </span>

                            </a>


                            <a href="/community">

                                <i class="bi bi-people-fill"
                                   aria-hidden="true">
                                </i>

                                <span>

                                    <strong>
                                        Community
                                    </strong>

                                    <small>
                                        Return to the
                                        ShoppetCare community.
                                    </small>

                                </span>

                            </a>


                            @if (!Auth.IsPremium)
                            {
                                <a href="/premium">

                                    <i class="bi bi-star-fill"
                                       aria-hidden="true">
                                    </i>

                                    <span>

                                        <strong>
                                            Premium
                                        </strong>

                                        <small>
                                            Review your available
                                            premium features.
                                        </small>

                                    </span>

                                </a>
                            }
                        }
                        else if (Auth.IsClinicStaff)
                        {
                            <a href="/clinic-portal">

                                <i class="bi bi-building"
                                   aria-hidden="true">
                                </i>

                                <span>

                                    <strong>
                                        Clinic Portal
                                    </strong>

                                    <small>
                                        Open your clinic workspace.
                                    </small>

                                </span>

                            </a>
                        }
                        else if (Auth.IsAdmin)
                        {
                            <a href="/admin-portal">

                                <i class="bi bi-shield-check"
                                   aria-hidden="true">
                                </i>

                                <span>

                                    <strong>
                                        Admin Portal
                                    </strong>

                                    <small>
                                        Open ShoppetCare administration.
                                    </small>

                                </span>

                            </a>
                        }

                    </div>

                </section>

            </div>


            <!-- =================================================
                 SESSION
                 ================================================= -->

            <section class="sc-account-security">

                <div>

                    <span class="sc-account-card-kicker">
                        SESSION
                    </span>

                    <h2>
                        Finished for now?
                    </h2>

                    <p>
                        Signing out clears the active
                        ShoppetCare web session on
                        this browser.
                    </p>

                </div>


                <button type="button"
                        class="sc-account-signout"
                        @onclick="SignOutAsync">

                    Sign Out

                </button>

            </section>

        </div>
    }

</div>


<style>

    .sc-account-page {
        min-height: 70vh;
        padding: 46px 0 72px;
        background: radial-gradient( circle at 90% 8%, rgba(47,144,152,.08), transparent 23% ), #FAF9F6;
    }


    .sc-account-shell,
    .sc-account-loading,
    .sc-account-access-card {
        width: min( 1180px, calc(100% - 40px) );
        margin: 0 auto;
    }


    .sc-account-loading {
        padding: 60px 0;
        color: #7C8C87;
        text-align: center;
    }


    /* =========================================================
           GUEST / SIGNED-OUT CARD
           ========================================================= */

    .sc-account-access-card {
        max-width: 760px;
        margin-top: 45px;
        padding: 48px;
        text-align: center;
        border: 1px solid #DDE7E4;
        border-radius: 24px;
        background: #FFFFFF;
        box-shadow: 0 22px 60px rgba(23,61,61,.09);
    }


    .sc-account-lock-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 18px;
        display: grid;
        place-items: center;
        border-radius: 15px;
        background: #EAF5F5;
        color: #2F9098;
        font-size: 1.2rem;
    }


    .sc-account-eyebrow,
    .sc-account-card-kicker {
        display: inline-block;
        color: #267C83;
        font-size: .65rem;
        font-weight: 900;
        letter-spacing: .10em;
    }


    .sc-account-access-card h1 {
        max-width: 620px;
        margin: 9px auto 0;
        color: #173D3D;
        font-size: clamp( 2rem, 4vw, 3.3rem );
        line-height: 1.02;
        letter-spacing: -.045em;
        font-weight: 900;
    }


    .sc-account-access-card p {
        max-width: 580px;
        margin: 16px auto 0;
        color: #6A7B76;
        line-height: 1.65;
    }


    .sc-account-access-actions {
        margin-top: 24px;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 9px;
    }


    .sc-account-primary,
    .sc-account-secondary,
    .sc-account-text-link {
        min-height: 46px;
        padding: 0 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        text-decoration: none;
        font-size: .76rem;
        font-weight: 850;
    }


    .sc-account-primary {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


    .sc-account-secondary {
        border: 1px solid #C9D9D5;
        background: #FFFFFF;
        color: #173D3D;
    }


    .sc-account-text-link {
        color: #267C83;
    }


    /* =========================================================
           REAL ACCOUNT
           ========================================================= */

    .sc-account-hero {
        padding: 28px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        border: 1px solid #DDE7E4;
        border-radius: 22px;
        background: #FFFFFF;
        box-shadow: 0 16px 42px rgba(23,61,61,.07);
    }


    .sc-account-identity {
        display: flex;
        align-items: center;
        gap: 18px;
    }


    .sc-account-avatar {
        width: 68px;
        height: 68px;
        flex: 0 0 68px;
        display: grid;
        place-items: center;
        border-radius: 20px;
        background: #173D3D;
        color: #FFFFFF;
        font-size: 1.1rem;
        font-weight: 900;
        letter-spacing: -.02em;
    }


    .sc-account-identity h1 {
        margin: 4px 0 0;
        color: #173D3D;
        font-size: clamp( 2rem, 3.5vw, 3.25rem );
        font-weight: 900;
        line-height: 1;
        letter-spacing: -.05em;
    }


    .sc-account-identity p {
        max-width: 620px;
        margin: 9px 0 0;
        color: #6A7B76;
        font-size: .82rem;
        line-height: 1.5;
    }


    .sc-account-status {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }


    .sc-account-role,
    .sc-account-plan {
        padding: 7px 10px;
        border-radius: 999px;
        font-size: .66rem;
        font-weight: 850;
    }


    .sc-account-role {
        background: #EAF5F5;
        color: #267C83;
    }


    .sc-account-plan {
        background: #EEF1F0;
        color: #5F6E69;
    }


        .sc-account-plan.premium {
            background: #FFF4CF;
            color: #806212;
        }


    .sc-account-grid {
        margin-top: 14px;
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        gap: 14px;
    }


    .sc-account-card {
        padding: 25px;
        border: 1px solid #DDE7E4;
        border-radius: 19px;
        background: #FFFFFF;
    }


    .sc-account-card-head {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 19px;
    }


        .sc-account-card-head h2,
        .sc-account-security h2 {
            margin: 5px 0 0;
            color: #173D3D;
            font-size: 1.25rem;
            font-weight: 900;
            letter-spacing: -.025em;
        }


        .sc-account-card-head > i {
            color: #2F9098;
            font-size: 1.2rem;
        }


    .sc-account-details {
        margin: 0;
    }


        .sc-account-details > div {
            padding: 13px 0;
            display: grid;
            grid-template-columns: 130px minmax(0,1fr);
            gap: 14px;
            border-top: 1px solid #E1E9E6;
        }


        .sc-account-details dt {
            color: #879691;
            font-size: .7rem;
            font-weight: 750;
        }


        .sc-account-details dd {
            margin: 0;
            color: #173D3D;
            font-size: .76rem;
            font-weight: 750;
            overflow-wrap: anywhere;
        }


    .sc-account-links {
        display: grid;
        gap: 8px;
    }


        .sc-account-links a {
            min-height: 66px;
            padding: 11px 13px;
            display: grid;
            grid-template-columns: 36px minmax(0,1fr);
            align-items: center;
            gap: 11px;
            border: 1px solid #E1E9E6;
            border-radius: 12px;
            background: #FBFCFB;
            text-decoration: none;
            transition: transform .18s ease, border-color .18s ease, background .18s ease;
        }


            .sc-account-links a:hover {
                transform: translateY(-2px);
                border-color: #BFD7D2;
                background: #F3F9F8;
            }


            .sc-account-links a > i {
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                background: #EAF5F5;
                color: #2F9098;
            }


        .sc-account-links strong,
        .sc-account-links small {
            display: block;
        }


        .sc-account-links strong {
            color: #173D3D;
            font-size: .76rem;
        }


        .sc-account-links small {
            margin-top: 3px;
            color: #879691;
            font-size: .66rem;
        }


    .sc-account-security {
        margin-top: 14px;
        padding: 23px 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border: 1px solid #DDE7E4;
        border-radius: 19px;
        background: #FFFFFF;
    }


        .sc-account-security p {
            margin: 6px 0 0;
            color: #7C8C87;
            font-size: .76rem;
        }


    .sc-account-signout {
        min-height: 44px;
        padding: 0 16px;
        flex: 0 0 auto;
        border: 1px solid #F3B1B1;
        border-radius: 9px;
        background: #FFF4F4;
        color: #9B2C2C;
        font-size: .75rem;
        font-weight: 850;
        cursor: pointer;
    }


    @@media (max-width: 800px) {

        .sc-account-hero,
        .sc-account-security {
            align-items: flex-start;
            flex-direction: column;
        }


        .sc-account-status {
            justify-content: flex-start;
        }


        .sc-account-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 520px) {

        .sc-account-access-card {
            padding: 34px 22px;
        }


        .sc-account-hero {
            padding: 22px;
        }


        .sc-account-identity {
            align-items: flex-start;
            flex-direction: column;
        }


        .sc-account-details > div {
            grid-template-columns: 1fr;
            gap: 5px;
        }


        .sc-account-access-actions {
            display: grid;
        }
    }

</style>


@code {

    [Parameter]
    public string? Mode { get; set; }


    private bool isReady;


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await Auth.InitializeAsync();


        isReady = true;


        await InvokeAsync(
            StateHasChanged);
    }


    private string GetDisplayName()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        return
            string.IsNullOrWhiteSpace(name)
                ? "ShoppetCare User"
                : name;
    }


    private string GetRole()
    {
        var role =
            Auth.CurrentUser?
                .Role?
                .Trim();


        return
            string.IsNullOrWhiteSpace(role)
                ? "Account"
                : role;
    }


    private string GetInitials()
    {
        var name =
            GetDisplayName();


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 0)
            return "U";


        if (parts.Length == 1)
        {
            return
                parts[0]
                    .Substring(
                        0,
                        Math.Min(
                            2,
                            parts[0].Length))
                    .ToUpperInvariant();
        }


        return
            (
                parts[0].Substring(0, 1)
                +
                parts[^1].Substring(0, 1)
            )
            .ToUpperInvariant();
    }


    private string GetMemberSince()
    {
        var date =
            Auth.CurrentUser?.CreatedAt;


        if (
            date is null
            ||
            date == default
        )
        {
            return "—";
        }


        return
            date.Value.ToString(
                "MMMM yyyy");
    }


    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync();


        Nav.NavigateTo("/");
    }

}