    private string GetInitials()
    {
        var parts =
            GetDisplayName()
                .Split(
                    ' ',
                    StringSplitOptions
                        .RemoveEmptyEntries);


        if (parts.Length == 0)
        {
            return "U";
        }


        if (parts.Length == 1)
        {
            return
                parts[0]
                    [..Math.Min(
                        2,
                        parts[0].Length)]
                    .ToUpperInvariant();
        }


        return
            $"{parts[0][0]}{parts[^1][0]}"
                .ToUpperInvariant();
