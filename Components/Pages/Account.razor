        }
        finally
        {
            savingPassword =
                false;
        }
    }


    private static bool IsStrongPassword(
        string password)
    {
        return
            !string.IsNullOrWhiteSpace(
                password)
            &&
            password.Length >= 8
            &&
            password.Any(
                char.IsUpper)
            &&
            password.Any(
                char.IsLower)
            &&
            password.Any(
                char.IsDigit);
    }


