@page "/account"
@page "/account/{Mode}"

@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject DatabaseService DbService
@inject FileStorageService FileStorage
@inject NavigationManager Nav

<PageTitle>Account & Premium | ShoppetCare</PageTitle>


<div class="account-page">

    @if (!isReady)
    {
        <div class="account-shell account-loading">
            Loading your ShoppetCare account...
        </div>
    }
    else if (Auth.IsGuest)
    {
        <section class="account-access">

            <span class="access-icon">

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                </svg>

            </span>


            <span class="account-eyebrow">
                GUEST MODE
            </span>


            <h1>
                Your personal ShoppetCare
                space starts with an account.
            </h1>


            <p>
                Create a free account to save pets,
                issue Digital Pet IDs, and keep
                health records connected.
            </p>


            <div class="access-actions">

                <a href="/register"
                   class="primary">
                    Create Free Account
                </a>


                <a href="/login">
                    Sign In
                </a>

            </div>

        </section>
    }
    else if (!Auth.IsLoggedIn)
    {
        <section class="account-access">

            <span class="account-eyebrow">
                ACCOUNT REQUIRED
            </span>


            <h1>
                Sign in to manage
                your ShoppetCare account.
            </h1>


            <div class="access-actions">

                <a href="/login"
                   class="primary">
                    Sign In
                </a>


                <a href="/register">
                    Create Account
                </a>

            </div>

        </section>
    }
    else
    {
        <main class="account-shell">


            <!-- =====================================================
                 ACCOUNT HERO
                 ===================================================== -->

            <section class="account-hero">

                <div class="account-hero-main">

                    <div class="hero-photo">

                        @if (!string.IsNullOrWhiteSpace(
                            ProfilePhotoUrl))
                        {
                            <img src="@ProfilePhotoUrl"
                                 alt="@GetDisplayName()" />
                        }
                        else
                        {
                            <span>
                                @GetInitials()
                            </span>
                        }

                    </div>


                    <div>

                        <span class="account-eyebrow">
                            ACCOUNT &amp; PREMIUM
                        </span>


                        <h1>
                            @GetDisplayName()
                        </h1>


                        <p>
                            Your identity, security,
                            membership, and privacy settings
                            — managed in one place.
                        </p>


                        <div class="hero-meta">

                            <span>
                                @Auth.CurrentUser?.Email
                            </span>

                            <i></i>

                            <span>
                                @GetRole()
                            </span>

                            <i></i>

                            <span>
                                Member since @GetMemberSince()
                            </span>

                        </div>

                    </div>

                </div>


                <div class="hero-status">

                    @if (Auth.IsPremium)
                    {
                        <span class="premium-status">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                            </svg>

                            Lifetime Premium

                        </span>
                    }
                    else
                    {
                        <span class="free-status">
                            Free Account
                        </span>
                    }

                </div>

            </section>


            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@(messageIsError
                                                    ? "account-message error"
                                                    : "account-message success")">

                    @message

                </div>
            }


            <!-- =====================================================
                 TWO-COLUMN ACCOUNT WORKSPACE
                 ===================================================== -->

            <section class="account-workspace">


                <!-- =================================================
                     LEFT COLUMN
                     ================================================= -->

                <div class="account-column main">


                    <!-- PROFILE -->

                    <article class="profile-card">

                        <div class="account-card-head">

                            <div>

                                <span class="account-eyebrow">
                                    PERSONAL INFORMATION
                                </span>


                                <h2>
                                    Your ShoppetCare profile
                                </h2>


                                <p>
                                    Keep the identity connected
                                    to your pets and account current.
                                </p>

                            </div>


                            @if (!editProfile)
                            {
                                <button type="button"
                                        class="outline-button"
                                        @onclick="OpenProfileEditor">

                                    Edit Profile

                                </button>
                            }

                        </div>


                        <div class="profile-body">


                            <!-- PHOTO MANAGEMENT -->

                            <section class="photo-panel">

                                <div class="profile-photo">

                                    @if (!string.IsNullOrWhiteSpace(
                                        ProfilePhotoUrl))
                                    {
                                        <img src="@ProfilePhotoUrl"
                                             alt="@GetDisplayName()" />
                                    }
                                    else
                                    {
                                        <span>
                                            @GetInitials()
                                        </span>
                                    }

                                </div>


                                <div>

                                    <span class="small-heading">
                                        PROFILE PHOTO
                                    </span>


                                    <strong>
                                        Put a face to your account
                                    </strong>


                                    <p>
                                        Optional. JPG, PNG,
                                        or WEBP up to 5 MB.
                                    </p>


                                    <div class="photo-actions">

                                        <label class="photo-picker">

                                            <svg aria-hidden="true">
                                                <use href="/icons/bootstrap-icons.svg#image"></use>
                                            </svg>

                                            Choose Photo

                                            <InputFile OnChange="HandleProfilePhotoSelected"
                                                       accept="image/jpeg,image/png,image/webp" />

                                        </label>


                                        @if (!string.IsNullOrWhiteSpace(
                                            ProfilePhotoUrl))
                                        {
                                            <button type="button"
                                                    class="remove-photo"
                                                    @onclick="RemoveProfilePhoto">

                                                Remove

                                            </button>
                                        }

                                    </div>

                                </div>

                            </section>


                            <!-- DETAILS -->
                            @if (!editProfile)
                            {
                                <section class="identity-panel">

                                    <div class="identity-row">

                                        <span>
                                            Full Name
                                        </span>

                                        <strong>
                                            @GetDisplayName()
                                        </strong>

                                    </div>


                                    <div class="identity-row">

                                        <span>
                                            Email Address
                                        </span>

                                        <strong>
                                            @Auth.CurrentUser?.Email
                                        </strong>

                                    </div>


                                    <div class="identity-row">

                                        <span>
                                            Account Role
                                        </span>

                                        <strong>
                                            @GetRole()
                                        </strong>

                                    </div>


                                    <div class="identity-row">

                                        <span>
                                            Membership
                                        </span>

                                        <strong>
                                            @(Auth.IsPremium
                                                ? "Lifetime Premium"
                                                : "Free Account")
                                        </strong>

                                    </div>


                                    <div class="identity-row">

                                        <span>
                                            Member Since
                                        </span>

                                        <strong>
                                            @GetMemberSince()
                                        </strong>

                                    </div>

                                </section>
                            }
                            else
                            {
                                <section class="profile-editor">

                                    <div class="account-field">

                                        <label>
                                            Full Name
                                        </label>

                                        <input type="text"
                                               maxlength="150"
                                               @bind="editFullName" />

                                    </div>


                                    <div class="account-field">

                                        <label>
                                            Email Address
                                        </label>

                                        <input type="email"
                                               maxlength="150"
                                               @bind="editEmail" />

                                    </div>


                                    <div class="editor-actions">

                                        <button type="button"
                                                class="primary-button"
                                                disabled="@savingProfile"
                                                @onclick="SaveProfileAsync">

                                            @(savingProfile
                                                ? "Saving..."
                                                : "Save Changes")

                                        </button>


                                        <button type="button"
                                                class="outline-button"
                                                disabled="@savingProfile"
                                                @onclick="CancelProfileEditor">

                                            Cancel

                                        </button>

                                    </div>

                                </section>
                            }

                        </div>


                        <!-- WHY PROFILE MATTERS -->

                        <div class="profile-purpose">

                            <span class="purpose-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    One account. One connected identity.
                                </strong>

                                <p>
                                    This account owns your pet profiles,
                                    Digital Pet IDs, health records,
                                    marketplace activity, and care interactions.
                                </p>

                            </div>

                        </div>

                    </article>


                    <!-- SECURITY -->

                    <article class="security-card">

                        <div class="security-heading">

                            <span class="security-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                                </svg>

                            </span>


                            <div>

                                <span class="account-eyebrow">
                                    ACCOUNT SECURITY
                                </span>

                                <h2>
                                    Password &amp; access
                                </h2>

                                <p>
                                    Protect the account connected
                                    to your pets and private records.
                                </p>

                            </div>

                        </div>


                        @if (!changePassword)
                        {
                            <div class="security-actions">

                                <button type="button"
                                        class="primary-button"
                                        @onclick="OpenPasswordEditor">

                                    Change Password

                                </button>


                                <a href="/forgot-password">
                                    Forgot your password?
                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="password-editor">

                                <div class="account-field">

                                    <label>
                                        Current Password
                                    </label>

                                    <input type="password"
                                           @bind="currentPassword" />

                                </div>


                                <div class="password-grid">

                                    <div class="account-field">

                                        <label>
                                            New Password
                                        </label>

                                        <input type="password"
                                               @bind="newPassword" />

                                    </div>


                                    <div class="account-field">

                                        <label>
                                            Confirm New Password
                                        </label>

                                        <input type="password"
                                               @bind="confirmPassword" />

                                    </div>

                                </div>


                                <small class="password-rule">
                                    Use at least 8 characters
                                    with uppercase and lowercase letters
                                    and at least one number.
                                </small>


                                <div class="editor-actions">

                                    <button type="button"
                                            class="primary-button"
                                            disabled="@savingPassword"
                                            @onclick="SavePassword">

                                        @(savingPassword
                                            ? "Updating..."
                                            : "Update Password")

                                    </button>


                                    <button type="button"
                                            class="outline-button"
                                            disabled="@savingPassword"
                                            @onclick="CancelPasswordEditor">

                                        Cancel

                                    </button>

                                </div>

                            </div>
                        }

                    </article>

                </div>


                <!-- =================================================
                     RIGHT COLUMN
                     ================================================= -->

                <div class="account-column side">


                    <!-- MEMBERSHIP -->

                    <article class="membership-card">

                        <span class="membership-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                            </svg>

                        </span>


                        <span class="account-eyebrow gold">
                            MEMBERSHIP
                        </span>


                        @if (Auth.IsPremium)
                        {
                            <h2>
                                Lifetime
                                <em>Premium.</em>
                            </h2>


                            <p class="membership-lead">
                                Your one-time Premium upgrade
                                expands the ShoppetCare experience
                                around every pet connected to you.
                            </p>


                            <div class="premium-benefits">

                                <div>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                    </svg>

                                    Unlimited pet profiles

                                </div>


                                <div>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                    </svg>

                                    Unlimited health records

                                </div>


                                <div>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                    </svg>

                                    Premium Pet ID themes

                                </div>


                                <div>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                    </svg>

                                    Health document export

                                </div>

                            </div>


                            <div class="membership-details">

                                <div>

                                    <span>
                                        Access
                                    </span>

                                    <strong>
                                        Lifetime
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Activated
                                    </span>

                                    <strong>
                                        @(Auth.CurrentUser?
                                            .PremiumActivatedAt?
                                            .ToString("MMM dd, yyyy")
                                            ?? "Active")
                                    </strong>

                                </div>


                                <div class="reference">

                                    <span>
                                        Transaction Reference
                                    </span>

                                    <strong>
                                        @(Auth.CurrentUser?
                                            .PremiumReference
                                            ?? "—")
                                    </strong>

                                </div>

                            </div>
                        }
                        else
                        {
                            <h2>
                                Upgrade once.
                                <em>Keep it for life.</em>
                            </h2>


                            <p class="membership-lead">
                                Expand pet profiles,
                                health records, Pet ID personalization,
                                and document tools with one
                                lifetime upgrade.
                            </p>


                            <div class="price-display">

                                <strong>
                                    ₱49
                                </strong>

                                <span>
                                    one-time
                                </span>

                            </div>


                            <a href="/premium"
                               class="membership-cta">

                                Explore Premium

                                <span>→</span>

                            </a>
                        }

                    </article>


                    <!-- PRIVACY -->

                    <article class="trust-card">

                        <div class="trust-heading">

                            <span class="trust-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#shield-check"></use>
                                </svg>

                            </span>


                            <div>

                                <span class="account-eyebrow">
                                    PRIVACY &amp; OWNERSHIP
                                </span>

                                <h2>
                                    Share the pet.
                                    Protect the owner.
                                </h2>

                            </div>

                        </div>


                        <p>
                            ShoppetCare separates the information
                            useful on a public Pet ID from
                            the private information that belongs
                            inside your account.
                        </p>


                        <div class="trust-list">

                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                Public Pet ID shows basic pet identity

                            </div>


                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                Owner information remains protected

                            </div>


                            <div>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                                </svg>

                                Private health information stays inside the account

                            </div>

                        </div>

                    </article>

                </div>

            </section>


            <!-- =====================================================
                 SESSION
                 ===================================================== -->

            <section class="session-bar">

                <div>

                    <span class="account-eyebrow">
                        ACCOUNT SESSION
                    </span>


                    <strong>
                        Finished for now?
                    </strong>


                    <p>
                        Sign out when using a shared
                        or public computer.
                    </p>

                </div>


                <button type="button"
                        @onclick="SignOutAsync">

                    Sign Out

                </button>

            </section>

        </main>
    }

</div>


<style>

    :root {
        --account-teal: #2F9098;
        --account-teal-dark: #267C83;
        --account-dark: #173D3D;
        --account-cream: #FBF8F2;
        --account-yellow: #F3D27A;
        --account-yellow-soft: #FFF4CF;
        --account-border: #DDE7E4;
        --account-muted: #72837D;
    }


    .account-page,
    .account-page *,
    .account-page *::before,
    .account-page *::after {
        box-sizing: border-box;
    }


    .account-page {
        min-height: 100vh;
        padding: 30px 0 72px;
        color: var(--account-dark);
        background: radial-gradient( circle at 94% 3%, rgba(47,144,152,.10), transparent 23% ), var(--account-cream);
    }


        .account-page svg {
            width: 1em;
            height: 1em;
            fill: currentColor;
        }


    .account-shell,
    .account-access {
        width: min( 1400px, calc(100% - 48px) );
        margin: 0 auto;
    }


    .account-loading {
        padding: 80px 0;
        text-align: center;
        color: var(--account-muted);
    }


    .account-eyebrow {
        display: block;
        color: var(--account-teal);
        font-size: 10px;
        font-weight: 950;
        letter-spacing: .13em;
    }


        .account-eyebrow.gold {
            color: #947016;
        }


    /* =========================================================
           HERO
           ========================================================= */

    .account-hero {
        position: relative;
        overflow: hidden;
        min-height: 175px;
        padding: 29px 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        border: 1px solid var(--account-border);
        border-radius: 24px;
        background: radial-gradient( circle at 91% 12%, rgba(47,144,152,.14), transparent 28% ), linear-gradient( 125deg, #FFFDF9, #FBF8F2 51%, #EEF7F5 );
        box-shadow: 0 18px 45px rgba(23,61,61,.07);
    }


        .account-hero::after {
            content: "";
            position: absolute;
            right: -250px;
            top: -300px;
            width: 450px;
            height: 450px;
            border: 1px solid rgba(47,144,152,.13);
            border-radius: 50%;
        }


    .account-hero-main {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 19px;
    }


    .hero-photo {
        width: 92px;
        height: 92px;
        flex: 0 0 92px;
        overflow: hidden;
        display: grid;
        place-items: center;
        border: 4px solid #FFFFFF;
        border-radius: 25px;
        background: linear-gradient( 135deg, var(--account-teal), var(--account-dark) );
        color: #FFFFFF;
        font-size: 20px;
        font-weight: 950;
        box-shadow: 0 12px 27px rgba(23,61,61,.14);
    }


        .hero-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .account-hero h1 {
        margin: 6px 0 0;
        color: var(--account-dark);
        font-size: clamp( 34px, 4vw, 50px );
        line-height: .96;
        font-weight: 950;
        letter-spacing: -.05em;
    }


    .account-hero-main p {
        margin: 7px 0 0;
        color: var(--account-muted);
        font-size: 12px;
    }


    .hero-meta {
        margin-top: 10px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        color: #788A83;
        font-size: 10px;
        font-weight: 750;
    }


        .hero-meta i {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #A7B4B0;
        }


    .hero-status {
        position: relative;
        z-index: 2;
    }


    .premium-status,
    .free-status {
        min-height: 38px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
    }


    .premium-status {
        border: 1px solid #E1C45F;
        background: var(--account-yellow-soft);
        color: #80600F;
    }


    .free-status {
        background: #EDF3F1;
        color: #63736D;
    }


    /* =========================================================
           MESSAGE
           ========================================================= */

    .account-message {
        margin-top: 13px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 12px;
    }


        .account-message.success {
            border: 1px solid #B8DDCF;
            background: #EFFAF5;
            color: #28664D;
        }


        .account-message.error {
            border: 1px solid #EDC1C1;
            background: #FFF3F3;
            color: #983838;
        }


    /* =========================================================
           WORKSPACE
           ========================================================= */

    .account-workspace {
        margin-top: 14px;
        display: grid;
        grid-template-columns: minmax(0,1.55fr) minmax(360px,.75fr);
        gap: 14px;
        align-items: start;
    }


    .account-column {
        display: grid;
        gap: 14px;
    }


    /* =========================================================
           SHARED CARD
           ========================================================= */

    .profile-card,
    .security-card,
    .membership-card,
    .trust-card,
    .session-bar {
        border: 1px solid var(--account-border);
        border-radius: 21px;
        background: #FFFFFF;
        box-shadow: 0 10px 28px rgba(23,61,61,.045);
    }


    .account-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 22px;
    }


        .account-card-head h2,
        .security-card h2,
        .trust-card h2 {
            margin: 6px 0 0;
            color: var(--account-dark);
            font-weight: 950;
            letter-spacing: -.035em;
        }


        .account-card-head h2 {
            font-size: 27px;
        }


        .account-card-head p {
            margin: 6px 0 0;
            color: #7C8C86;
            font-size: 11px;
            line-height: 1.5;
        }


    /* =========================================================
           PROFILE
           ========================================================= */

    .profile-card {
        padding: 27px;
        background: radial-gradient( circle at 94% 6%, rgba(47,144,152,.08), transparent 25% ), #FFFFFF;
    }


    .profile-body {
        margin-top: 22px;
        display: grid;
        grid-template-columns: minmax(250px,.65fr) minmax(0,1.35fr);
        gap: 19px;
    }


    .photo-panel {
        padding: 17px;
        display: grid;
        grid-template-columns: 120px minmax(0,1fr);
        align-items: center;
        gap: 16px;
        border-radius: 15px;
        background: linear-gradient( 145deg, #EAF6F4, #F8FBFA );
    }


    .profile-photo {
        width: 120px;
        height: 120px;
        overflow: hidden;
        display: grid;
        place-items: center;
        border-radius: 22px;
        background: linear-gradient( 135deg, var(--account-teal), var(--account-dark) );
        color: #FFFFFF;
        font-size: 27px;
        font-weight: 950;
    }


        .profile-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .small-heading {
        display: block;
        color: var(--account-teal);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .11em;
    }


    .photo-panel strong {
        display: block;
        margin-top: 4px;
        color: var(--account-dark);
        font-size: 13px;
    }


    .photo-panel p {
        margin: 4px 0 10px;
        color: #7F8F89;
        font-size: 9px;
        line-height: 1.45;
    }


    .photo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }


    .photo-picker {
        position: relative;
        min-height: 37px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        overflow: hidden;
        border: 1px solid #C6DAD5;
        border-radius: 8px;
        background: #FFFFFF;
        color: var(--account-teal-dark);
        font-size: 10px;
        font-weight: 850;
        cursor: pointer;
    }


        .photo-picker input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }


    .remove-photo {
        min-height: 37px;
        padding: 0 9px;
        border: 1px solid #E8C5C5;
        border-radius: 8px;
        background: #FFFFFF;
        color: #9C4242;
        font-size: 10px;
