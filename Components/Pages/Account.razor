    private static string FormatMobileNumber(
        string value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return "—";
        }


        var digits =
            new string(
                value
                    .Where(char.IsDigit)
                    .ToArray());


        if (digits.Length == 11 &&
            digits.StartsWith(
                "09",
                StringComparison.Ordinal))
        {
            return
                $"+63 {digits.Substring(1, 3)} " +
                $"{digits.Substring(4, 3)} " +
                $"{digits.Substring(7, 4)}";
        }


        return value;
    }


