        }


        if (!IsStrongPassword(
            newPassword))
        {
            ShowError(
                "Your new password must contain at least 8 characters, uppercase and lowercase letters, and a number.");

            return;
        }


        if (!string.Equals(
            newPassword,
            confirmPassword,
            StringComparison.Ordinal))
        {
            ShowError(
                "The new password and confirmation do not match.");

            return;
        }


        if (string.Equals(
            currentPassword,
            newPassword,
            StringComparison.Ordinal))
        {
            ShowError(
                "Choose a new password that is different from your current password.");

            return;
        }


        savingPassword =
