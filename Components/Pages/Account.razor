       PREMIUM / SUBSCRIPTION
       Uses your EXISTING UserAccount fields:
       IsPremium
       PremiumActivatedAt
       PremiumReference

       No extra C# model properties required.
       ========================================================= */

    private bool HasActivePremium => Auth.IsPremium;
    private bool IsPremiumExpired => false;

