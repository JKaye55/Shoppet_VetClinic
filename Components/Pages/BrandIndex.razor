@page "/brands"
@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services
@inject DatabaseService DbService
@inject NavigationManager Nav


<div class="shoppet-viewport">
    <main class="container-xl py-4 flex-grow-1">
        <div class="mb-4">
            <h4 class="fw-bold mb-0" style="color: #1E2824;">Brand Availability Index &amp; Directory Hub</h4>
            <p class="text-muted small mb-0">Browse authorized pet food and pharmacy brands carried by partner establishments</p>
        </div>

        <div class="row g-3">
            @foreach (var brand in new[] { "Royal Canin", "NexGard Spectra", "Pedigree", "Aozi" })
            {
                var carryingClinics = clinics.Where(c => c.BrandsCarried.Contains(brand, StringComparison.OrdinalIgnoreCase)).ToList();
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 h-100 d-flex flex-column justify-content-between bg-white">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="fw-bold mb-0 text-dark">@brand</h6>
                                <span class="badge bg-light text-dark border">Verified Spotlight</span>
                            </div>
                            <small class="text-muted d-block mb-2">Available across verified counters:</small>
                            <ul class="list-unstyled small mb-3">
                                @foreach (var c in carryingClinics)
                                {
                                    <li class="mb-1 d-flex justify-content-between">
                                        <span>@c.ClinicName</span>
                                        @if (!string.IsNullOrEmpty(c.MessengerUrl))
                                        {
                                            <a href="@c.MessengerUrl" target="_blank" class="text-decoration-none fw-bold" style="color: #5C766D; font-size: 0.75rem;">Message Page →</a>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private List<ClinicTenant> clinics = new();

    protected override void OnInitialized()
    {
        clinics = DbService.GetAllClinics();
    }
}