@code {

    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter, EditorRequired]
    public PetProfile Pet { get; set; } =
        default!;


    [Parameter]
    public string OwnerName { get; set; } =
        "Pet Owner";


    [Parameter]
    public string OwnerPhone { get; set; } =
        string.Empty;


    [Parameter]
    public string PhotoUrl { get; set; } =
        string.Empty;


    [Parameter]
    public string QrDataUri { get; set; } =
        string.Empty;


    [Parameter]
    public bool IsPremium { get; set; }


    [Parameter]
    public string VaccinationStatus { get; set; } =
        "No Record";


    [Parameter]
    public int HealthRecordCount { get; set; }


    [Parameter]
    public bool PublicMode { get; set; }


    // =========================================================
    // CARD THEME
    // =========================================================

    private string CardClass
    {
        get
        {
            /*
                Premium themes are only rendered while
                Premium is active.

                We do NOT erase the saved theme when Premium
                expires. The card simply falls back to Classic.
            */

            var theme =
                IsPremium
                    ? Pet.CardTheme
                    : "Classic";


            var normalized =
                string.IsNullOrWhiteSpace(theme)
                    ? "classic"
                    : theme
                        .Trim()
                        .ToLowerInvariant();


            return
                $"sc-pet-id theme-{normalized}";
        }
    }


    // =========================================================
    // ISSUE DATE
    // =========================================================

    private string IssueDate =>
        (
            Pet.CardIssuedAt
            ??
            Pet.CreatedAt
        )
        .ToString(
            "MMM dd, yyyy");


    // =========================================================
    // BIRTHDATE
    // =========================================================

    private string BirthDateDisplay =>
        Pet.BirthDate?
            .ToString(
                "MMM dd, yyyy")
        ??
        "Not provided";


    // =========================================================
    // AGE
    // =========================================================

    private string AgeDisplay
    {
        get
        {
            /*
                New pets should use BirthDate.

                Existing records may still only have the old
                Age text, so we retain that as a fallback.
            */

            if (!Pet.BirthDate.HasValue)
            {
                return
                    Display(
                        Pet.Age);
            }


            var birthDate =
                Pet.BirthDate
                    .Value
                    .Date;


            var today =
                DateTime.Today;


            if (birthDate > today)
            {
                return "Invalid date";
            }


            var years =
                today.Year
                -
                birthDate.Year;


            if (birthDate >
                today.AddYears(
                    -years))
            {
                years--;
            }


            if (years >= 1)
            {
                return
                    years == 1
                        ? "1 year"
                        : $"{years} years";
            }


            var months =
                (
                    today.Year
                    -
                    birthDate.Year
                )
                *
                12
                +
                today.Month
                -
                birthDate.Month;


            if (today.Day <
                birthDate.Day)
            {
                months--;
            }


            months =
                Math.Max(
                    months,
                    0);


            if (months == 0)
            {
                var days =
                    (
                        today
                        -
                        birthDate
                    )
                    .Days;


                return
                    days == 1
                        ? "1 day"
                        : $"{days} days";
            }


            return
                months == 1
                    ? "1 month"
                    : $"{months} months";
        }
    }


    // =========================================================
    // WEIGHT
    // =========================================================

    private string WeightDisplay =>
        Pet.WeightKg.HasValue
            ? $"{Pet.WeightKg.Value:0.##} kg"
            : "Not provided";


    // =========================================================
    // OWNER PHONE
    // =========================================================

    private string FormattedOwnerPhone =>
        FormatPhilippinePhone(
            OwnerPhone);


    // =========================================================
    // SAFE DISPLAY
    // =========================================================

    private static string Display(
        string? value)
    {
        return
            string.IsNullOrWhiteSpace(value)
                ? "Not provided"
                : value.Trim();
    }


    // =========================================================
    // PH MOBILE FORMAT
    // =========================================================

    private static string FormatPhilippinePhone(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return "Not provided";
        }


        var raw =
            value.Trim();


        var digits =
            new string(
                raw
                    .Where(char.IsDigit)
                    .ToArray());


        /*
            09171234567

            becomes

            +63 917 123 4567
        */

        if (digits.Length == 11 &&
            digits.StartsWith(
                "09",
                StringComparison.Ordinal))
        {
            return
                $"+63 " +
                $"{digits.Substring(1, 3)} " +
                $"{digits.Substring(4, 3)} " +
                $"{digits.Substring(7, 4)}";
        }


        /*
            639171234567

            becomes

            +63 917 123 4567
        */

        if (digits.Length == 12 &&
            digits.StartsWith(
                "63",
                StringComparison.Ordinal))
        {
            return
                $"+63 " +
                $"{digits.Substring(2, 3)} " +
                $"{digits.Substring(5, 3)} " +
                $"{digits.Substring(8, 4)}";
        }


        return raw;
    }

}