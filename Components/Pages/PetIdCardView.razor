@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject CardService Cards


<article class="@CardClass">

    <!-- =========================================================
         TOP BRAND
         ========================================================= -->

    <header class="pid-top">

        <div class="pid-brand">

            <div class="pid-logo">

                <img src="/shoppetlogo.png"
                     alt="ShoppetCare" />

            </div>


            <div>

                <strong>
                    ShoppetCare
                </strong>

                <span>
                    DIGITAL PET IDENTITY
                </span>

            </div>

        </div>


        <div class="pid-tier @(IsPremium ? "premium" : "basic")">

            @if (IsPremium)
            {
                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                </svg>

                <span>
                    Premium Pet ID
                </span>
            }
            else
            {
                <span>
                    Basic Pet ID
                </span>
            }

        </div>

    </header>


    <!-- =========================================================
         PET IDENTITY
         ========================================================= -->

    <section class="pid-main">

        <!-- PHOTO -->

        <div class="pid-photo-area">

            <div class="pid-photo">

                @if (!string.IsNullOrWhiteSpace(PhotoUrl))
                {
                    <img src="@PhotoUrl"
                         alt="@Pet.PetName" />
                }
                else
                {
                    <span>
                        @Initial
                    </span>
                }

            </div>


            <div class="pid-status">

                <span class="pid-status-dot"></span>

                Active Digital ID

            </div>

        </div>


        <!-- MAIN PET INFO -->

        <div class="pid-details">

            <span class="pid-label">
                REGISTERED PET
            </span>


            <h2>
                @Pet.PetName
            </h2>


            <p class="pid-description">
                @Pet.Species
                @if (!string.IsNullOrWhiteSpace(Pet.Breed))
                {
                    <span> · @Pet.Breed</span>
                }
            </p>


            <div class="pid-info-grid">

                <div class="pid-info-item">

                    <span class="pid-info-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#tag-fill"></use>
                        </svg>

                    </span>


                    <span>

                        <small>
                            Species
                        </small>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Pet.Species)
                                ? "Not specified"
                                : Pet.Species)
                        </strong>

                    </span>

                </div>


                <div class="pid-info-item">

                    <span class="pid-info-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#stars"></use>
                        </svg>

                    </span>


                    <span>

                        <small>
                            Breed
                        </small>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Pet.Breed)
                                ? "Not specified"
                                : Pet.Breed)
                        </strong>

                    </span>

                </div>


                <div class="pid-info-item">

                    <span class="pid-info-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#calendar3"></use>
                        </svg>

                    </span>


                    <span>

                        <small>
                            Age
                        </small>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Pet.Age)
                                ? "Not set"
                                : Pet.Age)
                        </strong>

                    </span>

                </div>


                <div class="pid-info-item">

                    <span class="pid-info-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#speedometer2"></use>
                        </svg>

                    </span>


                    <span>

                        <small>
                            Weight
                        </small>

                        <strong>
                            @(Pet.WeightKg.HasValue
                                ? $"{Pet.WeightKg.Value:0.##} kg"
                                : "Not set")
                        </strong>

                    </span>

                </div>

            </div>

        </div>


        <!-- QR -->

        <div class="pid-qr-column">

            <div class="pid-qr">

                @if (!string.IsNullOrWhiteSpace(QrDataUri))
                {
                    <img src="@QrDataUri"
                         alt="@Pet.PetName Pet ID QR code" />
                }

            </div>


            <span class="pid-scan-label">
                SCAN PET ID
            </span>


            <small>
                Opens public identity
            </small>

        </div>

    </section>


    <!-- =========================================================
         OWNER + CARD ID
         ========================================================= -->

    <section class="pid-identity-bar">

        <div>

            <span class="pid-round-icon">

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#person-fill"></use>
                </svg>

            </span>


            <span>

                <small>
                    @(PublicMode
                        ? "Owner Privacy"
                        : "Pet Owner")
                </small>

                <strong>
                    @(PublicMode
                        ? "Protected"
                        : OwnerName)
                </strong>

            </span>

        </div>


        <div>

            <span class="pid-round-icon">

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                </svg>

            </span>


            <span>

                <small>
                    Digital Pet ID
                </small>

                <strong class="pid-number">
                    @Pet.CardId
                </strong>

            </span>

        </div>

    </section>


    <!-- =========================================================
         VALUE / CARE SNAPSHOT
         ========================================================= -->

    <section class="pid-snapshot">

        @if (PublicMode)
        {
            <div>

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                </svg>

                <span>

                    <small>
                        Identity
                    </small>

                    <strong>
                        Active
                    </strong>

                </span>

            </div>


            <div>

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                </svg>

                <span>

                    <small>
                        QR Profile
                    </small>

                    <strong>
                        Verified
                    </strong>

                </span>

            </div>


            <div>

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                </svg>

                <span>

                    <small>
                        Privacy
                    </small>

                    <strong>
                        Basic Info Only
                    </strong>

                </span>

            </div>
        }
        else
        {
            <div>

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#shield-check"></use>
                </svg>

                <span>

                    <small>
                        Vaccination
                    </small>

                    <strong>
                        @VaccinationStatus
                    </strong>

                </span>

            </div>


            <div>

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#clipboard2-pulse-fill"></use>
                </svg>

                <span>

                    <small>
                        Health Records
                    </small>

                    <strong>
                        @HealthRecordCount
                        @(HealthRecordCount == 1
                            ? "Record"
                            : "Records")
                    </strong>

                </span>

            </div>


            <div>

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#heart-fill"></use>
                </svg>

                <span>

                    <small>
                        Usual Diet
                    </small>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Pet.Diet)
                            ? "Not specified"
                            : Pet.Diet)
                    </strong>

                </span>

            </div>
        }

    </section>


    <!-- =========================================================
         FOOT
         ========================================================= -->

    <footer class="pid-footer">

        <span>
            Issued
            @(Pet.CardIssuedAt?.ToString("MMM yyyy") ?? "—")
        </span>


        <span>
            ShoppetCare Digital Pet Identity
        </span>

    </footer>

</article>


<style>

    .pid-card {
        --pid-a: #F7FFFF;
        --pid-b: #E4F5F2;
        --pid-accent: #2F9098;
        --pid-accent-soft: #DDF3F1;
        --pid-dark: #173D3D;
        --pid-muted: #71847D;
        --pid-border: #AFCFC9;
        position: relative;
        width: 100%;
        aspect-ratio: 1.586 / 1;
        min-height: 470px;
        padding: clamp(24px,3.2vw,42px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--pid-border);
        border-radius: 28px;
        background: radial-gradient( circle at 91% 14%, rgba(255,255,255,.86), transparent 19% ), radial-gradient( circle at 89% 88%, rgba(47,144,152,.08), transparent 24% ), linear-gradient( 135deg, var(--pid-a), var(--pid-b) );
        color: var(--pid-dark);
        box-shadow: 0 25px 60px rgba(23,61,61,.12);
    }


        .pid-card::before {
            content: "";
            position: absolute;
            width: 290px;
            height: 290px;
            right: -150px;
            top: -160px;
            border: 1px solid rgba(47,144,152,.11);
            border-radius: 50%;
        }


        .pid-card.is-premium {
            border-width: 2px;
            --pid-border: #E0BF5D;
        }


        .pid-card.theme-classic {
            --pid-a: #F7FFFF;
            --pid-b: #E6F6F3;
        }


        .pid-card.theme-ocean {
            --pid-a: #EFFCFE;
            --pid-b: #CFEFF3;
            --pid-accent: #237F90;
            --pid-accent-soft: #D3EEF1;
            --pid-border: #83C6CF;
        }


        .pid-card.theme-sunset {
            --pid-a: #FFF9F5;
            --pid-b: #FFE4D5;
            --pid-accent: #B9614D;
            --pid-accent-soft: #F7DED4;
            --pid-border: #E19A7E;
        }


        .pid-card.theme-mint {
            --pid-a: #F4FCF6;
            --pid-b: #D9EDDF;
            --pid-accent: #4B886E;
            --pid-accent-soft: #D8ECE0;
            --pid-border: #96C2A7;
        }


        .pid-card.theme-royal {
            --pid-a: #F8F5FF;
            --pid-b: #E4DAFA;
            --pid-accent: #5C4B95;
            --pid-accent-soft: #E4DDF7;
            --pid-border: #AE9ADA;
        }


        .pid-card *,
        .pid-card *::before,
        .pid-card *::after {
            box-sizing: border-box;
        }


        .pid-card svg {
            width: 1em;
            height: 1em;
            fill: currentColor;
        }


    /* =========================================================
           TOP
           ========================================================= */

    .pid-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }


    .pid-brand {
        display: flex;
        align-items: center;
        gap: 11px;
    }


    .pid-logo {
        width: 50px;
        height: 50px;
        padding: 5px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background: rgba(255,255,255,.88);
        box-shadow: 0 6px 16px rgba(23,61,61,.07);
    }


        .pid-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }


    .pid-brand strong,
    .pid-brand span {
        display: block;
    }


    .pid-brand strong {
        color: var(--pid-dark);
        font-size: clamp( 15px, 1.5vw, 20px );
        font-weight: 950;
        letter-spacing: -.035em;
    }


    .pid-brand span {
        margin-top: 2px;
        color: var(--pid-muted);
        font-size: 8px;
        font-weight: 900;
        letter-spacing: .12em;
    }


    .pid-tier {
        min-height: 34px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 900;
        white-space: nowrap;
    }


        .pid-tier.basic {
            background: var(--pid-accent-soft);
            color: var(--pid-accent);
        }


        .pid-tier.premium {
            border: 1px solid #E2BF58;
            background: linear-gradient( 180deg, #FFF5D6, #FFE6A1 );
            color: #74530B;
            box-shadow: 0 5px 13px rgba(164,121,18,.12);
        }


    /* =========================================================
           MAIN
           ========================================================= */

    .pid-main {
        position: relative;
        z-index: 2;
        flex: 1;
        margin-top: clamp( 26px, 4.6%, 44px );
        display: grid;
        grid-template-columns: minmax(145px,23%) minmax(0,1fr) minmax(135px,20%);
        align-items: center;
        gap: clamp( 20px, 4%, 45px );
    }


    /* PHOTO */

    .pid-photo-area {
        text-align: center;
    }


    .pid-photo {
        width: 100%;
        max-width: 205px;
        aspect-ratio: 1;
        margin: 0 auto;
        overflow: hidden;
        display: grid;
        place-items: center;
        border: clamp( 4px, .5vw, 6px ) solid rgba(255,255,255,.98);
        border-radius: 50%;
        background: #DCEDEA;
        box-shadow: 0 14px 30px rgba(23,61,61,.15);
    }


        .pid-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


        .pid-photo > span {
            width: 100%;
            height: 100%;
            display: grid;
            place-items: center;
            background: linear-gradient( 135deg, var(--pid-accent), #173D3D );
            color: #FFFFFF;
            font-size: 40px;
            font-weight: 950;
        }


    .pid-status {
        margin-top: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--pid-accent);
        font-size: 9px;
        font-weight: 900;
    }


    .pid-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--pid-accent);
        box-shadow: 0 0 0 4px rgba(47,144,152,.10);
    }


    /* DETAILS */

    .pid-details {
        min-width: 0;
    }


    .pid-label {
        color: var(--pid-accent);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .12em;
    }


    .pid-details h2 {
        margin: 4px 0 0;
        color: var(--pid-dark);
        font-size: clamp( 26px, 3.7vw, 43px );
        line-height: .95;
        font-weight: 950;
        letter-spacing: -.055em;
    }


    .pid-description {
        margin: 6px 0 0;
        color: var(--pid-muted);
        font-size: 12px;
        font-weight: 750;
    }


    .pid-info-grid {
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat( 2, minmax(0,1fr) );
        gap: 8px;
    }


    .pid-info-item {
        min-width: 0;
        padding: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-radius: 10px;
        background: rgba(255,255,255,.55);
    }


    .pid-info-icon {
        width: 30px;
        height: 30px;
        flex: 0 0 30px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: var(--pid-accent-soft);
        color: var(--pid-accent);
        font-size: 11px;
    }


    .pid-info-item > span:last-child {
        min-width: 0;
    }


    .pid-info-item small,
    .pid-info-item strong {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .pid-info-item small {
        color: var(--pid-muted);
        font-size: 7px;
    }


    .pid-info-item strong {
        margin-top: 2px;
        color: var(--pid-dark);
        font-size: 10px;
        font-weight: 900;
    }


    /* QR */

    .pid-qr-column {
        text-align: center;
    }


    .pid-qr {
        width: 100%;
        max-width: 175px;
        margin: 0 auto;
        padding: 11px;
        border: 2px solid var(--pid-border);
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: 0 10px 24px rgba(23,61,61,.09);
    }


        .pid-qr img {
            width: 100%;
            display: block;
        }


    .pid-scan-label {
        display: block;
        margin-top: 8px;
        color: var(--pid-dark);
        font-size: 8px;
        font-weight: 950;
        letter-spacing: .09em;
    }


    .pid-qr-column small {
        display: block;
        margin-top: 2px;
        color: var(--pid-muted);
        font-size: 7px;
    }


    /* =========================================================
           IDENTITY BAR
           ========================================================= */

    .pid-identity-bar {
        position: relative;
        z-index: 2;
        margin-top: 24px;
        padding: 16px 0;
        display: grid;
        grid-template-columns: 1.3fr .7fr;
        gap: 18px;
        border-top: 1px solid rgba(47,144,152,.16);
        border-bottom: 1px solid rgba(47,144,152,.12);
    }


        .pid-identity-bar > div {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 9px;
        }


    .pid-round-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--pid-accent-soft);
        color: var(--pid-accent);
    }


    .pid-identity-bar small,
    .pid-identity-bar strong {
        display: block;
    }


    .pid-identity-bar small {
        color: var(--pid-muted);
        font-size: 7px;
    }


    .pid-identity-bar strong {
        margin-top: 2px;
        overflow: hidden;
        color: var(--pid-dark);
        font-size: 10px;
        font-weight: 900;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .pid-number {
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        letter-spacing: .02em;
    }


    /* =========================================================
           SNAPSHOT
           ========================================================= */

    .pid-snapshot {
        position: relative;
        z-index: 2;
        margin-top: 12px;
        padding: 11px 13px;
        display: grid;
        grid-template-columns: repeat( 3, minmax(0,1fr) );
        gap: 10px;
        border: 1px solid rgba(47,144,152,.09);
        border-radius: 12px;
        background: rgba(255,255,255,.68);
    }


        .pid-snapshot > div {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }


            .pid-snapshot > div > svg {
                flex: 0 0 auto;
                color: var(--pid-accent);
                font-size: 13px;
            }


        .pid-snapshot small,
        .pid-snapshot strong {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        .pid-snapshot small {
            color: var(--pid-muted);
            font-size: 7px;
        }


        .pid-snapshot strong {
            margin-top: 1px;
            color: var(--pid-dark);
            font-size: 9px;
            font-weight: 900;
        }


    /* =========================================================
           FOOTER
           ========================================================= */

    .pid-footer {
        position: relative;
        z-index: 2;
        margin-top: auto;
        padding-top: 10px;
        display: flex;
        justify-content: space-between;
        gap: 15px;
        color: var(--pid-muted);
        font-size: 7px;
        font-weight: 750;
    }


    @@media (max-width: 640px) {

        .pid-card {
            aspect-ratio: auto;
            min-height: auto;
            padding: 22px;
            border-radius: 22px;
        }


        .pid-main {
            grid-template-columns: 105px minmax(0,1fr);
        }


        .pid-qr-column {
            grid-column: 1 / -1;
            width: 130px;
            margin-top: 5px;
        }


        .pid-info-grid {
            grid-template-columns: 1fr;
        }


        .pid-identity-bar {
            grid-template-columns: 1fr;
        }


        .pid-snapshot {
            grid-template-columns: 1fr;
        }


        .pid-footer {
            margin-top: 15px;
        }
    }

</style>


@code {

    [Parameter]
    public PetProfile Pet { get; set; }
        = new();


    [Parameter]
    public string OwnerName { get; set; }
        = "Pet Owner";


    [Parameter]
    public string PhotoUrl { get; set; }
        = string.Empty;


    [Parameter]
    public string QrDataUri { get; set; }
        = string.Empty;


    [Parameter]
    public bool IsPremium { get; set; }


    [Parameter]
    public string VaccinationStatus { get; set; }
        = "No Record";


    [Parameter]
    public int HealthRecordCount { get; set; }


    [Parameter]
    public bool PublicMode { get; set; }


    private string Initial =>
        string.IsNullOrWhiteSpace(
            Pet.PetName)
            ? "P"
            : Pet.PetName[..1]
                .ToUpperInvariant();


    private string CardClass
    {
        get
        {
            var theme =
                IsPremium
                    ? Pet.CardTheme
                    : "Classic";


            var css =
                "pid-card " +
                Cards.GetThemeCssClass(
                    theme);


            if (IsPremium)
            {
                css +=
                    " is-premium";
            }


            return css;
        }
    }

}