@code {

    [Parameter, EditorRequired]
    public PetProfile Pet { get; set; } = default!;


    [Parameter]
    public string OwnerName { get; set; } =
        "Pet Owner";


    [Parameter]
    public string OwnerPhone { get; set; } =
        string.Empty;


    [Parameter]
    public string PhotoUrl { get; set; } =
        string.Empty;


    [Parameter]
    public string QrDataUri { get; set; } =
        string.Empty;


    [Parameter]
    public bool IsPremium { get; set; }


    [Parameter]
    public string VaccinationStatus { get; set; } =
        "No Record";


    [Parameter]
    public int HealthRecordCount { get; set; }


    [Parameter]
    public bool PublicMode { get; set; }


    /*
        Keep false for now.

        Later, if you add a privacy toggle to the
        owner's account/public Pet ID settings,
        pass true only when the owner explicitly
        allows their phone number to appear publicly.
    */
    [Parameter]
    public bool ShowOwnerPhoneInPublic { get; set; }


    private bool CanShowOwnerPhone =>
        !string.IsNullOrWhiteSpace(OwnerPhone)
        &&
        (
            !PublicMode
            ||
            ShowOwnerPhoneInPublic
        );


    private string FormattedOwnerPhone =>
        FormatPhilippinePhone(
            OwnerPhone);


    private string CardClass
    {
        get
        {
            var theme =
                string.IsNullOrWhiteSpace(
                    Pet.CardTheme)
                    ? "classic"
                    : Pet.CardTheme
                        .Trim()
                        .ToLowerInvariant();


            return
                $"sc-pet-id theme-{theme}";
        }
    }


    private string IssueDate =>
        (Pet.CardIssuedAt
            ??
            Pet.CreatedAt)
        .ToString(
            "MMM dd, yyyy");


    private static string Display(
        string? value)
    {
        return
            string.IsNullOrWhiteSpace(
                value)
                ? "Not provided"
                : value.Trim();
    }


    private static string FormatPhilippinePhone(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return "Not provided";
        }


        var raw =
            value.Trim();


        var digits =
            new string(
                raw
                    .Where(char.IsDigit)
                    .ToArray());


        /*
            09171234567
            becomes
            +63 917 123 4567
        */

        if (digits.Length == 11
            &&
            digits.StartsWith(
                "09",
                StringComparison.Ordinal))
        {
            return
                $"+63 {digits.Substring(1, 3)} " +
                $"{digits.Substring(4, 3)} " +
                $"{digits.Substring(7, 4)}";
        }


        /*
            639171234567
            becomes
            +63 917 123 4567
        */

        if (digits.Length == 12
            &&
            digits.StartsWith(
                "63",
                StringComparison.Ordinal))
        {
            return
                $"+63 {digits.Substring(2, 3)} " +
                $"{digits.Substring(5, 3)} " +
                $"{digits.Substring(8, 4)}";
        }


        return raw;
    }

}