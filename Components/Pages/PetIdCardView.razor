@using Shoppet_VetClinic.Models

@if (Pet is not null)
{
    <article class="@CardClass">

        <!-- =====================================================
             TOP IDENTITY BAR
             ===================================================== -->

        <header class="sc-id-header">

            <div class="sc-id-brand">

                <div class="sc-id-logo">
                    <img src="/shoppetlogo.png"
                         alt="ShoppetCare" />
                </div>

                <div class="sc-id-brand-copy">
                    <strong>ShoppetCare</strong>
                    <span>Digital Pet Identity</span>
                </div>

            </div>


            <div class="sc-id-title">
                <span>SHOPPETCARE</span>
                <strong>PET IDENTIFICATION CARD</strong>
            </div>


            @if (IsPremium)
            {
                <div class="sc-id-plan premium">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                    </svg>

                    PREMIUM PET ID

                </div>
            }
            else
            {
                <div class="sc-id-plan">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                    </svg>

                    DIGITAL PET ID

                </div>
            }

        </header>


        <!-- =====================================================
             MAIN PET IDENTITY
             ===================================================== -->

        <section class="sc-id-main">

            <!-- PET PHOTO -->

            <div class="sc-id-photo-column">

                <div class="sc-id-photo">

                    @if (!string.IsNullOrWhiteSpace(PhotoUrl))
                    {
                        <img src="@PhotoUrl"
                             alt="@Pet.PetName" />
                    }
                    else
                    {
                        <div class="sc-id-photo-placeholder">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#heart-fill"></use>
                            </svg>

                        </div>
                    }

                </div>


                <div class="sc-id-active-status">

                    <span class="sc-id-active-dot"></span>

                    <span>
                        ACTIVE DIGITAL ID
                    </span>

                </div>

            </div>


            <!-- PET DETAILS -->

            <div class="sc-id-pet">

                <span class="sc-id-kicker">
                    REGISTERED PET
                </span>

                <h2>
                    @Display(Pet.PetName)
                </h2>

                <p class="sc-id-pet-subtitle">
                    @Display(Pet.Species)

                    <span>•</span>

                    @Display(Pet.Breed)
                </p>


                <div class="sc-id-data-grid">

                    <div class="sc-id-data-row">

                        <span>Species</span>

                        <strong>
                            @Display(Pet.Species)
                        </strong>

                    </div>


                    <div class="sc-id-data-row">

                        <span>Breed</span>

                        <strong>
                            @Display(Pet.Breed)
                        </strong>

                    </div>


                    <div class="sc-id-data-row">

                        <span>Age</span>

                        <strong>
                            @Display(Pet.Age)
                        </strong>

                    </div>


                    <div class="sc-id-data-row">

                        <span>Weight</span>

                        <strong>
                            @(Pet.WeightKg.HasValue
                                ? $"{Pet.WeightKg.Value:0.##} kg"
                                : "Not provided")
                        </strong>

                    </div>

                </div>

            </div>


            <!-- QR CODE -->

            <div class="sc-id-qr-column">

                <div class="sc-id-qr-frame">

                    @if (!string.IsNullOrWhiteSpace(QrDataUri))
                    {
                        <img src="@QrDataUri"
                             alt="QR code for @Pet.PetName's Digital Pet ID" />
                    }
                    else
                    {
                        <div class="sc-id-qr-placeholder">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code"></use>
                            </svg>

                        </div>
                    }

                </div>


                <strong class="sc-id-scan-title">
                    SCAN PET ID
                </strong>

                <span class="sc-id-scan-copy">
                    Opens public pet identity
                </span>

            </div>

        </section>


        <!-- =====================================================
             OWNER / REGISTRATION
             ===================================================== -->

        <section class="sc-id-registration">

            <!-- OWNER -->

            <div class="sc-id-registration-block sc-id-owner-block">

                <span class="sc-id-label">
                    REGISTERED OWNER
                </span>

                <strong class="sc-id-primary-value">
                    @(PublicMode
                        ? "Registered Pet Owner"
                        : Display(OwnerName))
                </strong>

                <small>
                    Owner-managed ShoppetCare account
                </small>

            </div>


            <div class="sc-id-registration-divider"></div>


            <!-- CONTACT -->

            <div class="sc-id-registration-block">

                <span class="sc-id-label">
                    OWNER CONTACT
                </span>

                @if (CanShowOwnerPhone)
                {
                    <strong class="sc-id-primary-value sc-id-phone">
                        @FormattedOwnerPhone
                    </strong>

                    <small>
                        Emergency / owner contact
                    </small>
                }
                else if (PublicMode)
                {
                    <strong class="sc-id-primary-value">
                        Contact via Pet ID
                    </strong>

                    <small>
                        Mobile number kept private
                    </small>
                }
                else
                {
                    <strong class="sc-id-primary-value">
                        Not provided
                    </strong>

                    <small>
                        Add a mobile number to your account
                    </small>
                }

            </div>


            <div class="sc-id-registration-divider"></div>


            <!-- PET ID -->

            <div class="sc-id-registration-block">

                <span class="sc-id-label">
                    PET ID NUMBER
                </span>

                <strong class="sc-id-primary-value sc-id-mono">
                    @Display(Pet.CardId)
                </strong>

                <small>
                    Unique ShoppetCare identity
                </small>

            </div>


            <div class="sc-id-registration-divider"></div>


            <!-- ISSUE DATE -->

            <div class="sc-id-registration-block">

                <span class="sc-id-label">
                    DATE ISSUED
                </span>

                <strong class="sc-id-primary-value">
                    @IssueDate
                </strong>

                <small>
                    Digital registry
                </small>

            </div>

        </section>


        <!-- =====================================================
             CARE INFORMATION
             ===================================================== -->

        <section class="sc-id-care">

            <div class="sc-id-care-item">

                <span class="sc-id-care-icon">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#shield-check"></use>
                    </svg>

                </span>

                <div>

                    <span class="sc-id-care-label">
                        Vaccination
                    </span>

                    <strong>
                        @Display(VaccinationStatus)
                    </strong>

                </div>

            </div>


            <div class="sc-id-care-item">

                <span class="sc-id-care-icon">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#clipboard2-pulse"></use>
                    </svg>

                </span>

                <div>

                    <span class="sc-id-care-label">
                        Health Records
                    </span>

                    <strong>
                        @HealthRecordCount
                        @(HealthRecordCount == 1
                            ? "Record"
                            : "Records")
                    </strong>

                </div>

            </div>


            <div class="sc-id-care-item sc-id-care-diet">

                <span class="sc-id-care-icon">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#heart-pulse"></use>
                    </svg>

                </span>

                <div>

                    <span class="sc-id-care-label">
                        Usual Diet / Care Profile
                    </span>

                    <strong>
                        @Display(Pet.Diet)
                    </strong>

                </div>

            </div>

        </section>


        <!-- =====================================================
             OFFICIAL CARD FOOTER
             ===================================================== -->

        <footer class="sc-id-footer">

            <div class="sc-id-footer-status">

                <span></span>

                <strong>
                    ACTIVE DIGITAL PET ID
                </strong>

            </div>


            <div class="sc-id-website">

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#globe2"></use>
                </svg>

                <strong>
                    shoppetcare.com
                </strong>

            </div>


            <div class="sc-id-footer-verify">

                <svg aria-hidden="true">
                    <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                </svg>

                <span>
                    Scan QR to verify
                </span>

            </div>

        </footer>

    </article>
}


<style>

    /* =========================================================
       BASE CARD
       ========================================================= */

    .sc-pet-id,
    .sc-pet-id *,
    .sc-pet-id *::before,
    .sc-pet-id *::after {
        box-sizing: border-box;
    }


    .sc-pet-id {
        --id-accent: #F3D27A;
        --id-accent-text: #FFE99E;

        position: relative;

        width: 100%;
        min-height: 520px;

        display: flex;
        flex-direction: column;

        overflow: hidden;

        border: 1px solid rgba(255,255,255,.18);
        border-radius: 23px;

        color: #FFFFFF;

        background:
            radial-gradient(
                circle at 91% 8%,
                rgba(255,255,255,.18),
                transparent 24%
            ),
            linear-gradient(
                135deg,
                #183E3E 0%,
                #235E5D 55%,
                #2A7779 100%
            );

        box-shadow:
            0 24px 55px
            rgba(23,61,61,.18);
    }


    .sc-pet-id::before {
        content: "";

        position: absolute;

        width: 370px;
        height: 370px;

        right: -160px;
        top: -210px;

        border: 1px solid
            rgba(255,255,255,.07);

        border-radius: 50%;

        pointer-events: none;
    }


    .sc-pet-id::after {
        content: "";

        position: absolute;

        width: 250px;
        height: 250px;

        right: -95px;
        top: -145px;

        border: 1px solid
            rgba(255,255,255,.055);

        border-radius: 50%;

        pointer-events: none;
    }


    .sc-pet-id svg {
        width: 1em;
        height: 1em;

        fill: currentColor;
    }


    /* =========================================================
       THEMES
       ========================================================= */

    .sc-pet-id.theme-classic {
        background:
            radial-gradient(
                circle at 91% 8%,
                rgba(255,255,255,.16),
                transparent 24%
            ),
            linear-gradient(
                135deg,
                #173D3D,
                #276C6D
            );
    }


    .sc-pet-id.theme-ocean {
        background:
            radial-gradient(
                circle at 91% 8%,
                rgba(255,255,255,.18),
                transparent 24%
            ),
            linear-gradient(
                135deg,
                #17344C,
                #1F647D
            );
    }


    .sc-pet-id.theme-sunset {
        background:
            radial-gradient(
                circle at 91% 8%,
                rgba(255,255,255,.16),
                transparent 24%
            ),
            linear-gradient(
                135deg,
                #5E3835,
                #A25F51
            );
    }


    .sc-pet-id.theme-mint {
        background:
            radial-gradient(
                circle at 91% 8%,
                rgba(255,255,255,.17),
                transparent 24%
            ),
            linear-gradient(
                135deg,
                #284A40,
                #4F7968
            );
    }


    .sc-pet-id.theme-royal {
        background:
            radial-gradient(
                circle at 88% 6%,
                rgba(255,255,255,.22),
                transparent 24%
            ),
            linear-gradient(
                135deg,
                #292244 0%,
                #3B315E 55%,
                #514274 100%
            );
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .sc-id-header {
        position: relative;
        z-index: 2;

        min-height: 76px;

        padding: 17px 26px;

        display: grid;

        grid-template-columns:
            minmax(210px,1fr)
            auto
            minmax(180px,1fr);

        align-items: center;

        gap: 18px;

        border-bottom:
            1px solid
            rgba(255,255,255,.13);
    }


    .sc-id-brand {
        display: flex;
        align-items: center;

        gap: 11px;
    }


    .sc-id-logo {
        width: 42px;
        height: 42px;

        padding: 4px;

        display: grid;
        place-items: center;

        overflow: hidden;

        border-radius: 11px;

        background: #FFFFFF;
    }


    .sc-id-logo img {
        width: 100%;
        height: 100%;

        object-fit: contain;
    }


    .sc-id-brand-copy {
        min-width: 0;

        display: flex;
        flex-direction: column;
    }


    .sc-id-brand-copy strong {
        font-size: 1rem;
        font-weight: 950;

        letter-spacing: -.025em;
    }


    .sc-id-brand-copy span {
        margin-top: 1px;

        color:
            rgba(255,255,255,.54);

        font-size: .45rem;
        font-weight: 900;

        letter-spacing: .11em;

        text-transform: uppercase;
    }


    .sc-id-title {
        text-align: center;
    }


    .sc-id-title span,
    .sc-id-title strong {
        display: block;
    }


    .sc-id-title span {
        color: var(--id-accent);

        font-size: .42rem;
        font-weight: 950;

        letter-spacing: .19em;
    }


    .sc-id-title strong {
        margin-top: 3px;

        color: #FFFFFF;

        font-size: .55rem;
        font-weight: 950;

        letter-spacing: .12em;
    }


    .sc-id-plan {
        justify-self: end;

        min-height: 31px;

        padding: 0 11px;

        display: inline-flex;
        align-items: center;

        gap: 6px;

        border:
            1px solid
            rgba(255,255,255,.2);

        border-radius: 999px;

        background:
            rgba(255,255,255,.08);

        color:
            rgba(255,255,255,.82);

        font-size: .46rem;
        font-weight: 950;

        letter-spacing: .07em;
    }


    .sc-id-plan.premium {
        border-color:
            rgba(243,210,122,.58);

        background:
            rgba(243,210,122,.12);

        color:
            #FFE18A;
    }


    /* =========================================================
       MAIN PET
       ========================================================= */

    .sc-id-main {
        position: relative;
        z-index: 1;

        padding: 26px 30px;

        display: grid;

        grid-template-columns:
            155px
            minmax(0,1fr)
            155px;

        align-items: center;

        gap: 28px;
    }


    /* PHOTO */

    .sc-id-photo-column {
        min-width: 0;
    }


    .sc-id-photo {
        width: 145px;

        aspect-ratio: 1;

        overflow: hidden;

        border:
            4px solid
            rgba(255,255,255,.96);

        border-radius: 50%;

        background:
            rgba(255,255,255,.12);

        box-shadow:
            0 14px 32px
            rgba(0,0,0,.17);
    }


    .sc-id-photo img {
        width: 100%;
        height: 100%;

        object-fit: cover;
    }


    .sc-id-photo-placeholder {
        width: 100%;
        height: 100%;

        display: grid;
        place-items: center;

        color: var(--id-accent);

        font-size: 2rem;
    }


    .sc-id-active-status {
        margin-top: 10px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 6px;

        color: #FFE28D;

        font-size: .44rem;
        font-weight: 950;

        letter-spacing: .04em;
    }


    .sc-id-active-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #F3D27A;

        box-shadow:
            0 0 0 3px
            rgba(243,210,122,.13);
    }


    /* PET INFO */

    .sc-id-kicker {
        color: var(--id-accent);

        font-size: .45rem;
        font-weight: 950;

        letter-spacing: .15em;
    }


    .sc-id-pet h2 {
        margin: 5px 0 0;

        color: #FFFFFF;

        font-size:
            clamp(2.15rem,3.4vw,3.55rem);

        line-height: .94;

        font-weight: 950;

        letter-spacing: -.055em;
    }


    .sc-id-pet-subtitle {
        margin: 7px 0 0;

        color:
            rgba(255,255,255,.8);

        font-size: .67rem;
        font-weight: 800;
    }


    .sc-id-pet-subtitle span {
        margin: 0 5px;

        color: var(--id-accent);
    }


    .sc-id-data-grid {
        margin-top: 18px;

        display: grid;

        grid-template-columns:
            repeat(2,minmax(0,1fr));

        column-gap: 24px;
        row-gap: 1px;
    }


    .sc-id-data-row {
        min-width: 0;

        padding: 8px 0;

        display: grid;

        grid-template-columns:
            61px
            minmax(0,1fr);

        align-items: center;

        gap: 8px;

        border-bottom:
            1px solid
            rgba(255,255,255,.11);
    }


    .sc-id-data-row span {
        color:
            rgba(255,255,255,.47);

        font-size: .43rem;
        font-weight: 900;

        text-transform: uppercase;

        letter-spacing: .06em;
    }


    .sc-id-data-row strong {
        overflow: hidden;

        color: #FFFFFF;

        font-size: .6rem;
        font-weight: 850;

        white-space: nowrap;

        text-overflow: ellipsis;
    }


    /* QR */

    .sc-id-qr-column {
        text-align: center;
    }


    .sc-id-qr-frame {
        width: 137px;

        aspect-ratio: 1;

        margin: 0 auto;

        padding: 10px;

        display: grid;
        place-items: center;

        border:
            2px solid
            rgba(243,210,122,.8);

        border-radius: 15px;

        background: #FFFFFF;

        box-shadow:
            0 15px 30px
            rgba(0,0,0,.16);
    }


    .sc-id-qr-frame img {
        width: 100%;
        height: 100%;

        object-fit: contain;
    }


    .sc-id-qr-placeholder {
        color: #173D3D;

        font-size: 4rem;
    }


    .sc-id-scan-title {
        display: block;

        margin-top: 8px;

        color: #FFFFFF;

        font-size: .45rem;
        font-weight: 950;

        letter-spacing: .11em;
    }


    .sc-id-scan-copy {
        display: block;

        margin-top: 2px;

        color:
            rgba(255,255,255,.44);

        font-size: .4rem;
    }


    /* =========================================================
       OWNER / REGISTRATION
       ========================================================= */

    .sc-id-registration {
        margin: 0 30px;

        padding: 14px 0;

        display: grid;

        grid-template-columns:
            minmax(0,1.35fr)
            1px
            minmax(0,1fr)
            1px
            minmax(0,1fr)
            1px
            minmax(0,.8fr);

        align-items: center;

        gap: 17px;

        border-top:
            1px solid
            rgba(255,255,255,.14);

        border-bottom:
            1px solid
            rgba(255,255,255,.14);
    }


    .sc-id-registration-block {
        min-width: 0;
    }


    .sc-id-label {
        display: block;

        color:
            rgba(255,255,255,.44);

        font-size: .4rem;
        font-weight: 950;

        letter-spacing: .1em;

        text-transform: uppercase;
    }


    .sc-id-primary-value {
        display: block;

        margin-top: 4px;

        overflow: hidden;

        color: #FFFFFF;

        font-size: .59rem;
        font-weight: 900;

        white-space: nowrap;

        text-overflow: ellipsis;
    }


    .sc-id-registration-block small {
        display: block;

        margin-top: 2px;

        overflow: hidden;

        color:
            rgba(255,255,255,.4);

        font-size: .38rem;

        white-space: nowrap;

        text-overflow: ellipsis;
    }


    .sc-id-phone {
        color: #FFE69A;
    }


    .sc-id-mono {
        font-family:
            Consolas,
            "Courier New",
            monospace;

        letter-spacing: .045em;
    }


    .sc-id-registration-divider {
        width: 1px;
        height: 34px;

        background:
            rgba(255,255,255,.14);
    }


    /* =========================================================
       CARE STRIP
       ========================================================= */

    .sc-id-care {
        margin: 12px 30px 0;

        display: grid;

        grid-template-columns:
            .8fr
            .8fr
            1.4fr;

        gap: 8px;
    }


    .sc-id-care-item {
        min-width: 0;
        min-height: 54px;

        padding: 9px 11px;

        display: flex;
        align-items: center;

        gap: 9px;

        border:
            1px solid
            rgba(255,255,255,.1);

        border-radius: 10px;

        background:
            rgba(255,255,255,.07);
    }


    .sc-id-care-icon {
        width: 30px;
        height: 30px;

        flex: 0 0 30px;

        display: grid;
        place-items: center;

        border-radius: 8px;

        background:
            rgba(243,210,122,.12);

        color: var(--id-accent);

        font-size: .72rem;
    }


    .sc-id-care-item > div {
        min-width: 0;
    }


    .sc-id-care-label {
        display: block;

        color:
            rgba(255,255,255,.44);

        font-size: .39rem;
        font-weight: 850;

        text-transform: uppercase;

        letter-spacing: .045em;
    }


    .sc-id-care-item strong {
        display: block;

        margin-top: 2px;

        overflow: hidden;

        color: #FFFFFF;

        font-size: .54rem;
        font-weight: 850;

        white-space: nowrap;

        text-overflow: ellipsis;
    }


    /* =========================================================
       OFFICIAL FOOTER
       ========================================================= */

    .sc-id-footer {
        min-height: 48px;

        margin-top: auto;

        padding: 0 30px;

        display: grid;

        grid-template-columns:
            minmax(0,1fr)
            auto
            minmax(0,1fr);

        align-items: center;

        gap: 18px;

        border-top:
            1px solid
            rgba(255,255,255,.1);

        background:
            rgba(0,0,0,.1);
    }


    .sc-id-footer-status {
        display: flex;
        align-items: center;

        gap: 6px;
    }


    .sc-id-footer-status > span {
        width: 6px;
        height: 6px;

        border-radius: 50%;

        background: var(--id-accent);
    }


    .sc-id-footer-status strong {
        color:
            rgba(255,255,255,.74);

        font-size: .4rem;
        font-weight: 950;

        letter-spacing: .07em;
    }


    .sc-id-website {
        display: flex;
        align-items: center;

        gap: 6px;

        color: #FFFFFF;
    }


    .sc-id-website svg {
        color: var(--id-accent);

        font-size: .65rem;
    }


    .sc-id-website strong {
        font-size: .56rem;
        font-weight: 900;

        letter-spacing: .025em;
    }


    .sc-id-footer-verify {
        justify-self: end;

        display: flex;
        align-items: center;

        gap: 5px;

        color:
            rgba(255,255,255,.48);

        font-size: .4rem;
        font-weight: 700;
    }


    .sc-id-footer-verify svg {
        color: var(--id-accent);
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 850px) {

        .sc-id-header {
            grid-template-columns:
                1fr
                auto;
        }


        .sc-id-title {
            display: none;
        }


        .sc-id-main {
            grid-template-columns:
                130px
                minmax(0,1fr)
