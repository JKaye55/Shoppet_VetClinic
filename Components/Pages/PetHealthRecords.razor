@code {

    [Parameter]
    public int PetId { get; set; }


    private PetProfile? pet;

    private List<PetHealthRecord> records =
        new();


    private bool isPremium;

    private bool showForm;

    private int? editingId;


    private string formRecordType =
        "Checkup";

    private string formTitle =
        string.Empty;

    private string formNotes =
        string.Empty;

    private string formVetName =
        string.Empty;

  private DateTime formRecordDate =
    DateTime.Today;

private DateTime? formNextDueDate;


    private string message =
        string.Empty;

    private bool isError;


    private bool CanAddRecord =>
        isPremium ||
        records.Count < 5;


    private int FreeUsagePercent =>
        Math.Min(
            100,
            (int)Math.Round(
                records.Count / 5.0 * 100));


    protected override async Task OnParametersSetAsync()
    {
        await Auth.InitializeAsync();


        var userId =
            Auth.CurrentUser?.Id ?? 0;


        pet =
            Db.GetPetById(
                PetId);


        if (pet is null ||
            pet.UserId != userId)
        {
            pet =
                null;

            return;
        }


        isPremium =
            Auth.IsPremium;


        LoadRecords();
    }


    private void LoadRecords()
    {
        records =
            Db.GetHealthRecords(
                PetId)
            ??
            new List<PetHealthRecord>();
    }


    private void OpenAddForm()
    {
        if (!CanAddRecord)
        {
            ShowError(
                "Your Free plan has reached its 5-record limit.");

            return;
        }


        ResetForm();

        showForm =
            true;
    }


    private void EditRecord(
        PetHealthRecord record)
    {
        editingId =
            record.Id;


        formRecordType =
            record.RecordType;


        formTitle =
            record.Title;


        formNotes =
            record.Notes;


        formVetName =
            record.VetName;


        formRecordDate =
     record.RecordDate;


        formNextDueDate =
            record.NextDueDate;

        showForm =
            true;


        message =
            string.Empty;
    }


    private void SaveRecord()
    {
        if (pet is null ||
            Auth.CurrentUser is null)
        {
            return;
        }


        formTitle =
            formTitle.Trim();


        if (string.IsNullOrWhiteSpace(
            formTitle))
        {
            ShowError(
                "Please enter a title for the health record.");

            return;
        }


        try
        {
            // =====================================================
            // UPDATE EXISTING RECORD
            // =====================================================

            if (editingId.HasValue)
            {
                var record =
                    new PetHealthRecord
                    {
                        Id =
                            editingId.Value,

                        PetId =
                            pet.Id,

                        RecordType =
                            formRecordType,

                        Title =
                            formTitle,

                        Notes =
                            formNotes.Trim(),

                        RecordDate =
                            formRecordDate,

                        NextDueDate =
                            formNextDueDate,

                        VetName =
                            formVetName.Trim()
                    };


                var updated =
                    Db.UpdateHealthRecord(
                        record,
                        Auth.CurrentUser.Id);


                if (!updated)
                {
                    ShowError(
                        "The health record could not be updated.");

                    return;
                }


                ShowSuccess(
                    "Health record updated.");
            }

            // =====================================================
            // CREATE NEW RECORD
            // =====================================================

            else
            {
                if (!CanAddRecord)
                {
                    ShowError(
                        "Your Free plan has reached its 5-record limit.");

                    return;
                }


                var record =
                    new PetHealthRecord
                    {
                        PetId =
                            pet.Id,

                        RecordType =
                            formRecordType,

                        Title =
                            formTitle,

                        Notes =
                            formNotes.Trim(),

                        RecordDate =
                            formRecordDate,

                        NextDueDate =
                            formNextDueDate,

                        VetName =
                            formVetName.Trim()
                    };


                Db.AddHealthRecord(
                    record);


                ShowSuccess(
                    "Health record added.");
            }


            showForm =
                false;


            ResetForm();


            LoadRecords();
        }
        catch (InvalidOperationException ex)
        {
            ShowError(
                ex.Message);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Health Record] {ex}");


            ShowError(
                "The health record could not be saved.");
        }
    }

    private void DeleteRecord(
        PetHealthRecord record)
    {
        if (Auth.CurrentUser is null)
            return;


        try
        {
            var deleted =
                Db.DeleteHealthRecordForOwner(
                    record.Id,
                    PetId,
                    Auth.CurrentUser.Id);


            if (!deleted)
            {
                ShowError(
                    "The health record could not be deleted.");

                return;
            }


            ShowSuccess(
                "Health record deleted.");


            LoadRecords();
        }
        catch
        {
            ShowError(
                "The health record could not be deleted.");
        }
    }


    private void CloseForm()
    {
        showForm =
            false;


        ResetForm();
    }


    private void ResetForm()
    {
        editingId =
            null;


        formRecordType =
            "Checkup";


        formTitle =
            string.Empty;


        formNotes =
            string.Empty;


        formVetName =
            string.Empty;


        formRecordDate =
            DateTime.Today;


        formNextDueDate =
            null;
    }

    private string GetRecordIcon(
        string recordType)
    {
        return recordType switch
        {
            "Vaccination" =>
                "bi bi-shield-check",

            "Medication" =>
                "bi bi-capsule",

            "Surgery" =>
                "bi bi-hospital",

            "Deworming" =>
                "bi bi-shield-plus",

            _ =>
                "bi bi-clipboard2-pulse"
        };
    }


    private string GetDueClass(
        PetHealthRecord record)
    {
        return record.IsOverdue
            ? "sc-record-due overdue"
            : "sc-record-due";
    }


    private void ShowSuccess(
        string text)
    {
        message =
            text;

        isError =
            false;
    }


    private void ShowError(
        string text)
    {
        message =
            text;

        isError =
            true;
    }
}