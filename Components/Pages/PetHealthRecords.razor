@page "/pet/{PetId:int}/records"
@rendermode InteractiveServer

@inject AuthService Auth
@inject DatabaseService Db
@inject NavigationManager Nav

<PageTitle>@(pet?.PetName ?? "Pet") Health Records | ShoppetCare</PageTitle>


<div class="sc-records-page">

    @if (pet is null)
    {
        <div class="sc-records-shell">

            <div class="sc-record-error">

                <h2>
                    Pet not found
                </h2>

                <p>
                    This pet does not exist or you do not have
                    permission to view its records.
                </p>

                <a href="/my-pets">
                    Back to My Pets
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- =====================================================
             HERO
             ===================================================== -->

        <section class="sc-records-hero">

            <div class="sc-records-shell sc-records-hero-inner">

                <div>

                    <span class="sc-records-kicker">
                        HEALTH RECORDS
                    </span>

                    <h1>
                        @pet.PetName's health history
                    </h1>

                    <p>
                        Keep vaccinations, checkups, medications,
                        and other important pet-care records organized.
                    </p>

                </div>


                <div class="sc-records-hero-actions">

                    <a href="/pet/@PetId"
                       class="secondary">

                        Pet Details

                    </a>

                    <a href="/pet/@PetId/card"
                       class="secondary">

                        Pet ID

                    </a>

                    <a href="/my-pets"
                       class="secondary">

                        My Pets

                    </a>

                </div>

            </div>

        </section>


        <main class="sc-records-shell sc-records-content">

            <!-- =================================================
                 STATUS
                 ================================================= -->
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="@(isError
                                        ? "sc-record-message error"
                                        : "sc-record-message success")">

                    @message

                </div>
            }


            <!-- =================================================
                 PLAN STATUS
                 ================================================= -->

            <section class="sc-record-plan">

                <div>

                    @if (isPremium)
                    {
                        <span class="premium">
                            PREMIUM · UNLIMITED
                        </span>

                        <strong>
                            Unlimited health history
                        </strong>

                        <p>
                            Your Premium plan allows unlimited
                            health records for this pet.
                        </p>
                    }
                    else
                    {
                        <span>
                            FREE PLAN
                        </span>

                        <strong>
                            @records.Count of 5 records used
                        </strong>

                        <p>
                            You can add up to five records for this pet.
                            Existing records can always be edited or deleted.
                        </p>

                        <div class="sc-record-progress">

                            <div style="@($"width:{FreeUsagePercent}%")">
                            </div>

                        </div>
                    }

                </div>


                @if (CanAddRecord)
                {
                    <button type="button"
                            class="sc-record-add"
                            @onclick="OpenAddForm">

                        + Add Health Record

                    </button>
                }
                else
                {
                    <a href="/premium"
                       class="sc-record-upgrade">

                        Upgrade for Unlimited Records

                    </a>
                }

            </section>


            <!-- =================================================
                 FORM
                 ================================================= -->
            @if (showForm)
            {
                <section class="sc-record-form">

                    <div class="sc-record-form-head">

                        <div>

                            <span class="sc-records-kicker dark">
                                @(editingId.HasValue
                                    ? "EDIT RECORD"
                                    : "NEW HEALTH RECORD")
                            </span>

                            <h2>
                                @(editingId.HasValue
                                    ? "Update health record"
                                    : "Add health record")
                            </h2>

                        </div>


                        <button type="button"
                                class="close"
                                @onclick="CloseForm">

                            ×

                        </button>

                    </div>


                    <div class="sc-record-form-grid">

                        <div class="field">

                            <label>
                                Record Type *
                            </label>

                            <select @bind="formRecordType">

                                <option value="Checkup">
                                    Checkup
                                </option>

                                <option value="Vaccination">
                                    Vaccination
                                </option>

                                <option value="Deworming">
                                    Deworming
                                </option>

                                <option value="Medication">
                                    Medication
                                </option>

                                <option value="Surgery">
                                    Surgery
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>


                        <div class="field">

                            <label>
                                Record Date *
                            </label>

                            <input type="date"
                                   @bind="formRecordDate" />

                        </div>


                        <div class="field wide">

                            <label>
                                Title *
                            </label>

                            <input type="text"
                                   maxlength="150"
                                   @bind="formTitle"
                                   placeholder="Example: Annual Anti-Rabies Vaccination" />

                        </div>


                        <div class="field">

                            <label>
                                Veterinarian
                            </label>

                            <input type="text"
                                   maxlength="100"
                                   @bind="formVetName"
                                   placeholder="Example: Dr. Maria Santos" />

                        </div>


                        <div class="field">

                            <label>
                                Next Due Date
                            </label>

                            <input type="date"
                                   @bind="formNextDueDate" />

                        </div>


                        <div class="field wide">

                            <label>
                                Notes
                            </label>

                            <textarea rows="4"
                                      @bind="formNotes"
                                      placeholder="Optional details about the visit, treatment, vaccine, or medication.">
                            </textarea>

                        </div>

                    </div>


                    <div class="sc-record-form-actions">

                        <button type="button"
                                class="save"
                                @onclick="SaveRecord">

                            @(editingId.HasValue
                                ? "Save Changes"
                                : "Add Record")

                        </button>

                        <button type="button"
                                class="cancel"
                                @onclick="CloseForm">

                            Cancel

                        </button>

                    </div>

                </section>
            }


            <!-- =================================================
                 FREE LIMIT CTA
                 ================================================= -->
            @if (!isPremium &&
                             records.Count >= 5)
            {
                <section class="sc-record-limit">

                    <div>

                        <span>
                            RECORD LIMIT REACHED
                        </span>

                        <h3>
                            Your five free records are safe.
                        </h3>

                        <p>
                            You can continue viewing, editing,
                            and deleting them. Upgrade if you need
                            to store additional health history.
                        </p>

                    </div>

                    <a href="/premium">
                        Upgrade for ₱49 Lifetime
                    </a>

                </section>
            }


            <!-- =================================================
                 RECORD LIST
                 ================================================= -->

            <div class="sc-record-heading">

                <div>

                    <span class="sc-records-kicker dark">
                        HISTORY
                    </span>

                    <h2>
                        Health Records
                    </h2>

                </div>

                <span>
                    @records.Count
                    @(records.Count == 1
                        ? "record"
                        : "records")
                </span>

            </div>


            @if (records.Count == 0)
            {
                <div class="sc-record-empty">

                    <div>
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>

                    <h3>
                        No health records yet.
                    </h3>

                    <p>
                        Add @pet.PetName's first checkup,
                        vaccination, medication, or other
                        important health record.
                    </p>

                </div>
            }
            else
            {
                <div class="sc-record-list">

                    @foreach (var record in records)
                    {
                        <article class="sc-record-card">

                            <div class="sc-record-icon">

                                <i class="@GetRecordIcon(record.RecordType)">
                                </i>

                            </div>


                            <div class="sc-record-main">

                                <div class="sc-record-meta">

                                    <span>
                                        @record.RecordType
                                    </span>

                                    <time>
                                        @record.RecordDate.ToString("MMM d, yyyy")
                                    </time>

                                </div>


                                <h3>
                                    @record.Title
                                </h3>


                                @if (!string.IsNullOrWhiteSpace(
                                    record.VetName))
                                {
                                    <p>
                                        Veterinarian:
                                        <strong>
                                            @record.VetName
                                        </strong>
                                    </p>
                                }


                                @if (!string.IsNullOrWhiteSpace(
                                    record.Notes))
                                {
                                    <p>
                                        @record.Notes
                                    </p>
                                }


                                @if (record.NextDueDate.HasValue)
                                {
                                    <div class="@GetDueClass(record)">

                                        <i class="bi bi-calendar-event"></i>

                                        Next due:
                                        @record.NextDueDate.Value.ToString("MMM d, yyyy")

                                    </div>
                                }

                            </div>


                            <div class="sc-record-actions">

                                <button type="button"
                                        @onclick="() => EditRecord(record)">

                                    Edit

                                </button>

                                <button type="button"
                                        class="delete"
                                        @onclick="() => DeleteRecord(record)">

                                    Delete

                                </button>

                            </div>

                        </article>
                    }

                </div>
            }

        </main>
    }

</div>


<style>

