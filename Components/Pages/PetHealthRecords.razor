@page "/pet/{PetId:int}/records"
@rendermode InteractiveServer
@inject AuthService Auth
@inject DatabaseService Db
@inject PetCareService Care
@inject FileStorageService Files
<PageTitle>Pet care records | ShoppetCare</PageTitle>
<main class="owner-shell"><header class="owner-header"><span class="owner-eyebrow">CONNECTED PET CARE</span><h1>@(pet?.PetName??"Your pet")'s care journal.</h1><p>Vaccinations, medication, feeding routines, and progress — shared with Mobile.</p>@if(pet is not null){<a class="owner-button" href="@($"/pet/{PetId}/card")">Digital Pet ID</a>}</header>
@if(!ready){<p>Loading care records…</p>}else if(pet is null){<p>This pet is unavailable for your account.</p><a href="/my-pets">My pets</a>}else {
@if(message.Length>0){<p class="owner-notice" role="status">@message</p>}
<div class="owner-grid"><section class="owner-card"><h2>@(health.Id==0?"Add a health record":"Edit health record")</h2><label>Record type<select @bind="health.Type"><option value="vital">Checkup / vital</option><option value="vaccine">Vaccination</option><option value="medication">Medication</option><option value="Other">Other</option></select></label><label>Record title<input @bind="health.Title" maxlength="150" /></label><div class="owner-grid"><label>Record date<input type="datetime-local" @bind="health.RecordDate" @bind:format="yyyy-MM-ddTHH:mm" /></label><label>Next due date<input type="datetime-local" @bind="health.DueDate" @bind:format="yyyy-MM-ddTHH:mm" /></label></div><label>Veterinarian name<input @bind="health.VetName" maxlength="150" /></label><label>Notes<textarea @bind="health.Notes" maxlength="1000"></textarea></label>
@if(IsVaccine(health.Type)){<label>Date administered<input type="date" @bind="health.DateAdministered" /></label><div class="owner-grid"><label>Validity interval<input type="number" min="0" @bind="health.ValidityInterval" /></label><label>Unit<select @bind="health.ValidityUnit"><option>Days</option><option>Weeks</option><option>Months</option><option>Years</option></select></label></div>}
@if(IsMedication(health.Type)){<label>Time started<input type="datetime-local" @bind="health.TimeStarted" @bind:format="yyyy-MM-ddTHH:mm" /></label><div class="owner-grid"><label>Hours between doses<input type="number" min="0" step="0.5" @bind="health.MedicationIntervalHours" /></label><label>Total doses<input type="number" min="0" @bind="health.DosageTotal" /></label><label>Doses remaining<input type="number" min="0" @bind="health.DosageRemaining" /></label></div>}
<label>Checkup date<input type="date" @bind="health.CheckupDate" /></label><label>Care documents<InputFile OnChange="UploadDocuments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" /></label><small>PDF and images, up to five files of 10 MB each.</small><label>Attachment URLs, separated with |<textarea @bind="health.DocumentPaths"></textarea></label><label class="owner-check"><input type="checkbox" @bind="health.Completed" /> Completed</label><div class="owner-actions"><button @onclick="SaveHealth" disabled="@uploading">Save health record</button><button class="secondary" @onclick="()=>health=new()">Clear</button></div></section>
<section class="owner-card"><h2>Health history <small>(@records.Count)</small></h2>@if(records.Count==0){<p>Add the first care record for your pet.</p>}@foreach(var x in records){<article class="owner-row"><div><strong>@x.Title</strong><p>@x.Type · @x.RecordDate.ToString("MMM d, yyyy")</p><small>@(x.Completed?"Completed":x.DueDate.HasValue?$"Due {x.DueDate:MMM d, yyyy h:mm tt}":"No due date")</small>@if(IsMedication(x.Type)){<p>@(x.DosageTotal-x.DosageRemaining) / @x.DosageTotal doses taken</p>}<p>@x.Notes</p>@foreach(var url in Links(x.DocumentPaths)){<a href="@url" target="_blank" rel="noopener noreferrer">Care document</a><br />}</div><div class="owner-actions"><button class="secondary" @onclick="()=>health=Clone(x)">Edit</button>@if(IsMedication(x.Type)&&x.DosageRemaining>0&&!x.Completed){<button class="secondary" @onclick="()=>Run(()=>Care.Dose(PetId,x.Id))">Dose taken</button>}<button class="secondary" @onclick="()=>Run(()=>{x.Completed=!x.Completed;Care.SaveHealth(PetId,x);})">@(x.Completed?"Reopen":"Complete")</button><button class="secondary" @onclick="()=>Run(()=>Care.DeleteHealth(PetId,x.Id))">Delete</button></div></article>}</section></div>
<div class="owner-grid"><section class="owner-card"><h2>@(food.Id==0?"Add feeding routine":"Edit feeding routine")</h2><label>Food name<input @bind="food.Name" maxlength="150" /></label><div class="owner-grid"><label>Amount (grams)<input type="number" min="0" @bind="food.Grams" /></label><label>Started at<input type="datetime-local" @bind="food.StartedAt" @bind:format="yyyy-MM-ddTHH:mm" /></label><label>Interval hours<input type="number" min="0" @bind="food.Hours" /></label><label>Interval minutes<input type="number" min="0" max="59" @bind="food.Minutes" /></label></div><label>Notes<textarea @bind="food.Notes" maxlength="1000"></textarea></label><label class="owner-check"><input type="checkbox" @bind="food.Completed" /> Routine completed</label><div class="owner-actions"><button @onclick="SaveFood">Save feeding routine</button><button class="secondary" @onclick="()=>food=new()">Clear</button></div></section><section class="owner-card"><h2>Feeding routines</h2>@if(foods.Count==0){<p>Your pet's routines will appear here.</p>}@foreach(var x in foods){<article class="owner-row"><div><strong>@x.Name</strong><p>@x.Grams g · Every @x.Hours h @x.Minutes min</p><small>Last fed: @(x.LastFedAt?.ToString("MMM d h:mm tt")??"Not yet") · @(x.Completed?"Completed":"Active")</small><p>@x.Notes</p></div><div class="owner-actions"><button class="secondary" @onclick="()=>food=Clone(x)">Edit</button><button class="secondary" @onclick="()=>Run(()=>Care.Fed(PetId,x.Id))">Fed now</button><button class="secondary" @onclick="()=>Run(()=>Care.DeleteFood(PetId,x.Id))">Delete</button></div></article>}</section></div>
<a class="owner-button" href="/account/care">Emergency contacts &amp; vet reminders</a>
}</main>
@code {
 [Parameter]public int PetId{get;set;}
 bool ready,uploading;string message="";Shoppet_VetClinic.Models.PetProfile? pet;CareHealth health=new();CareFood food=new();List<CareHealth> records=new();List<CareFood> foods=new();
 protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();if(Auth.IsPetOwner)try{pet=Db.GetPetById(PetId);if(pet?.UserId!=Auth.CurrentUser?.Id)pet=null;if(pet is not null)Reload();}catch(Exception){message="Could not load shared care data. Check the database connection.";}ready=true;StateHasChanged();}
 void Reload(){records=Care.Health(PetId);foods=Care.Food(PetId);}
 void Run(Action a){try{a();Reload();message="Saved. Your care journal is shared with Mobile.";}catch(Exception ex){message=ex is ArgumentException?ex.Message:"Could not save. Check the database connection and try again.";}}
 void SaveHealth()=>Run(()=>{if(health.Id==0&&IsMedication(health.Type)&&health.DosageRemaining==0)health.DosageRemaining=health.DosageTotal;Care.SaveHealth(PetId,health);health=new();});void SaveFood()=>Run(()=>{Care.SaveFood(PetId,food);food=new();});
 static bool IsMedication(string t)=>t.Contains("med",StringComparison.OrdinalIgnoreCase);static bool IsVaccine(string t)=>t.Contains("vacc",StringComparison.OrdinalIgnoreCase);
 static T Clone<T>(T x)=>System.Text.Json.JsonSerializer.Deserialize<T>(System.Text.Json.JsonSerializer.Serialize(x))!;
 static IEnumerable<string> Links(string value)=>value.Split(new[]{'|',';'},StringSplitOptions.RemoveEmptyEntries).Where(u=>Uri.TryCreate(u,UriKind.Absolute,out var parsed)&&parsed.Scheme is "https" or "http");
 async Task UploadDocuments(InputFileChangeEventArgs e){uploading=true;try{var saved=new List<string>();foreach(var f in e.GetMultipleFiles(5)){var ext=Path.GetExtension(f.Name).ToLowerInvariant();if(!new[]{".pdf",".jpg",".jpeg",".png",".webp"}.Contains(ext))throw new ArgumentException("Choose PDF or image files.");var name=Guid.NewGuid().ToString("N")+ext;var folder=Path.Combine(Directory.GetCurrentDirectory(),"wwwroot","uploads","documents");Directory.CreateDirectory(folder);await using var target=File.Create(Path.Combine(folder,name));await f.OpenReadStream(10*1024*1024).CopyToAsync(target);saved.Add("/uploads/documents/"+name);}var origin=new Uri(new Uri(Files.PublicBaseUrl),"/");health.DocumentPaths=string.Join("|",Links(health.DocumentPaths).Concat(saved.Select(p=>new Uri(origin,p).AbsoluteUri)));message="Documents attached. Save the health record to keep them.";}catch(Exception ex){message=ex is ArgumentException?ex.Message:"Could not attach documents. Check file sizes and try again.";}finally{uploading=false;}}
}
