@page "/pet/{PetId:int}/records"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject DatabaseService Db
@inject AuthService Auth

<PageTitle>@(pet?.PetName ?? "Pet") Care Summary | ShoppetCare</PageTitle>

<div class="care-page">
    @if (!ready)
    {
        <div class="care-state">Loading connected care records...</div>
    }
    else if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
    {
        <main class="care-shell"><section class="care-panel centered"><h1>Sign in required.</h1><a class="primary-link" href="/login">Sign In</a></section></main>
    }
    else if (pet is null || pet.UserId != Auth.CurrentUser.Id)
    {
        <main class="care-shell"><section class="care-panel centered"><h1>Pet record not found.</h1><a class="primary-link" href="/my-pets">Back to My Pets</a></section></main>
    }
    else
    {
        <section class="care-hero">
            <div class="care-shell hero-inner">
                <div>
                    <span class="eyebrow light">CONNECTED PET CARE</span>
                    <h1>@pet.PetName's care summary</h1>
                    <p>
                        Read-only Web view of vaccination and health information associated with this pet.
                        Day-to-day care records are primarily managed in the ShoppetCare Mobile application.
                    </p>
                </div>

                <div class="hero-actions">
                    <a class="secondary-link" href="@($"/pet/{PetId}")">Pet Overview</a>
                    <a class="secondary-link" href="@($"/pet/{PetId}/card")">Digital Pet ID</a>
                </div>
            </div>
        </section>

        <main class="care-shell care-content">
            <section class="summary-grid">
                <article><span>Total Records</span><strong>@records.Count</strong><small>Connected care entries</small></article>
                <article><span>Vaccinations</span><strong>@VaccinationCount</strong><small>Vaccination records</small></article>
                <article><span>Upcoming Due</span><strong>@UpcomingCount</strong><small>Future due dates</small></article>
                <article><span>Latest Record</span><strong>@LatestDate</strong><small>Most recent care entry</small></article>
            </section>

            <section class="care-panel source-note">
                <i class="bi bi-phone-fill"></i>
                <div>
                    <strong>Mobile-primary pet care management</strong>
                    <span>
                        Add, edit, and maintain vaccination, health, medical, food, weight, and day-to-day care information
                        from Mobile. This Web page is intentionally a synchronized summary instead of a second competing CRUD interface.
                    </span>
                </div>
            </section>

            <section class="care-panel">
                <div class="panel-head">
                    <div>
                        <span class="eyebrow">CARE HISTORY</span>
                        <h2>Vaccination &amp; health records</h2>
                    </div>

                    @if (Auth.IsPremium && records.Count > 0)
                    {
                        <a class="primary-link"
                           href="@ExportDataUri"
                           download="@($"{SafeFileName(pet.PetName)}-health-records.csv")">
                            <i class="bi bi-file-earmark-arrow-down"></i>
                            Export CSV
                        </a>
                    }
                    else if (!Auth.IsPremium)
                    {
                        <a class="secondary-link" href="/premium">Premium Export</a>
                    }
                </div>

                @if (records.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-clipboard2-pulse"></i>
                        <h3>No connected care records yet.</h3>
                        <p>When vaccination or health data is available for this pet, it will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="record-list">
                        @foreach (var record in records)
                        {
                            <article class="record-row">
                                <div class="record-icon"><i class="@Icon(record.RecordType)"></i></div>
                                <div class="record-main">
                                    <div class="record-title">
                                        <div>
                                            <span>@record.RecordType</span>
                                            <h3>@record.Title</h3>
                                        </div>
                                        <strong>@record.RecordDate.ToString("MMM d, yyyy")</strong>
                                    </div>

                                    <div class="record-meta">
                                        @if (!string.IsNullOrWhiteSpace(record.VetName))
                                        {
                                            <span><i class="bi bi-person-badge"></i>@record.VetName</span>
                                        }

                                        @if (record.NextDueDate.HasValue)
                                        {
                                            <span class="@(record.IsOverdue ? "overdue" : "")">
                                                <i class="bi bi-calendar-check"></i>
                                                Due @record.NextDueDate.Value.ToString("MMM d, yyyy")
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(record.Notes))
                                    {
                                        <p>@record.Notes</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="privacy-note">
                <i class="bi bi-shield-lock-fill"></i>
                <span>
                    These care records are private account information and are not displayed on the public QR Pet ID.
                    See the <a href="/privacy">Data Privacy Notice</a>.
                </span>
            </section>
        </main>
    }
</div>

<style>
    .care-page{min-height:100vh;background:#FAF9F6;color:#1E2D27}.care-shell{width:min(1080px,calc(100% - 40px));margin:auto}.care-state{padding:90px;text-align:center;color:#6D7A74}.care-hero{padding:48px 0;background:linear-gradient(145deg,#173D3D,#102E2D);color:#fff}.hero-inner{display:flex;align-items:end;justify-content:space-between;gap:24px}.eyebrow{color:#2F9098;font-size:.66rem;font-weight:900;letter-spacing:.12em}.eyebrow.light{color:#8DD8D9}.care-hero h1{margin:7px 0 9px;font-size:clamp(2.4rem,5vw,4rem);font-weight:900;letter-spacing:-.05em}.care-hero p{max-width:720px;margin:0;color:rgba(255,255,255,.67);line-height:1.65}.hero-actions{display:flex;gap:8px;flex-wrap:wrap}.primary-link,.secondary-link{min-height:42px;padding:0 14px;border-radius:9px;text-decoration:none;font-size:.7rem;font-weight:850;display:inline-flex;align-items:center;gap:7px;justify-content:center}.primary-link{background:#2F9098;color:#fff}.secondary-link{border:1px solid #CAD9D5;background:#fff;color:#173D3D}
    .care-content{padding:26px 0 60px}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.summary-grid article,.care-panel{border:1px solid #DDE7E4;border-radius:16px;background:#fff;box-shadow:0 9px 26px rgba(30,45,39,.04)}.summary-grid article{padding:16px}.summary-grid span,.summary-grid strong,.summary-grid small{display:block}.summary-grid span{color:#7C8984;font-size:.61rem;font-weight:850;text-transform:uppercase}.summary-grid strong{margin-top:6px;font-size:1.25rem}.summary-grid small{margin-top:2px;color:#939D99;font-size:.59rem}.care-panel{margin-top:14px;padding:24px}.source-note{display:flex;gap:11px;background:#EEF6F4}.source-note i{font-size:1.3rem;color:#267C83}.source-note strong,.source-note span{display:block}.source-note span{margin-top:3px;color:#61716A;font-size:.7rem;line-height:1.5}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:18px}.panel-head h2{margin:5px 0 0;font-weight:900}.record-list{display:grid;gap:9px;margin-top:18px}.record-row{display:flex;gap:12px;padding:14px;border:1px solid #E4EBE8;border-radius:12px}.record-icon{width:38px;height:38px;flex:0 0 38px;border-radius:10px;background:#EEF6F4;color:#267C83;display:grid;place-items:center}.record-main{min-width:0;flex:1}.record-title{display:flex;justify-content:space-between;gap:14px}.record-title span{color:#2F9098;font-size:.57rem;font-weight:900;text-transform:uppercase}.record-title h3{margin:3px 0 0;font-size:.88rem}.record-title>strong{font-size:.65rem;color:#71807A}.record-meta{display:flex;flex-wrap:wrap;gap:9px;margin-top:8px;color:#78857F;font-size:.63rem}.record-meta span{display:flex;gap:5px;align-items:center}.record-meta .overdue{color:#A03A3A}.record-main p{margin:9px 0 0;color:#6D7A74;font-size:.68rem;line-height:1.5}.empty-state{text-align:center;padding:40px;color:#78857F}.empty-state>i{font-size:2rem;color:#2F9098}.empty-state h3{margin:8px 0 4px}.empty-state p{margin:0}.privacy-note{display:flex;gap:9px;margin-top:14px;padding:13px;border-radius:10px;background:#FFF7D9;color:#6F5B16;font-size:.67rem;line-height:1.5}.privacy-note a{color:#5E641D;font-weight:850}.centered{max-width:700px;margin:70px auto;text-align:center}
    @@media(max-width:800px){.hero-inner{align-items:start;flex-direction:column}.summary-grid{grid-template-columns:1fr 1fr}}@@media(max-width:560px){.summary-grid{grid-template-columns:1fr}.panel-head,.record-title{flex-direction:column}.record-row{align-items:flex-start}}
</style>

@code {
    [Parameter] public int PetId { get; set; }

    private bool ready;
    private PetProfile? pet;
    private List<PetHealthRecord> records = new();
    private string ExportDataUri = string.Empty;

    private int VaccinationCount =>
        records.Count(x => string.Equals(x.RecordType, "Vaccination", StringComparison.OrdinalIgnoreCase));

    private int UpcomingCount =>
        records.Count(x => x.NextDueDate.HasValue && x.NextDueDate.Value >= DateTime.Today);

    private string LatestDate =>
        records.Count == 0 ? "—" : records.Max(x => x.RecordDate).ToString("MMM d");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.InitializeAsync();

        pet = Db.GetPetById(PetId);

        if (Auth.CurrentUser is not null &&
            pet is not null &&
            pet.UserId == Auth.CurrentUser.Id)
        {
            records = Db.GetHealthRecords(PetId);

            if (Auth.IsPremium && records.Count > 0)
            {
                try
                {
                    var bytes = Db.ExportHealthRecordsCsv(PetId, Auth.CurrentUser.Id);
                    ExportDataUri = $"data:text/csv;base64,{Convert.ToBase64String(bytes)}";
                }
                catch
                {
                    ExportDataUri = string.Empty;
                }
            }
        }

        ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private static string Icon(string? type) =>
        type?.ToLowerInvariant() switch
        {
            "vaccination" => "bi bi-shield-check",
            "medication" => "bi bi-capsule",
            "surgery" => "bi bi-bandaid",
            "deworming" => "bi bi-bug",
            _ => "bi bi-heart-pulse"
        };

    private static string SafeFileName(string value) =>
        new(value.Where(ch => char.IsLetterOrDigit(ch) || ch is '-' or '_').ToArray());
}
