@page "/account/care"
@rendermode InteractiveServer
@inject AuthService Auth
@inject OwnerCareService Care
@inject DatabaseService Db
<PageTitle>Contacts &amp; personal care | ShoppetCare</PageTitle>
<main class="owner-shell">
    <header class="owner-header"><span class="owner-eyebrow">YOUR CARE CIRCLE</span><h1>Stay connected. Care confidently.</h1><p>Manage emergency contacts, personal vet reminders, and the information you choose to share.</p></header>
    @if(!ready){<p>Loading your preferences…</p>}
    else if(!Auth.IsPetOwner){<p>Sign in with a Pet Owner account to continue.</p><a href="/login">Sign in</a>}
    else {
    @if(message.Length>0){<p class="owner-notice" role="status">@message</p>}
    <div class="owner-grid">
        <section class="owner-card"><h2>Privacy &amp; social profiles</h2><label>Facebook URL<input @bind="social.Facebook" placeholder="https://…" maxlength="300" /></label><label>Instagram URL<input @bind="social.Instagram" placeholder="https://…" maxlength="300" /></label><label>Other social profile<input @bind="social.Other" placeholder="https://…" maxlength="300" /></label><label class="owner-check"><input type="checkbox" @bind="social.ShowSocial" /> Show social profiles beside my listings</label><label class="owner-check"><input type="checkbox" @bind="social.ShowPhone" /> Show my phone on the public Pet ID</label><small>Your phone stays private until you enable this setting. Update the number on your account page.</small><button @onclick="SaveSocial">Save preferences</button></section>
        <section class="owner-card"><h2>Emergency contacts</h2><label>Name<input @bind="contact.Name" maxlength="150" /></label><label>Relationship / role<input @bind="contact.Role" maxlength="100" /></label><label>Phone<input @bind="contact.Phone" type="tel" maxlength="50" /></label><label>Address<input @bind="contact.Address" maxlength="300" /></label><div class="owner-actions"><button @onclick="SaveContact">@(contact.Id==0?"Add contact":"Save contact")</button><button class="secondary" @onclick="()=>contact=new()">Clear</button></div>@foreach(var x in contacts){<article class="owner-row"><div><strong>@x.Name</strong><p>@x.Role · <a href="@($"tel:{x.Phone}")">@x.Phone</a></p><small>@x.Address</small></div><div class="owner-actions"><button class="secondary" @onclick="()=>contact=new(){Id=x.Id,Name=x.Name,Phone=x.Phone,Role=x.Role,Address=x.Address}">Edit</button><button class="secondary" @onclick="()=>Run(()=>Care.DeleteContact(x.Id))">Delete</button></div></article>}</section>
    </div>
    <section class="owner-card"><h2>Personal vet visit reminders</h2><p>Keep your own schedule for a visit arranged directly with your veterinarian.</p><div class="owner-grid"><label>Pet<select @bind="visit.PetId"><option value="0">Choose a pet</option>@foreach(var p in pets){<option value="@p.Id">@p.PetName</option>}</select></label><label>Veterinarian name<input @bind="visit.ClinicName" maxlength="150" /></label><label>Visit date &amp; time<input type="datetime-local" @bind="visit.VisitAt" @bind:format="yyyy-MM-ddTHH:mm" /></label><label>Purpose<input @bind="visit.Purpose" maxlength="150" /></label></div><label>Notes<textarea @bind="visit.Notes" maxlength="1000"></textarea></label><div class="owner-actions"><button @onclick="SaveVisit">@(visit.Id==0?"Add reminder":"Save reminder")</button><button class="secondary" @onclick="()=>visit=new()">Clear</button></div>@foreach(var x in visits){<article class="owner-row"><div><strong>@x.PetName · @x.Purpose</strong><p>@x.VisitAt.ToString("MMM d, yyyy h:mm tt") · @x.ClinicName</p><small>@(x.Completed?"Completed":"Upcoming") · @x.Notes</small></div><div class="owner-actions"><button class="secondary" @onclick="()=>visit=new(){Id=x.Id,PetId=x.PetId,ClinicName=x.ClinicName,VisitAt=x.VisitAt,Purpose=x.Purpose,Notes=x.Notes,Completed=x.Completed}">Edit</button><button class="secondary" @onclick="()=>Run(()=>{x.Completed=!x.Completed;Care.SaveVisit(x);})">@(x.Completed?"Reopen":"Done")</button><button class="secondary" @onclick="()=>Run(()=>Care.DeleteVisit(x.Id))">Delete</button></div></article>}</section>
    }
</main>
@code {
 bool ready;string message="";SocialPreferences social=new();CareContact contact=new();CareVisit visit=new();List<CareContact> contacts=new();List<CareVisit> visits=new();List<Shoppet_VetClinic.Models.PetProfile> pets=new();
 protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();if(Auth.IsPetOwner)try{social=Care.Social();Reload();}catch(Exception){message="Could not load shared care data. Check the database connection.";}ready=true;StateHasChanged();}
 void Reload(){contacts=Care.Contacts();visits=Care.Visits();pets=Db.GetPetsByUser(Care.Actor);}
 void Run(Action a){try{a();Reload();message="Saved. Your changes are shared with Mobile.";}catch(Exception ex){message=ex is ArgumentException?ex.Message:"Could not save. Check the shared database connection.";}}
 void SaveSocial()=>Run(()=>Care.SaveSocial(social));void SaveContact()=>Run(()=>{Care.SaveContact(contact);contact=new();});void SaveVisit()=>Run(()=>{Care.SaveVisit(visit);visit=new();});
}
