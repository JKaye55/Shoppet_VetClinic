@page "/services"
@rendermode InteractiveServer

<PageTitle>Services | ShoppetCare</PageTitle>

<div class="services-page">
    <section class="services-hero">
        <div class="services-shell hero-inner">
            <div>
                <span class="eyebrow light">SHOPPETCARE SERVICES</span>
                <h1>One connected pet-care ecosystem.</h1>
                <p>
                    Discover local veterinary care, manage your ShoppetCare pet identity, connect with the pet community,
                    and use the pre-loved marketplace across Web and Mobile.
                </p>
            </div>
        </div>
    </section>

    <main class="services-shell services-content">
        <section class="service-grid">
            <article>
                <div class="icon"><i class="bi bi-hospital"></i></div>
                <span class="eyebrow">LOCAL CARE</span>
                <h2>Clinic Directory</h2>
                <p>
                    Search listed veterinary clinics and pet-care providers, review offered services, recognize active
                    Verified Clinic badges, and contact providers directly.
                </p>
                <a href="/clinics">Explore Clinics</a>
            </article>

            <article>
                <div class="icon"><i class="bi bi-qr-code"></i></div>
                <span class="eyebrow">PET IDENTITY</span>
                <h2>Digital Pet ID</h2>
                <p>
                    Give each pet a QR-enabled ShoppetCare identity with a privacy-safe public view and richer private
                    owner views.
                </p>
                <a href="/my-pets">Open My Pets</a>
            </article>

            <article>
                <div class="icon"><i class="bi bi-phone"></i></div>
                <span class="eyebrow">MOBILE PET CARE</span>
                <h2>Pet Care Management</h2>
                <p>
                    The Mobile application is the primary place for pet profiles, vaccination records, other health or
                    medical records, Food Tracker, weight, and day-to-day care information.
                </p>
                <a href="/dashboard">View Web Summary</a>
            </article>

            <article>
                <div class="icon"><i class="bi bi-bag-heart"></i></div>
                <span class="eyebrow">C2C MARKETPLACE</span>
                <h2>Pre-Loved Buy &amp; Sell</h2>
                <p>
                    Browse pre-loved pet items from the local community. Active Verified Sellers can create and manage
                    their own listings for ₱50/month.
                </p>
                <a href="/marketplace">Browse Marketplace</a>
            </article>

            <article>
                <div class="icon"><i class="bi bi-people"></i></div>
                <span class="eyebrow">COMMUNITY</span>
                <h2>Pet Stories</h2>
                <p>
                    Create, read, update, and delete your own Community posts, tag a pet, attach a photo, and discover
                    stories shared by fellow pet owners.
                </p>
                <a href="/community">Open Community</a>
            </article>

            <article>
                <div class="icon"><i class="bi bi-star-fill"></i></div>
                <span class="eyebrow">PREMIUM</span>
                <h2>ShoppetCare Premium</h2>
                <p>
                    Activate Premium for ₱150 / 3 months for Premium Pet ID themes, eligible private card information,
                    selected care summaries, and supported record export.
                </p>
                <a href="/premium">See Premium</a>
            </article>
        </section>

        <section class="roles-card">
            <div>
                <span class="eyebrow">FOR CLINICS</span>
                <h2>Get your clinic listed, claimed, and verified.</h2>
                <p>
                    Directory listing is free. Authorized representatives can claim an approved listing, then activate
                    Verified Clinic for ₱50/month through the project mock checkout.
                </p>
            </div>
            <div class="actions">
                <a href="/clinics" class="secondary">Find Your Clinic</a>
                <a href="/list-your-clinic" class="primary">List Your Clinic</a>
            </div>
        </section>

        <section class="pilot-note">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>Academic e-commerce pilot</strong>
                <span>
                    Subscription checkout simulates GCash, Maya, and Card payment flows for demonstration. No real funds
                    are transferred by the current project.
                </span>
            </div>
        </section>
    </main>
</div>

<style>
    .services-page{min-height:100vh;background:#FAF9F6;color:#1E2D27}.services-shell{width:min(1160px,calc(100% - 40px));margin:auto}.services-hero{padding:55px 0;background:linear-gradient(145deg,#173D3D,#102E2D);color:#fff}.eyebrow{color:#2F9098;font-size:.67rem;font-weight:900;letter-spacing:.12em}.eyebrow.light{color:#8ED8D9}.services-hero h1{max-width:820px;margin:8px 0 12px;font-size:clamp(2.7rem,5vw,4.5rem);line-height:.98;font-weight:900;letter-spacing:-.055em}.services-hero p{max-width:760px;margin:0;color:rgba(255,255,255,.67);line-height:1.68}.services-content{padding:30px 0 60px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.service-grid article,.roles-card,.pilot-note{border:1px solid #DDE7E4;border-radius:18px;background:#fff;box-shadow:0 10px 28px rgba(30,45,39,.04)}.service-grid article{padding:23px}.icon{width:44px;height:44px;margin-bottom:18px;border-radius:12px;background:#EEF6F4;color:#267C83;display:grid;place-items:center;font-size:1.1rem}.service-grid h2{margin:5px 0 8px;font-size:1.16rem;font-weight:900}.service-grid p{min-height:94px;margin:0;color:#708079;font-size:.72rem;line-height:1.58}.service-grid a{display:inline-flex;margin-top:16px;color:#267C83;text-decoration:none;font-size:.7rem;font-weight:900}.roles-card{margin-top:18px;padding:28px;display:flex;align-items:center;justify-content:space-between;gap:28px;background:linear-gradient(135deg,#fff,#F0F7F5)}.roles-card h2{margin:6px 0 8px;font-weight:900}.roles-card p{max-width:760px;margin:0;color:#6C7974;line-height:1.6}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions a{min-height:44px;padding:0 15px;border-radius:10px;text-decoration:none;font-size:.7rem;font-weight:850;display:inline-flex;align-items:center}.actions .primary{background:#2F9098;color:#fff}.actions .secondary{border:1px solid #C9D9D5;background:#fff;color:#173D3D}.pilot-note{margin-top:18px;padding:15px;display:flex;gap:10px;background:#FFF7D9;color:#6E5917}.pilot-note strong,.pilot-note span{display:block}.pilot-note span{margin-top:3px;font-size:.69rem;line-height:1.5}
    @@media(max-width:900px){.service-grid{grid-template-columns:1fr 1fr}}@@media(max-width:620px){.service-grid{grid-template-columns:1fr}.roles-card{align-items:flex-start;flex-direction:column}.service-grid p{min-height:0}}
</style>
