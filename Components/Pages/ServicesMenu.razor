@page "/services"
@rendermode InteractiveServer
@inject NavigationManager Nav

<style>
    .service-mark {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #EEF4F1;
        color: #5C766D;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .08em;
    }
</style>


<div class="shoppet-viewport">
  

    <main class="container-xl py-5 flex-grow-1">
        <div class="text-center mb-5">
            <span class="badge rounded-pill px-3 py-1 mb-2 small fw-bold" style="background: #EEF4F1; color: #1E2D27;">Professional Care Menu</span>
            <h2 class="fw-bold mb-2" style="color: #1E2824;">Services Offered Across Lipa &amp; Tanauan</h2>
            <p class="text-muted small">Select any service below to format an inquiry for clinic social inboxes</p>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between bg-white">
                    <div>
                        <div class="service-mark mb-3">CONSULTATION</div>
                        <h5 class="fw-bold mb-2">General Checkup &amp; Consultation</h5>
                        <p class="text-muted small mb-3">Routine physical examination, diagnosis of clinical symptoms, and overall health assessment.</p>
                        <div class="badge bg-light text-dark border mb-3">From ₱350</div>
                    </div>
                    <button class="btn w-100 py-2 fw-bold rounded-pill text-white" style="background-color: #5C766D;" @onclick='() => Nav.NavigateTo("/inquire")'>Inquire via Social Desk →</button>
                </div>
            </div>
            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between bg-white">
                    <div>
                        <div class="service-mark mb-3">VACCINATION</div>
                        <h5 class="fw-bold mb-2">Core Vaccinations</h5>
                        <p class="text-muted small mb-3">Anti-Rabies immunization, 5-in-1 DHPP shots, kennel cough protection, and health cards.</p>
                        <div class="badge bg-light text-dark border mb-3">From ₱450</div>
                    </div>
                    <button class="btn w-100 py-2 fw-bold rounded-pill" style="background-color: #F7DD7D; color: #2F423B;" @onclick='() => Nav.NavigateTo("/inquire")'>Inquire Vaccine Stock →</button>
                </div>
            </div>
            <div class="col">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between bg-white">
                    <div>
                        <div class="service-mark mb-3">NUTRITION</div>
                        <h5 class="fw-bold mb-2">Prescription Nutrition</h5>
                        <p class="text-muted small mb-3">Specialized renal, gastrointestinal, and hypoallergenic veterinary formulas verified for counter pickup.</p>
                        <div class="badge bg-light text-dark border mb-3">Brand Directory</div>
                    </div>
                    <button class="btn w-100 py-2 fw-bold rounded-pill text-white" style="background-color: #5C766D;" @onclick='() => Nav.NavigateTo("/brands")'>Browse Brand Index →</button>
                </div>
            </div>
        </div>
    </main>
</div>