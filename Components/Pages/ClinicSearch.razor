@code {
    private List<ClinicTenant> allClinics = new();
    private string searchText = string.Empty;
    private string locationFilter = string.Empty;
    private string providerFilter = string.Empty;
    private bool verifiedOnly;

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "location")]
    public string? LocationQuery { get; set; }

    [SupplyParameterFromQuery(Name = "provider")]
    public string? ProviderQuery { get; set; }

    protected override void OnInitialized()
    {
        allClinics = Db.GetAllClinics();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(SearchQuery))
            searchText = SearchQuery.Trim();

        if (!string.IsNullOrWhiteSpace(LocationQuery))
            locationFilter = LocationQuery.Trim();

        if (!string.IsNullOrWhiteSpace(ProviderQuery))
        {
            providerFilter = ProviderQuery.Trim().ToLowerInvariant() switch
            {
                "veterinary" => "vet",
                "veterinary clinic" => "vet",
                "pet shop" => "petshop",
                "petshop" => "petshop",
                "both" => "both",
                _ => string.Empty
            };
        }
    }

    private List<ClinicTenant> Filtered
    {
        get
        {
            IEnumerable<ClinicTenant> query = allClinics;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var s = searchText.Trim();

                query = query.Where(c =>
                    Contains(c.ClinicName, s) ||
                    Contains(c.Branch, s) ||
                    Contains(c.Address, s) ||
                    Contains(c.ServiceCapabilities, s));
            }

            if (!string.IsNullOrWhiteSpace(locationFilter))
            {
                query = query.Where(c =>
                    Contains(c.Address, locationFilter) ||
                    Contains(c.Branch, locationFilter));
            }

            query = providerFilter switch
            {
                "vet" => query.Where(c => c.HasClinic && !c.HasPetShop),
                "petshop" => query.Where(c => c.HasPetShop && !c.HasClinic),
                "both" => query.Where(c => c.HasClinic && c.HasPetShop),
                _ => query
            };

            if (verifiedOnly)
                query = query.Where(c => c.IsVerified);

            return query
                .OrderByDescending(c => c.IsVerified)
                .ThenBy(c => c.ClinicName)
                .ToList();
        }
    }

    private void ResetFilters()
    {
        searchText = string.Empty;
        locationFilter = string.Empty;
        providerFilter = string.Empty;
        verifiedOnly = false;
    }

    private static bool Contains(string? source, string value) =>
        !string.IsNullOrWhiteSpace(source)
        && source.Contains(value, StringComparison.OrdinalIgnoreCase);

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private static string TrimText(string value, int length) =>
        value.Length <= length ? value : value[..length] + "...";
}
