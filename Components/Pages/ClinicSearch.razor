@page "/clinics"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject DatabaseService Db
@inject NavigationManager Nav
@inject AuthService Auth

<PageTitle>Verified Clinics | ShoppetCare</PageTitle>

<div class="clinic-directory-page">
    <section class="directory-hero">
        <div class="directory-shell hero-inner">
            <div>
                <span class="eyebrow light">SHOPPETCARE CLINIC DIRECTORY</span>
                <h1>Find trusted local pet care.</h1>
                <p>
                    Browse listed veterinary and pet-care providers in Lipa City, Tanauan, and nearby Batangas.
                    A Verified Clinic badge means the claimed clinic has an active ShoppetCare verification subscription.
                </p>
            </div>

            <div class="hero-actions">
                @if (Auth.IsGuest)
                {
                    <span class="secondary-link disabled-link"
                          title="Sign in or create an account to request a clinic listing">
                        <i class="bi bi-lock-fill"></i>
                        List Your Clinic
                    </span>
                }
                else
                {
                    <a href="/list-your-clinic"
                       class="secondary-link"
                       title="Request a clinic listing">
                        List Your Clinic
                    </a>
                }
            </div>
        </div>
    </section>

    <main class="directory-shell directory-content">
        <section class="search-card">
            <div class="search-input">
                <i class="bi bi-search"></i>
                <input type="search"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Search clinic, service, or location..." />
            </div>

            <select @bind="locationFilter">
                <option value="">All locations</option>
                <option value="Lipa">Lipa City</option>
                <option value="Tanauan">Tanauan City</option>
            </select>

            <select @bind="providerFilter">
                <option value="">All provider types</option>
                <option value="vet">Veterinary Clinic</option>
                <option value="petshop">Pet Shop</option>
                <option value="both">Clinic + Pet Shop</option>
            </select>

            <label class="verified-toggle">
                <input type="checkbox" @bind="verifiedOnly" />
                <span>Verified only</span>
            </label>

            <button type="button" @onclick="ResetFilters">Reset</button>
        </section>

        <div class="result-head">
            <div>
                <span class="eyebrow">LOCAL CARE DIRECTORY</span>
                <h2>@Filtered.Count provider@(Filtered.Count == 1 ? "" : "s") found</h2>
            </div>

            <div class="legend">
                <span><i class="bi bi-patch-check-fill"></i> Active Verified Clinic</span>
            </div>
        </div>

        @if (Filtered.Count == 0)
        {
            <section class="empty-state">
                <i class="bi bi-hospital"></i>
                <h3>No providers match those filters.</h3>
                <p>Try another search, or request a clinic that is not yet listed.</p>
                <a href="/list-your-clinic" class="primary-link">Request Clinic Listing</a>
            </section>
        }
        else
        {
            <section class="clinic-grid">
                @foreach (var clinic in Filtered)
                {
                    <article class="clinic-card">
                        <div class="card-head">
                            <div class="clinic-icon">
                                <i class="bi bi-hospital"></i>
                            </div>

                            <div class="clinic-title">
                                <div class="title-row">
                                    <h3>@clinic.ClinicName</h3>
                                    @if (clinic.IsVerified)
                                    {
                                        <span class="verified-badge">
                                            <i class="bi bi-patch-check-fill"></i>
                                            Verified Clinic
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(clinic.Branch))
                                {
                                    <span class="branch">@clinic.Branch</span>
                                }
                            </div>
                        </div>

                        <div class="clinic-info">
                            <div><i class="bi bi-geo-alt"></i><span>@Display(clinic.Address)</span></div>
                            <div><i class="bi bi-telephone"></i><span>@Display(clinic.ContactPhone)</span></div>
                            <div><i class="bi bi-clock"></i><span>@Display(clinic.OperatingHours)</span></div>
                        </div>

                        <div class="provider-tags">
                            @if (clinic.HasClinic)
                            {
                                <span>Veterinary Care</span>
                            }
                            @if (clinic.HasPetShop)
                            {
                                <span>Pet Shop</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(clinic.FacilityType))
                            {
                                <span>@clinic.FacilityType</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(clinic.ServiceCapabilities))
                        {
                            <div class="services">
                                <strong>Services</strong>
                                <p>@TrimText(clinic.ServiceCapabilities, 180)</p>
                            </div>
                        }

                        <div class="card-actions">
                            @if (!string.IsNullOrWhiteSpace(clinic.MessengerUrl))
                            {
                                <a href="@clinic.MessengerUrl"
                                   target="_blank"
                                   rel="noopener"
                                   class="primary-link">
                                    Contact Clinic
                                </a>
                            }
                            else if (!string.IsNullOrWhiteSpace(clinic.ContactPhone))
                            {
                                <a href="@($"tel:{clinic.ContactPhone}")"
                                   class="primary-link">
                                    Call Clinic
                                </a>
                            }

                            @if (!clinic.IsClaimed)
                            {
                                @if (Auth.IsGuest)
                                {
                                    <span class="secondary-link disabled-link"
                                          title="Sign in or create an account to claim a clinic">
                                        <i class="bi bi-lock-fill"></i>
                                        Claim This Clinic
                                    </span>
                                }
                                else
                                {
                                    <a href="@($"/claim-clinic/{clinic.Id}")"
                                       class="secondary-link"
                                       title="Claim this clinic as an authorized representative">
                                        Claim This Clinic
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="claimed-label">
                                    <i class="bi bi-person-check-fill"></i>
                                    Claimed listing
                                </span>
                            }
                        </div>
                    </article>
                }
            </section>
        }

        <section class="clinic-owner-cta">
            <div>
                <span class="eyebrow">FOR CLINIC REPRESENTATIVES</span>
                <h2>Already listed or missing from the directory?</h2>
                <p>
                    Existing clinics can be claimed by an authorized representative. Missing clinics can request a free
                    directory listing before starting the claim process.
                </p>
            </div>
            @if (Auth.IsGuest)
            {
                <span class="primary-link disabled-primary"
                      title="Sign in or create an account to request a clinic listing">
                    <i class="bi bi-lock-fill"></i>
                    Request a Listing
                </span>
            }
            else
            {
                <a href="/list-your-clinic" class="primary-link">Request a Listing</a>
            }
        </section>
    </main>
</div>

