@page "/my-pets"
@rendermode InteractiveServer
@namespace Shoppet_VetClinic.Components.Pages

<PageTitle>My Pets | ShoppetCare</PageTitle>


<div class="pets-page">

    <MyShoppetCareNav />


    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="pets-hero">

        <div class="pets-shell pets-hero-grid">

            <div class="pets-hero-copy">

                <span class="pets-eyebrow">
                    PET MANAGEMENT
                </span>


                <h1>
                    Everything about
                    <em>your pets.</em>
                </h1>


                <p>
                    Review pet profiles, manage photos,
                    open Digital Pet IDs, and access
                    connected care summaries from Web.
                </p>

            </div>


            <aside class="pets-hero-panel">

                <div class="pets-hero-stat">

                    <span>
                        PET FAMILY
                    </span>

                    <strong>
                        @Pets.Count
                    </strong>

                    <small>
                        @(Pets.Count == 1
                            ? "Pet profile"
                            : "Pet profiles")
                    </small>

                </div>


                <div class="pets-plan">

                    @if (IsPremium)
                    {
                        <span class="premium">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                            </svg>

                            Premium Member

                        </span>
                    }
                    else
                    {
                        <span>
                            Free Plan
                        </span>
                    }

                </div>


                <button type="button"
                        class="add-pet"
                        disabled="@(!CanAddMorePets)"
                        @onclick="OpenAddForm">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#plus-lg"></use>
                    </svg>

                    Add Pet

                </button>

            </aside>

        </div>

    </section>


    <!-- =========================================================
         CONTENT
         ========================================================= -->

    <section class="pets-content">

        <div class="pets-shell">


            @if (!IsPremium &&
                 Pets.Count >= 1)
            {
                <div class="plan-notice">

                    <span class="notice-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#info-circle"></use>
                        </svg>

                    </span>


                    <div>

                        <strong>
                            Your Free pet profile is active.
                        </strong>

                        <p>
                            You can review this pet, use its Digital Pet ID,
                            and open the connected care summary.
                            Detailed day-to-day care management remains Mobile-primary.
                        </p>

                    </div>


                    <a href="/premium">
                        Compare Premium →
                    </a>

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(
                StatusMessage))
            {
                <div class="@(IsError
                                                    ? "pets-message error"
                                                    : "pets-message success")">

                    @StatusMessage

                </div>
            }


            <!-- =====================================================
                 FORM
                 ===================================================== -->
            @if (ShowPetForm)
            {
                <section class="pet-editor">

                    <div class="editor-header">

                        <div>

                            <span class="pets-eyebrow">
                                @(IsEditingPet
                                    ? "EDIT PET"
                                    : "NEW PET")
                            </span>

                            <h2>
                                @(IsEditingPet
                                    ? $"Update {PetForm.PetName}"
                                    : "Add a pet profile")
                            </h2>

                            <p>
                                Use the guided choices below
                                to keep information consistent.
                            </p>

                        </div>


                        <button type="button"
                                class="close-editor"
                                disabled="@IsSaving"
                                @onclick="ClosePetForm"
                                aria-label="Close">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#x-lg"></use>
                            </svg>

                        </button>

                    </div>


                    <div class="editor-layout">


                        <!-- PHOTO -->

                        <div class="photo-column">

                            <div class="photo-preview">

                                @if (!string.IsNullOrWhiteSpace(
                                    PetPhotoPreview))
                                {
                                    <img src="@PetPhotoPreview"
                                         alt="Pet preview" />
                                }
                                else
                                {
                                    <span class="photo-placeholder">

                                        <svg aria-hidden="true">
                                            <use href="/icons/bootstrap-icons.svg#image"></use>
                                        </svg>

                                        Pet Photo

                                    </span>
                                }

                            </div>


                            <div class="photo-copy">

                                <strong>
                                    Pet photo
                                </strong>

                                <p>
                                    JPG, PNG, or WEBP.
                                    Maximum 5 MB.
                                </p>


                                <label class="file-picker">

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#upload"></use>
                                    </svg>

                                    @(IsEditingPet
                                        ? "Choose New Photo"
                                        : "Choose Photo")

                                    <InputFile OnChange="HandlePetPhotoSelected"
                                               accept="image/jpeg,image/png,image/webp" />

                                </label>


                                @if (!string.IsNullOrWhiteSpace(
                                    SelectedPetFileName))
                                {
                                    <small>
                                        @SelectedPetFileName
                                    </small>
                                }

                            </div>

                        </div>


                        <!-- FIELDS -->

                        <div class="editor-fields">


                            <div class="field full">

                                <label>
                                    Pet Name *
                                </label>

                                <input type="text"
                                       maxlength="150"
                                       @bind="PetForm.PetName"
                                       placeholder="Example: Buddy" />

                            </div>


                            <div class="field">

                                <label>
                                    Species *
                                </label>

                                <select @bind="PetForm.Species"
                                        @bind:after="SpeciesChanged">

                                    <option value="Dog">Dog</option>
                                    <option value="Cat">Cat</option>
                                    <option value="Rabbit">Rabbit</option>
                                    <option value="Bird">Bird</option>
                                    <option value="Hamster">Hamster</option>
                                    <option value="Fish">Fish</option>
                                    <option value="Other">Other</option>

                                </select>

                            </div>


                            <div class="field">

                                <label>
                                    Breed
                                </label>


                                @if (PetForm.Species == "Other")
                                {
                                    <input type="text"
                                           maxlength="150"
                                           @bind="PetForm.Breed"
                                           placeholder="Enter breed or pet type" />
                                }
                                else
                                {
                                    <select @bind="PetForm.Breed">

                                        <option value="">
                                            Select breed
                                        </option>

                                        @foreach (var breed in CurrentBreeds)
                                        {
                                            <option value="@breed">
                                                @breed
                                            </option>
                                        }

                                    </select>
                                }

                            </div>


                            <div class="field">

                                <label>
                                     Age / Approximate Age
                                </label>

                                <select @bind="PetForm.Age">

                                    <option value="">
                                        Select age
                                    </option>

                                    @foreach (var age in AgeOptions)
                                    {
                                        <option value="@age">
                                            @age
                                        </option>
                                    }

                                </select>

                            </div>
                            <div class="field">

    <label>
        Birthdate
    </label>

    <input type="date"
           max="@DateTime.Today.ToString("yyyy-MM-dd")"
           @bind="PetForm.BirthDate"
           @bind:format="yyyy-MM-dd" />

    <small>
        Optional. Used to calculate age on the Digital Pet ID.
    </small>

</div>

                            <div class="field">

                                <label>
                                    Weight
                                </label>

                                <div class="weight-input">

                                    <input type="number"
                                           min="0"
                                           step="0.1"
                                           @bind="PetForm.WeightKg"
                                           placeholder="0.0" />

                                    <span>
                                        kg
                                    </span>

                                </div>

                            </div>


                            <div class="field full">

                                <label>
                                    Usual Diet
                                </label>

                                <select @bind="PetForm.Diet">

                                    <option value="">
                                        Select usual diet
                                    </option>

                                    @foreach (var diet in DietOptions)
                                    {
                                        <option value="@diet">
                                            @diet
                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                    </div>


                    <div class="editor-actions">

                        <button type="button"
                                class="save"
                                disabled="@IsSaving"
                                @onclick="SavePetAsync">

                            @(IsSaving
                                ? "Saving..."
                                : IsEditingPet
                                    ? "Save Changes"
                                    : "Save Pet")

                        </button>


                        <button type="button"
                                class="cancel"
                                disabled="@IsSaving"
                                @onclick="ClosePetForm">

                            Cancel

                        </button>

                    </div>

                </section>
            }


            <!-- =====================================================
                 COLLECTION HEADING
                 ===================================================== -->

            <div class="collection-heading">

                <div>

                    <span class="pets-eyebrow">
                        YOUR PET FAMILY
                    </span>

                    <h2>
                        Pet collection
                    </h2>

                    <p>
                        Select a pet to review its profile,
                        open its Digital Pet ID,
                        or view connected care information.
                    </p>

                </div>


                <span class="collection-count">

                    @Pets.Count

                    @(Pets.Count == 1
                        ? "Pet"
                        : "Pets")

                </span>

            </div>


            <!-- =====================================================
                 EMPTY
                 ===================================================== -->
            @if (Pets.Count == 0)
            {
                <div class="empty-pets">

                    <span class="empty-pets-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#heart"></use>
                        </svg>

                    </span>


                    <h3>
                        Meet your first
                        ShoppetCare pet profile.
                    </h3>


                    <p>
                        Create a pet profile to unlock
                        its Digital Pet ID and organized
                        health-record workspace.
                    </p>


                    <button type="button"
                            @onclick="OpenAddForm">

                        Add Your First Pet

                    </button>

                </div>
            }
            else
            {
                <!-- =================================================
                     PET CARDS
                     ================================================= -->

                <div class="pet-grid">

                    @foreach (var pet in Pets)
                    {
                        var photoUrl =
                            GetPetPhoto(
                                pet.Id);


                        <article class="pet-card">


                            <div class="pet-card-visual">

                                <div class="pet-photo">

                                    @if (!string.IsNullOrWhiteSpace(
                                        photoUrl))
                                    {
                                        <img src="@photoUrl"
                                             alt="@pet.PetName" />
                                    }
                                    else
                                    {
                                        <span>
                                            @GetPetInitial(pet)
                                        </span>
                                    }

                                </div>


                                @if (IsPremium)
                                {
                                    <span class="pet-premium">

                                        <svg aria-hidden="true">
                                            <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                                        </svg>

                                        Premium

                                    </span>
                                }

                            </div>


                            <div class="pet-card-body">

                                <span class="species">
                                    @pet.Species
                                </span>


                                <h3>
                                    @pet.PetName
                                </h3>


                                <p class="breed">
                                    @(string.IsNullOrWhiteSpace(
                                        pet.Breed)
                                        ? "Breed not specified"
                                        : pet.Breed)
                                </p>


                               <div class="pet-specs">

    <div>

        <span>
            AGE
        </span>

        <strong>
            @GetDisplayAge(pet)
        </strong>

    </div>


    <div>

        <span>
            BIRTHDATE
        </span>

        <strong>
            @(pet.BirthDate.HasValue
                ? pet.BirthDate.Value.ToString("MMM d, yyyy")
                : "Not set")
        </strong>

    </div>


    <div>

        <span>
            WEIGHT
        </span>

        <strong>
            @(pet.WeightKg.HasValue
                ? $"{pet.WeightKg.Value:0.##} kg"
                : "Not set")
        </strong>

    </div>

</div>


                                <div class="diet">

                                    <span>
                                        USUAL DIET
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(
                                            pet.Diet)
                                            ? "Not specified"
                                            : pet.Diet)
                                    </strong>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(
                                    pet.CardId))
                                {
                                    <div class="pet-id">

                                        <div>

                                            <span>
                                                DIGITAL PET ID
                                            </span>

                                            <strong>
                                                @pet.CardId
                                            </strong>

                                        </div>


                                        <svg aria-hidden="true">
                                            <use href="/icons/bootstrap-icons.svg#qr-code"></use>
                                        </svg>

                                    </div>
                                }


                                <div class="pet-actions">

                                    <a href="/pet/@pet.Id/card"
                                       class="primary">

                                        <svg aria-hidden="true">
                                            <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                        </svg>

                                        Pet ID

                                    </a>


                                    <a href="/pet/@pet.Id/records">

                                        Records

                                    </a>


                                    <button type="button"
                                            @onclick="() => OpenEditForm(pet)">

                                        Edit

                                    </button>


                                    <button type="button"
                                            class="delete"
                                            title="Delete pet"
                                            @onclick="() => DeletePetAsync(pet)">

                                        <svg aria-hidden="true">
                                            <use href="/icons/bootstrap-icons.svg#trash3"></use>
                                        </svg>

                                    </button>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }

        </div>

    </section>

</div>


<style>

    :root {
        --pc-teal: #2F9098;
        --pc-teal-dark: #267C83;
        --pc-dark: #173D3D;
        --pc-cream: #FBF8F2;
        --pc-yellow: #F3D27A;
        --pc-border: #DDE7E4;
        --pc-muted: #73847E;
    }


    .pets-page,
    .pets-page *,
    .pets-page *::before,
    .pets-page *::after {
        box-sizing: border-box;
    }


    .pets-page {
        min-height: 100vh;
        color: var(--pc-dark);
        background: var(--pc-cream);
    }


        .pets-page svg {
            width: 1em;
            height: 1em;
            fill: currentColor;
        }


    .pets-shell {
        width: min( 1480px, calc(100% - 48px) );
        margin: 0 auto;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .pets-hero {
        position: relative;
        overflow: hidden;
        padding: 46px 0;
        border-bottom: 1px solid var(--pc-border);
        background: radial-gradient( circle at 90% 15%, rgba(47,144,152,.14), transparent 27% ), linear-gradient( 125deg, #FFFDF9, #FBF8F2 53%, #EEF7F5 );
    }


        .pets-hero::after {
            content: "";
            position: absolute;
            top: -290px;
            right: -230px;
            width: 440px;
            height: 440px;
            border: 1px solid rgba(47,144,152,.13);
            border-radius: 50%;
        }


    .pets-hero-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0,1fr) 340px;
        align-items: end;
        gap: 50px;
    }


    .pets-eyebrow {
        display: block;
        color: var(--pc-teal);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .12em;
    }


    .pets-hero h1 {
        max-width: 760px;
        margin: 8px 0 0;
        color: var(--pc-dark);
        font-size: clamp( 46px, 5vw, 72px );
        line-height: .91;
        font-weight: 900;
        letter-spacing: -.055em;
    }


        .pets-hero h1 em {
            display: block;
            color: var(--pc-teal);
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            font-weight: 500;
        }


    .pets-hero-copy > p {
        max-width: 650px;
        margin: 18px 0 0;
        color: #657771;
        font-size: 15px;
        line-height: 1.65;
    }


    .pets-hero-panel {
        padding: 21px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 15px;
        align-items: end;
        border: 1px solid #D5E3DF;
        border-radius: 20px;
        background: rgba(255,255,255,.88);
        box-shadow: 0 13px 32px rgba(23,61,61,.07);
    }


    .pets-hero-stat span,
    .pets-hero-stat strong,
    .pets-hero-stat small {
        display: block;
    }


    .pets-hero-stat > span {
        color: var(--pc-teal);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .1em;
    }


    .pets-hero-stat strong {
        margin-top: 3px;
        color: var(--pc-dark);
        font-size: 36px;
        line-height: 1;
        font-weight: 950;
    }


    .pets-hero-stat small {
        margin-top: 3px;
        color: #82908B;
        font-size: 11px;
    }


    .pets-plan {
        align-self: start;
    }


        .pets-plan > span {
            padding: 7px 9px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            background: #EEF3F1;
            color: #65736E;
            font-size: 10px;
            font-weight: 850;
        }


            .pets-plan > span.premium {
                border: 1px solid #E3CE7F;
                background: #FFF4CF;
                color: #806213;
            }


    .add-pet {
        grid-column: 1 / -1;
        min-height: 45px;
        border: 0;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: var(--pc-teal);
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 850;
        cursor: pointer;
    }


    button:disabled {
        opacity: .52;
        cursor: not-allowed;
    }


    /* =========================================================
           CONTENT
           ========================================================= */

    .pets-content {
        padding: 28px 0 74px;
    }


    .plan-notice {
        margin-bottom: 15px;
        padding: 13px 15px;
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 13px;
        border: 1px solid #E5D28E;
        border-radius: 13px;
        background: #FFF8DF;
    }


    .notice-icon {
        width: 39px;
        height: 39px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #FFFFFF;
        color: #896817;
    }


    .plan-notice strong {
        color: #5D4C1D;
        font-size: 13px;
    }


    .plan-notice p {
        margin: 3px 0 0;
        color: #7F7144;
        font-size: 11px;
    }


    .plan-notice a {
        color: var(--pc-teal-dark);
        font-size: 12px;
        font-weight: 850;
        text-decoration: none;
    }


    .pets-message {
        margin-bottom: 15px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 13px;
    }


        .pets-message.success {
            border: 1px solid #B8DDCF;
            background: #EFFAF5;
            color: #28664D;
        }


        .pets-message.error {
            border: 1px solid #F0BEBE;
            background: #FFF3F3;
            color: #9B2C2C;
        }


    /* =========================================================
           EDITOR
           ========================================================= */

    .pet-editor {
        margin-bottom: 34px;
        padding: 27px;
        border: 1px solid var(--pc-border);
        border-radius: 21px;
        background: #FFFFFF;
        box-shadow: 0 15px 38px rgba(23,61,61,.06);
    }


    .editor-header {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }


        .editor-header h2 {
            margin: 5px 0 0;
            color: var(--pc-dark);
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -.03em;
        }


        .editor-header p {
            margin: 5px 0 0;
            color: #82908B;
            font-size: 12px;
        }


    .close-editor {
        width: 40px;
        height: 40px;
        border: 1px solid #D8E3DF;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: #FFFFFF;
        color: #64746E;
        cursor: pointer;
    }


    .editor-layout {
        margin-top: 22px;
        display: grid;
        grid-template-columns: 280px minmax(0,1fr);
        gap: 25px;
    }


    .photo-column {
        padding: 16px;
        border-radius: 15px;
        background: linear-gradient( 145deg, #EAF6F4, #F8FBFA );
    }


    .photo-preview {
        width: 100%;
        aspect-ratio: 1;
        overflow: hidden;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background: #E4EFEC;
    }


        .photo-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .photo-placeholder {
        display: grid;
        justify-items: center;
        gap: 7px;
        color: #758681;
        font-size: 12px;
    }


        .photo-placeholder svg {
            width: 25px;
            height: 25px;
        }


    .photo-copy {
        margin-top: 13px;
    }


        .photo-copy strong {
            color: var(--pc-dark);
            font-size: 14px;
        }


        .photo-copy p {
            margin: 4px 0 10px;
            color: #7A8984;
            font-size: 11px;
        }


    .file-picker {
        position: relative;
        min-height: 38px;
        padding: 0 11px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        overflow: hidden;
        border: 1px solid #C9DAD6;
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--pc-teal-dark);
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
    }


        .file-picker input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }


    .photo-copy small {
        display: block;
        margin-top: 7px;
        color: #7D8C87;
        font-size: 10px;
    }


    .editor-fields {
        display: grid;
        grid-template-columns: repeat( 2, minmax(0,1fr) );
        gap: 14px;
    }


    .field.full {
        grid-column: 1 / -1;
    }


    .field label {
        display: block;
        margin-bottom: 6px;
        color: #455A53;
        font-size: 12px;
        font-weight: 850;
    }


    .field input,
    .field select {
        width: 100%;
        min-height: 46px;
        padding: 0 12px;
        border: 1px solid #CDDCD8;
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--pc-dark);
        font-size: 13px;
        outline: none;
    }


        .field input:focus,
        .field select:focus {
            border-color: var(--pc-teal);
            box-shadow: 0 0 0 3px rgba(47,144,152,.08);
        }


    .weight-input {
        position: relative;
    }


        .weight-input input {
            padding-right: 45px;
        }


        .weight-input span {
            position: absolute;
            top: 50%;
            right: 12px;
            transform: translateY(-50%);
            color: #82908B;
            font-size: 12px;
        }


    .editor-actions {
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }


        .editor-actions button {
            min-height: 43px;
            padding: 0 14px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 850;
            cursor: pointer;
        }


        .editor-actions .save {
            border: 1px solid var(--pc-teal);
            background: var(--pc-teal);
            color: #FFFFFF;
        }


        .editor-actions .cancel {
            border: 1px solid #D3DFDC;
            background: #FFFFFF;
            color: #5F706A;
        }


