@page "/my-pets"
@rendermode InteractiveServer
@namespace Shoppet_VetClinic.Components.Pages

<div class="container py-5">

    <!-- =============================================
         HEADER
         ============================================= -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h3 class="fw-bold mb-1" style="color:#1E2D27;">My Pets</h3>
            <p class="text-muted small mb-0">
                Manage your pets, their health records, and their ID cards.
            </p>
        </div>

        <div class="d-flex gap-2 align-items-center">

            @if (IsPremium)
            {
                <span class="sp-badge-premium"><i class="bi bi-star-fill"></i> Premium</span>
            }

            <button class="sp-btn-primary-pill"
                    @onclick="ShowAddForm"
                    disabled="@(!CanAddMorePets)">
                + Add Pet
            </button>

        </div>

    </div>

    <!-- =============================================
         UPGRADE PROMPT (free users at limit)
         ============================================= -->
    @if (!IsPremium && Pets.Count >= 1)
    {
        <div class="alert alert-warning rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <strong>You've reached the free plan limit.</strong><br />
                <span class="small">
                    Upgrade to Pet ID Virtual Card Premium (₱49) for unlimited pets.
                </span>
            </div>
            <a href="/premium" class="sp-btn-primary-pill text-decoration-none">
                <i class="bi bi-star-fill"></i> Upgrade
            </a>
        </div>
    }

    <!-- =============================================
         FEEDBACK
         ============================================= -->
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @(IsError ? "alert-danger" : "alert-success") rounded-3 border">
            @StatusMessage
        </div>
    }

    <!-- =============================================
         ADD PET FORM
         ============================================= -->
    @if (ShowAddPetForm)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="color:#1E2D27;">Add a new pet</h5>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill"
                            @onclick="HideAddForm">
                        Cancel
                    </button>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Pet Name *</label>
                        <input class="form-control rounded-3"
                               @bind="NewPetName"
                               placeholder="e.g. Beba" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Species</label>
                        <select class="form-select rounded-3" @bind="NewPetSpecies">
                            <option value="Dog">Dog</option>
                            <option value="Cat">Cat</option>
                            <option value="Rabbit">Rabbit</option>
                            <option value="Bird">Bird</option>
                            <option value="Hamster">Hamster</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Breed</label>
                        <input class="form-control rounded-3"
                               @bind="NewPetBreed"
                               placeholder="e.g. Golden Retriever" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Age</label>
                        <input class="form-control rounded-3"
                               @bind="NewPetAge"
                               placeholder="e.g. 2 years" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Weight (kg)</label>
                        <input class="form-control rounded-3"
                               type="number"
                               step="0.1"
                               @bind="NewPetWeightKg" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Diet</label>
                        <input class="form-control rounded-3"
                               @bind="NewPetDiet"
                               placeholder="e.g. Mixed Dry & Wet Food" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button class="sp-btn-primary-pill"
                            @onclick="SaveNewPetAsync"
                            disabled="@IsSaving">
                        @(IsSaving ? "Saving…" : "Save Pet")
                    </button>
                    <button class="sp-btn-outline-pill"
                            @onclick="HideAddForm">
                        Cancel
                    </button>
                </div>

            </div>
        </div>
    }

    <!-- =============================================
         PET LIST
         ============================================= -->
    @if (Pets.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center">
                <div style="font-size:3rem;"><i class="bi bi-heart-fill"></i></div>
                <h5 class="fw-bold mt-2 mb-1" style="color:#1E2D27;">
                    No pets yet
                </h5>
                <p class="text-muted small mb-3">
                    Add your first pet to get started.
                </p>
                <button class="sp-btn-primary-pill" @onclick="ShowAddForm">
                    + Add Your First Pet
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var pet in Pets)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column">

                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@GetPetPhoto(pet.Id)"
                                     alt="@pet.PetName"
                                     style="width:64px;height:64px;border-radius:50%;object-fit:cover;background:#EEF4F1;" />
                                <div>
                                    <h5 class="fw-bold mb-0" style="color:#1E2D27;">
                                        @pet.PetName
                                    </h5>
                                    <div class="small text-muted">
                                        @pet.Species
                                        @if (!string.IsNullOrWhiteSpace(pet.Breed))
                                        {
                                            <text> · @pet.Breed</text>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="small text-muted mb-3 flex-grow-1">
                                @if (!string.IsNullOrWhiteSpace(pet.Age))
                                {
                                    <div>Age: @pet.Age</div>
                                }
                                @if (pet.WeightKg.HasValue)
                                {
                                    <div>Weight: @pet.WeightKg.Value.ToString("0.##") kg</div>
                                }
                                <div class="font-monospace mt-1" style="font-size:.7rem;">
                                    @pet.CardId
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/pet/@pet.Id/card"
                                   class="sp-btn-primary-pill text-decoration-none"
                                   style="font-size:.78rem;padding:8px 16px;">
                                    🪪 View Card
                                </a>
                                <a href="/pet/@pet.Id/records"
                                   class="sp-btn-outline-pill text-decoration-none"
                                   style="font-size:.78rem;padding:7px 15px;">
                                    📋 Records
                                </a>
                                <button class="btn btn-sm btn-outline-danger rounded-pill"
                                        @onclick="() => DeletePetAsync(pet)">
                                    Delete
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>