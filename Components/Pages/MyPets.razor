@page "/my-pets"
@rendermode InteractiveServer
@namespace Shoppet_VetClinic.Components.Pages

<PageTitle>My Pets | ShoppetCare</PageTitle>


<div class="sp-pets-page">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="sp-pets-hero">

        <div class="sp-pets-shell sp-pets-hero-inner">

            <div>

                <span class="sp-pets-eyebrow light">
                    PET MANAGEMENT
                </span>

                <h1>
                    Everything about your pets,
                    <em>in one place.</em>
                </h1>

                <p>
                    Keep pet information current, manage photos,
                    view health records, and access each pet's
                    digital ShoppetCare ID.
                </p>

            </div>


            <div class="sp-pets-hero-actions">

                @if (IsPremium)
                {
                    <span class="sp-premium-badge">

                        <i class="bi bi-star-fill"></i>

                        Premium Member

                    </span>
                }

                <button type="button"
                        class="sp-pets-add"
                        disabled="@(!CanAddMorePets)"
                        @onclick="OpenAddForm">

                    <i class="bi bi-plus-lg"></i>

                    Add Pet

                </button>

            </div>

        </div>

    </section>


    <section class="sp-pets-content">

        <div class="sp-pets-shell">


            <!-- =====================================================
                 FREE PLAN NOTICE
                 ===================================================== -->
            @if (!IsPremium && Pets.Count >= 1)
            {
                <div class="sp-plan-notice">

                    <div class="sp-plan-icon">

                        <i class="bi bi-info-circle"></i>

                    </div>

                    <div>

                        <strong>
                            Your Free pet profile is active
                        </strong>

                        <span>
                            You can continue editing this pet,
                            changing its photo, using its Pet ID,
                            and managing up to 5 health records.
                            Premium unlocks additional pet profiles
                            and unlimited health records.
                        </span>

                    </div>

                    <a href="/premium">
                        View Premium
                    </a>

                </div>
            }


            <!-- =====================================================
                 MESSAGE
                 ===================================================== -->
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="@(IsError
                                        ? "sp-pets-message error"
                                        : "sp-pets-message success")">

                    @StatusMessage

                </div>
            }


            <!-- =====================================================
                 ADD / EDIT PET FORM
                 ===================================================== -->
            @if (ShowPetForm)
            {
                <section class="sp-pet-form">

                    <div class="sp-pet-form-heading">

                        <div>

                            <span class="sp-pets-eyebrow">
                                @(IsEditingPet
                                    ? "EDIT PET PROFILE"
                                    : "NEW PET PROFILE")
                            </span>

                            <h2>
                                @(IsEditingPet
                                    ? $"Update {PetForm.PetName}"
                                    : "Add your pet")
                            </h2>

                            <p>
                                Choose from common options where
                                possible to make pet information
                                quicker and easier to enter.
                            </p>

                        </div>


                        <button type="button"
                                class="sp-close-button"
                                disabled="@IsSaving"
                                @onclick="ClosePetForm"
                                aria-label="Close">

                            <i class="bi bi-x-lg"></i>

                        </button>

                    </div>


                    <!-- =============================================
                         PHOTO
                         ============================================= -->

                    <div class="sp-photo-editor">

                        <div class="sp-photo-preview">

                            @if (!string.IsNullOrWhiteSpace(
                                PetPhotoPreview))
                            {
                                <img src="@PetPhotoPreview"
                                     alt="Pet photo preview" />
                            }
                            else
                            {
                                <div class="sp-photo-placeholder">

                                    <i class="bi bi-image"></i>

                                    <span>
                                        Pet Photo
                                    </span>

                                </div>
                            }

                        </div>


                        <div class="sp-photo-copy">

                            <strong>
                                Pet Photo
                            </strong>

                            <p>
                                Choose a clear JPG, PNG, or WEBP
                                image from your device.
                            </p>


                            <label class="sp-file-picker">

                                <i class="bi bi-upload"></i>

                                @(IsEditingPet
                                    ? "Choose New Photo"
                                    : "Choose Photo")

                                <InputFile OnChange="HandlePetPhotoSelected"
                                           accept="image/jpeg,image/png,image/webp"
                                           class="sp-file-input" />

                            </label>


                            @if (!string.IsNullOrWhiteSpace(
                                SelectedPetFileName))
                            {
                                <small>
                                    Selected: @SelectedPetFileName
                                </small>
                            }
                            else if (IsEditingPet &&
                                     !string.IsNullOrWhiteSpace(
                                         PetPhotoPreview))
                            {
                                <small>
                                    Current photo will remain unless
                                    you choose a new one.
                                </small>
                            }

                        </div>

                    </div>


                    <!-- =============================================
                         FORM FIELDS
                         ============================================= -->

                    <div class="sp-pet-form-grid">


                        <!-- PET NAME -->

                        <div class="sp-field wide">

                            <label>
                                Pet Name *
                            </label>

                            <input type="text"
                                   maxlength="150"
                                   @bind="PetForm.PetName"
                                   placeholder="Example: Beba" />

                        </div>


                        <!-- SPECIES -->

                        <div class="sp-field">

                            <label>
                                Species *
                            </label>

                            <select @bind="PetForm.Species"
                                    @bind:after="SpeciesChanged">

                                <option value="Dog">
                                    Dog
                                </option>

                                <option value="Cat">
                                    Cat
                                </option>

                                <option value="Rabbit">
                                    Rabbit
                                </option>

                                <option value="Bird">
                                    Bird
                                </option>

                                <option value="Hamster">
                                    Hamster
                                </option>

                                <option value="Fish">
                                    Fish
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- BREED -->

                        <div class="sp-field">

                            <label>
                                Breed
                            </label>


                            @if (PetForm.Species == "Other")
                            {
                                <input type="text"
                                       maxlength="150"
                                       @bind="PetForm.Breed"
                                       placeholder="Enter breed or pet type" />
                            }
                            else
                            {
                                <select @bind="PetForm.Breed">

                                    <option value="">
                                        Select breed
                                    </option>

                                    @foreach (var breed in CurrentBreeds)
                                    {
                                        <option value="@breed">
                                            @breed
                                        </option>
                                    }

                                </select>
                            }

                        </div>


                        <!-- AGE -->

                        <div class="sp-field">

                            <label>
                                Age
                            </label>

                            <select @bind="PetForm.Age">

                                <option value="">
                                    Select age
                                </option>

                                @foreach (var age in AgeOptions)
                                {
                                    <option value="@age">
                                        @age
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- WEIGHT -->

                        <div class="sp-field">

                            <label>
                                Weight
                            </label>

                            <div class="sp-weight-field">

                                <input type="number"
                                       min="0"
                                       step="0.1"
                                       @bind="PetForm.WeightKg"
                                       placeholder="0.0" />

                                <span>
                                    kg
                                </span>

                            </div>

                        </div>


                        <!-- DIET -->

                        <div class="sp-field wide">

                            <label>
                                Usual Diet
                            </label>

                            <select @bind="PetForm.Diet">

                                <option value="">
                                    Select usual diet
                                </option>

                                @foreach (var diet in DietOptions)
                                {
                                    <option value="@diet">
                                        @diet
                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <div class="sp-form-actions">

                        <button type="button"
                                class="sp-primary-action"
                                disabled="@IsSaving"
                                @onclick="SavePetAsync">

                            @if (IsSaving)
                            {
                                <span>
                                    Saving...
                                </span>
                            }
                            else if (IsEditingPet)
                            {
                                <span>
                                    Save Changes
                                </span>
                            }
                            else
                            {
                                <span>
                                    Save Pet
                                </span>
                            }

                        </button>


                        <button type="button"
                                class="sp-secondary-action"
                                disabled="@IsSaving"
                                @onclick="ClosePetForm">

                            Cancel

                        </button>

                    </div>

                </section>
            }


            <!-- =====================================================
                 SECTION TITLE
                 ===================================================== -->

            <div class="sp-pets-section-heading">

                <div>

                    <span class="sp-pets-eyebrow">
                        YOUR PETS
                    </span>

                    <h2>
                        Pet Profiles
                    </h2>

                </div>


                <span>
                    @Pets.Count
                    @(Pets.Count == 1
                        ? "pet"
                        : "pets")
                </span>

            </div>


            <!-- =====================================================
                 EMPTY
                 ===================================================== -->
            @if (Pets.Count == 0)
            {
                <section class="sp-empty-pets">

                    <div class="sp-empty-icon">

                        <i class="bi bi-heart"></i>

                    </div>

                    <h3>
                        Your first pet profile starts here.
                    </h3>

                    <p>
                        Add your pet to create a Digital Pet ID,
                        manage health information, and keep their
                        details organized.
                    </p>

                    <button type="button"
                            class="sp-primary-action"
                            @onclick="OpenAddForm">

                        <i class="bi bi-plus-lg"></i>

                        Add Your First Pet

                    </button>

                </section>
            }
            else
            {
                <!-- =================================================
                     PET GRID
                     ================================================= -->

                <div class="sp-pet-grid">

                    @foreach (var pet in Pets)
                    {
                        var photoUrl =
                            GetPetPhoto(
                                pet.Id);


                        <article class="sp-pet-card">


                            <div class="sp-pet-card-header">

                                <div class="sp-pet-card-photo">

                                    @if (!string.IsNullOrWhiteSpace(
                                        photoUrl))
                                    {
                                        <img src="@photoUrl"
                                             alt="@pet.PetName" />
                                    }
                                    else
                                    {
                                        <div class="sp-pet-initial">
                                            @GetPetInitial(pet)
                                        </div>
                                    }

                                </div>


                                <div class="sp-pet-title">

                                    <span>
                                        @pet.Species
                                    </span>

                                    <h3>
                                        @pet.PetName
                                    </h3>

                                    <p>
                                        @(string.IsNullOrWhiteSpace(
                                            pet.Breed)
                                            ? "Breed not specified"
                                            : pet.Breed)
                                    </p>

                                </div>


                                @if (IsPremium)
                                {
                                    <div class="sp-card-premium">

                                        <i class="bi bi-star-fill"></i>

                                    </div>
                                }

                            </div>


                            <!-- =====================================
                                 DETAILS
                                 ===================================== -->

                            <div class="sp-pet-info-grid">

                                <div>

                                    <span>
                                        Age
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(
                                            pet.Age)
                                            ? "Not set"
                                            : pet.Age)
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Weight
                                    </span>

                                    <strong>
                                        @(pet.WeightKg.HasValue
                                            ? $"{pet.WeightKg.Value:0.##} kg"
                                            : "Not set")
                                    </strong>

                                </div>


                                <div class="wide">

                                    <span>
                                        Diet
                                    </span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(
                                            pet.Diet)
                                            ? "Not set"
                                            : pet.Diet)
                                    </strong>

                                </div>

                            </div>


                            <!-- =====================================
                                 PET ID
                                 ===================================== -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            pet.CardId))
                            {
                                <div class="sp-pet-id-strip">

                                    <div>

                                        <span>
                                            DIGITAL PET ID
                                        </span>

                                        <strong>
                                            @pet.CardId
                                        </strong>

                                    </div>

                                    <i class="bi bi-qr-code"></i>

                                </div>
                            }


                            <!-- =====================================
                                 ACTIONS
                                 ===================================== -->

                            <div class="sp-pet-card-actions">

                                <button type="button"
                                        class="edit"
                                        @onclick="() => OpenEditForm(pet)">

                                    <i class="bi bi-pencil"></i>

                                    Edit

                                </button>


                                <a href="/pet/@pet.Id/card"
                                   class="primary">

                                    <i class="bi bi-person-vcard"></i>

                                    Pet ID

                                </a>


                                <a href="/pet/@pet.Id/records">

                                    <i class="bi bi-clipboard2-pulse"></i>

                                    Records

                                </a>


                                <button type="button"
                                        class="delete"
                                        @onclick="() => DeletePetAsync(pet)"
                                        title="Delete pet">

                                    <i class="bi bi-trash3"></i>

                                </button>

                            </div>

                        </article>
                    }

                </div>
            }

        </div>

    </section>

</div>


<style>

    .sp-pets-page {
        min-height: 100vh;
        background: #FAF9F6;
        color: #172A28;
    }


    .sp-pets-shell {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .sp-pets-hero {
        padding: 58px 0 52px;
        background: radial-gradient( circle at 88% 15%, rgba(243,210,122,.21), transparent 27% ), linear-gradient( 135deg, #173D3D, #102E2D );
        color: #FFFFFF;
    }


    .sp-pets-hero-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 35px;
    }


    .sp-pets-eyebrow {
        display: inline-block;
        color: #2F9098;
        font-size: .64rem;
        font-weight: 900;
        letter-spacing: .11em;
    }


        .sp-pets-eyebrow.light {
            color: #9ADBDD;
        }


    .sp-pets-hero h1 {
        max-width: 700px;
        margin: 9px 0 0;
        font-size: clamp(2.6rem, 5vw, 4.6rem);
        font-weight: 900;
        line-height: .95;
        letter-spacing: -.055em;
    }


        .sp-pets-hero h1 em {
            display: block;
            color: #F3D27A;
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 500;
        }


    .sp-pets-hero p {
        max-width: 620px;
        margin: 18px 0 0;
        color: rgba(255,255,255,.66);
        line-height: 1.65;
    }


    .sp-pets-hero-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }


    .sp-premium-badge {
        min-height: 43px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid rgba(243,210,122,.3);
        border-radius: 999px;
        background: rgba(243,210,122,.10);
        color: #F3D27A;
        font-size: .67rem;
        font-weight: 850;
    }


    .sp-pets-add,
    .sp-primary-action,
    .sp-secondary-action {
        min-height: 43px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 9px;
        font-size: .71rem;
        font-weight: 850;
        cursor: pointer;
    }


    .sp-pets-add,
    .sp-primary-action {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


    .sp-pets-add {
        border-color: #F3D27A;
        background: #F3D27A;
        color: #173D3D;
    }


    .sp-secondary-action {
        border: 1px solid #D7E0DD;
        background: #FFFFFF;
        color: #586762;
    }


    button:disabled {
        opacity: .55;
        cursor: not-allowed;
    }


    /* =========================================================
           CONTENT
           ========================================================= */

    .sp-pets-content {
        padding: 25px 0 80px;
    }


    /* =========================================================
           PLAN NOTICE
           ========================================================= */

    .sp-plan-notice {
        margin-bottom: 17px;
        padding: 14px 17px;
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 13px;
        border: 1px solid #E7D59A;
        border-radius: 13px;
        background: #FFF8DF;
    }


    .sp-plan-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #FFFFFF;
        color: #806212;
    }


    .sp-plan-notice strong,
    .sp-plan-notice span {
        display: block;
    }


    .sp-plan-notice strong {
        color: #5E4B17;
        font-size: .73rem;
    }


    .sp-plan-notice span {
        margin-top: 3px;
        color: #7E6C37;
        font-size: .65rem;
        line-height: 1.45;
    }


    .sp-plan-notice a {
        color: #6F5815;
        font-size: .67rem;
        font-weight: 850;
    }


    /* =========================================================
           MESSAGE
           ========================================================= */

    .sp-pets-message {
        margin-bottom: 17px;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: .72rem;
    }


        .sp-pets-message.success {
            border: 1px solid #B8DDCF;
            background: #EFFAF5;
            color: #28664D;
        }


        .sp-pets-message.error {
            border: 1px solid #F2B8B8;
            background: #FFF3F3;
            color: #9B2C2C;
        }


    /* =========================================================
           FORM
           ========================================================= */

    .sp-pet-form {
        margin-bottom: 27px;
        padding: 25px;
        border: 1px solid #DDE7E4;
        border-radius: 19px;
        background: #FFFFFF;
        box-shadow: 0 14px 36px rgba(23,61,61,.065);
    }


    .sp-pet-form-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }


        .sp-pet-form-heading h2 {
            margin: 5px 0 0;
            color: #173D3D;
            font-size: 1.35rem;
            font-weight: 900;
        }


        .sp-pet-form-heading p {
            margin: 5px 0 0;
            color: #80908B;
            font-size: .69rem;
        }


    .sp-close-button {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid #DCE5E2;
        border-radius: 9px;
        background: #FFFFFF;
        color: #63716D;
        cursor: pointer;
    }


    /* =========================================================
           PHOTO EDITOR
           ========================================================= */

    .sp-photo-editor {
        margin-top: 21px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 17px;
        border: 1px solid #E0E8E5;
        border-radius: 14px;
        background: #F8FBFA;
    }


    .sp-photo-preview {
        width: 105px;
        height: 105px;
        flex: 0 0 105px;
        overflow: hidden;
        border-radius: 16px;
        background: #ECF3F1;
    }


        .sp-photo-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .sp-photo-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        align-content: center;
        gap: 5px;
        color: #8B9994;
    }


        .sp-photo-placeholder i {
            font-size: 1.4rem;
        }


        .sp-photo-placeholder span {
            font-size: .59rem;
        }


    .sp-photo-copy strong,
    .sp-photo-copy p,
    .sp-photo-copy small {
        display: block;
    }


    .sp-photo-copy strong {
        color: #173D3D;
        font-size: .77rem;
    }


    .sp-photo-copy p {
        margin: 4px 0 10px;
        color: #7C8C87;
        font-size: .64rem;
    }


    .sp-photo-copy small {
        margin-top: 7px;
        color: #73827D;
        font-size: .6rem;
    }


    .sp-file-picker {
        position: relative;
        min-height: 38px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        overflow: hidden;
        border: 1px solid #C7D7D3;
        border-radius: 8px;
        background: #FFFFFF;
        color: #267C83;
        font-size: .65rem;
        font-weight: 850;
        cursor: pointer;
    }


    .sp-file-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }


    /* =========================================================
           FIELDS
           ========================================================= */

    .sp-pet-form-grid {
        margin-top: 18px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 13px;
    }


    .sp-field.wide {
        grid-column: 1 / -1;
    }


    .sp-field label {
        display: block;
        margin-bottom: 6px;
        color: #45554F;
        font-size: .67rem;
        font-weight: 850;
    }


    .sp-field input,
    .sp-field select {
        width: 100%;
        min-height: 45px;
        padding: 0 12px;
        border: 1px solid #CFDCD8;
        border-radius: 9px;
        background: #FFFFFF;
        color: #172A28;
        outline: none;
    }


        .sp-field input:focus,
        .sp-field select:focus {
            border-color: #2F9098;
            box-shadow: 0 0 0 3px rgba(47,144,152,.08);
        }


    .sp-weight-field {
        position: relative;
    }


        .sp-weight-field input {
            padding-right: 42px;
        }


        .sp-weight-field span {
            position: absolute;
            top: 50%;
            right: 12px;
            transform: translateY(-50%);
            color: #87958F;
            font-size: .67rem;
        }


    .sp-form-actions {
        margin-top: 19px;
        display: flex;
        gap: 8px;
    }


    /* =========================================================
           PET SECTION
           ========================================================= */

    .sp-pets-section-heading {
        margin: 30px 0 14px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 15px;
    }


        .sp-pets-section-heading h2 {
            margin: 4px 0 0;
            color: #173D3D;
            font-size: 1.45rem;
            font-weight: 900;
        }


        .sp-pets-section-heading > span {
            color: #84928D;
            font-size: .68rem;
        }


    /* =========================================================
           PET GRID
           ========================================================= */

    .sp-pet-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 14px;
    }


    .sp-pet-card {
        padding: 18px;
        border: 1px solid #DDE7E4;
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: 0 9px 25px rgba(23,61,61,.05);
        transition: transform .18s ease, box-shadow .18s ease;
    }


        .sp-pet-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 31px rgba(23,61,61,.08);
        }


    .sp-pet-card-header {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .sp-pet-card-photo {
        width: 70px;
        height: 70px;
        flex: 0 0 70px;
        overflow: hidden;
        border-radius: 18px;
        background: #EEF4F1;
    }


        .sp-pet-card-photo img {
