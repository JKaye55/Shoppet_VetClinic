@page "/register"
@rendermode InteractiveServer

@layout Shoppet_VetClinic.Components.Layout.LandingLayout

@using Shoppet_VetClinic.Services

@inject DatabaseService DbService
@inject NavigationManager Nav
@inject AuthService Auth
@inject NotificationService Notify

<PageTitle>Create Account | ShoppetCare</PageTitle>

<div class="sc-register-page">

    <div class="sc-register-shell">

        <!-- =====================================================
             LEFT SIDE
             ===================================================== -->

        <section class="sc-register-copy">

            <a href="/"
               class="sc-register-brand">

                <img src="/shoppetlogo.png"
                     alt="ShoppetCare" />

                <span>

                    <strong>
                        ShoppetCare
                    </strong>

                    <small>
                        Connected pet care
                    </small>

                </span>

            </a>


            <div>

                <span class="sc-register-eyebrow">
                    CREATE YOUR ACCOUNT
                </span>

                <h1>
                    Start with your pet.

                    <em>
                        Keep everything connected.
                    </em>
                </h1>

                <p>
                    A free account unlocks personal pet tools
                    while public clinic discovery and browsing
                    remain easy to explore.
                </p>

            </div>


            <div class="sc-register-preview">

                <article>

                    <strong>
                        Pet Profiles
                    </strong>

                    <small>
                        Create and manage your pet information.
                    </small>

                </article>


                <article>

                    <strong>
                        Digital Pet ID
                    </strong>

                    <small>
                        Keep an accessible QR-enabled
                        pet identity.
                    </small>

                </article>


                <article>

                    <strong>
                        Health Records
                    </strong>

                    <small>
                        Organize important vaccination
                        and health details.
                    </small>

                </article>

            </div>

        </section>


        <!-- =====================================================
             REGISTER FORM
             ===================================================== -->

        <section class="sc-register-panel">

            <div class="sc-register-card">

                <div class="sc-register-card-head">

                    <span class="sc-register-eyebrow">
                        FREE PET OWNER ACCOUNT
                    </span>

                    <h2>
                        Create account
                    </h2>

                    <p>
                        You can explore public ShoppetCare
                        features without an account.
                        Register when you're ready to use
                        personal tools.
                    </p>

                </div>


                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="sc-register-alert"
                         role="alert">

                        @errorMessage

                    </div>
                }


                <div class="sc-register-form">

                    <div class="sc-register-field">

                        <label for="register-name">
                            Full Name
                            <span>*</span>
                        </label>

                        <input id="register-name"
                               type="text"
                               maxlength="150"
                               placeholder="Juan Dela Cruz"
                               @bind="fullName"
                               autocomplete="name"
                               disabled="@isRegistering" />

                    </div>


                    <div class="sc-register-field">

                        <label for="register-email">
                            Email Address
                            <span>*</span>
                        </label>

                        <input id="register-email"
                               type="email"
                               maxlength="254"
                               placeholder="you@example.com"
                               @bind="email"
                               autocomplete="email"
                               disabled="@isRegistering" />

                    </div>

                    <div class="sc-register-field">

    <label for="register-mobile">
        Mobile Number <span>*</span>
    </label>

    <input id="register-mobile"
           type="tel"
           placeholder="0917 123 4567"
           @bind="mobileNumber"
           autocomplete="tel"
           inputmode="tel"
           disabled="@isRegistering" />

    <small>
        Used as the owner contact for your Digital Pet ID.
    </small>

</div>


                    <div class="sc-register-field">

                        <label for="register-password">
                            Password
                            <span>*</span>
                        </label>

                        <input id="register-password"
                               type="password"
                               maxlength="64"
                               placeholder="Use at least 15 characters"
                               @bind="password"
                               autocomplete="new-password"
                               disabled="@isRegistering" />

                        <small class="sc-register-password-help">
                            Use at least 15 characters. Spaces are allowed,
                            so a memorable passphrase works well.
                        </small>
                    </div>


                    <div class="sc-register-field">

                        <label for="register-confirm">
                            Confirm Password
                            <span>*</span>
                        </label>

                        <input id="register-confirm"
                               type="password"
                               maxlength="64"
                               placeholder="Enter the same password again"
                               @bind="confirmPassword"
                               autocomplete="new-password"
                               disabled="@isRegistering" />
                    </div>


                    <button type="button"
                            class="sc-register-primary"
                            @onclick="HandleRegistrationAsync"
                            disabled="@isRegistering">

                        @(isRegistering
                            ? "Creating account..."
                            : "Create Free Account")

                    </button>


                    <div class="sc-register-divider">

                        <span>
                            or
                        </span>

                    </div>


                    <button type="button"
                            class="sc-register-guest"
                            @onclick="ContinueAsGuestAsync"
                            disabled="@isRegistering">

                        Explore as Guest

                    </button>


                    <p class="sc-register-switch">

                        Already have an account?

                        <a href="/login">
                            Sign in
                        </a>

                    </p>

                </div>

            </div>

        </section>

    </div>

</div>


<style>
    .sc-register-password-help {
        display: block;
        margin-top: 5px;
        color: #87948F;
        font-size: .64rem;
        line-height: 1.4;
    }

    .sc-register-page {
        min-height: calc(100vh - 74px);
        padding: 34px;
        display: grid;
        place-items: center;
        background: radial-gradient( circle at 8% 12%, rgba(47,144,152,.12), transparent 28% ), radial-gradient( circle at 92% 88%, rgba(243,210,122,.16), transparent 25% ), #FBF8F2;
        color: #172A28;
    }


    .sc-register-shell {
        width: min(1180px, 100%);
        min-height: 690px;
        display: grid;
        grid-template-columns: minmax(0, .92fr) minmax(460px, 1.08fr);
        overflow: hidden;
        border: 1px solid #DDE7E4;
        border-radius: 28px;
        background: #FFFFFF;
        box-shadow: 0 30px 80px rgba(23,61,61,.13);
    }


    .sc-register-copy {
        padding: 42px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: radial-gradient( circle at 75% 20%, rgba(243,210,122,.19), transparent 27% ), linear-gradient( 145deg, #173D3D 0%, #102E2D 100% );
        color: #FFFFFF;
    }


    .sc-register-brand {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        color: #FFFFFF;
        text-decoration: none;
    }


        .sc-register-brand img {
            width: 52px;
            height: 52px;
            padding: 5px;
            object-fit: contain;
            border-radius: 14px;
            background: #FFFFFF;
        }


        .sc-register-brand span,
        .sc-register-brand strong,
        .sc-register-brand small {
            display: block;
        }


        .sc-register-brand strong {
            font-size: 1.05rem;
        }


        .sc-register-brand small {
            margin-top: 3px;
            color: rgba(255,255,255,.55);
            font-size: .68rem;
        }


    .sc-register-eyebrow {
        display: inline-block;
        margin-bottom: 12px;
        color: #2F9098;
        font-size: .67rem;
        font-weight: 900;
        letter-spacing: .11em;
    }


    .sc-register-copy
    .sc-register-eyebrow {
        color: #9ADBDD;
    }


    .sc-register-copy h1 {
        max-width: 510px;
        margin: 0;
        font-size: clamp( 2.8rem, 4.4vw, 4.7rem );
        font-weight: 900;
        line-height: .96;
        letter-spacing: -.055em;
    }


        .sc-register-copy h1 em {
            display: block;
            margin-top: 5px;
            color: #F3D27A;
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 500;
            font-size: .91em;
        }


    .sc-register-copy > div > p {
        max-width: 460px;
        margin: 21px 0 0;
        color: rgba(255,255,255,.68);
        font-size: .91rem;
        line-height: 1.68;
    }


    .sc-register-preview {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }


        .sc-register-preview article {
            padding: 12px;
            border: 1px solid rgba(255,255,255,.11);
            border-radius: 13px;
            background: rgba(255,255,255,.06);
        }


        .sc-register-preview strong,
        .sc-register-preview small {
            display: block;
        }


        .sc-register-preview strong {
            color: #FFFFFF;
            font-size: .72rem;
        }


        .sc-register-preview small {
            margin-top: 4px;
            color: rgba(255,255,255,.50);
            font-size: .61rem;
            line-height: 1.45;
        }


    /* =========================================================
           FORM SIDE
           ========================================================= */

    .sc-register-panel {
        padding: 42px 48px;
        display: grid;
        place-items: center;
    }


    .sc-register-card {
        width: min(450px, 100%);
    }


    .sc-register-card-head h2 {
        margin: 0;
        color: #173D3D;
        font-size: 2.35rem;
        font-weight: 900;
        letter-spacing: -.045em;
    }


    .sc-register-card-head p {
        margin: 9px 0 0;
        color: #7C8C87;
        font-size: .8rem;
        line-height: 1.5;
    }


    .sc-register-alert {
        margin-top: 19px;
        padding: 12px 14px;
        border: 1px solid #F5B8B8;
        border-radius: 11px;
        background: #FFF2F2;
        color: #9B2C2C;
        font-size: .77rem;
        line-height: 1.45;
    }


    .sc-register-form {
        margin-top: 22px;
        display: grid;
        gap: 13px;
    }


    .sc-register-field label {
        display: block;
        margin-bottom: 6px;
        color: #173D3D;
        font-size: .74rem;
        font-weight: 800;
    }


        .sc-register-field label span {
            color: #B34545;
        }


    .sc-register-field input {
        width: 100%;
        min-height: 48px;
        padding: 0 14px;
        border: 1px solid #C9D9D5;
        border-radius: 11px;
        outline: none;
    }


        .sc-register-field input:focus {
            border-color: #2F9098;
            box-shadow: 0 0 0 3px rgba(47,144,152,.10);
        }


    .sc-register-primary,
    .sc-register-guest {
        min-height: 50px;
        border-radius: 11px;
        font-weight: 850;
        cursor: pointer;
        transition: transform .18s ease, background .18s ease, border-color .18s ease;
    }


    .sc-register-primary {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


        .sc-register-primary:hover {
            transform: translateY(-2px);
            background: #267C83;
            border-color: #267C83;
        }


    .sc-register-guest {
        border: 1px solid #C9D9D5;
        background: #FFFFFF;
        color: #173D3D;
    }


        .sc-register-guest:hover {
            transform: translateY(-2px);
            background: #EAF5F5;
            border-color: #AFCBC7;
        }


    .sc-register-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #9AA6A2;
        font-size: .68rem;
    }


        .sc-register-divider::before,
        .sc-register-divider::after {
            content: "";
            height: 1px;
            flex: 1;
            background: #E1E9E6;
        }


    .sc-register-switch {
        margin: 2px 0 0;
        text-align: center;
        color: #7C8C87;
        font-size: .76rem;
    }


        .sc-register-switch a {
            color: #267C83;
            font-weight: 850;
            text-decoration: none;
        }


    @@media (max-width: 900px) {

        .sc-register-page {
            padding: 18px;
        }


        .sc-register-shell {
            grid-template-columns: 1fr;
        }


        .sc-register-copy {
            min-height: 390px;
            padding: 30px;
        }


        .sc-register-preview {
            margin-top: 30px;
        }


        .sc-register-panel {
            padding: 34px 24px;
        }
    }


    @@media (max-width: 560px) {

        .sc-register-preview {
            grid-template-columns: 1fr;
        }
    }

</style>
@code {

    private string fullName =
        string.Empty;

    private string mobileNumber =
        string.Empty;

    private string email =
        string.Empty;

    private string password =
        string.Empty;

    private string confirmPassword =
        string.Empty;


    private string errorMessage =
        string.Empty;

    private bool isRegistering;


    private async Task HandleRegistrationAsync()
    {
        if (isRegistering)
            return;


        errorMessage =
            string.Empty;


        fullName =
            fullName.Trim();


        email =
            email
                .Trim()
                .ToLowerInvariant();


        mobileNumber =
            NormalizeMobileNumber(
                mobileNumber);


        // =====================================================
        // REQUIRED FIELDS
        // =====================================================

        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(mobileNumber) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage =
                "Please complete all required fields.";

            return;
        }


        // =====================================================
        // MOBILE VALIDATION
        // Expected stored format:
        // 09171234567
        // =====================================================

        if (mobileNumber.Length != 11 ||
            !mobileNumber.StartsWith(
                "09",
                StringComparison.Ordinal))
        {
            errorMessage =
                "Please enter a valid Philippine mobile number, for example 09171234567.";

            return;
        }


        // =====================================================
        // PASSWORD
        // =====================================================

        if (password.Length < 8)
        {
            errorMessage =
                "Please use a password with at least 8 characters.";

            return;
        }


        if (!string.Equals(
                password,
                confirmPassword,
                StringComparison.Ordinal))
        {
            errorMessage =
                "The passwords do not match.";

            return;
        }


        isRegistering =
            true;


        try
        {
            var user =
                DbService.RegisterUser(
                    fullName,
                    mobileNumber,
                    email,
                    password,
                    "Pet Owner");


            if (user is null)
            {
                errorMessage =
                    "That email address is already registered.";

                return;
            }


            Notify.WelcomeUser(
                user.Id,
                user.FullName);


            await Auth.LoginAsync(
                user);


            Nav.NavigateTo(
                "/home");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Registration Error] {ex}");


            errorMessage =
                "Registration could not be completed right now. Please try again.";
        }
        finally
        {
            isRegistering =
                false;
        }
    }


    private static string NormalizeMobileNumber(
        string value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return string.Empty;
        }


        var digits =
            new string(
                value
                    .Where(char.IsDigit)
                    .ToArray());


        /*
            +63 917 123 4567
            becomes:
            09171234567
        */

        if (digits.Length == 12 &&
            digits.StartsWith(
                "63",
                StringComparison.Ordinal))
        {
            digits =
                "0" +
                digits.Substring(2);
        }


        return digits;
    }


    private async Task ContinueAsGuestAsync()
    {
        if (isRegistering)
            return;


        await Auth.EnterGuestModeAsync();


        Nav.NavigateTo(
            "/home");
    }

}
}