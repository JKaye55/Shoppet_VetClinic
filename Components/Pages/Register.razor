@page "/register"
@rendermode InteractiveServer
@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services
@inject DatabaseService DbService
@inject NavigationManager Nav
@inject AuthService Auth
@inject NotificationService Notify

<div class="shoppet-viewport">
    <main class="container-xl py-5 flex-grow-1">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <span class="badge rounded-pill px-3 py-1 mb-2 small fw-bold"
                              style="background: #EEF4F1; color: #1E2D27;">
                            Pilot Testing Portal
                        </span>
                        <h3 class="fw-bold" style="color: #1E2824;">Create Your Account</h3>
                        <p class="text-muted small">
                            Register to access your full pet care management dashboard and history records.
                        </p>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger small py-2 rounded-3 mb-3">
                            @errorMessage
                        </div>
                    }

                    <div class="vstack gap-3">
                        <div>
                            <label class="form-label small fw-bold text-muted mb-1">Full Name *</label>
                            <input class="form-control rounded-3"
                                   placeholder="Juan Dela Cruz"
                                   @bind="fullName" />
                        </div>

                        <div>
                            <label class="form-label small fw-bold text-muted mb-1">Email Address *</label>
                            <input type="email" class="form-control rounded-3"
                                   placeholder="juandelacruz@gmail.com"
                                   @bind="email" />
                        </div>

                        <div>
                            <label class="form-label small fw-bold text-muted mb-1">Password *</label>
                            <input type="password" class="form-control rounded-3"
                                   placeholder="••••••••"
                                   @bind="password" />
                        </div>

                        <div class="pt-3">
                            <button class="btn w-100 py-3 fw-bold shadow-sm rounded-pill"
                                    style="background-color: #F7DD7D; color: #2F423B;"
                                    @onclick="HandleRegistration">
                                Complete Registration &amp; Login
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small class="text-muted">
                                Already participating in the pilot?
                                <a href="/login" class="text-decoration-none fw-bold" style="color: #5C766D;">
                                    Sign In here
                                </a>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private void HandleRegistration()
    {
        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please fill out all required fields to register.";
            return;
        }

        email = email.Trim().ToLowerInvariant();

        try
        {
            var user = DbService.RegisterUser(
                fullName.Trim(),
                email,
                password,
                "Pet Owner");

            if (user is null)
            {
                errorMessage = "That email address is already registered.";
                return;
            }

            // 🔔 Send welcome notification
            Notify.WelcomeUser(user.Id, user.FullName);

            Auth.Login(user);
            Nav.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Registration failed: {ex.Message}";
        }
    }
}