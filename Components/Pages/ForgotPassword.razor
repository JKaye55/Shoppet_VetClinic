@page "/forgot-password"
@rendermode InteractiveServer

@layout LandingLayout

@using System.Security.Cryptography

@inject DatabaseService Db
@inject NavigationManager Nav

<PageTitle>Reset Password | ShoppetCare</PageTitle>


<div class="sc-reset-page">

    <div class="sc-reset-shell">

        <a href="/"
           class="sc-reset-brand">

            <img src="/shoppetlogo.png"
                 alt="ShoppetCare" />

            <span>

                <strong>
                    ShoppetCare
                </strong>

                <small>
                    Connected pet care
                </small>

            </span>

        </a>


        <section class="sc-reset-card">

            <span class="sc-reset-eyebrow">
                ACCOUNT RECOVERY
            </span>


            @if (stage == 1)
            {
                <h1>
                    Forgot your password?
                </h1>

                <p class="intro">
                    Enter your account email.
                    For this pilot build, a temporary verification
                    code will be displayed on this page.
                </p>


                <div class="sc-reset-notice">

                    <strong>
                        Pilot Mode
                    </strong>

                    <span>
                        A production release would send this
                        verification code through a secure email
                        or another verified recovery channel.
                    </span>

                </div>


                <label>
                    Email Address
                </label>

                <input type="email"
                       maxlength="254"
                       autocomplete="email"
                       placeholder="you@example.com"
                       @bind="email" />


                @if (!string.IsNullOrWhiteSpace(
                    errorMessage))
                {
                    <div class="sc-reset-error">
                        @errorMessage
                    </div>
                }


                <button type="button"
                        class="primary"
                        @onclick="RequestCode">

                    Continue

                </button>
            }
            else if (stage == 2)
            {
                <h1>
                    Verify your request
                </h1>

                <p class="intro">
                    Enter the six-digit pilot verification code.
                </p>


                <div class="sc-demo-code">

                    <span>
                        PILOT VERIFICATION CODE
                    </span>

                    <strong>
                        @verificationCode
                    </strong>

                    <small>
                        Expires in 10 minutes.
                    </small>

                </div>


                <label>
                    Verification Code
                </label>

                <input type="text"
                       inputmode="numeric"
                       maxlength="6"
                       autocomplete="one-time-code"
                       placeholder="000000"
                       @bind="enteredCode" />


                @if (!string.IsNullOrWhiteSpace(
                    errorMessage))
                {
                    <div class="sc-reset-error">
                        @errorMessage
                    </div>
                }


                <button type="button"
                        class="primary"
                        @onclick="VerifyCode">

                    Verify Code

                </button>


                <button type="button"
                        class="secondary"
                        @onclick="StartOver">

                    Use Another Email

                </button>
            }
            else
            {
                <h1>
                    Create a new password
                </h1>

                <p class="intro">
                    Choose a new password of at least
                    15 characters.
                </p>


                <label>
                    New Password
                </label>

                <input type="password"
                       maxlength="64"
                       autocomplete="new-password"
                       placeholder="At least 15 characters"
                       @bind="newPassword" />


                <small class="password-note">
                    Spaces are allowed. A longer memorable
                    passphrase works well.
                </small>


                <label>
                    Confirm New Password
                </label>

                <input type="password"
                       maxlength="64"
                       autocomplete="new-password"
                       placeholder="Enter the same password"
                       @bind="confirmPassword" />


                @if (!string.IsNullOrWhiteSpace(
                    errorMessage))
                {
                    <div class="sc-reset-error">
                        @errorMessage
                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(
                    successMessage))
                {
                    <div class="sc-reset-success">
                        @successMessage
                    </div>
                }


                @if (string.IsNullOrWhiteSpace(
                    successMessage))
                {
                    <button type="button"
                            class="primary"
                            @onclick="ResetPassword">

                        Save New Password

                    </button>
                }
                else
                {
                    <a href="/login"
                       class="primary link-button">

                        Return to Sign In

                    </a>
                }
            }


            <a href="/login"
               class="back-link">

                Back to Sign In

            </a>

        </section>

    </div>

</div>


<style>

    .sc-reset-page {
        min-height: 100vh;
        padding: 42px 20px;
        display: grid;
        place-items: center;
        background: radial-gradient( circle at 10% 12%, rgba(47,144,152,.12), transparent 28% ), radial-gradient( circle at 90% 85%, rgba(243,210,122,.14), transparent 25% ), #FBF8F2;
    }


    .sc-reset-shell {
        width: min(520px,100%);
    }


    .sc-reset-brand {
        margin-bottom: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        color: #173D3D;
        text-decoration: none;
    }


        .sc-reset-brand img {
            width: 44px;
            height: 44px;
            object-fit: contain;
        }


        .sc-reset-brand strong,
        .sc-reset-brand small {
            display: block;
        }


        .sc-reset-brand strong {
            font-size: .9rem;
            font-weight: 950;
        }


        .sc-reset-brand small {
            margin-top: 2px;
            color: #81908B;
            font-size: .56rem;
        }


    .sc-reset-card {
        padding: 34px;
        border: 1px solid #DDE7E4;
        border-radius: 22px;
        background: #FFFFFF;
        box-shadow: 0 24px 60px rgba(23,61,61,.11);
    }


    .sc-reset-eyebrow {
        color: #2F9098;
        font-size: .61rem;
        font-weight: 900;
        letter-spacing: .11em;
    }


    .sc-reset-card h1 {
        margin: 7px 0 0;
        color: #173D3D;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -.04em;
    }


    .intro {
        margin: 8px 0 22px;
        color: #73837D;
        font-size: .76rem;
        line-height: 1.55;
    }


    .sc-reset-card label {
        display: block;
        margin: 14px 0 6px;
        color: #173D3D;
        font-size: .7rem;
        font-weight: 850;
    }


    .sc-reset-card input {
        width: 100%;
        min-height: 48px;
        padding: 0 13px;
        border: 1px solid #C9D9D5;
        border-radius: 10px;
        outline: none;
    }


        .sc-reset-card input:focus {
            border-color: #2F9098;
            box-shadow: 0 0 0 3px rgba(47,144,152,.10);
        }


    .sc-reset-notice {
        margin-bottom: 20px;
        padding: 12px 13px;
        border: 1px solid #E7D59A;
        border-radius: 10px;
        background: #FFF8DF;
    }


        .sc-reset-notice strong,
        .sc-reset-notice span {
            display: block;
        }


        .sc-reset-notice strong {
            color: #6E5716;
            font-size: .66rem;
        }


        .sc-reset-notice span {
            margin-top: 3px;
            color: #7D6A34;
            font-size: .6rem;
            line-height: 1.45;
        }


    .sc-demo-code {
        margin: 18px 0;
        padding: 17px;
        border-radius: 13px;
        background: #EAF5F5;
        text-align: center;
    }


        .sc-demo-code span,
        .sc-demo-code strong,
        .sc-demo-code small {
            display: block;
        }


        .sc-demo-code span {
            color: #267C83;
            font-size: .54rem;
            font-weight: 900;
            letter-spacing: .08em;
        }


        .sc-demo-code strong {
            margin-top: 5px;
            color: #173D3D;
            font-family: monospace;
            font-size: 1.7rem;
            letter-spacing: .14em;
        }


        .sc-demo-code small {
            margin-top: 3px;
            color: #75847F;
            font-size: .56rem;
        }


    .primary,
    .secondary {
        width: 100%;
        min-height: 47px;
        margin-top: 16px;
        border-radius: 10px;
        font-size: .7rem;
        font-weight: 900;
    }


    .primary {
        border: 1px solid #2F9098;
        background: #2F9098;
        color: #FFFFFF;
    }


    .secondary {
        margin-top: 7px;
        border: 1px solid #D2DEDA;
        background: #FFFFFF;
        color: #566761;
    }


    .link-button {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }


    .back-link {
        margin-top: 18px;
        display: block;
        color: #267C83;
        text-align: center;
        font-size: .65rem;
        font-weight: 800;
        text-decoration: none;
    }


    .password-note {
        display: block;
        margin-top: 5px;
        color: #82908B;
        font-size: .58rem;
    }


    .sc-reset-error,
    .sc-reset-success {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        font-size: .66rem;
    }


    .sc-reset-error {
        border: 1px solid #F0BABA;
        background: #FFF3F3;
        color: #963B3B;
    }


    .sc-reset-success {
        border: 1px solid #B9DDCF;
        background: #EFFAF5;
        color: #28664D;
    }

</style>


@code {

    private int stage =
        1;


    private string email =
        string.Empty;


    private string verificationCode =
        string.Empty;


    private string enteredCode =
        string.Empty;


    private DateTime codeExpiresAt;


    private int targetUserId;


    private string newPassword =
        string.Empty;


    private string confirmPassword =
        string.Empty;


    private string errorMessage =
        string.Empty;


    private string successMessage =
        string.Empty;


    private void RequestCode()
    {
        errorMessage =
            string.Empty;


        email =
            AuthService.NormalizeEmail(
                email);


        if (!AuthService
            .IsValidEmailAddress(
                email))
        {
            errorMessage =
                "Please enter a valid email address.";

            return;
        }


        var user =
            Db.GetUserByEmail(
                email);


        targetUserId =
            user?.Id
            ??
            0;


        // Always create a code so the first response
        // behaves consistently in pilot mode.
        verificationCode =
            RandomNumberGenerator
                .GetInt32(
                    100000,
                    1000000)
                .ToString();


        codeExpiresAt =
            DateTime.UtcNow
                .AddMinutes(10);


        enteredCode =
            string.Empty;


        stage =
            2;
    }


    private void VerifyCode()
    {
        errorMessage =
            string.Empty;


        if (DateTime.UtcNow >
            codeExpiresAt)
        {
            errorMessage =
                "This verification code has expired. Please request another code.";

            return;
        }


        if (!string.Equals(
            enteredCode.Trim(),
            verificationCode,
            StringComparison.Ordinal))
        {
            errorMessage =
                "The verification code is incorrect.";

            return;
        }


        stage =
            3;
    }


    private void ResetPassword()
    {
        errorMessage =
            string.Empty;


        successMessage =
            string.Empty;


        var passwordError =
            AuthService
                .ValidateNewPassword(
                    newPassword);


        if (passwordError is not null)
        {
            errorMessage =
                passwordError;

            return;
        }


        if (!string.Equals(
            newPassword,
            confirmPassword,
            StringComparison.Ordinal))
        {
            errorMessage =
                "The passwords do not match.";

            return;
        }


        if (targetUserId <= 0 ||
            !Db.UpdateUserPassword(
                targetUserId,
                newPassword))
        {
            errorMessage =
                "This password reset request could not be completed.";

            return;
        }


        // Single-use code.
        verificationCode =
            string.Empty;


        enteredCode =
            string.Empty;


        codeExpiresAt =
            DateTime.MinValue;


        successMessage =
            "Your password has been updated. You can now sign in with the new password.";
    }


    private void StartOver()
    {
        stage =
            1;


        email =
            string.Empty;


        verificationCode =
            string.Empty;


        enteredCode =
            string.Empty;


        targetUserId =
            0;


        errorMessage =
            string.Empty;


        newPassword =
            string.Empty;


        confirmPassword =
            string.Empty;
    }

}