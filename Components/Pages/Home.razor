@page "/"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject DatabaseService DbService
@inject NavigationManager Nav

<div class="shoppet-home">

    <!-- =========================================================
         HERO SECTION
         ========================================================= -->
    <section class="hero-section">
        <div class="container-xl">

            <div class="row align-items-center g-4">

                <!-- HERO TEXT -->
                <div class="col-12 col-lg-6">

                    <span class="hero-eyebrow">
                        SHOPPET CARE
                    </span>

                    <h1 class="hero-title">
                        Better care for
                        <span>every pet.</span>
                    </h1>

                    <p class="hero-description">
                        Find trusted veterinary clinics, pet supplies,
                        food, services, and helpful information for your
                        pets around Lipa City and Tanauan.
                    </p>

                    <div class="hero-buttons">

                        <button type="button"
                                class="btn primary-btn"
                                @onclick="GoToClinics">
                            Find a Veterinary Clinic
                        </button>

                        <button type="button"
                                class="btn secondary-btn"
                                @onclick="GoToPetShop">
                            Explore Pet Shop
                        </button>

                    </div>

                </div>


                <!-- HERO IMAGE -->
                <div class="col-12 col-lg-6">

                    <div class="hero-image-wrapper">

                        <img src="/hero_vet_hd.jpg"
                             alt="Veterinarian caring for a pet"
                             class="hero-image" />

                        <div class="hero-floating-card">

                            <div class="floating-icon">
                                <span class="floating-icon-mark">
                                    CARE
                                </span>
                            </div>

                            <div>
                                <strong>Pet care made easier</strong>

                                <small>
                                    Find clinics, services &amp; supplies
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 SEARCH / FILTER CARD
                 ===================================================== -->
            <div class="hero-search-card">

                <div class="search-heading">

                    <div class="search-heading-icon"
                         aria-hidden="true">

                        <span class="search-icon-mark"></span>

                    </div>

                    <div>

                        <h3>
                            Find Pet Care Near You
                        </h3>

                        <p>
                            Search clinics, pet shops, services, and brands.
                        </p>

                    </div>

                </div>


                <div class="row g-3">

                    <!-- SEARCH -->
                    <div class="col-12 col-lg-5 position-relative">

                        <label class="search-label">
                            What are you looking for?
                        </label>

                        <input class="form-control search-input bg-white"
                               type="text"
                               placeholder="Type clinic name (e.g. Maxivet)..."
                               @bind="homeSearch"
                               @bind:event="oninput" />

                        @if (!string.IsNullOrWhiteSpace(homeSearch)
                            && cachedSuggestions.Any())
                        {
                            <div class="live-suggestions-dropdown">

                                @foreach (var clinic in cachedSuggestions)
                                {
                                    <button type="button"
                                            class="suggestion-item"
                                            @onclick="() => SelectClinic(clinic)">

                                        <div class="d-flex justify-content-between align-items-center">

                                            <strong class="text-dark">
                                                @clinic.ClinicName
                                            </strong>

                                            <span class="badge bg-light text-success border">
                                                @clinic.Branch
                                            </span>

                                        </div>

                                        <small class="text-muted d-block mt-1">
                                            @clinic.Address
                                        </small>

                                    </button>
                                }

                            </div>
                        }

                    </div>


                    <!-- LOCATION -->
                    <div class="col-12 col-lg-3">

                        <label class="search-label">
                            Location
                        </label>

                        <select class="form-select search-input"
                                @bind="homeLocation">

                            <option value="">
                                All Locations
                            </option>

                            <option value="Lipa">
                                Lipa City
                            </option>

                            <option value="Tanauan">
                                Tanauan City
                            </option>

                        </select>

                    </div>


                    <!-- PROVIDER -->
                    <div class="col-12 col-lg-2">

                        <label class="search-label">
                            Provider
                        </label>

                        <select class="form-select search-input"
                                @bind="homeProvider">

                            <option value="">
                                All Providers
                            </option>

                            <option value="Veterinary">
                                Veterinary Clinic
                            </option>

                            <option value="Pet Shop">
                                Pet Shop
                            </option>

                        </select>

                    </div>


                    <!-- FIND BUTTON -->
                    <div class="col-12 col-lg-2 d-flex align-items-end">

                        <button type="button"
                                class="btn find-care-btn w-100"
                                @onclick="SearchClinics">

                            Find Care

                        </button>

                    </div>

                </div>


                <!-- SELECTED CLINIC PREVIEW -->
                @if (selectedActiveClinic != null)
                {
                    <div class="filter-sneak-peek-card mt-3">

                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                            <div>

                                <span class="selected-match-label">
                                    Selected Match
                                </span>

                                <h6 class="mb-1 text-dark fw-bold">
                                    @selectedActiveClinic.ClinicName
                                    <span class="selected-branch">
                                        @selectedActiveClinic.Branch
                                    </span>
                                </h6>

                                <p class="text-muted mb-0 small">
                                    @selectedActiveClinic.Address

                                    @if (!string.IsNullOrWhiteSpace(selectedActiveClinic.PrcLicenseNo))
                                    {
                                        <span>
                                            · PRC @selectedActiveClinic.PrcLicenseNo
                                        </span>
                                    }
                                </p>

                            </div>

                            <button type="button"
                                    class="btn preview-btn"
                                    @onclick="SearchClinics">

                                View Full Details
                                <span>→</span>

                            </button>

                        </div>

                    </div>
                }


                <!-- QUICK SEARCHES -->
                <div class="quick-searches">

                    <span class="quick-label">
                        Popular:
                    </span>

                    <button type="button"
                            @onclick='() => QuickHomeSearch("Vaccination")'>

                        Vaccination

                    </button>

                    <button type="button"
                            @onclick='() => QuickHomeSearch("Consultation")'>

                        Consultation

                    </button>

                    <button type="button"
                            @onclick='() => QuickHomeSearch("Royal Canin")'>

                        Royal Canin

                    </button>

                    <button type="button"
                            @onclick='() => QuickHomeSearch("Hills")'>

                        Hill's

                    </button>

                </div>

            </div>

        </div>
    </section>


    <!-- =========================================================
         QUICK ACTIONS
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="section-heading">

                <div>

                    <span class="section-eyebrow">
                        QUICK ACCESS
                    </span>

                    <h2>
                        What does your pet need?
                    </h2>

                </div>

                <button type="button"
                        class="text-link"
                        @onclick="GoToClinics">

                    View all care options →

                </button>

            </div>


            <div class="row g-3">

                <!-- VETERINARY -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick="GoToClinics">

                        <div class="quick-card-icon">
                            CARE
                        </div>

                        <h4>
                            Veterinary Care
                        </h4>

                        <p>
                            Find veterinary clinics and
                            pet-care professionals.
                        </p>

                        <span>
                            Find a clinic →
                        </span>

                    </button>

                </div>


                <!-- VACCINATIONS -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick='() => QuickHomeSearch("Vaccination")'>

                        <div class="quick-card-icon">
                            VAX
                        </div>

                        <h4>
                            Vaccinations
                        </h4>

                        <p>
                            Look for clinics offering
                            vaccination services.
                        </p>

                        <span>
                            Find vaccination →
                        </span>

                    </button>

                </div>


                <!-- PET FOOD -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick='() => QuickHomeSearch("Pet Food")'>

                        <div class="quick-card-icon">
                            FOOD
                        </div>

                        <h4>
                            Pet Food
                        </h4>

                        <p>
                            Discover pet food and
                            available brands.
                        </p>

                        <span>
                            Find pet food →
                        </span>

                    </button>

                </div>


                <!-- SUPPLIES -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick='() => QuickHomeSearch("Pet Supplies")'>

                        <div class="quick-card-icon">
                            SUPPLY
                        </div>

                        <h4>
                            Pet Supplies
                        </h4>

                        <p>
                            Browse useful products and
                            supplies for your pet.
                        </p>

                        <span>
                            Explore supplies →
                        </span>

                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         INFORMATION STRIP
         ========================================================= -->
    <section class="info-strip">

        <div class="container-xl">

            <div class="row g-3">

                <div class="col-12 col-md-4">

                    <div class="info-item">

                        <span class="info-icon">
                            ✓
                        </span>

                        <div>

                            <strong>
                                Local Pet Care
                            </strong>

                            <small>
                                Clinics and providers around
                                Lipa and Tanauan.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="col-12 col-md-4">

                    <div class="info-item">

                        <span class="info-icon">
                            FIND
                        </span>

                        <div>

                            <strong>
                                Easy Discovery
                            </strong>

                            <small>
                                Quickly find services,
                                facilities, and products.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="col-12 col-md-4">

                    <div class="info-item">

                        <span class="info-icon">
                            HELP
                        </span>

                        <div>

                            <strong>
                                Helpful Support
                            </strong>

                            <small>
                                Get answers and connect
                                with pet-care providers.
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CORE SERVICES
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="section-heading centered">

                <span class="section-eyebrow">
                    SHOPPET CARE
                </span>

                <h2>
                    Everything your pet needs,
                    <br />
                    in one place.
                </h2>

                <p>
                    From professional veterinary care to everyday
                    pet essentials, Shoppet Care helps make pet
                    care easier to discover.
                </p>

            </div>


            <div class="row g-4">

                <!-- VETERINARY -->
                <div class="col-12 col-lg-6">

                    <div class="feature-card">

                        <div class="feature-image">

                            <img src="/vet_wpets.jpg"
                                 alt="Veterinary care"
                                 loading="lazy" />

                        </div>

                        <div class="feature-content">

                            <span class="feature-tag">
                                VETERINARY CARE
                            </span>

                            <h3>
                                Find trusted veterinary care
                            </h3>

                            <p>
                                Search for nearby veterinary clinics
                                and discover their available services
                                and contact information.
                            </p>

                            <button type="button"
                                    class="btn feature-btn"
                                    @onclick="GoToClinics">

                                Find a Clinic →

                            </button>

                        </div>

                    </div>

                </div>


                <!-- PET SHOP -->
                <div class="col-12 col-lg-6">

                    <div class="feature-card">

                        <div class="feature-image">

                            <img src="/foodprod.png"
                                 alt="Pet food and supplies"
                                 loading="lazy" />

                        </div>

                        <div class="feature-content">

                            <span class="feature-tag">
                                PET SHOP
                            </span>

                            <h3>
                                Pet food &amp; everyday supplies
                            </h3>

                            <p>
                                Discover food, supplies, and products
                                that help keep your pets happy and comfortable.
                            </p>

                            <button type="button"
                                    class="btn feature-btn"
                                    @onclick="GoToPetShop">

                                Explore Pet Shop →

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CATEGORY SHOWCASE
         ========================================================= -->
    <section class="category-section">

        <div class="container-xl">

            <div class="row g-4">

                <!-- VETERINARY -->
                <div class="col-12 col-lg-6">

                    <div class="category-card">

                        <img src="/petvitna.jpg"
                             alt="Veterinary services"
                             loading="lazy" />

                        <div class="category-overlay">

                            <span>
                                CARE
                            </span>

                            <h3>
                                Veterinary Services
                            </h3>

                            <p>
                                Find clinics for consultations,
                                vaccinations, and other pet-care needs.
                            </p>

                            <button type="button"
                                    @onclick="GoToClinics">

                                Find Veterinary Care →

                            </button>

                        </div>

                    </div>

                </div>


                <!-- PET SUPPLIES -->
                <div class="col-12 col-lg-6">

                    <div class="category-card">

                        <img src="/premiumft.png"
                             alt="Pet supplies"
                             loading="lazy" />

                        <div class="category-overlay">

                            <span>
                                SHOP
                            </span>

                            <h3>
                                Pet Food &amp; Supplies
                            </h3>

                            <p>
                                Explore food, accessories, beds,
                                and other everyday pet essentials.
                            </p>

                            <button type="button"
                                    @onclick="GoToPetShop">

                                Explore Pet Shop →

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PEOPLE BEHIND THE CARE
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="people-card">

                <div class="people-image">

                    <img src="/vet_group.png"
                         alt="Veterinary care team"
                         loading="lazy" />

                </div>

                <div class="people-content">

                    <span class="section-eyebrow">
                        PEOPLE BEHIND THE CARE
                    </span>

                    <h2>
                        Helping pet owners find the care they need.
                    </h2>

                    <p>
                        Shoppet Care connects pet owners with local
                        pet-care providers while making important
                        information easier to discover.
                    </p>

                    <button type="button"
                            class="btn primary-btn"
                            @onclick="GoToClinics">

                        Explore Local Providers

                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         TRUST & COMMUNICATION
         ========================================================= -->
    <section class="trust-section">

        <div class="container-xl">

            <div class="row align-items-center g-5">

                <div class="col-12 col-lg-6">

                    <span class="section-eyebrow">
                        SUPPORT WHEN YOU NEED IT
                    </span>

                    <h2>
                        Have a question?
                        <br />
                        Get help easily.
                    </h2>

                    <p>
                        Shoppet Care is designed to make communication
                        easier. Browse common questions or connect with
                        a provider when you need additional assistance.
                    </p>

                    <div class="trust-points">

                        <div>
                            <span>✓</span>
                            Common questions and answers
                        </div>

                        <div>
                            <span>✓</span>
                            Direct provider communication
                        </div>

                        <div>
                            <span>✓</span>
                            Easy access to clinic information
                        </div>

                    </div>

                    <button type="button"
                            class="btn primary-btn"
                            @onclick="GoToInquire">

                        Ask About Pet Care

                    </button>

                </div>


                <div class="col-12 col-lg-6">

                    <div class="trust-image">

                        <img src="/catft.jpg"
                             alt="Cat receiving care"
                             loading="lazy" />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         COMMUNITY PHOTO WALL
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="section-heading centered">

                <span class="section-eyebrow">
                    FOR EVERY PET
                </span>

                <h2>
                    Care for every stage of their life.
                </h2>

            </div>


            <div class="photo-grid">

                <div class="photo-item photo-large">

                    <img src="/vet_wpets.jpg"
                         alt="Veterinarian with pets"
                         loading="lazy" />

                </div>

                <div class="photo-item">

                    <img src="/catft.jpg"
                         alt="Cat"
                         loading="lazy" />

                </div>

                <div class="photo-item">

                    <img src="/petbedna.jpg"
                         alt="Pet supplies"
                         loading="lazy" />

                </div>

                <div class="photo-item">

                    <img src="/premiumft.png"
                         alt="Premium pet products"
                         loading="lazy" />

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PARTNER CTA
         ========================================================= -->
    <section class="partner-section">

        <div class="container-xl">

            <div class="partner-card">

                <div>

                    <span class="section-eyebrow">
                        FOR PET-CARE PROVIDERS
                    </span>

                    <h2>
                        Want your clinic to be part of Shoppet Care?
                    </h2>

                    <p>
                        Register your clinic and make your services
                        easier for local pet owners to discover.
                    </p>

                </div>

                <button type="button"
                        class="btn partner-btn"
                        @onclick="GoToClinics">

                    Register a Clinic →

                </button>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PROFESSIONAL FOOTER
         ========================================================= -->
    <footer class="shoppet-footer">

        <div class="container-xl">

            <!-- MAIN FOOTER -->
            <div class="footer-main">

                <!-- BRAND -->
                <div class="footer-brand">

                    <a href="/"
                       class="footer-logo-link">

                        <div class="footer-logo-mark">
                            <span>
                                SHOPPET
                            </span>
                        </div>

                        <div>

                            <div class="footer-brand-name">
                                ShoppetCare
                            </div>

                            <div class="footer-brand-subtitle">
                                PET CARE DIRECTORY
                            </div>

                        </div>

                    </a>


                    <p class="footer-description">
                        Helping pet owners discover trusted veterinary
                        clinics, pet shops, services, and everyday pet
                        essentials around Lipa City and Tanauan.
                    </p>


                    <div class="footer-location">

                        <span class="footer-location-mark"></span>

                        <div>

                            <strong>
                                Lipa City &amp; Tanauan
                            </strong>

                            <small>
                                Local pet-care discovery platform
                            </small>

                        </div>

                    </div>

                </div>


                <!-- EXPLORE -->
                <div class="footer-column">

                    <h4>
                        Explore
                    </h4>

                    <a href="/">
                        Home
                    </a>

                    <a href="/clinics">
                        Verified Clinics
                    </a>

                    <a href="/services">
                        Services
                    </a>

                    <a href="/brands">
                        Brands &amp; Diets
                    </a>

                </div>


                <!-- PET CARE -->
                <div class="footer-column">

                    <h4>
                        Pet Care
                    </h4>

                    <a href="/clinics?provider=Veterinary">
                        Veterinary Care
                    </a>

                    <a href="/clinics?provider=Pet%20Shop">
                        Pet Shops
                    </a>

                    <a href="/clinics?search=Vaccination">
                        Vaccinations
                    </a>

                    <a href="/clinics?search=Pet%20Food">
                        Pet Food
                    </a>

                    <a href="/clinics?search=Pet%20Supplies">
                        Pet Supplies
                    </a>

                </div>


                <!-- ACCOUNT -->
                <div class="footer-column">

                    <h4>
                        Account &amp; Support
                    </h4>

                    <a href="/login">
                        Sign In
                    </a>

                    <a href="/register">
                        Create Account
                    </a>

                    <a href="/dashboard">
                        My Dashboard
                    </a>

                    <a href="/inquire">
                        Ask About Pet Care
                    </a>

                </div>

            </div>


            <!-- PROVIDER CTA -->
            <div class="footer-provider">

                <div>

                    <span class="footer-provider-label">
                        FOR PET-CARE PROVIDERS
                    </span>

                    <h3>
                        Want your clinic or pet shop to be discovered?
                    </h3>

                    <p>
                        Join ShoppetCare and make your services easier
                        for local pet owners to find.
                    </p>

                </div>

                <button type="button"
                        class="footer-provider-btn"
                        @onclick="GoToClinics">

                    Register a Provider
                    <span>→</span>

                </button>

            </div>


            <!-- FOOTER BOTTOM -->
            <div class="footer-bottom">

                <div class="footer-copyright">
                    © @DateTime.Now.Year ShoppetCare.
                    All rights reserved.
                </div>


                <div class="footer-bottom-links">

                    <a href="/">
                        Home
                    </a>

                    <span></span>

                    <a href="/clinics">
                        Clinics
                    </a>

                    <span></span>

                    <a href="/inquire">
                        Support
                    </a>

                </div>


                <div class="footer-platform">
                    Lipa City &amp; Tanauan
                </div>

            </div>

        </div>

    </footer>

</div>


<!-- =============================================================
     STYLES
     ============================================================= -->
<style>

    :root {
        --pb-sage: #5C766D;
        --pb-sage-dark: #16241F;
        --pb-sage-deep: #101B17;
        --pb-sage-light: #EBF2EE;
        --pb-butter: #F7DD7D;
        --pb-butter-hover: #F2D257;
        --pb-cream: #F8F6F0;
        --pb-page: #FAF8F5;
        --pb-white: #FFFFFF;
        --pb-title: #1E2824;
        --pb-body: #58655F;
        --pb-muted: #7C8782;
        --pb-border: #E5E9E6;
    }


    /* =========================================================
           BASE
           ========================================================= */

    .shoppet-home {
        min-height: 100vh;
        background: var(--pb-page);
        color: var(--pb-title);
    }


    /* =========================================================
           HERO
           ========================================================= */

    .hero-section {
        background: linear-gradient( 135deg, #F4F8F5 0%, #FAF8F5 65%, #F8F1D9 100% );
        padding: 55px 0 70px;
    }

    .hero-eyebrow,
    .section-eyebrow {
        display: inline-block;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .14em;
        color: var(--pb-sage);
        margin-bottom: 12px;
    }

    .hero-title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.03;
        letter-spacing: -.045em;
        font-weight: 850;
        margin-bottom: 20px;
        color: var(--pb-title);
    }

        .hero-title span {
            display: block;
            color: var(--pb-sage);
        }

    .hero-description {
        max-width: 570px;
        color: var(--pb-body);
        font-size: 1.05rem;
        line-height: 1.75;
        margin-bottom: 26px;
    }

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .primary-btn {
        background: var(--pb-sage);
        color: white;
        border: none;
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 800;
    }

        .primary-btn:hover {
            background: var(--pb-sage-dark);
            color: white;
        }

    .secondary-btn {
        background: white;
        color: var(--pb-sage-dark);
        border: 1px solid var(--pb-border);
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 800;
    }

        .secondary-btn:hover {
            background: var(--pb-sage-light);
            color: var(--pb-sage-dark);
        }


    /* =========================================================
           HERO IMAGE
           ========================================================= */

    .hero-image-wrapper {
        position: relative;
        border-radius: 32px;
        overflow: visible;
    }

    .hero-image {
        width: 100%;
        height: 430px;
        object-fit: cover;
        border-radius: 32px;
        display: block;
        box-shadow: 0 25px 60px rgba(30, 40, 36, .15);
    }

    .hero-floating-card {
        position: absolute;
        left: -25px;
        bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: white;
        padding: 14px 18px;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(30, 40, 36, .15);
    }

        .hero-floating-card strong {
            font-size: .88rem;
            color: var(--pb-title);
            display: block;
        }

        .hero-floating-card small {
            color: var(--pb-muted);
            margin-top: 2px;
            display: block;
        }

    .floating-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--pb-sage-light);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .floating-icon-mark {
        font-size: .62rem;
        font-weight: 850;
        letter-spacing: .08em;
        color: var(--pb-sage);
    }


    /* =========================================================
           SEARCH CARD
           ========================================================= */

    .hero-search-card {
        position: relative;
        margin-top: 45px;
        padding: 24px;
        border-radius: 24px;
        background: white;
        box-shadow: 0 18px 50px rgba(30, 40, 36, .10);
        border: 1px solid rgba(92, 118, 109, .08);
    }

    .search-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-heading-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: var(--pb-sage-light);
    }

    .search-heading h3 {
        font-size: 1.05rem;
        font-weight: 850;
        margin: 0;
    }

    .search-heading p {
        margin: 2px 0 0;
        color: var(--pb-muted);
        font-size: .82rem;
    }

    .search-icon-mark {
        width: 16px;
        height: 16px;
        border: 2px solid var(--pb-sage);
        border-radius: 50%;
        position: relative;
        display: block;
    }

        .search-icon-mark::after {
            content: "";
            position: absolute;
            width: 7px;
            height: 2px;
            background: var(--pb-sage);
            right: -5px;
            bottom: -2px;
            transform: rotate(45deg);
            border-radius: 2px;
        }

    .search-label {
        display: block;
        font-size: .72rem;
        font-weight: 800;
        color: var(--pb-title);
        margin-bottom: 7px;
    }

    .search-input {
        height: 47px;
        border-radius: 13px;
        border: 1px solid var(--pb-border);
        color: var(--pb-title);
        font-weight: 600;
    }

        .search-input:focus {
            border-color: var(--pb-sage);
            box-shadow: 0 0 0 3px rgba(92, 118, 109, .12);
        }

    .find-care-btn {
        height: 47px;
        border: none;
        border-radius: 13px;
        background: var(--pb-sage);
        color: white;
        font-weight: 850;
    }

        .find-care-btn:hover {
            background: var(--pb-sage-dark);
            color: white;
        }


    /* =========================================================
           AUTOCOMPLETE
           ========================================================= */

    .live-suggestions-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid var(--pb-border);
        border-radius: 14px;
        margin-top: 6px;
        box-shadow: 0 15px 35px rgba(30, 40, 36, .12);
        z-index: 1000;
        max-height: 230px;
        overflow-y: auto;
        padding: 6px;
    }

    .suggestion-item {
        width: 100%;
        display: block;
        text-align: left;
        border: none;
        background: transparent;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        transition: background .15s ease;
    }

        .suggestion-item:hover {
            background: var(--pb-sage-light);
        }


    /* =========================================================
           SEARCH PREVIEW
           ========================================================= */

    .filter-sneak-peek-card {
        background: #F4F8F5;
        border: 1.5px solid var(--pb-sage);
        border-radius: 14px;
        padding: 13px 16px;
        box-shadow: 0 8px 20px rgba(92, 118, 109, .10);
    }

    .selected-match-label {
        display: inline-block;
        color: white;
        background: var(--pb-sage);
        border-radius: 999px;
        padding: 4px 9px;
        font-size: .62rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 5px;
    }

    .selected-branch {
        font-weight: 500;
        color: var(--pb-muted);
        margin-left: 3px;
    }

    .preview-btn {
        color: var(--pb-sage);
        border: 1px solid var(--pb-sage);
        background: white;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: .74rem;
        font-weight: 800;
    }

        .preview-btn:hover {
            color: white;
            background: var(--pb-sage);
        }


    /* =========================================================
           QUICK SEARCH
           ========================================================= */

    .quick-searches {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 17px;
    }

    .quick-label {
        color: var(--pb-muted);
        font-size: .76rem;
        font-weight: 700;
        margin-right: 3px;
    }

    .quick-searches button {
        border: 1px solid var(--pb-border);
        background: var(--pb-cream);
        color: var(--pb-title);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: .74rem;
        font-weight: 700;
        cursor: pointer;
    }

        .quick-searches button:hover {
            background: var(--pb-sage-light);
            border-color: var(--pb-sage-light);
        }


    /* =========================================================
           GENERAL SECTIONS
           ========================================================= */

    .section-space {
        padding: 75px 0;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 28px;
    }

        .section-heading.centered {
            display: block;
            text-align: center;
            max-width: 720px;
            margin: 0 auto 38px;
        }

        .section-heading h2,
        .trust-section h2,
        .people-content h2,
        .partner-card h2 {
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            line-height: 1.15;
            letter-spacing: -.03em;
            font-weight: 850;
            margin-bottom: 12px;
        }

        .section-heading p {
            color: var(--pb-body);
            line-height: 1.7;
        }

    .text-link {
        border: none;
        background: transparent;
        color: var(--pb-sage);
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer;
    }


    /* =========================================================
           QUICK CARDS
           ========================================================= */

    .quick-card {
        width: 100%;
        height: 100%;
        text-align: left;
        background: white;
        border: 1px solid var(--pb-border);
        border-radius: 22px;
        padding: 23px;
        transition: transform .2s ease, box-shadow .2s ease;
        cursor: pointer;
    }

        .quick-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(30, 40, 36, .09);
        }

    .quick-card-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        background: var(--pb-sage-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .62rem;
        font-weight: 800;
        letter-spacing: .08em;
        color: var(--pb-sage);
        margin-bottom: 18px;
    }

    .quick-card h4 {
        font-size: 1rem;
        font-weight: 850;
        margin-bottom: 8px;
    }

    .quick-card p {
        color: var(--pb-muted);
        font-size: .84rem;
        line-height: 1.6;
        min-height: 53px;
        margin-bottom: 14px;
    }

    .quick-card span {
        color: var(--pb-sage);
        font-size: .78rem;
        font-weight: 800;
    }


    /* =========================================================
           INFORMATION STRIP
           ========================================================= */

    .info-strip {
        background: var(--pb-sage-dark);
        padding: 24px 0;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: white;
    }

    .info-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,.1);
        color: white;
        font-size: .48rem;
        font-weight: 850;
        letter-spacing: .04em;
    }

    .info-item strong {
        font-size: .85rem;
        display: block;
    }

    .info-item small {
        color: rgba(255,255,255,.68);
        margin-top: 2px;
        font-size: .73rem;
        display: block;
    }


    /* =========================================================
           FEATURE CARDS
           ========================================================= */

    .feature-card {
        background: white;
        border-radius: 26px;
        overflow: hidden;
        border: 1px solid var(--pb-border);
        height: 100%;
    }

    .feature-image {
        height: 260px;
        overflow: hidden;
    }

        .feature-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .feature-content {
        padding: 27px;
    }

    .feature-tag {
        color: var(--pb-sage);
        font-size: .68rem;
        font-weight: 850;
        letter-spacing: .12em;
    }

    .feature-content h3 {
        font-size: 1.45rem;
        font-weight: 850;
        margin: 9px 0;
    }

    .feature-content p {
        color: var(--pb-body);
        line-height: 1.7;
        font-size: .88rem;
    }

    .feature-btn {
        background: var(--pb-sage);
        color: white;
        border-radius: 999px;
        font-weight: 800;
        padding: 10px 18px;
        margin-top: 7px;
        border: none;
    }

        .feature-btn:hover {
            background: var(--pb-sage-dark);
            color: white;
        }


    /* =========================================================
           CATEGORY SECTION
           ========================================================= */

    .category-section {
        padding: 10px 0 75px;
    }

    .category-card {
        position: relative;
        height: 430px;
        border-radius: 28px;
        overflow: hidden;
    }

        .category-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( to top, rgba(16,27,23,.88), rgba(16,27,23,.08) 65% );
        }

        .category-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .category-overlay {
        position: absolute;
        z-index: 2;
        left: 28px;
        right: 28px;
        bottom: 28px;
        color: white;
    }

        .category-overlay span {
            font-size: .68rem;
            font-weight: 850;
            letter-spacing: .14em;
            color: var(--pb-butter);
        }

        .category-overlay h3 {
            font-size: 1.7rem;
            font-weight: 850;
            margin: 6px 0;
        }

        .category-overlay p {
            color: rgba(255,255,255,.8);
            font-size: .85rem;
            line-height: 1.6;
            max-width: 480px;
        }

        .category-overlay button {
            border: none;
            background: var(--pb-butter);
            color: var(--pb-sage-dark);
            border-radius: 999px;
            padding: 10px 17px;
            font-size: .78rem;
            font-weight: 850;
            cursor: pointer;
        }

            .category-overlay button:hover {
                background: var(--pb-butter-hover);
            }


    /* =========================================================
           PEOPLE
           ========================================================= */

    .people-card {
        background: var(--pb-sage-light);
        border-radius: 30px;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }

    .people-image {
        height: 100%;
        min-height: 420px;
    }

        .people-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .people-content {
        padding: 45px;
    }

        .people-content p {
            color: var(--pb-body);
            line-height: 1.75;
            max-width: 520px;
            margin-bottom: 23px;
        }


    /* =========================================================
           TRUST
           ========================================================= */

    .trust-section {
        background: white;
        padding: 75px 0;
    }

        .trust-section p {
            color: var(--pb-body);
            line-height: 1.75;
            max-width: 570px;
        }

    .trust-points {
        margin: 22px 0;
    }

        .trust-points div {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            font-size: .88rem;
            font-weight: 700;
        }

        .trust-points span {
            width: 25px;
            height: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--pb-sage-light);
            color: var(--pb-sage);
            border-radius: 50%;
            font-size: .7rem;
        }

    .trust-image {
        height: 390px;
        border-radius: 28px;
        overflow: hidden;
    }

        .trust-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    /* =========================================================
           PHOTO WALL
           ========================================================= */

    .photo-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        grid-template-rows: 220px 220px;
        gap: 14px;
    }

    .photo-item {
        border-radius: 20px;
        overflow: hidden;
    }

    .photo-large {
        grid-row: span 2;
    }

    .photo-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }


    /* =========================================================
           PARTNER CTA
           ========================================================= */

    .partner-section {
        padding: 0 0 75px;
    }

    .partner-card {
        background: var(--pb-sage-dark);
        color: white;
        padding: 42px;
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

        .partner-card h2 {
            margin-bottom: 8px;
        }

        .partner-card p {
            color: rgba(255,255,255,.7);
            margin: 0;
            max-width: 620px;
            line-height: 1.65;
        }

    .partner-btn {
        background: var(--pb-butter);
        color: var(--pb-sage-dark);
        border-radius: 999px;
        padding: 12px 21px;
        font-weight: 850;
        white-space: nowrap;
        border: none;
    }

        .partner-btn:hover {
            background: var(--pb-butter-hover);
            color: var(--pb-sage-dark);
        }


    /* =========================================================
           PROFESSIONAL FOOTER
           ========================================================= */

    .shoppet-footer {
        background: #16241F;
        color: rgba(255,255,255,.78);
        padding-top: 65px;
    }


    /* MAIN FOOTER */

    .footer-main {
        display: grid;
        grid-template-columns: 2.1fr 1fr 1fr 1fr;
        gap: 55px;
        padding-bottom: 55px;
    }


    /* BRAND */

    .footer-brand {
        max-width: 430px;
    }

    .footer-logo-link {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: white;
    }

    .footer-logo-mark {
        width: 47px;
        height: 47px;
        border-radius: 14px;
        background: #EBF2EE;
        color: #5C766D;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .52rem;
        font-weight: 900;
        letter-spacing: .04em;
    }

    .footer-brand-name {
        color: white;
        font-size: 1.15rem;
        font-weight: 850;
        line-height: 1.1;
    }

    .footer-brand-subtitle {
        color: rgba(255,255,255,.48);
        font-size: .61rem;
        font-weight: 750;
        letter-spacing: .09em;
        margin-top: 4px;
    }

    .footer-description {
        color: rgba(255,255,255,.62);
        font-size: .84rem;
        line-height: 1.75;
        max-width: 400px;
        margin: 20px 0 22px;
    }


    /* LOCATION */

    .footer-location {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .footer-location-mark {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgba(247,221,125,.12);
        border: 1px solid rgba(247,221,125,.18);
        position: relative;
        flex: 0 0 34px;
    }

        .footer-location-mark::before {
            content: "";
            position: absolute;
            width: 9px;
            height: 9px;
            border: 2px solid #F7DD7D;
            border-radius: 50%;
            top: 7px;
            left: 11px;
        }

        .footer-location-mark::after {
            content: "";
            position: absolute;
            width: 8px;
            height: 8px;
            border-left: 2px solid #F7DD7D;
            border-bottom: 2px solid #F7DD7D;
            transform: rotate(-45deg);
            left: 12px;
            top: 15px;
        }

    .footer-location strong {
        display: block;
        color: white;
        font-size: .78rem;
        font-weight: 800;
    }

    .footer-location small {
        display: block;
        color: rgba(255,255,255,.45);
        font-size: .69rem;
        margin-top: 2px;
    }


    /* FOOTER COLUMNS */

    .footer-column {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

        .footer-column h4 {
            color: white;
            font-size: .78rem;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin: 4px 0 19px;
        }

        .footer-column a {
            color: rgba(255,255,255,.58);
            text-decoration: none;
            font-size: .79rem;
            line-height: 1.4;
            margin-bottom: 12px;
            transition: color .18s ease, transform .18s ease;
        }

            .footer-column a:hover {
                color: #F7DD7D;
                transform: translateX(2px);
            }


    /* PROVIDER CTA */

    .footer-provider {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 25px 28px;
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(255,255,255,.045);
        border-radius: 20px;
        margin-bottom: 35px;
    }

    .footer-provider-label {
        display: block;
        color: #F7DD7D;
        font-size: .64rem;
        font-weight: 850;
        letter-spacing: .13em;
        margin-bottom: 7px;
    }

    .footer-provider h3 {
        color: white;
        font-size: 1.15rem;
        font-weight: 850;
        margin: 0 0 5px;
    }

    .footer-provider p {
        color: rgba(255,255,255,.55);
        font-size: .78rem;
        margin: 0;
    }

    .footer-provider-btn {
        flex: 0 0 auto;
        border: none;
        background: #F7DD7D;
        color: #16241F;
        border-radius: 999px;
        padding: 11px 19px;
        font-size: .77rem;
        font-weight: 850;
        cursor: pointer;
        transition: background .18s ease, transform .18s ease;
    }

        .footer-provider-btn span {
            margin-left: 6px;
        }

        .footer-provider-btn:hover {
            background: #F2D257;
            transform: translateY(-1px);
        }


    /* FOOTER BOTTOM */

    .footer-bottom {
        border-top: 1px solid rgba(255,255,255,.09);
        min-height: 67px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 20px;
    }

    .footer-copyright {
        color: rgba(255,255,255,.42);
        font-size: .68rem;
    }

    .footer-bottom-links {
        display: flex;
        align-items: center;
        gap: 11px;
    }

        .footer-bottom-links a {
            color: rgba(255,255,255,.55);
            text-decoration: none;
            font-size: .68rem;
            transition: color .18s ease;
        }

            .footer-bottom-links a:hover {
                color: #F7DD7D;
            }

        .footer-bottom-links span {
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: rgba(255,255,255,.25);
        }

    .footer-platform {
        color: rgba(255,255,255,.42);
        font-size: .68rem;
        text-align: right;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991px) {

        .hero-section {
            padding-top: 35px;
        }

        .hero-image {
            height: 350px;
        }

        .hero-floating-card {
            left: 15px;
        }

        .hero-search-card {
            margin-top: 30px;
        }

        .people-card {
            grid-template-columns: 1fr;
        }

        .people-image {
            min-height: 320px;
        }

        .partner-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer-main {
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 35px;
        }

        .footer-brand {
            grid-column: 1 / -1;
            max-width: 600px;
        }

        .footer-provider {
            align-items: flex-start;
            flex-direction: column;
        }

        .footer-bottom {
            grid-template-columns: 1fr;
            gap: 8px;
            padding: 18px 0;
        }

        .footer-bottom-links {
            order: 2;
        }

        .footer-platform {
            text-align: left;
            order: 3;
        }
    }


    @@media (max-width: 767px) {

        .section-heading {
            display: block;
        }

            .section-heading .text-link {
                margin-top: 12px;
            }

        .photo-grid {
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 220px 180px 180px;
        }

        .photo-large {
            grid-column: 1 / -1;
            grid-row: auto;
        }

        .footer-main {
            grid-template-columns: 1fr 1fr;
            gap: 32px 24px;
        }

        .footer-brand {
            grid-column: 1 / -1;
        }
    }


    @@media (max-width: 575px) {

        .hero-section {
            padding-bottom: 45px;
        }

        .hero-title {
            font-size: 2.65rem;
        }

        .hero-buttons {
            flex-direction: column;
        }

            .hero-buttons .btn {
                width: 100%;
            }

        .hero-image {
            height: 300px;
