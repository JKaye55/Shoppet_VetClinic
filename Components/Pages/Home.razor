@page "/home"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Services

@inject NavigationManager Nav

<div class="shoppet-home">

    <!-- =========================================================
         HERO SECTION
         ========================================================= -->
    <section class="hero-section">
        <div class="container-xl">

            <div class="row align-items-center g-4">

                <!-- HERO TEXT -->
                <div class="col-12 col-lg-6">

                    <span class="hero-eyebrow">
                        SHOPPET CARE
                    </span>

                    <h1 class="hero-title">
                        Better care for
                        <span>every pet.</span>
                    </h1>

                    <p class="hero-description">
                        Manage your pets, browse the pre-loved Marketplace,
                        connect with the pet-owner Community, and manage your
                        ShoppetCare experience around Lipa City and Tanauan.
                    </p>

                    <div class="hero-buttons">

                        <button type="button"
                                class="btn primary-btn"
                                @onclick="GoToPets">
                            Manage My Pets
                        </button>

                        <button type="button"
                                class="btn secondary-btn"
                                @onclick="GoToMarketplace">
                            Explore Marketplace
                        </button>

                    </div>

                </div>


                <!-- HERO IMAGE -->
                <div class="col-12 col-lg-6">

                    <div class="hero-image-wrapper">

                        <img src="/hero_vet_hd.jpg"
                             alt="Veterinarian caring for a pet"
                             class="hero-image" />

                        <div class="hero-floating-card">

                            <div class="floating-icon">
                                <span class="floating-icon-mark">
                                    CARE
                                </span>
                            </div>

                            <div>
                                <strong>Pet care made easier</strong>

                                <small>
                                    Pet identity, care records &amp; supplies
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 SEARCH / FILTER CARD
                 ===================================================== -->


        </div>
    </section>

    <!-- =========================================================
         PROMOTIONAL & MARKETING CAMPAIGN STRIP (RUBRIC CRITERIA 3 & 9)
         ========================================================= -->
    <section class="home-promo-strip" style="background:linear-gradient(135deg, #173D3D 0%, #225656 60%, #2F9098 100%);color:#fff;padding:16px 0;border-bottom:3px solid #F3D27A;">
        <div class="container-xl" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <span style="background:#F3D27A;color:#173D3D;padding:4px 10px;border-radius:999px;font-weight:900;font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;">
                    LIMITED OFFER
                </span>
                <div>
                    <strong style="font-size:.95rem;display:block;">Shoppet Premium — ₱150 for 2 Full Months!</strong>
                    <span style="font-size:.8rem;color:#D8ECE8;">Unlock unlimited pet profiles, cloud sync, and priority care records. Plus use code <code style="background:rgba(255,255,255,0.22);padding:2px 7px;border-radius:5px;color:#F3D27A;font-weight:800;">WELCOME50</code> on the Marketplace!</span>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <a href="/premium" class="btn" style="background:#F3D27A;color:#173D3D;font-weight:850;font-size:.78rem;padding:7px 15px;border-radius:8px;text-decoration:none;border:0;">
                    Upgrade to Premium
                </a>
                <a href="/marketplace" class="btn" style="background:rgba(255,255,255,0.15);color:#fff;font-weight:800;font-size:.78rem;padding:7px 15px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.3);">
                    Shop Pre-Loved Deals
                </a>
            </div>
        </div>
    </section>


    <!-- =========================================================
         QUICK ACTIONS
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="section-heading">

                <div>

                    <span class="section-eyebrow">
                        QUICK ACCESS
                    </span>

                    <h2>
                        What does your pet need?
                    </h2>

                </div>

                <button type="button"
                        class="text-link"
                        @onclick="GoToPets">

                    View all care options →

                </button>

            </div>


            <div class="row g-3">

                <!-- PET CARE -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick="GoToPets">

                        <div class="quick-card-icon">
                            CARE
                        </div>

                        <h4>
                            Pet Profiles
                        </h4>

                        <p>
                            Keep pet identity and
                            care details together.
                        </p>

                        <span>
                            Open My Pets →
                        </span>

                    </button>

                </div>


                <!-- VACCINATIONS -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick='() => QuickHomeSearch("Vaccination")'>

                        <div class="quick-card-icon">
                            VAX
                        </div>

                        <h4>
                            Vaccinations
                        </h4>

                        <p>
                            Keep vaccination dates and
                            health records organized.
                        </p>

                        <span>
                            View care records →
                        </span>

                    </button>

                </div>


                <!-- MARKETPLACE -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick="GoToMarketplace">

                        <div class="quick-card-icon">
                            SHOP
                        </div>

                        <h4>
                            Pre-Loved Marketplace
                        </h4>

                        <p>
                            Browse durable pre-loved pet items
                            listed by pet owners.
                        </p>

                        <span>
                            Open Marketplace →
                        </span>

                    </button>

                </div>


                <!-- COMMUNITY -->
                <div class="col-12 col-md-6 col-lg-3">

                    <button type="button"
                            class="quick-card"
                            @onclick="GoToCommunity">

                        <div class="quick-card-icon">
                            TALK
                        </div>

                        <h4>
                            Pet Owner Community
                        </h4>

                        <p>
                            Read local pet stories and connect
                            through posts and comments.
                        </p>

                        <span>
                            Open Community →
                        </span>

                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         INFORMATION STRIP
         ========================================================= -->
    <section class="info-strip">

        <div class="container-xl">

            <div class="row g-3">

                <div class="col-12 col-md-4">

                    <div class="info-item">

                        <span class="info-icon">
                            ✓
                        </span>

                        <div>

                            <strong>
                                Local Pet Care
                            </strong>

                            <small>
                                Pet owners around
                                Lipa and Tanauan.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="col-12 col-md-4">

                    <div class="info-item">

                        <span class="info-icon">
                            FIND
                        </span>

                        <div>

                            <strong>
                                Easy Discovery
                            </strong>

                            <small>
                                Quickly find pet records,
                                facilities, and products.
                            </small>

                        </div>

                    </div>

                </div>


                <div class="col-12 col-md-4">

                    <div class="info-item">

                        <span class="info-icon">
                            HELP
                        </span>

                        <div>

                            <strong>
                                Helpful Support
                            </strong>

                            <small>
                                Get answers and connect
                                with pet-care providers.
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CORE SERVICES
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="section-heading centered">

                <span class="section-eyebrow">
                    SHOPPET CARE
                </span>

                <h2>
                    Everything your pet needs,
                    <br />
                    in one place.
                </h2>

                <p>
                    From organized pet-care records to everyday
                    pet essentials, Shoppet Care helps make pet
                    care easier to manage.
                </p>

            </div>


            <div class="row g-4">

                <!-- PET CARE -->
                <div class="col-12 col-lg-6">

                    <div class="feature-card">

                        <div class="feature-image">

                            <img src="/vet_wpets.jpg"
                                 alt="Veterinary care"
                                 loading="lazy" />

                        </div>

                        <div class="feature-content">

                            <span class="feature-tag">
                                PET CARE
                            </span>

                            <h3>
                                Keep pet care organized
                            </h3>

                            <p>
                                Manage your pet profiles
                                and keep their care records and
                                contact information together.
                            </p>

                            <button type="button"
                                    class="btn feature-btn"
                                    @onclick="GoToPets">

                                Open My Pets →

                            </button>

                        </div>

                    </div>

                </div>


                <!-- MARKETPLACE -->
                <div class="col-12 col-lg-6">

                    <div class="feature-card">

                        <div class="feature-image">

                            <img src="/foodprod.png"
                                 alt="Pet food and supplies"
                                 loading="lazy" />

                        </div>

                        <div class="feature-content">

                            <span class="feature-tag">
                                MARKETPLACE
                            </span>

                            <h3>
                                Pre-loved pet essentials
                            </h3>

                            <p>
                                Browse pre-loved carriers, beds, toys, accessories,
                                clothing, and other durable pet essentials from pet owners.
                            </p>

                            <button type="button"
                                    class="btn feature-btn"
                                    @onclick="GoToMarketplace">

                                Explore Marketplace →

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CATEGORY SHOWCASE
         ========================================================= -->
    <section class="category-section">

        <div class="container-xl">

            <div class="row g-4">

                <!-- PET CARE -->
                <div class="col-12 col-lg-6">

                    <div class="category-card">

                        <img src="/petvitna.jpg"
                             alt="Pet care"
                             loading="lazy" />

                        <div class="category-overlay">

                            <span>
                                CARE
                            </span>

                            <h3>
                                Pet Care Records
                            </h3>

                            <p>
                                Track vaccinations, medications,
                                feeding, and other pet-care needs.
                            </p>

                            <button type="button"
                                    @onclick="GoToPets">

                                Open My Pets →

                            </button>

                        </div>

                    </div>

                </div>


                <!-- PRE-LOVED MARKETPLACE -->
                <div class="col-12 col-lg-6">

                    <div class="category-card">

                        <img src="/premiumft.png"
                             alt="Pet supplies"
                             loading="lazy" />

                        <div class="category-overlay">

                            <span>
                                SHOP
                            </span>

                            <h3>
                                Pre-Loved Pet Items
                            </h3>

                            <p>
                                Explore pre-loved accessories, beds, carriers,
                                toys, clothing, and other durable pet essentials.
                            </p>

                            <button type="button"
                                    @onclick="GoToMarketplace">

                                Explore Marketplace →

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PEOPLE BEHIND THE CARE
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="people-card">

                <div class="people-image">

                    <img src="/vet_group.png"
                         alt="Veterinary care team"
                         loading="lazy" />

                </div>

                <div class="people-content">

                    <span class="section-eyebrow">
                        PEOPLE BEHIND THE CARE
                    </span>

                    <h2>
                        Helping pet owners find the care they need.
                    </h2>

                    <p>
                        Shoppet Care connects pet owners with local
                        pet-care providers while making important
                        information easier to discover.
                    </p>

                    <button type="button"
                            class="btn primary-btn"
                            @onclick="GoToPets">

                        Explore Local Providers

                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         TRUST & COMMUNICATION
         ========================================================= -->
    <section class="trust-section">

        <div class="container-xl">

            <div class="row align-items-center g-5">

                <div class="col-12 col-lg-6">

                    <span class="section-eyebrow">
                        SUPPORT WHEN YOU NEED IT
                    </span>

                    <h2>
                        Have a question?
                        <br />
                        Get help easily.
                    </h2>

                    <p>
                        Shoppet Care is designed to make communication
                        easier. Browse common questions or connect with
                        a provider when you need additional assistance.
                    </p>

                    <div class="trust-points">

                        <div>
                            <span>✓</span>
                            Common questions and answers
                        </div>

                        <div>
                            <span>✓</span>
                            Direct provider communication
                        </div>

                        <div>
                            <span>✓</span>
                            Easy access to pet-care information
                        </div>

                    </div>

                    <button type="button"
                            class="btn primary-btn"
                            @onclick="GoToHelp">

                        Search Help Center

                    </button>

                </div>


                <div class="col-12 col-lg-6">

                    <div class="trust-image">

                        <img src="/catft.jpg"
                             alt="Cat receiving care"
                             loading="lazy" />

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         COMMUNITY PHOTO WALL
         ========================================================= -->
    <section class="section-space">

        <div class="container-xl">

            <div class="section-heading centered">

                <span class="section-eyebrow">
                    FOR EVERY PET
                </span>

                <h2>
                    Care for every stage of their life.
                </h2>

            </div>


            <div class="photo-grid">

                <div class="photo-item photo-large">

                    <img src="/vet_wpets.jpg"
                         alt="Veterinarian with pets"
                         loading="lazy" />

                </div>

                <div class="photo-item">

                    <img src="/catft.jpg"
                         alt="Cat"
                         loading="lazy" />

                </div>

                <div class="photo-item">

                    <img src="/petbedna.jpg"
                         alt="Pet supplies"
                         loading="lazy" />

                </div>

                <div class="photo-item">

                    <img src="/premiumft.png"
                         alt="Premium pet products"
                         loading="lazy" />

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         PARTNER CTA
         ========================================================= -->



    <!-- =========================================================
         PROFESSIONAL FOOTER
         ========================================================= -->


</div>


<!-- =============================================================
     STYLES
     ============================================================= -->
<style>

    :root {
        --pb-sage: #5C766D;
        --pb-sage-dark: #16241F;
        --pb-sage-deep: #101B17;
        --pb-sage-light: #EBF2EE;
        --pb-butter: #F7DD7D;
        --pb-butter-hover: #F2D257;
        --pb-cream: #F8F6F0;
        --pb-page: #FAF8F5;
        --pb-white: #FFFFFF;
        --pb-title: #1E2824;
        --pb-body: #58655F;
        --pb-muted: #7C8782;
        --pb-border: #E5E9E6;
    }


    /* =========================================================
           BASE
           ========================================================= */

    .shoppet-home {
        min-height: 100vh;
        background: var(--pb-page);
        color: var(--pb-title);
    }


    /* =========================================================
           HERO
           ========================================================= */

    .hero-section {
        background: linear-gradient( 135deg, #F4F8F5 0%, #FAF8F5 65%, #F8F1D9 100% );
        padding: 55px 0 70px;
    }

    .hero-eyebrow,
    .section-eyebrow {
        display: inline-block;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .14em;
        color: var(--pb-sage);
        margin-bottom: 12px;
    }

    .hero-title {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.03;
        letter-spacing: -.045em;
        font-weight: 850;
        margin-bottom: 20px;
        color: var(--pb-title);
    }

        .hero-title span {
            display: block;
            color: var(--pb-sage);
        }

    .hero-description {
        max-width: 570px;
        color: var(--pb-body);
        font-size: 1.05rem;
        line-height: 1.75;
        margin-bottom: 26px;
    }

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .primary-btn {
        background: var(--pb-sage);
        color: white;
        border: none;
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 800;
    }

        .primary-btn:hover {
            background: var(--pb-sage-dark);
            color: white;
        }

    .secondary-btn {
        background: white;
        color: var(--pb-sage-dark);
        border: 1px solid var(--pb-border);
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 800;
    }

        .secondary-btn:hover {
            background: var(--pb-sage-light);
            color: var(--pb-sage-dark);
        }


    /* =========================================================
           HERO IMAGE
           ========================================================= */

    .hero-image-wrapper {
        position: relative;
        border-radius: 32px;
        overflow: visible;
    }

    .hero-image {
        width: 100%;
        height: 430px;
        object-fit: cover;
        border-radius: 32px;
        display: block;
        box-shadow: 0 25px 60px rgba(30, 40, 36, .15);
    }

    .hero-floating-card {
        position: absolute;
        left: -25px;
        bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: white;
        padding: 14px 18px;
        border-radius: 18px;
        box-shadow: 0 15px 40px rgba(30, 40, 36, .15);
    }

        .hero-floating-card strong {
            font-size: .88rem;
            color: var(--pb-title);
            display: block;
        }

        .hero-floating-card small {
            color: var(--pb-muted);
            margin-top: 2px;
            display: block;
        }

    .floating-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--pb-sage-light);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .floating-icon-mark {
        font-size: .62rem;
        font-weight: 850;
        letter-spacing: .08em;
        color: var(--pb-sage);
    }


    /* =========================================================
           SEARCH CARD
           ========================================================= */

    .hero-search-card {
        position: relative;
        margin-top: 45px;
        padding: 24px;
        border-radius: 24px;
        background: white;
        box-shadow: 0 18px 50px rgba(30, 40, 36, .10);
        border: 1px solid rgba(92, 118, 109, .08);
    }

    .search-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-heading-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: var(--pb-sage-light);
    }

    .search-heading h3 {
        font-size: 1.05rem;
        font-weight: 850;
        margin: 0;
    }

    .search-heading p {
        margin: 2px 0 0;
        color: var(--pb-muted);
        font-size: .82rem;
    }

    .search-icon-mark {
        width: 16px;
        height: 16px;
        border: 2px solid var(--pb-sage);
        border-radius: 50%;
        position: relative;
        display: block;
    }

        .search-icon-mark::after {
            content: "";
            position: absolute;
            width: 7px;
            height: 2px;
            background: var(--pb-sage);
            right: -5px;
            bottom: -2px;
            transform: rotate(45deg);
            border-radius: 2px;
        }

    .search-label {
        display: block;
        font-size: .72rem;
        font-weight: 800;
        color: var(--pb-title);
        margin-bottom: 7px;
    }

    .search-input {
        height: 47px;
        border-radius: 13px;
        border: 1px solid var(--pb-border);
        color: var(--pb-title);
        font-weight: 600;
    }

        .search-input:focus {
            border-color: var(--pb-sage);
            box-shadow: 0 0 0 3px rgba(92, 118, 109, .12);
        }

    .find-care-btn {
        height: 47px;
        border: none;
        border-radius: 13px;
        background: var(--pb-sage);
        color: white;
        font-weight: 850;
    }

        .find-care-btn:hover {
            background: var(--pb-sage-dark);
            color: white;
        }


    /* =========================================================
           AUTOCOMPLETE
           ========================================================= */

    .live-suggestions-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        border: 1px solid var(--pb-border);
        border-radius: 14px;
        margin-top: 6px;
        box-shadow: 0 15px 35px rgba(30, 40, 36, .12);
        z-index: 1000;
        max-height: 230px;
        overflow-y: auto;
        padding: 6px;
    }

    .suggestion-item {
        width: 100%;
        display: block;
        text-align: left;
        border: none;
        background: transparent;
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        transition: background .15s ease;
    }

        .suggestion-item:hover {
            background: var(--pb-sage-light);
        }


    /* =========================================================
           SEARCH PREVIEW
           ========================================================= */

    .filter-sneak-peek-card {
        background: #F4F8F5;
        border: 1.5px solid var(--pb-sage);
        border-radius: 14px;
        padding: 13px 16px;
        box-shadow: 0 8px 20px rgba(92, 118, 109, .10);
    }

    .selected-match-label {
        display: inline-block;
        color: white;
        background: var(--pb-sage);
        border-radius: 999px;
        padding: 4px 9px;
        font-size: .62rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 5px;
    }

    .selected-branch {
        font-weight: 500;
        color: var(--pb-muted);
        margin-left: 3px;
    }

    .preview-btn {
        color: var(--pb-sage);
        border: 1px solid var(--pb-sage);
        background: white;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: .74rem;
        font-weight: 800;
    }

        .preview-btn:hover {
            color: white;
            background: var(--pb-sage);
        }


    /* =========================================================
           QUICK SEARCH
           ========================================================= */

    .quick-searches {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 17px;
    }

    .quick-label {
        color: var(--pb-muted);
        font-size: .76rem;
        font-weight: 700;
        margin-right: 3px;
    }

    .quick-searches button {
        border: 1px solid var(--pb-border);
        background: var(--pb-cream);
        color: var(--pb-title);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: .74rem;
        font-weight: 700;
        cursor: pointer;
    }

        .quick-searches button:hover {
            background: var(--pb-sage-light);
            border-color: var(--pb-sage-light);
        }


    /* =========================================================
           GENERAL SECTIONS
           ========================================================= */

    .section-space {
        padding: 75px 0;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
