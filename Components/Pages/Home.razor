@code {

    /* =========================================================
       SEARCH STATE
       ========================================================= */

    private string homeSearch = string.Empty;

    private string homeLocation = string.Empty;

    private string homeProvider = string.Empty;


    /* =========================================================
       CLINIC DATA
       ========================================================= */

    private List<ClinicTenant> allClinics = new();

    private ClinicTenant? selectedActiveClinic;


    /* =========================================================
       LOAD CLINICS
       ========================================================= */

    protected override void OnInitialized()
    {
        try
        {
            var data = DbService.GetAllClinics();

            allClinics = data ?? new List<ClinicTenant>();
        }
        catch
        {
            allClinics = new List<ClinicTenant>();
        }
    }


    /* =========================================================
       AUTOCOMPLETE
       ========================================================= */

    private IEnumerable<ClinicTenant> cachedSuggestions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(homeSearch))
            {
                return Enumerable.Empty<ClinicTenant>();
            }

            if (selectedActiveClinic != null &&
                string.Equals(
                    homeSearch,
                    selectedActiveClinic.ClinicName,
                    StringComparison.OrdinalIgnoreCase))
            {
                return Enumerable.Empty<ClinicTenant>();
            }

            return allClinics
                .Where(c =>
                    !string.IsNullOrWhiteSpace(c.ClinicName) &&
                    c.ClinicName.Contains(
                        homeSearch,
                        StringComparison.OrdinalIgnoreCase))
                .Take(5);
        }
    }


    /* =========================================================
       SELECT CLINIC
       ========================================================= */

    private void SelectClinic(ClinicTenant clinic)
    {
        selectedActiveClinic = clinic;

        homeSearch = clinic.ClinicName ?? string.Empty;
    }


    /* =========================================================
       SEARCH
       ========================================================= */

    private void SearchClinics()
    {
        var parameters = new List<string>();


        if (!string.IsNullOrWhiteSpace(homeSearch))
        {
            parameters.Add(
                $"search={Uri.EscapeDataString(homeSearch)}");
        }


        if (!string.IsNullOrWhiteSpace(homeLocation))
        {
            parameters.Add(
                $"location={Uri.EscapeDataString(homeLocation)}");
        }


        if (!string.IsNullOrWhiteSpace(homeProvider))
        {
            parameters.Add(
                $"provider={Uri.EscapeDataString(homeProvider)}");
        }


        var query =
            parameters.Count > 0
                ? "?" + string.Join("&", parameters)
                : string.Empty;


        Nav.NavigateTo($"/clinics{query}");
    }


    /* =========================================================
       QUICK SEARCH
       ========================================================= */

    private void QuickHomeSearch(string search)
    {
        homeSearch = search;

        selectedActiveClinic =
            allClinics.FirstOrDefault(
                c =>
                    !string.IsNullOrWhiteSpace(c.ClinicName) &&
                    c.ClinicName.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase));

        SearchClinics();
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    private void GoToClinics()
    {
        Nav.NavigateTo("/clinics");
    }


    private void GoToPetShop()
    {
        Nav.NavigateTo("/clinics?provider=Pet%20Shop");
    }


    private void GoToInquire()
    {
        Nav.NavigateTo("/inquire");
    }

}