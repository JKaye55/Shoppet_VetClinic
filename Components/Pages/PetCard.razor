        padding: 9px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: 8px;
        background: linear-gradient( 135deg, #F7FFFF, #DDF3F1 );
    }


        .sc-petcard-theme-preview.theme-ocean {
            background: linear-gradient( 135deg, #EFFCFE, #BEE8ED );
        }


        .sc-petcard-theme-preview.theme-sunset {
            background: linear-gradient( 135deg, #FFF7F2, #FFD7C6 );
        }


        .sc-petcard-theme-preview.theme-mint {
            background: linear-gradient( 135deg, #F2FBF5, #CBE7D4 );
        }


        .sc-petcard-theme-preview.theme-royal {
            background: linear-gradient( 135deg, #F7F4FF, #DDD2F8 );
        }


        .sc-petcard-theme-preview span {
            font-size: .4rem;
            font-weight: 900;
        }


        .sc-petcard-theme-preview strong {
            font-size: .66rem;
        }


    .theme-footer {
        margin-top: 6px;
        display: flex;
        justify-content: space-between;
        gap: 5px;
    }


        .theme-footer > span {
            color: #53625D;
            font-size: .59rem;
            font-weight: 850;
        }


        .theme-footer small {
            color: #2F9098;
            font-size: .48rem;
        }


            .theme-footer small.locked {
                color: #A37817;
            }


    .sc-petcard-error {
        margin-top: 60px;
        padding: 30px;
        border-radius: 15px;
        background: #FFFFFF;
    }


    @@media (max-width: 900px) {

        .sc-petcard-layout {
            grid-template-columns: 1fr;
        }


        .sc-petcard-theme-grid {
            grid-template-columns: repeat(3,minmax(0,1fr));
        }
    }


    @@media (max-width: 650px) {

        .sc-petcard-shell {
            width: calc(100% - 24px);
        }


        .sc-petcard-header-inner,
        .sc-petcard-public {
            align-items: flex-start;
            flex-direction: column;
        }


        .sc-petcard-theme-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

</style>


@code {

    [Parameter]
    public int PetId { get; set; }


    private PetProfile? pet;


    private List<PetHealthRecord> healthRecords =
        new();


    private string ownerName =
        "Pet Owner";


    private string photoUrl =
        string.Empty;


    private string qrDataUri =
        string.Empty;


    private string vaccinationStatus =
        "No Record";


    private bool isPremium;


    private string message =
        string.Empty;


    protected override async Task OnParametersSetAsync()
    {
        await Auth.InitializeAsync();


        var userId =
            Auth.CurrentUser?.Id
            ??
            0;


        pet =
            Db.GetPetById(
                PetId);


        if (pet is null ||
            pet.UserId != userId)
        {
            pet =
                null;

            return;
        }


        isPremium =
            Auth.IsPremium;


        ownerName =
            string.IsNullOrWhiteSpace(
                Auth.CurrentUser?.FullName)
                ? "Pet Owner"
                : Auth.CurrentUser!.FullName;


        photoUrl =
            FileStorage.GetImageUrl(
                "pets",
                pet.Id)
            ??
            string.Empty;


        healthRecords =
            Db.GetHealthRecords(
                pet.Id)
            ??
            new List<PetHealthRecord>();


        vaccinationStatus =
            GetVaccinationStatus();


        qrDataUri =
            Cards.GenerateQrDataUri(
                pet.CardId,
                Nav.BaseUri.TrimEnd('/'));
    }


    private string GetVaccinationStatus()
    {
        var vaccination =
            healthRecords
                .Where(
                    record =>
                        string.Equals(
                            record.RecordType,
                            "Vaccination",
                            StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(
                    record =>
                        record.RecordDate)
                .FirstOrDefault();


        if (vaccination is null)
        {
            return "No Record";
        }


        if (!vaccination.NextDueDate.HasValue)
        {
            return "Recorded";
        }


        return
            vaccination.NextDueDate.Value.Date <
            DateTime.Today
                ? "Due"
                : "Up to Date";
    }


    private void SelectTheme(
        string theme)
    {
        if (pet is null ||
            Auth.CurrentUser is null)
        {
            return;
        }


        if (!Cards.IsThemeAllowed(
            theme,
            isPremium))
        {
            Nav.NavigateTo(
                "/premium");

            return;
        }


        var updated =
            Db.SetCardTheme(
                pet.Id,
                Auth.CurrentUser.Id,
                theme);


        if (!updated)
        {
            message =
                "The Pet ID theme could not be changed.";

            return;
        }


        pet.CardTheme =
            theme;


        message =
            $"{theme} Pet ID theme selected.";
    }


    private bool IsCurrentTheme(
        string theme)
    {
        var current =
            string.IsNullOrWhiteSpace(
                pet?.CardTheme)
                ? "Classic"
                : pet!.CardTheme!;


        return
            string.Equals(
                current,
                theme,
                StringComparison.OrdinalIgnoreCase);
    }


    private string GetThemeButtonClass(
        string theme,
        bool locked)
    {
        var css =
            "sc-petcard-theme";


        if (IsCurrentTheme(
            theme))
        {
            css +=
                " selected";
        }


        if (locked)
        {
            css +=
                " locked";
        }


        return css;
    }


    private string GetThemePreviewClass(
        string theme)
    {
        return
            "sc-petcard-theme-preview " +
            Cards.GetThemeCssClass(
                theme);
    }

}