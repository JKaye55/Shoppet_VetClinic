@page "/pet/{PetId:int}/card"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject DatabaseService Db
@inject CardService Cards
@inject FileStorageService FileStorage
@inject NavigationManager Nav

<PageTitle>@(pet?.PetName ?? "Pet") Pet ID | ShoppetCare</PageTitle>


<div class="petid-page">

    @if (!isReady)
    {
        <div class="petid-shell petid-loading">
            Loading Digital Pet ID...
        </div>
    }
    else if (pet is null)
    {
        <div class="petid-shell">

            <section class="petid-error">

                <span class="petid-error-icon">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                    </svg>

                </span>

                <h2>
                    Pet ID unavailable
                </h2>

                <p>
                    This pet could not be found or
                    does not belong to your account.
                </p>

                <a href="/my-pets">
                    Return to My Pets
                </a>

            </section>

        </div>
    }
    else
    {
        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <header class="petid-header">

            <div class="petid-shell petid-header-inner">

                <div>

                    <span class="petid-eyebrow">
                        DIGITAL PET ID
                    </span>

                    <h1>
                        @pet.PetName's
                        <em>connected identity.</em>
                    </h1>

                    <p>
                        A scannable ShoppetCare identity
                        connected to @pet.PetName's profile
                        and care information.
                    </p>

                </div>


                <div class="petid-header-actions">

                    <a href="/pet/@PetId">
                        Pet Details
                    </a>

                    <a href="/pet/@PetId/records">
                        Health Records
                    </a>

                    <a href="/my-pets">
                        My Pets
                    </a>

                </div>

            </div>

        </header>


        <main class="petid-shell petid-content">

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="petid-message">
                    @message
                </div>
            }


            <!-- =====================================================
                 PET ID + PLAN PANEL
                 ===================================================== -->

            <section class="petid-workspace">

                <!-- =================================================
                     DIGITAL PET ID
                     ================================================= -->

                <div class="petid-card-column">

                    <PetIdCardView Pet="@pet"
                                   OwnerName="@ownerName"
                                   OwnerPhone="@ownerPhone"
                                   PhotoUrl="@photoUrl"
                                   QrDataUri="@qrDataUri"
                                   IsPremium="@isPremium"
                                   VaccinationStatus="@vaccinationStatus"
                                   HealthRecordCount="@healthRecords.Count"
                                   PublicMode="false" />


                    <div class="petid-public-bar">

                        <span class="public-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                            </svg>

                        </span>


                        <div>

                            <strong>
                                Public Pet ID
                            </strong>

                            <p>
                                Anyone scanning the QR code sees a
                                privacy-safe version of this identity.
                                Owner contact and private care information
                                remain protected.
                            </p>

                        </div>


                        <a href="/pet/card/@pet.CardId"
                           target="_blank">

                            Preview Public Card →

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     PLAN / VALUE PANEL
                     ================================================= -->

                <aside class="petid-value-panel">

               <div class="premium-plan-head">

    <div>

        <span class="@(isPremium
            ? "plan-label premium"
            : "plan-label")">

            @(isPremium
                ? "PREMIUM PET ID"
                : "BASIC PET ID")

        </span>

        <h2>
            @pet.PetName
        </h2>

        <p class="plan-status-line">

            @if (isPremium)
            {
                <span>
                    Active until @PremiumEndDisplay
                </span>
            }
            else
            {
                <span>
                    Standard Digital Pet ID
                </span>
            }

        </p>

    </div>


    @if (isPremium)
    {
        <div class="premium-active-mark">

            <svg aria-hidden="true">
                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
            </svg>

        </div>
    }

</div>


@if (isPremium)
{
    <div class="premium-active-mark">

        <svg aria-hidden="true">
            <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
        </svg>

    </div>
}

                    <!-- =================================================
                         SUBSCRIPTION SUMMARY
                         ================================================= -->

                    <div class="petid-subscription">

                        <div class="subscription-price">

                            <small>
                                PLAN
                            </small>

                            <strong>
                                ₱150
                            </strong>

                            <span>
                                / 3 months
                            </span>

                        </div>


                        <div class="subscription-details">

                            <div>

                                <span>
                                    Status
                                </span>

                                <strong class="@(isPremium
                                    ? "active-text"
                                    : "")">

                                    @(isPremium
                                        ? "Active"
                                        : "Upgrade Available")

                                </strong>

                            </div>


                            <div>

                                <span>
                                    Access Period
                                </span>

                                <strong>
                                    3 Months
                                </strong>

                            </div>


                            @if (isPremium)
                            {
                                <div class="wide">

                                    <span>
                                        Premium Valid Until
                                    </span>

                                    <strong>
                                        @PremiumEndDisplay
                                    </strong>

                                </div>
                            }

                        </div>

                    </div>


                  @*   <!-- =================================================
                         DIGITAL PET ID VALUE
                         ================================================= -->

                    <div class="petid-feature-section">

                        <span class="section-label">
                            DIGITAL PET ID VALUE
                        </span>


                        <div class="petid-value-list">

                            <div>

                                <span>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                                    </svg>

                                </span>


                                <div>

                                    <strong>
                                        Scannable identity
                                    </strong>

                                    <small>
                                        One QR code opens
                                        @pet.PetName's public Pet ID.
                                    </small>

                                </div>

                            </div>


                            <div>

                                <span>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                                    </svg>

                                </span>


                                <div>

                                    <strong>
                                        Privacy-safe public view
                                    </strong>

                                    <small>
                                        Public scanning does not expose
                                        the owner's private mobile number
                                        or private health information.
                                    </small>

                                </div>

                            </div>


                            <div>

                                <span>

                                    <svg aria-hidden="true">
                                        <use href="/icons/bootstrap-icons.svg#clipboard2-pulse-fill"></use>
                                    </svg>

                                </span>


                                <div>

                                    <strong>
                                        Connected care history
                                    </strong>

                                    <small>
                                        The owner can jump from the Pet ID
                                        directly to @pet.PetName's
                                        health records.
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div> *@


                    <!-- =================================================
                         PREMIUM BENEFITS
                         ================================================= -->

                    <section class="petid-benefits">

                        <div class="benefits-heading">

                            <span>
                                PREMIUM INCLUDES
                            </span>

                            <strong>
                                @(isPremium
                                    ? "Active"
                                    : "₱150 / 3 months")
                            </strong>

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#telephone-fill"></use>
                            </svg>

                            Owner mobile contact on the private Pet ID

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#speedometer2"></use>
                            </svg>

                            Pet weight in the Premium care snapshot

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#shield-check"></use>
                            </svg>

                            Vaccination status on the private Pet ID

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#clipboard2-pulse"></use>
                            </svg>

                            Health-record summary and care profile

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#palette-fill"></use>
                            </svg>

                            Premium Digital Pet ID themes

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                            </svg>

                            No pet-profile limit while Premium is active

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                            </svg>

                            No health-record limit while Premium is active

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#file-earmark-arrow-down-fill"></use>
                            </svg>

                            Health-record export while Premium is active

                        </div>


                        @if (!isPremium)
                        {
                            <a href="/premium"
                               class="upgrade-button">

                                Get 3 Months of Premium

                                <span>
                                    →
                                </span>

                            </a>
                        }
                        else
                        {
                            <a href="/account"
                               class="manage-plan-link">

                                View Subscription Details

                                <span>
                                    →
                                </span>

                            </a>
                        }

                    </section>


                    <!-- =================================================
                         PET MANAGEMENT
                         ================================================= -->

                    <div class="petid-management">

                        <span class="petid-eyebrow">
                            MANAGE @pet.PetName.ToUpperInvariant()
                        </span>


                        <div>

                            <a href="/pet/@PetId">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                </svg>

                                Pet Details

                            </a>


                            <a href="/pet/@PetId/records">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#clipboard2-pulse-fill"></use>
                                </svg>

                                Health Records

                            </a>

                        </div>

                    </div>

                </aside>

            </section>


            <!-- =====================================================
                 PET ID THEMES
                 ===================================================== -->

            <section class="petid-themes">

                <div class="theme-intro">

                    <span class="petid-eyebrow">
                        PET ID APPEARANCE
                    </span>


                    <h2>
                        Make their identity
                        <em>feel like theirs.</em>
                    </h2>


                    <p>
                        Classic is included with every Pet ID.
                        Premium members can personalize the
                        card with additional visual themes.
                    </p>

                </div>


                <div class="theme-grid">

                    @foreach (var theme in CardService.PremiumThemes)
                    {
                        var locked =
                            !Cards.IsThemeAllowed(
                                theme,
                                isPremium);


                        <button type="button"
                                class="@GetThemeButtonClass(theme, locked)"
                                @onclick="() => SelectTheme(theme)">

                            <div class="@GetThemePreviewClass(theme)">

                                <span>
                                    SHOPPETCARE
                                </span>

                                <strong>
                                    @theme
                                </strong>

                                <small>
                                    @pet.PetName
                                </small>

                            </div>


                            <div class="theme-footer">

                                <span>
                                    @theme
                                </span>


                                @if (locked)
                                {
                                    <small class="locked">
                                        Premium
                                    </small>
                                }
                                else if (IsCurrentTheme(theme))
                                {
                                    <small>
                                        Selected
                                    </small>
                                }

                            </div>

                        </button>
                    }

                </div>

            </section>

        </main>
    }

</div>


<style>

    :root {
        --petid-teal: #2F9098;
        --petid-teal-dark: #267C83;
        --petid-dark: #173D3D;
        --petid-cream: #FBF8F2;
        --petid-yellow: #F3D27A;
        --petid-yellow-soft: #FFF4CF;
        --petid-border: #DDE7E4;
        --petid-muted: #72837D;
    }


    .petid-page,
    .petid-page *,
    .petid-page *::before,
    .petid-page *::after {
        box-sizing: border-box;
    }

    .plan-status-line {
    margin:
        6px
        0
        0;

    color: #71827C;

    font-size: 11px;
    line-height: 1.45;
}

    .petid-page {
        min-height: 100vh;

        color: var(--petid-dark);

        background:
            radial-gradient(
                circle at 93% 5%,
                rgba(47, 144, 152, .09),
                transparent 23%
            ),
            var(--petid-cream);
    }


    .petid-page svg {
        width: 1em;
        height: 1em;

        fill: currentColor;
    }


    .petid-shell {
        width:
            min(
                1420px,
                calc(100% - 48px)
            );

        margin:
            0
            auto;
    }


    .petid-loading {
        padding:
            80px
            0;

        color: var(--petid-muted);

        text-align: center;
    }


    .petid-eyebrow {
        display: block;

        color: var(--petid-teal);

        font-size: 10px;
        font-weight: 950;

        letter-spacing: .13em;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .petid-header {
        padding:
            33px
            0;

        border-bottom:
            1px solid
            var(--petid-border);

        background:
            linear-gradient(
                135deg,
                #F0F9F7,
                #FFFDF8
            );
    }


    .petid-header-inner {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 30px;
    }


    .petid-header h1 {
        margin:
            7px
            0
            0;

        color: var(--petid-dark);

        font-size:
            clamp(
                34px,
                4vw,
                52px
            );

        line-height: .98;

        font-weight: 950;

        letter-spacing: -.055em;
    }


    .petid-header h1 em {
        color: var(--petid-teal);

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-style: italic;
        font-weight: 500;
    }


    .petid-header p {
        max-width: 620px;

        margin:
            11px
            0
            0;

        color: var(--petid-muted);

        font-size: 12px;
        line-height: 1.6;
    }


    .petid-header-actions {
        display: flex;
        flex-wrap: wrap;

        gap: 8px;
    }


    .petid-header-actions a {
        min-height: 39px;

        padding:
            0
            14px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border:
            1px solid
            #CBDCD8;

        border-radius: 9px;

        background: #FFFFFF;

        color: var(--petid-dark);

        font-size: 11px;
        font-weight: 850;

        text-decoration: none;

        transition:
            border-color .16s ease,
            background .16s ease,
            transform .16s ease;
    }


    .petid-header-actions a:hover {
        border-color: #A9CCC5;

        background: #F4FAF8;

        transform:
            translateY(-1px);
    }


    /* =========================================================
       CONTENT
       ========================================================= */

    .petid-content {
        padding:
            28px
            0
            70px;
    }


    .petid-message {
        margin-bottom: 14px;

        padding:
            12px
            15px;

        border:
            1px solid
            #C9E1DC;

        border-radius: 11px;

        background: #F1F9F7;

        color: #31675F;

        font-size: 11px;
        font-weight: 750;
    }


    /* =========================================================
       WORKSPACE
       ========================================================= */

   .petid-workspace {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        320px;

    align-items: start;

    gap: 24px;
}


    .petid-card-column {
        min-width: 0;
    }


    /* =========================================================
       PUBLIC BAR
       ========================================================= */

    .petid-public-bar {
        margin-top: 12px;

        padding:
            14px
            16px;

        display: grid;

        grid-template-columns:
            auto
            minmax(0, 1fr)
            auto;

        align-items: center;

        gap: 13px;

        border:
            1px solid
            var(--petid-border);

        border-radius: 13px;

        background: #FFFFFF;

        box-shadow:
            0 7px 20px
            rgba(23, 61, 61, .035);
    }


    .public-icon {
        width: 42px;
        height: 42px;

        display: grid;
        place-items: center;

        border-radius: 11px;

        background: #EAF5F5;

        color: var(--petid-teal);
    }


    .petid-public-bar strong {
        color: var(--petid-dark);

        font-size: 12px;
    }


    .petid-public-bar p {
        max-width: 600px;

        margin:
            3px
            0
            0;

        color: #83918C;

        font-size: 10px;
        line-height: 1.45;
    }


    .petid-public-bar > a {
        color: var(--petid-teal-dark);

        font-size: 11px;
        font-weight: 900;

        text-decoration: none;

        white-space: nowrap;
    }


    /* =========================================================
       VALUE PANEL
       ========================================================= */

   .petid-value-panel {
    min-height: 0;

    padding: 22px;

    display: flex;
    flex-direction: column;

        border:
            1px solid
            var(--petid-border);

        border-radius: 22px;

        background:
            radial-gradient(
                circle at 94% 4%,
                rgba(243, 210, 122, .25),
                transparent 26%
            ),
            #FFFFFF;

        box-shadow:
            0 12px 32px
            rgba(23, 61, 61, .055);
    }


    .plan-label {
        color: var(--petid-teal);

        font-size: 10px;
        font-weight: 950;

        letter-spacing: .12em;
    }


    .plan-label.premium {
        color: #987016;
    }


    /* =========================================================
       PREMIUM HEADER
       ========================================================= */

    .premium-plan-head {
        display: flex;

        align-items: flex-start;
        justify-content: space-between;

        gap: 16px;
    }


   .premium-plan-head h2 {
    margin:
        6px
        0
        0;

    color: #173D3D;

    font-size: 24px;
    line-height: 1;

    font-weight: 950;

    letter-spacing: -.035em;
}

    .premium-plan-head h2 em {
        display: block;

        margin-top: 3px;

        color: #A17819;

        font-family:
            Georgia,
            "Times New Roman",
            serif;

        font-style: italic;
        font-weight: 500;
    }


    .premium-active-mark {
        width: 44px;
        height: 44px;

        flex:
            0
            0
            44px;

        display: grid;
        place-items: center;

        border-radius: 13px;

        background: #173D3D;

        color: #F3D27A;

        box-shadow:
            0 10px 22px
            rgba(23, 61, 61, .15);
    }


    .premium-intro {
        margin:
            13px
            0
            0;

        color: #71827C;

        font-size: .72rem;
        line-height: 1.65;
    }


    /* =========================================================
       SUBSCRIPTION
       ========================================================= */

   .petid-subscription {
    margin-top: 16px;

        display: grid;

        grid-template-columns:
            .7fr
            1.3fr;

        overflow: hidden;

        border:
            1px solid
            #E1CC7E;

        border-radius: 15px;

        background: #FFFDF7;
    }


    .subscription-price {
        padding: 18px;

        display: flex;
        flex-direction: column;

        justify-content: center;

        background:
            linear-gradient(
                145deg,
                #173D3D,
                #245B56
            );

        color: #FFFFFF;
    }


    .subscription-price small {
        color: #F3D27A;

        font-size: .51rem;
        font-weight: 950;

        letter-spacing: .13em;
    }


   .subscription-price strong {
    margin-top: 4px;
    font-size: 1.7rem;
        line-height: 1;

        font-weight: 950;

        letter-spacing: -.045em;
    }


    .subscription-price span {
        margin-top: 4px;

        color:
            rgba(255, 255, 255, .68);

        font-size: .58rem;
        font-weight: 750;
    }


    .subscription-details {
        padding: 11px;

        display: grid;

        grid-template-columns:
            1fr
            1fr;

        gap: 7px;
    }


    .subscription-details > div {
        padding: 10px;

        border-radius: 9px;

        background: #FFFFFF;
    }


    .subscription-details .wide {
        grid-column:
            1
            /
            -1;
    }


    .subscription-details span,
    .subscription-details strong {
        display: block;
    }


    .subscription-details span {
        color: #8B9793;

        font-size: .5rem;
        font-weight: 850;

        letter-spacing: .06em;

        text-transform: uppercase;
    }


    .subscription-details strong {
        margin-top: 3px;

        color: #173D3D;

        font-size: .62rem;
        font-weight: 900;
    }


    .subscription-details strong.active-text {
        color: #24815D;
    }


    /* =========================================================
       DIGITAL PET ID VALUE
       ========================================================= */

    .petid-feature-section {
        margin-top: 20px;
    }


    .section-label {
        color: #2F9098;

        font-size: .55rem;
        font-weight: 950;

        letter-spacing: .12em;
    }


    .petid-value-list {
        margin-top: 12px;

        display: grid;

        gap: 8px;
    }


    .petid-value-list > div {
        padding: 11px;

        display: grid;

        grid-template-columns:
            auto
            minmax(0, 1fr);

        align-items: center;

        gap: 10px;

        border-radius: 11px;

        background: #F6F9F8;
    }


    .petid-value-list > div > span {
        width: 36px;
        height: 36px;

        display: grid;
        place-items: center;

        border-radius: 9px;

        background: #E2F2EF;

        color: var(--petid-teal);
    }


    .petid-value-list strong,
    .petid-value-list small {
        display: block;
    }


    .petid-value-list strong {
        color: var(--petid-dark);

        font-size: 11px;
    }


    .petid-value-list small {
        margin-top: 2px;

        color: #81908B;

        font-size: 9px;
        line-height: 1.45;
    }


    /* =========================================================
       PREMIUM BENEFITS
       ========================================================= */

.petid-benefits {
    margin-top: 16px;
    padding: 15px;

        border:
            1px solid
            #E7D38B;

        border-radius: 14px;

        background:
            linear-gradient(
                135deg,
                #FFF9E7,
                #FFFDF7
            );
    }


    .benefits-heading {
        margin-bottom: 11px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 12px;
    }


    .benefits-heading > span {
        color: #8A6918;

        font-size: 9px;
        font-weight: 950;

        letter-spacing: .09em;
    }


    .benefits-heading > strong {
        color: var(--petid-dark);

        font-size: 13px;
    }


.benefit {
    margin-top: 7px;

        display: flex;
        align-items: center;

        gap: 7px;

