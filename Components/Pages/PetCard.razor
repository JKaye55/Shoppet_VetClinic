@page "/pet/{PetId:int}/card"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject DatabaseService Db
@inject CardService Cards
@inject FileStorageService FileStorage
@inject NavigationManager Nav

<PageTitle>@(pet?.PetName ?? "Pet") Pet ID | ShoppetCare</PageTitle>


<div class="petid-page">

    @if (!isReady)
    {
        <div class="petid-shell petid-loading">
            Loading Digital Pet ID...
        </div>
    }
    else if (pet is null)
    {
        <div class="petid-shell">

            <section class="petid-error">

                <span class="petid-error-icon">

                    <svg aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                    </svg>

                </span>


                <h2>
                    Pet ID unavailable
                </h2>


                <p>
                    This pet could not be found or
                    does not belong to your account.
                </p>


                <a href="/my-pets">
                    Return to My Pets
                </a>

            </section>

        </div>
    }
    else
    {
        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <header class="petid-header">

            <div class="petid-shell petid-header-inner">

                <div>

                    <span class="petid-eyebrow">
                        DIGITAL PET ID
                    </span>


                    <h1>
                        @pet.PetName's
                        <em>connected identity.</em>
                    </h1>


                    <p>
                        A scannable ShoppetCare identity
                        connected to @pet.PetName's profile
                        and care information.
                    </p>

                </div>


                <div class="petid-header-actions">

                    <a href="/pet/@PetId">
                        Pet Details
                    </a>

                    <a href="/pet/@PetId/records">
                        Health Records
                    </a>

                    <a href="/my-pets">
                        My Pets
                    </a>

                </div>

            </div>

        </header>


        <main class="petid-shell petid-content">

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="petid-message">
                    @message
                </div>
            }


            <!-- =====================================================
                 PRODUCT WORKSPACE
                 ===================================================== -->

            <section class="petid-workspace">


                <!-- ACTUAL CARD -->

                <div class="petid-card-column">

                    <PetIdCardView Pet="@pet"
                                   OwnerName="@ownerName"
                                   PhotoUrl="@photoUrl"
                                   QrDataUri="@qrDataUri"
                                   IsPremium="@isPremium"
                                   VaccinationStatus="@vaccinationStatus"
                                   HealthRecordCount="@healthRecords.Count"
                                   PublicMode="false" />


                    <div class="petid-public-bar">

                        <span class="public-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                            </svg>

                        </span>


                        <div>

                            <strong>
                                Public Pet ID
                            </strong>

                            <p>
                                Anyone scanning the QR code sees
                                a privacy-safe version of this identity.
                                Owner details and private health
                                information remain protected.
                            </p>

                        </div>


                        <a href="/pet/card/@pet.CardId"
                           target="_blank">

                            Preview Public Card →

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     VALUE PANEL
                     ================================================= -->

                <aside class="petid-value-panel">

                    <div class="petid-value-top">

                        <span class="@(isPremium
                                                                    ? "plan-label premium"
                                                                    : "plan-label")">

                            @(isPremium
                                ? "PREMIUM ACTIVE"
                                : "BASIC PET ID")

                        </span>


                        <h2>

                            @if (isPremium)
                            {
                                <span>
                                    More than a card.
                                </span>

                                <em>
                                    A portable pet identity.
                                </em>
                            }
                            else
                            {
                                <span>
                                    A digital identity
                                </span>

                                <em>
                                    ready to grow.
                                </em>
                            }

                        </h2>


                        <p>
                            The Pet ID gives each pet a
                            recognizable ShoppetCare identity
                            that can be opened through a QR code
                            without exposing private account data.
                        </p>

                    </div>


                    <!-- VALUE POINTS -->

                    <div class="petid-value-list">

                        <div>

                            <span>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    Scannable identity
                                </strong>

                                <small>
                                    The QR opens a dedicated
                                    public Pet ID page.
                                </small>

                            </div>

                        </div>


                        <div>

                            <span>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#shield-lock-fill"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    Privacy-first sharing
                                </strong>

                                <small>
                                    Public visitors see useful
                                    pet identity information,
                                    not your private account.
                                </small>

                            </div>

                        </div>


                        <div>

                            <span>

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#clipboard2-pulse-fill"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    Connected care
                                </strong>

                                <small>
                                    The owner view links directly
                                    to @pet.PetName's health records.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- PREMIUM BENEFITS -->

                    <section class="petid-benefits">

                        <div class="benefits-heading">

                            <span>
                                @(isPremium
                                    ? "YOUR PREMIUM ACCESS"
                                    : "LIFETIME PREMIUM")
                            </span>


                            @if (!isPremium)
                            {
                                <strong>
                                    ₱49 once
                                </strong>
                            }
                            else
                            {
                                <strong>
                                    Lifetime
                                </strong>
                            }

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                            </svg>

                            Premium Pet ID themes

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                            </svg>

                            Unlimited pet profiles

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                            </svg>

                            Unlimited health records

                        </div>


                        <div class="benefit">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#patch-check-fill"></use>
                            </svg>

                            Health document export

                        </div>


                        @if (!isPremium)
                        {
                            <a href="/premium"
                               class="upgrade-button">

                                Unlock Lifetime Premium

                                <span>→</span>

                            </a>
                        }

                    </section>


                    <!-- QUICK MANAGEMENT -->

                    <div class="petid-management">

                        <span class="petid-eyebrow">
                            MANAGE THIS PET
                        </span>


                        <div>

                            <a href="/pet/@PetId">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                </svg>

                                Pet Details

                            </a>


                            <a href="/pet/@PetId/records">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#clipboard2-pulse-fill"></use>
                                </svg>

                                Health Records

                            </a>

                        </div>

                    </div>

                </aside>

            </section>


            <!-- =====================================================
                 THEMES
                 ===================================================== -->

            <section class="petid-themes">

                <div class="theme-intro">

                    <span class="petid-eyebrow">
                        PET ID APPEARANCE
                    </span>


                    <h2>
                        Make their identity
                        <em>feel like theirs.</em>
                    </h2>


                    <p>
                        Classic is included with every Pet ID.
                        Premium members can personalize
                        the card with additional visual themes.
                    </p>

                </div>


                <div class="theme-grid">

                    @foreach (var theme in CardService.PremiumThemes)
                    {
                        var locked =
                            !Cards.IsThemeAllowed(
                                theme,
                                isPremium);


                        <button type="button"
                                class="@GetThemeButtonClass(theme, locked)"
                                @onclick="() => SelectTheme(theme)">

                            <div class="@GetThemePreviewClass(theme)">

                                <span>
                                    SHOPPETCARE
                                </span>


                                <strong>
                                    @theme
                                </strong>


                                <small>
                                    @pet.PetName
                                </small>

                            </div>


                            <div class="theme-footer">

                                <span>
                                    @theme
                                </span>


                                @if (locked)
                                {
                                    <small class="locked">
                                        Premium
                                    </small>
                                }
                                else if (IsCurrentTheme(theme))
                                {
                                    <small>
                                        Selected
                                    </small>
                                }

                            </div>

                        </button>
                    }

                </div>

            </section>

        </main>
    }

</div>


<style>

    :root {
        --petid-teal: #2F9098;
        --petid-teal-dark: #267C83;
        --petid-dark: #173D3D;
        --petid-cream: #FBF8F2;
        --petid-yellow: #F3D27A;
        --petid-yellow-soft: #FFF4CF;
        --petid-border: #DDE7E4;
        --petid-muted: #72837D;
    }


    .petid-page,
    .petid-page *,
    .petid-page *::before,
    .petid-page *::after {
        box-sizing: border-box;
    }


    .petid-page {
        min-height: 100vh;
        color: var(--petid-dark);
        background: radial-gradient( circle at 93% 5%, rgba(47,144,152,.09), transparent 23% ), var(--petid-cream);
    }


        .petid-page svg {
            width: 1em;
            height: 1em;
            fill: currentColor;
        }


    .petid-shell {
        width: min( 1420px, calc(100% - 48px) );
        margin: 0 auto;
    }


    .petid-loading {
        padding: 80px 0;
        color: var(--petid-muted);
        text-align: center;
    }


    .petid-eyebrow {
        display: block;
        color: var(--petid-teal);
        font-size: 10px;
        font-weight: 950;
        letter-spacing: .13em;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .petid-header {
        padding: 33px 0;
        border-bottom: 1px solid var(--petid-border);
        background: linear-gradient( 135deg, #F0F9F7, #FFFDF8 );
    }


    .petid-header-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
    }


    .petid-header h1 {
        margin: 7px 0 0;
        color: var(--petid-dark);
        font-size: clamp( 34px, 4vw, 54px );
        line-height: .95;
        font-weight: 950;
        letter-spacing: -.05em;
    }


        .petid-header h1 em {
            color: var(--petid-teal);
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            font-weight: 500;
        }


    .petid-header p {
        max-width: 720px;
        margin: 10px 0 0;
        color: var(--petid-muted);
        font-size: 13px;
        line-height: 1.55;
    }


    .petid-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }


        .petid-header-actions a {
            min-height: 40px;
            padding: 0 12px;
            display: inline-flex;
            align-items: center;
            border: 1px solid #CFDDD9;
            border-radius: 9px;
            background: #FFFFFF;
            color: #53665F;
            font-size: 11px;
            font-weight: 850;
            text-decoration: none;
        }


    /* =========================================================
           CONTENT
           ========================================================= */

    .petid-content {
        padding: 28px 0 76px;
    }


    .petid-message {
        margin-bottom: 13px;
        padding: 12px 14px;
        border: 1px solid #B7DBCE;
        border-radius: 10px;
        background: #EFFAF5;
        color: #28664D;
        font-size: 12px;
    }


    /* =========================================================
           WORKSPACE
           ========================================================= */

    .petid-workspace {
        display: grid;
        grid-template-columns: minmax(0,1.8fr) minmax(330px,.7fr);
        gap: 16px;
        align-items: stretch;
    }


    .petid-card-column {
        min-width: 0;
    }


    /* PUBLIC */

    .petid-public-bar {
        margin-top: 12px;
        padding: 14px 16px;
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 13px;
        border: 1px solid var(--petid-border);
        border-radius: 13px;
        background: #FFFFFF;
        box-shadow: 0 7px 20px rgba(23,61,61,.035);
    }


    .public-icon {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #EAF5F5;
        color: var(--petid-teal);
    }


    .petid-public-bar strong {
        color: var(--petid-dark);
        font-size: 12px;
    }


    .petid-public-bar p {
        max-width: 600px;
        margin: 3px 0 0;
        color: #83918C;
        font-size: 10px;
        line-height: 1.45;
    }


    .petid-public-bar > a {
        color: var(--petid-teal-dark);
        font-size: 11px;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
    }


    /* =========================================================
           VALUE PANEL
           ========================================================= */

    .petid-value-panel {
        min-height: 100%;
        padding: 26px;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--petid-border);
        border-radius: 22px;
        background: radial-gradient( circle at 94% 4%, rgba(243,210,122,.25), transparent 26% ), #FFFFFF;
        box-shadow: 0 12px 32px rgba(23,61,61,.055);
    }


    .plan-label {
        color: var(--petid-teal);
        font-size: 10px;
        font-weight: 950;
        letter-spacing: .12em;
    }


        .plan-label.premium {
            color: #987016;
        }


    .petid-value-top h2 {
        margin: 8px 0 0;
        color: var(--petid-dark);
        font-size: clamp( 27px, 2.4vw, 38px );
        line-height: .98;
        font-weight: 950;
        letter-spacing: -.045em;
    }


        .petid-value-top h2 span,
        .petid-value-top h2 em {
            display: block;
        }


        .petid-value-top h2 em {
            margin-top: 2px;
            color: #A0791C;
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            font-weight: 500;
        }


    .petid-value-top > p {
        margin: 12px 0 0;
        color: #73847E;
        font-size: 12px;
        line-height: 1.62;
    }


    .petid-value-list {
        margin-top: 22px;
        display: grid;
        gap: 8px;
    }


        .petid-value-list > div {
            padding: 11px;
            display: grid;
            grid-template-columns: auto minmax(0,1fr);
            align-items: center;
            gap: 10px;
            border-radius: 11px;
            background: #F6F9F8;
        }


            .petid-value-list > div > span {
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border-radius: 9px;
                background: #E2F2EF;
                color: var(--petid-teal);
            }


        .petid-value-list strong,
        .petid-value-list small {
            display: block;
        }


        .petid-value-list strong {
            color: var(--petid-dark);
            font-size: 11px;
        }


        .petid-value-list small {
            margin-top: 2px;
            color: #81908B;
            font-size: 9px;
            line-height: 1.45;
        }


    /* BENEFITS */

    .petid-benefits {
        margin-top: 20px;
        padding: 16px;
        border: 1px solid #E7D38B;
        border-radius: 14px;
        background: linear-gradient( 135deg, #FFF9E7, #FFFDF7 );
    }


    .benefits-heading {
        margin-bottom: 11px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }


        .benefits-heading > span {
            color: #8A6918;
            font-size: 9px;
            font-weight: 950;
            letter-spacing: .09em;
        }


        .benefits-heading > strong {
            color: var(--petid-dark);
            font-size: 13px;
        }


    .benefit {
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #665A36;
        font-size: 10px;
        font-weight: 750;
    }


        .benefit svg {
            color: var(--petid-teal);
        }


    .upgrade-button {
        min-height: 42px;
        margin-top: 14px;
        padding: 0 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 9px;
        background: var(--petid-dark);
        color: #FFFFFF;
        font-size: 11px;
        font-weight: 900;
        text-decoration: none;
    }


    /* MANAGEMENT */

    .petid-management {
        margin-top: auto;
        padding-top: 20px;
    }


        .petid-management > div {
            margin-top: 8px;
            display: grid;
            grid-template-columns: repeat( 2, minmax(0,1fr) );
            gap: 7px;
        }


        .petid-management a {
            min-height: 42px;
            padding: 0 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: 1px solid #D6E1DE;
            border-radius: 9px;
            color: #566A63;
            font-size: 10px;
            font-weight: 850;
            text-decoration: none;
        }


            .petid-management a:hover {
                border-color: #BBD5D0;
                background: #F4FAF8;
                color: var(--petid-teal-dark);
            }


    /* =========================================================
           THEMES
           ========================================================= */

    .petid-themes {
        margin-top: 32px;
        padding: 26px;
        display: grid;
        grid-template-columns: minmax(240px,.45fr) minmax(0,1.55fr);
        gap: 28px;
        align-items: center;
        border: 1px solid var(--petid-border);
        border-radius: 20px;
        background: #FFFFFF;
    }


    .theme-intro h2 {
        margin: 7px 0 0;
        color: var(--petid-dark);
        font-size: 26px;
        line-height: 1;
        font-weight: 950;
        letter-spacing: -.04em;
    }


        .theme-intro h2 em {
            display: block;
            color: var(--petid-teal);
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            font-weight: 500;
        }


    .theme-intro p {
        margin: 10px 0 0;
        color: #7E8D88;
        font-size: 11px;
        line-height: 1.55;
    }


    .theme-grid {
        display: grid;
        grid-template-columns: repeat( 5, minmax(0,1fr) );
        gap: 8px;
    }


    .theme-option {
        padding: 7px;
        border: 1px solid #DCE5E2;
        border-radius: 11px;
        background: #FFFFFF;
        text-align: left;
        cursor: pointer;
        transition: transform .16s ease, border-color .16s ease;
    }


        .theme-option:hover {
            transform: translateY(-2px);
        }


        .theme-option.selected {
            border-color: var(--petid-teal);
            box-shadow: 0 0 0 2px rgba(47,144,152,.09);
        }


        .theme-option.locked {
            opacity: .58;
        }


    .theme-preview {
        height: 91px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: 8px;
        background: linear-gradient( 135deg, #F7FFFF, #DDF3F1 );
    }


        .theme-preview.theme-ocean {
            background: linear-gradient( 135deg, #EFFCFE, #BEE8ED );
        }


        .theme-preview.theme-sunset {
            background: linear-gradient( 135deg, #FFF7F2, #FFD7C6 );
        }


        .theme-preview.theme-mint {
            background: linear-gradient( 135deg, #F2FBF5, #CBE7D4 );
        }


        .theme-preview.theme-royal {
            background: linear-gradient( 135deg, #F7F4FF, #DDD2F8 );
        }


        .theme-preview span {
            font-size: 7px;
            font-weight: 950;
        }


        .theme-preview strong {
            color: var(--petid-dark);
            font-size: 13px;
        }


        .theme-preview small {
            color: #6F817A;
            font-size: 8px;
        }


    .theme-footer {
        margin-top: 6px;
        display: flex;
        justify-content: space-between;
        gap: 5px;
    }


        .theme-footer > span {
            color: #52655E;
            font-size: 10px;
            font-weight: 850;
        }


        .theme-footer small {
            color: var(--petid-teal);
            font-size: 8px;
            font-weight: 800;
        }


            .theme-footer small.locked {
                color: #9A7418;
            }


    /* =========================================================
           ERROR
           ========================================================= */

    .petid-error {
        max-width: 600px;
        margin: 65px auto;
        padding: 42px;
        text-align: center;
        border: 1px solid var(--petid-border);
        border-radius: 20px;
        background: #FFFFFF;
    }


    .petid-error-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto;
        display: grid;
        place-items: center;
        border-radius: 14px;
        background: #EAF5F5;
        color: var(--petid-teal);
    }


    .petid-error h2 {
        margin: 14px 0 0;
        font-size: 24px;
    }


    .petid-error p {
        color: var(--petid-muted);
    }


    .petid-error a {
        color: var(--petid-teal-dark);
        font-weight: 850;
    }


    @@media (max-width: 1050px) {

        .petid-workspace {
            grid-template-columns: 1fr;
        }


        .petid-value-panel {
            min-height: auto;
        }


        .petid-management {
            margin-top: 20px;
        }


        .petid-themes {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 820px) {

        .theme-grid {
            grid-template-columns: repeat( 3, minmax(0,1fr) );
        }
    }


    @@media (max-width: 650px) {

        .petid-shell {
            width: calc(100% - 24px);
        }


        .petid-header-inner {
            align-items: flex-start;
            flex-direction: column;
        }


        .petid-public-bar {
            grid-template-columns: auto minmax(0,1fr);
        }


            .petid-public-bar > a {
                grid-column: 2;
            }


        .theme-grid {
            grid-template-columns: repeat( 2, minmax(0,1fr) );
        }
    }

</style>


@code {

    [Parameter]
    public int PetId { get; set; }


    private PetProfile? pet;


    private List<PetHealthRecord> healthRecords =
        new();


    private string ownerName =
        "Pet Owner";


    private string photoUrl =
        string.Empty;


    private string qrDataUri =
        string.Empty;


    private string vaccinationStatus =
        "No Record";


    private bool isPremium;


    private bool isReady;


    private string message =
        string.Empty;


    protected override async Task OnParametersSetAsync()
    {
        await Auth.InitializeAsync();


        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo(
                "/login");

            return;
        }


        var userId =
            Auth.CurrentUser?.Id
            ??
            0;


        pet =
            Db.GetPetById(
                PetId);


        if (pet is null ||
            pet.UserId != userId)
        {
            pet =
                null;

            isReady =
                true;

            return;
        }


        isPremium =
            Auth.IsPremium;


        ownerName =
            string.IsNullOrWhiteSpace(
                Auth.CurrentUser?.FullName)
                ? "Pet Owner"
                : Auth.CurrentUser!.FullName;


        photoUrl =
            FileStorage.GetImageUrl(
                "pets",
                pet.Id)
            ??
            string.Empty;


        healthRecords =
            Db.GetHealthRecords(
                pet.Id)
            ??
            new List<PetHealthRecord>();


        vaccinationStatus =
            GetVaccinationStatus();


        qrDataUri =
            Cards.GenerateQrDataUri(
                pet.CardId,
                Nav.BaseUri.TrimEnd('/'));


        isReady =
            true;
    }


    private string GetVaccinationStatus()
    {
        var vaccination =
            healthRecords
                .Where(
                    record =>
                        string.Equals(
                            record.RecordType,
                            "Vaccination",
                            StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(
                    record =>
                        record.RecordDate)
                .FirstOrDefault();


        if (vaccination is null)
        {
            return "No Record";
        }


        if (vaccination.NextDueDate.HasValue)
        {
            if (vaccination.NextDueDate.Value.Date <
                DateTime.Today)
            {
                return "Due";
            }


            return "Recorded";
        }


        return "Recorded";
    }


    private void SelectTheme(
        string theme)
    {
        if (pet is null ||
            Auth.CurrentUser is null)
        {
            return;
        }


        if (!Cards.IsThemeAllowed(
            theme,
            isPremium))
        {
            message =
                "This card theme is included with Lifetime Premium.";

            return;
        }


        var updated =
            Db.SetCardTheme(
                pet.Id,
                Auth.CurrentUser.Id,
                theme);


        if (!updated)
        {
            message =
                "The Pet ID theme could not be changed.";

            return;
        }


        pet.CardTheme =
            theme;


        message =
            $"{theme} Pet ID theme selected.";
    }


    private bool IsCurrentTheme(
        string theme)
    {
        var current =
            string.IsNullOrWhiteSpace(
                pet?.CardTheme)
                ? "Classic"
                : pet!.CardTheme!;


        return
            string.Equals(
                current,
                theme,
                StringComparison.OrdinalIgnoreCase);
    }


    private string GetThemeButtonClass(
        string theme,
        bool locked)
    {
        var css =
            "theme-option";


        if (IsCurrentTheme(theme))
        {
            css +=
                " selected";
        }


        if (locked)
        {
            css +=
                " locked";
        }


        return css;
    }


    private string GetThemePreviewClass(
        string theme)
    {
        return
            "theme-preview " +
            Cards.GetThemeCssClass(
                theme);
    }

}