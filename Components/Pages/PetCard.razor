        margin: 0 auto;
    }


    .sc-petcard-page svg {
        width: 1em;
        height: 1em;
        fill: currentColor;
    }


    .sc-petcard-header {
        padding: 37px 0;
        border-bottom: 1px solid #DDE7E4;
        background: linear-gradient( 135deg, #F3FAF8, #FFFDF8 );
    }


    .sc-petcard-header-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
    }


        .sc-petcard-header-inner > div:first-child > span,
        .sc-petcard-themes .eyebrow {
            color: #2F9098;
            font-size: .58rem;
            font-weight: 900;
            letter-spacing: .1em;
        }


    .sc-petcard-header h1 {
        margin: 5px 0 0;
        color: #173D3D;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -.035em;
    }


    .sc-petcard-header p {
        margin: 5px 0 0;
        color: #7C8B86;
        font-size: .68rem;
    }


    .sc-petcard-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }


        .sc-petcard-actions a {
            min-height: 38px;
            padding: 0 11px;
            display: inline-flex;
            align-items: center;
            border: 1px solid #D5DFDC;
            border-radius: 8px;
            background: #FFFFFF;
            color: #52625C;
            font-size: .61rem;
            font-weight: 800;
            text-decoration: none;
        }


    .sc-petcard-content {
        padding: 27px 0 80px;
    }


    .sc-petcard-message {
        margin-bottom: 13px;
        padding: 11px 13px;
        border: 1px solid #B8DDCF;
        border-radius: 9px;
        background: #EFFAF5;
        color: #28664D;
        font-size: .66rem;
    }


    .sc-petcard-layout {
        display: grid;
        grid-template-columns: minmax(0,1fr) 285px;
        gap: 18px;
        align-items: start;
    }


    .sc-petcard-public {
        margin-top: 12px;
        padding: 13px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        border: 1px solid #DCE6E3;
        border-radius: 12px;
        background: #FFFFFF;
    }


        .sc-petcard-public > div {
            display: flex;
            align-items: center;
            gap: 9px;
        }


            .sc-petcard-public > div > svg {
                color: #2F9098;
                font-size: 1rem;
            }


        .sc-petcard-public strong,
        .sc-petcard-public small {
            display: block;
        }


        .sc-petcard-public strong {
            color: #173D3D;
            font-size: .66rem;
        }


        .sc-petcard-public small {
            margin-top: 2px;
            color: #84918D;
            font-size: .56rem;
        }


        .sc-petcard-public > a {
            color: #267C83;
            font-size: .61rem;
            font-weight: 850;
            text-decoration: none;
            white-space: nowrap;
        }


    .sc-petcard-side {
        padding: 20px;
        border: 1px solid #DDE7E4;
        border-radius: 17px;
        background: #FFFFFF;
        box-shadow: 0 9px 27px rgba(23,61,61,.05);
    }


        .sc-petcard-side .plan {
            color: #2F9098;
            font-size: .53rem;
            font-weight: 900;
            letter-spacing: .09em;
        }


            .sc-petcard-side .plan.premium {
                color: #9B7417;
            }


        .sc-petcard-side h2 {
            margin: 5px 0 0;
            color: #173D3D;
            font-size: 1rem;
            font-weight: 900;
        }


        .sc-petcard-side > p {
            margin: 6px 0 0;
            color: #788782;
            font-size: .62rem;
            line-height: 1.5;
        }


    .sc-petcard-side-links {
        margin-top: 16px;
        padding-top: 13px;
        display: grid;
        gap: 6px;
        border-top: 1px solid #EDF1EF;
    }


        .sc-petcard-side-links a {
            min-height: 37px;
            padding: 0 10px;
            display: flex;
            align-items: center;
            gap: 7px;
