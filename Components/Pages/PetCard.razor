    }


        .sc-petcard-upgrade > span,
        .sc-petcard-upgrade > strong,
        .sc-petcard-upgrade > small {
            display: block;
        }


        .sc-petcard-upgrade > span {
            color: #806212;
            font-size: .49rem;
            font-weight: 900;
            letter-spacing: .08em;
        }


        .sc-petcard-upgrade > strong {
            margin-top: 3px;
            color: #173D3D;
            font-size: 1.75rem;
            font-weight: 950;
        }


        .sc-petcard-upgrade > small {
            color: #796733;
            font-size: .53rem;
        }


        .sc-petcard-upgrade > a {
            min-height: 38px;
            margin-top: 10px;
            padding: 0 13px;
            display: inline-flex;
            align-items: center;
            border-radius: 8px;
            background: #173D3D;
            color: #FFFFFF;
            font-size: .6rem;
            font-weight: 900;
