@code {

    // =========================================================
    // ROUTE
    // =========================================================

    [Parameter]
    public int PetId { get; set; }


    // =========================================================
    // PAGE STATE
    // =========================================================

    private PetProfile? pet;


    private UserAccount? ownerAccount;


    private List<PetHealthRecord> healthRecords =
        new();


    private string ownerName =
        "Pet Owner";


    private string ownerPhone =
        string.Empty;


    private string photoUrl =
        string.Empty;


    private string qrDataUri =
        string.Empty;


    private string vaccinationStatus =
        "No Record";


    private bool isPremium;


    private bool isReady;


    private string message =
        string.Empty;


    // =========================================================
    // PREMIUM EXPIRATION
    // =========================================================

    private DateTime? PremiumEndsAt =>
        ownerAccount?
            .PremiumActivatedAt?
            .AddMonths(3);


    private string PremiumEndDisplay =>
        PremiumEndsAt?
            .ToString(
                "MMM dd, yyyy")
        ??
        "—";


    // =========================================================
    // LOAD PET CARD
    // =========================================================

    protected override async Task OnParametersSetAsync()
    {
        /*
            Always put the page back into loading state when
            navigating from one pet card to another.
        */

        isReady =
            false;


        message =
            string.Empty;


        pet =
            null;


        ownerAccount =
            null;


        ownerName =
            "Pet Owner";


        ownerPhone =
            string.Empty;


        photoUrl =
            string.Empty;


        qrDataUri =
            string.Empty;


        vaccinationStatus =
            "No Record";


        healthRecords =
            new List<PetHealthRecord>();


        isPremium =
            false;


        // =====================================================
        // AUTHENTICATION
        // =====================================================

        await Auth.InitializeAsync();


        if (!Auth.IsLoggedIn ||
            Auth.CurrentUser is null)
        {
            Nav.NavigateTo(
                "/login");

            return;
        }


        var currentUserId =
            Auth.CurrentUser.Id;


        // =====================================================
        // IMPORTANT:
        // LOAD PET BEFORE TRYING TO READ pet.UserId
        // =====================================================

        pet =
            Db.GetPetById(
                PetId);


        if (pet is null ||
            pet.UserId != currentUserId)
        {
            pet =
                null;


            isReady =
                true;


            return;
        }


        // =====================================================
        // LOAD OWNER FROM DATABASE
        // =====================================================

        ownerAccount =
            Db.GetUserById(
                pet.UserId);


        ownerName =
            string.IsNullOrWhiteSpace(
                ownerAccount?.FullName)
                ? "Pet Owner"
                : ownerAccount!.FullName;


        /*
            IMPORTANT:

            The mobile number is deliberately loaded directly
            from UserAccounts.

            Do NOT replace this with:

                Auth.CurrentUser.MobileNumber

            The current shared user mapping in the pushed branch
            does not populate MobileNumber consistently on every
            authentication query.

            This direct database call is what keeps the Pet ID
            synchronized with the number saved in UserAccounts.
        */

        ownerPhone =
            Db.GetUserMobileNumber(
                pet.UserId);


        // =====================================================
        // PREMIUM STATUS
        // =====================================================

        /*
            Use the database premium check rather than relying
            only on the cached Auth user.

            This matters after activating or expiring Premium.
        */

        isPremium =
            Db.IsUserPremium(
                pet.UserId);


        // =====================================================
        // PET PHOTO
        // =====================================================

        photoUrl =
            FileStorage.GetImageUrl(
                "pets",
                pet.Id)
            ??
            string.Empty;


        // =====================================================
        // HEALTH RECORDS
        // =====================================================

        healthRecords =
            Db.GetHealthRecords(
                pet.Id)
            ??
            new List<PetHealthRecord>();


        vaccinationStatus =
            GetVaccinationStatus();


        // =====================================================
        // QR CODE
        // =====================================================

        qrDataUri =
            Cards.GenerateQrDataUri(
                pet.CardId,
                Nav.BaseUri.TrimEnd('/'));


        // =====================================================
        // FINISHED
        // =====================================================

        isReady =
            true;
    }


    // =========================================================
    // VACCINATION SUMMARY
    // =========================================================

    private string GetVaccinationStatus()
    {
        var vaccination =
            healthRecords
                .Where(
                    record =>
                        string.Equals(
                            record.RecordType,
                            "Vaccination",
                            StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(
                    record =>
                        record.RecordDate)
                .FirstOrDefault();


        if (vaccination is null)
        {
            return "No Record";
        }


        if (vaccination.NextDueDate.HasValue &&
            vaccination.NextDueDate.Value.Date <
            DateTime.Today)
        {
            return "Due";
        }


        return "Recorded";
    }


    // =========================================================
    // SELECT CARD THEME
    // =========================================================

    private void SelectTheme(
        string theme)
    {
        if (pet is null ||
            Auth.CurrentUser is null)
        {
            return;
        }


        /*
            CardService determines whether the selected theme
            is allowed for the current account.
        */

        if (!Cards.IsThemeAllowed(
            theme,
            isPremium))
        {
            message =
                "This Pet ID theme is available with ShoppetCare Premium.";


            return;
        }


        var updated =
            Db.SetCardTheme(
                pet.Id,
                Auth.CurrentUser.Id,
                theme);


        if (!updated)
        {
            message =
                "The Pet ID theme could not be changed.";


            return;
        }


        pet.CardTheme =
            theme;


        message =
            $"{theme} Pet ID theme selected.";
    }


    // =========================================================
    // CURRENT THEME
    // =========================================================

    private bool IsCurrentTheme(
        string theme)
    {
        /*
            If Premium expires, the visual card returns to
            Classic.

            We intentionally leave the saved Premium theme in
            the database so it can return if Premium is renewed.
        */

        var current =
            !isPremium
                ? "Classic"
                : string.IsNullOrWhiteSpace(
                    pet?.CardTheme)
                    ? "Classic"
                    : pet!.CardTheme!;


        return
            string.Equals(
                current,
                theme,
                StringComparison.OrdinalIgnoreCase);
    }


    // =========================================================
    // THEME BUTTON CSS
    // =========================================================

    private string GetThemeButtonClass(
        string theme,
        bool locked)
    {
        var css =
            "theme-option";


        if (IsCurrentTheme(
            theme))
        {
            css +=
                " selected";
        }


        if (locked)
        {
            css +=
                " locked";
        }


        return css;
    }


    // =========================================================
    // THEME PREVIEW CSS
    // =========================================================

    private string GetThemePreviewClass(
        string theme)
    {
        return
            "theme-preview "
            +
            Cards.GetThemeCssClass(
                theme);
    }

}