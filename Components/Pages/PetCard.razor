@page "/pet/{PetId:int}/card"
@rendermode InteractiveServer

@inject AuthService Auth
@inject DatabaseService Db
@inject CardService Cards
@inject FileStorageService FileStorage
@inject NavigationManager Nav

<PageTitle>@(pet?.PetName ?? "Pet") Pet ID | ShoppetCare</PageTitle>


<div class="sc-petcard-page">

    @if (pet is null)
    {
        <div class="sc-petcard-shell">

            <section class="sc-petcard-error">

                <h2>
                    Pet ID unavailable
                </h2>

                <p>
                    This pet could not be found or does not belong
                    to your account.
                </p>

                <a href="/my-pets">
                    Back to My Pets
                </a>

            </section>

        </div>
    }
    else
    {
        <section class="sc-petcard-header">

            <div class="sc-petcard-shell sc-petcard-header-inner">

                <div>

                    <span>
                        SHOPPETCARE DIGITAL PET ID
                    </span>

                    <h1>
                        @pet.PetName's Pet ID
                    </h1>

                    <p>
                        View, personalize, and share this
                        scannable pet identity.
                    </p>

                </div>


                <div class="sc-petcard-actions">

                    <a href="/pet/@PetId">
                        Pet Details
                    </a>

                    <a href="/pet/@PetId/records">
                        Health Records
                    </a>

                    <a href="/my-pets">
                        My Pets
                    </a>

                </div>

            </div>

        </section>


        <main class="sc-petcard-shell sc-petcard-content">

            @if (!string.IsNullOrWhiteSpace(
                message))
            {
                <div class="sc-petcard-message">
                    @message
                </div>
            }


            <div class="sc-petcard-layout">

                <div>

                    <PetIdCardView Pet="@pet"
                                   OwnerName="@ownerName"
                                   PhotoUrl="@photoUrl"
                                   QrDataUri="@qrDataUri"
                                   IsPremium="@isPremium"
                                   VaccinationStatus="@vaccinationStatus"
                                   HealthRecordCount="@healthRecords.Count"
                                   PublicMode="false" />


                    <div class="sc-petcard-public">

                        <div>

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                            </svg>


                            <span>

                                <strong>
                                    Scannable Public Pet ID
                                </strong>

                                <small>
                                    Preview exactly what somebody
                                    sees after scanning the QR code.
                                </small>

                            </span>

                        </div>


                        <a href="/pet/card/@pet.CardId"
                           target="_blank">

                            Open Public View

                        </a>

                    </div>

                </div>


                <aside class="sc-petcard-side">

                    @if (isPremium)
                    {
                        <span class="plan premium">
                            PREMIUM ACTIVE
                        </span>

                        <h2>
                            Premium Pet ID
                        </h2>

                        <p>
                            Your Premium access includes card themes,
                            unlimited health records, and additional
                            pet profiles.
                        </p>
                    }
                    else
                    {
                        <span class="plan">
                            FREE PET ID
                        </span>

                        <h2>
                            Basic Pet ID
                        </h2>

                        <p>
                            Your free Pet ID remains fully usable.
                            Premium adds personalization and expanded
                            pet-management limits.
                        </p>
                    }


                    <div class="sc-petcard-side-links">

                        <a href="/pet/@PetId">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#pencil"></use>
                            </svg>

                            View Pet Details

                        </a>


                        <a href="/pet/@PetId/records">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#clipboard2-pulse"></use>
                            </svg>

                            Manage Health Records

                        </a>


                        <a href="/my-pets">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#heart"></use>
                            </svg>

                            Manage My Pets

                        </a>

                    </div>


                    @if (!isPremium)
                    {
                        <div class="sc-petcard-upgrade">

                            <span>
                                LIFETIME PREMIUM
                            </span>

                            <strong>
                                ₱49
                            </strong>

                            <small>
                                One-time payment
                            </small>

                            <a href="/premium">
                                Unlock Premium
                            </a>

                        </div>
                    }

                </aside>

            </div>


            <section class="sc-petcard-themes">

                <span class="eyebrow">
                    PET ID APPEARANCE
                </span>

                <h2>
                    Choose a card style
                </h2>

                <p>
                    Classic is included for free.
                    Premium members can select additional themes.
                </p>


                <div class="sc-petcard-theme-grid">

                    @foreach (var theme
                        in CardService.PremiumThemes)
                    {
                        var locked =
                            !Cards.IsThemeAllowed(
                                theme,
                                isPremium);


                        <button type="button"
                                class="@GetThemeButtonClass(
                                                                theme,
                                                                locked)"
                                @onclick="() => SelectTheme(theme)">

                            <div class="@GetThemePreviewClass(theme)">

                                <span>
                                    SHOPPETCARE
                                </span>

                                <strong>
                                    @theme
                                </strong>

                            </div>


                            <div class="theme-footer">

                                <span>
                                    @theme
                                </span>


                                @if (locked)
                                {
                                    <small class="locked">
                                        Premium
                                    </small>
                                }
                                else if (IsCurrentTheme(theme))
                                {
                                    <small>
                                        Selected
                                    </small>
                                }

                            </div>

                        </button>
                    }

                </div>

            </section>

        </main>
    }

</div>


<style>

