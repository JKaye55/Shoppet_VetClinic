@page "/inquire"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services
@inject DatabaseService DbService
@inject AuthService Auth
@inject NavigationManager Nav

<div class="inquiry-page">
    <main class="container-xl py-5">
        <div class="inquiry-shell">
            <div class="inquiry-header">
                <span class="eyebrow">FRONT DESK</span>
                <h1>Ask a clinic about your pet</h1>
                <p>Your account name and saved pets are loaded automatically, so you only need to choose what you need.</p>
            </div>

            @if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
            {
                <div class="login-note">
                    Please <a href="/login">sign in</a> first so your name and saved pets can be used automatically.
                </div>
            }
            else if (submitted)
            {
                <div class="success-panel">
                    <span class="eyebrow">INQUIRY SAVED</span>
                    <h2>Your inquiry is ready.</h2>
                    <p>The request was saved to your account and can be sent to the selected clinic.</p>

                    <div class="message-preview">@generatedMessage</div>

                    @if (!string.IsNullOrWhiteSpace(selectedMessengerUrl))
                    {
                        <a class="send-button" href="@selectedMessengerUrl" target="_blank" rel="noopener">Open Clinic Messenger</a>
                    }
                    <div class="success-actions">
                        <a href="/dashboard" class="secondary-action">View My Dashboard</a>
                        <button type="button" class="secondary-action" @onclick="ResetForm">New Inquiry</button>
                    </div>
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger rounded-4">@errorMessage</div>
                }

                <div class="form-grid">
                    <div>
                        <label>Clinic *</label>
                        <select class="form-select" @bind="selectedClinicId">
                            <option value="0">Choose a clinic</option>
                            @foreach (var clinic in clinics)
                            {
                                <option value="@clinic.Id">@clinic.ClinicName — @clinic.Branch</option>
                            }
                        </select>
                        <small>@clinics.Count clinic records loaded from the database.</small>
                    </div>

                    <div>
                        <label>Inquiry Topic *</label>
                        <select class="form-select" @bind="selectedTopic">
                            <option value="">Choose a topic</option>
                            <option>Consultation Availability</option>
                            <option>Vaccination</option>
                            <option>Pet Food / Product Availability</option>
                            <option>Grooming</option>
                            <option>Prescription / Pharmacy</option>
                            <option>General Question</option>
                        </select>
                    </div>

                    <div class="full-width">
                        <label>Pet Owner</label>
                        <div class="readonly-field">@Auth.CurrentUser.FullName</div>
                    </div>

                    <div class="full-width">
                        <label>Select Pet(s) *</label>
                        <div class="pet-selection">
                            @if (pets.Count == 0)
                            {
                                <div class="no-pets">
                                    <strong>No saved pets yet.</strong>
                                    <span>Add a pet from your dashboard first.</span>
                                    <a href="/dashboard">Go to My Dashboard</a>
                                </div>
                            }
                            else
                            {
                                @foreach (var pet in pets)
                                {
                                    <label class="pet-choice @(selectedPetIds.Contains(pet.Id) ? "selected" : "")">
                                        <input type="checkbox"
                                               checked="@selectedPetIds.Contains(pet.Id)"
                                               @onchange="e => TogglePet(pet.Id, e)" />
                                        <span>
                                            <strong>@pet.PetName</strong>
                                            <small>@pet.Species · @pet.Breed</small>
                                        </span>
                                    </label>
                                }
                                <div class="selection-hint">Choose one or up to two pets for the same inquiry.</div>
                            }
                        </div>
                    </div>

                    <div class="full-width">
                        <label>Additional Notes</label>
                        <textarea class="form-control" rows="4" @bind="notes" placeholder="Optional: preferred time, symptoms, item needed, or other details..."></textarea>
                    </div>
                </div>

                <div class="form-footer">
                    <div>
                        <strong>@SelectedPetSummary</strong>
                        <span>Owner: @Auth.CurrentUser.FullName</span>
                    </div>
                    <button type="button" class="submit-button" @onclick="SubmitInquiry" disabled="@(!CanSubmit)">
                        Save &amp; Prepare Inquiry
                    </button>
                </div>
            }
        </div>
    </main>
</div>

<style>
    .inquiry-page {
        min-height: 100vh;
        background: #FAF8F5;
        color: #1E2824
    }

    .inquiry-shell {
        max-width: 980px;
        margin: auto;
        background: white;
        border: 1px solid #E5E9E6;
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 18px 55px rgba(30,40,36,.07)
    }

    .inquiry-header {
        text-align: center;
        margin-bottom: 30px
    }

    .eyebrow {
        color: #5C766D;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .14em
    }

    .inquiry-header h1 {
        font-size: clamp(2rem,4vw,3rem);
        font-weight: 850;
        letter-spacing: -.04em;
        margin: 8px 0
    }

    .inquiry-header p {
        color: #68746F;
        max-width: 680px;
        margin: auto;
        line-height: 1.7
    }

    .login-note {
        background: #EEF4F1;
        padding: 18px;
        border-radius: 15px;
        text-align: center
    }

        .login-note a {
            color: #5C766D;
            font-weight: 800
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px
    }

        .form-grid > div {
            min-width: 0
        }

    .full-width {
        grid-column: 1/-1
    }

    .form-grid label {
        display: block;
        font-size: .75rem;
        font-weight: 850;
        color: #44534D;
        margin-bottom: 7px
    }

    .form-grid .form-control, .form-grid .form-select {
        min-height: 48px;
        border-radius: 12px;
        border: 1px solid #DCE3E0
    }

    .form-grid textarea {
        padding-top: 12px
    }

    .form-grid small {
        display: block;
        color: #87918D;
        font-size: .7rem;
        margin-top: 5px
    }

    .readonly-field {
        min-height: 48px;
        border: 1px solid #E1E7E4;
        background: #F6F8F7;
        border-radius: 12px;
        padding: 13px 15px;
        color: #33433C;
        font-weight: 700
    }

    .pet-selection {
        border: 1px solid #DCE3E0;
        border-radius: 15px;
        padding: 10px
    }

    .pet-choice {
        display: flex !important;
        align-items: center;
        gap: 12px !important;
        padding: 13px;
        border-radius: 11px;
        margin: 0 !important;
        cursor: pointer
    }

        .pet-choice:hover, .pet-choice.selected {
            background: #EEF4F1
        }

        .pet-choice input {
            width: 18px;
            height: 18px;
            accent-color: #5C766D
        }

        .pet-choice span {
            display: block
        }

        .pet-choice strong, .pet-choice small {
            display: block
        }

        .pet-choice small {
            color: #7C8782 !important;
            margin-top: 2px !important
        }

    .selection-hint {
        font-size: .7rem;
        color: #7C8782;
        padding: 7px 12px
    }

    .no-pets {
        padding: 18px;
        text-align: center;
        color: #7C8782
    }

        .no-pets strong, .no-pets span, .no-pets a {
            display: block
        }

        .no-pets strong {
            color: #34443D
        }

        .no-pets a {
            margin-top: 7px;
            color: #5C766D;
            font-weight: 800;
            text-decoration: none
        }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #E7EBE9
    }

        .form-footer strong, .form-footer span {
            display: block
        }

        .form-footer strong {
            font-size: .86rem
        }

        .form-footer span {
            color: #7C8782;
            font-size: .72rem;
            margin-top: 3px
        }

    .submit-button, .send-button {
        border: 0;
        background: #F7DD7D;
        color: #2F423B;
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 850;
        text-decoration: none
    }

        .submit-button:disabled {
            opacity: .45;
            cursor: not-allowed
        }

    .success-panel {
        text-align: center;
        background: #EEF4F1;
        border-radius: 20px;
        padding: 28px
    }

        .success-panel h2 {
            font-weight: 850;
            margin: 8px 0
        }

        .success-panel p {
            color: #68746F
        }

    .message-preview {
        text-align: left;
        background: white;
        border: 1px solid #DDE5E1;
        border-radius: 15px;
        padding: 18px;
        white-space: pre-line;
        line-height: 1.65;
        margin: 20px 0
    }

    .success-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 15px
    }

    .secondary-action {
        border: 1px solid #AAB8B2;
        background: white;
        color: #3F574E;
        border-radius: 999px;
        padding: 10px 17px;
        font-weight: 750;
        text-decoration: none
    }

    @@media(max-width:700px) {
        .inquiry-shell {
            padding: 24px;
            border-radius: 20px
        }

        .form-grid {
            grid-template-columns: 1fr
        }

        .full-width {
            grid-column: auto
        }

        .form-footer {
            flex-direction: column;
            align-items: stretch
        }

        .submit-button {
            width: 100%
        }
    }
</style>

@code {
    private List<ClinicTenant> clinics = new();
    private List<PetProfile> pets = new();
    private HashSet<int> selectedPetIds = new();
    private int selectedClinicId;
    private string selectedTopic = string.Empty;
    private string notes = string.Empty;
    private string errorMessage = string.Empty;
    private string generatedMessage = string.Empty;
    private string selectedMessengerUrl = string.Empty;
    private bool submitted;

    private bool CanSubmit =>
        Auth.CurrentUser is not null &&
        selectedClinicId > 0 &&
        !string.IsNullOrWhiteSpace(selectedTopic) &&
        selectedPetIds.Count >= 1 && selectedPetIds.Count <= 2;

    private string SelectedPetSummary =>
        string.Join(", ", pets.Where(p => selectedPetIds.Contains(p.Id)).Select(p => p.PetName));

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
        {
            return;
        }

        LoadData();
    }

    private void LoadData()
    {
        clinics = DbService.GetAllClinics() ?? new List<ClinicTenant>();
        pets = Auth.CurrentUser is null ? new List<PetProfile>() : DbService.GetPetsByUser(Auth.CurrentUser.Id);
    }

    private void TogglePet(int petId, ChangeEventArgs e)
    {
        var checkedValue = e.Value is bool b && b;
        if (checkedValue)
        {
            if (selectedPetIds.Count < 2)
                selectedPetIds.Add(petId);
        }
        else
        {
            selectedPetIds.Remove(petId);
        }
    }

    private void SubmitInquiry()
    {
        errorMessage = string.Empty;
        if (!CanSubmit || Auth.CurrentUser is null) return;

        var clinic = clinics.FirstOrDefault(c => c.Id == selectedClinicId);
        if (clinic is null)
        {
            errorMessage = "Please choose a valid clinic.";
            return;
        }

        var selectedPets = pets.Where(p => selectedPetIds.Contains(p.Id)).ToList();
        var petText = string.Join(", ", selectedPets.Select(p => $"{p.PetName} ({p.Breed})"));

        try
        {
            var inquiry = new Inquiry
            {
                UserId = Auth.CurrentUser.Id,
                ClinicId = clinic.Id,
                OwnerName = Auth.CurrentUser.FullName,
                PetName = petText,
                ServiceType = selectedTopic,
                Notes = notes
            };

            DbService.CreateInquiry(inquiry);

            generatedMessage =
                $"Hello {clinic.ClinicName},\n\n" +
                $"Pet owner: {Auth.CurrentUser.FullName}\n" +
                $"Pet(s): {petText}\n" +
                $"Inquiry: {selectedTopic}\n" +
                (string.IsNullOrWhiteSpace(notes) ? "" : $"Notes: {notes}\n") +
                "\nThank you.";

            selectedMessengerUrl = clinic.MessengerUrl ?? string.Empty;
            submitted = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FrontDeskInquiry Error] {ex}");
            errorMessage = "The inquiry could not be saved. Please try again.";
        }
    }

    private void ResetForm()
    {
        submitted = false;
        selectedClinicId = 0;
        selectedTopic = string.Empty;
        selectedPetIds.Clear();
        notes = string.Empty;
        errorMessage = string.Empty;
        generatedMessage = string.Empty;
        selectedMessengerUrl = string.Empty;
        LoadData();
    }
}
