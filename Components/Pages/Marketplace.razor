@code {

    // =========================================================
    // MARKETPLACE DATA
    // =========================================================

    private List<MarketplaceListing> listings = new();


    private readonly string[] categories =
    {
        "Accessories",
        "Beds & Furniture",
        "Carriers & Crates",
        "Clothing",
        "Feeding",
        "Grooming",
        "Toys",
        "Training",
        "Other"
    };


    // =========================================================
    // FILTERS
    // =========================================================

    private string searchText = string.Empty;

    private string categoryFilter = string.Empty;

    private string conditionFilter = string.Empty;

    private bool showMyListings;
    private bool sellerActive;


    // =========================================================
    // CREATE / EDIT FORM
    // =========================================================

    private bool showForm;

    private bool isSaving;

    private int? editingId;


    private string formTitle = string.Empty;

    private string formCategory = string.Empty;

    private string formCondition = string.Empty;

    private decimal formPrice;

    private string formDescription = string.Empty;

    private string formLocation = string.Empty;


    private IBrowserFile? selectedImage;


    // =========================================================
    // UI STATE
    // =========================================================

    private string statusMessage = string.Empty;

    private bool isError;

    private int? contactListingId;
    private int? reviewListingId;
    private readonly Dictionary<int, List<MarketplaceReview>> reviewCache = new();


    // =========================================================
    // FILTERED LISTINGS
    // =========================================================

    private List<MarketplaceListing> FilteredListings
    {
        get
        {
            IEnumerable<MarketplaceListing> result =
                listings;


            // -----------------------------------------------------
            // MY LISTINGS
            // -----------------------------------------------------

            if (showMyListings)
            {
                if (Auth.CurrentUser is null)
                {
                    return new List<MarketplaceListing>();
                }


                result =
                    result.Where(
                        listing =>
                            listing.SellerUserId ==
                            Auth.CurrentUser.Id);
            }
            else
            {
                // Sold items remain visible under My Listings,
                // but are hidden from the public marketplace feed.

                result =
                    result.Where(
                        listing =>
                            !string.Equals(
                                listing.Status,
                                "Sold",
                                StringComparison.OrdinalIgnoreCase));
            }


            // -----------------------------------------------------
            // SEARCH
            // -----------------------------------------------------

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var search =
                    searchText.Trim();


                result =
                    result.Where(
                        listing =>
                            ContainsIgnoreCase(
                                listing.Title,
                                search)
                            ||
                            ContainsIgnoreCase(
                                listing.Description,
                                search)
                            ||
                            ContainsIgnoreCase(
                                listing.Location,
                                search)
                            ||
                            ContainsIgnoreCase(
                                listing.SellerName,
                                search));
            }


            // -----------------------------------------------------
            // CATEGORY
            // -----------------------------------------------------

            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                result =
                    result.Where(
                        listing =>
                            string.Equals(
                                listing.Category,
                                categoryFilter,
                                StringComparison.OrdinalIgnoreCase));
            }


            // -----------------------------------------------------
            // CONDITION
            // -----------------------------------------------------

            if (!string.IsNullOrWhiteSpace(conditionFilter))
            {
                result =
                    result.Where(
                        listing =>
                            string.Equals(
                                listing.ItemCondition,
                                conditionFilter,
                                StringComparison.OrdinalIgnoreCase));
            }


            return result.ToList();
        }
    }


    // =========================================================
    // COMPONENT INITIALIZATION
    // =========================================================

    protected override void OnInitialized()
    {
        Auth.RegisterListener(
            OnAuthStateChanged);


        LoadListings();
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await Auth.InitializeAsync();

        RefreshSellerStatus();

        await InvokeAsync(
            StateHasChanged);
    }


    private void OnAuthStateChanged()
    {
        _ =
            InvokeAsync(
                StateHasChanged);
    }


    // =========================================================
    // LOAD LISTINGS
    // =========================================================

    private void LoadListings()
    {
        try
        {
            listings =
                ListingService
                    .GetAllListings();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Marketplace] Load failed: {ex}");


            ShowError(
                "Marketplace listings could not be loaded.");
        }
    }


    // =========================================================
    // START CREATE
    // =========================================================

    private void StartCreating()
    {
        if (!Auth.IsLoggedIn ||
            !Auth.IsPetOwner)
        {
            GoToRegister();

            return;
        }

        RefreshSellerStatus();

        if (!sellerActive)
        {
            GoToSellerCheckout();
            return;
        }

        ResetForm();


        showForm = true;

        showMyListings = true;

        statusMessage = string.Empty;
    }


    // =========================================================
    // EDIT LISTING
    // =========================================================

    private void EditListing(
        MarketplaceListing listing)
    {
        if (!IsOwnListing(listing))
            return;

        RefreshSellerStatus();

        if (!sellerActive)
        {
            ShowError("Your Verified Seller subscription is inactive. Renew it to manage listings.");
            return;
        }


        editingId =
            listing.Id;


        formTitle =
            listing.Title;


        formCategory =
            listing.Category;


        formCondition =
            listing.ItemCondition;


        formPrice =
            listing.Price;


        formDescription =
            listing.Description;


        formLocation =
            listing.Location;


        selectedImage =
            null;


        showForm =
            true;


        showMyListings =
            true;


        statusMessage =
            string.Empty;
    }


    // =========================================================
    // IMAGE
    // =========================================================

    private void HandleImageSelected(
        InputFileChangeEventArgs args)
    {
        var file =
            args.File;


        if (file.Size > 5 * 1024 * 1024)
        {
            selectedImage = null;


            ShowError(
                "Please choose an image smaller than 5 MB.");


            return;
        }


        selectedImage =
            file;


        statusMessage =
            string.Empty;
    }


    // =========================================================
    // SAVE LISTING
    // =========================================================

    private async Task SaveListingAsync()
    {
        statusMessage =
            string.Empty;


        isError =
            false;


        if (Auth.CurrentUser is null ||
            !Auth.IsPetOwner)
        {
            ShowError(
                "Please sign in with a pet owner account before creating a listing.");

            return;
        }

        RefreshSellerStatus();

        if (!sellerActive)
        {
            ShowError(
                "An active Verified Seller subscription is required to create or update listings.");

            return;
        }


        // -----------------------------------------------------
        // CLEAN VALUES
        // -----------------------------------------------------

        formTitle =
            formTitle.Trim();


        formCategory =
            formCategory.Trim();


        formCondition =
            formCondition.Trim();


        formDescription =
            formDescription.Trim();


        formLocation =
            formLocation.Trim();


        // -----------------------------------------------------
        // VALIDATION
        // -----------------------------------------------------

        if (string.IsNullOrWhiteSpace(formTitle))
        {
            ShowError(
                "Please enter an item title.");


            return;
        }


        if (formTitle.Length > 150)
        {
            ShowError(
                "Item title cannot exceed 150 characters.");


            return;
        }


        if (string.IsNullOrWhiteSpace(formCategory))
        {
            ShowError(
                "Please select a category.");


            return;
        }


        if (string.IsNullOrWhiteSpace(formCondition))
        {
            ShowError(
                "Please select the item's condition.");


            return;
        }


        if (formPrice < 0)
        {
            ShowError(
                "Price cannot be negative.");


            return;
        }


        isSaving =
            true;


        try
        {
            // =================================================
            // EDIT EXISTING
            // =================================================

            if (editingId.HasValue)
            {
                var listing =
                    new MarketplaceListing
                    {
                        Id =
                            editingId.Value,

                        SellerUserId =
                            Auth.CurrentUser.Id,

                        Title =
                            formTitle,

                        Category =
                            formCategory,

                        ItemCondition =
                            formCondition,

                        Price =
                            formPrice,

                        Description =
                            formDescription,

                        Location =
                            formLocation
                    };


                var updated =
                    ListingService
                        .UpdateListing(
                            listing,
                            Auth.CurrentUser.Id);


                if (!updated)
                {
                    ShowError(
                        "The listing could not be updated.");


                    return;
                }


                // ---------------------------------------------
                // OPTIONAL NEW IMAGE
                // ---------------------------------------------

                if (selectedImage is not null)
                {
                    var imageUrl =
                        await FileStorage
                            .SaveImageAsync(
                                "marketplace",
                                listing.Id,
                                selectedImage);


                    ListingService
                        .UpdateListingImage(
                            listing.Id,
                            Auth.CurrentUser.Id,
                            imageUrl,
                            Auth.CurrentUser.Id);
                }


                statusMessage =
                    "Your listing was updated.";
            }

            // =================================================
            // CREATE NEW
            // =================================================

            else
            {
                var listing =
                    new MarketplaceListing
                    {
                        SellerUserId =
                            Auth.CurrentUser.Id,

                        Title =
                            formTitle,

                        Category =
                            formCategory,

                        ItemCondition =
                            formCondition,

                        Price =
                            formPrice,

                        Description =
                            formDescription,

                        Location =
                            formLocation,

                        Status =
                            "Available"
                    };


                var listingId =
                    ListingService
                        .CreateListing(
                            listing,
                            Auth.CurrentUser.Id);


                // ---------------------------------------------
                // OPTIONAL IMAGE
                // ---------------------------------------------

                if (selectedImage is not null)
                {
                    var imageUrl =
                        await FileStorage
                            .SaveImageAsync(
                                "marketplace",
                                listingId,
                                selectedImage);


                    ListingService
                        .UpdateListingImage(
                            listingId,
                            Auth.CurrentUser.Id,
                            imageUrl,
                            Auth.CurrentUser.Id);
                }


                statusMessage =
                    "Your pre-loved item is now listed.";
            }


            isError =
                false;


            showForm =
                false;


            ResetForm();


            LoadListings();


            showMyListings =
                true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Marketplace] Save failed: {ex}");


            ShowError(
                "The listing could not be saved. Please try again.");
        }
        finally
        {
            isSaving =
                false;
        }
    }


    // =========================================================
    // STATUS UPDATE
    // =========================================================

    private void ChangeStatus(
        MarketplaceListing listing,
        string status)
    {
        if (!IsOwnListing(listing) ||
            Auth.CurrentUser is null)
        {
            return;
        }

        RefreshSellerStatus();

        if (!sellerActive)
        {
            ShowError("Renew Verified Seller to manage listing status.");
            return;
        }


        try
        {
            var updated =
                ListingService
                    .UpdateListingStatus(
                        listing.Id,
                        Auth.CurrentUser.Id,
                        status,
                        Auth.CurrentUser.Id);


            if (!updated)
            {
                ShowError(
                    "The listing status could not be updated.");


                return;
            }


            statusMessage =
                $"Listing marked as {status}.";


            isError =
                false;


            LoadListings();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Marketplace] Status update failed: {ex}");


            ShowError(
                "The listing status could not be updated.");
        }
    }


    private void ReserveListing(
        MarketplaceListing listing)
    {
        ChangeStatus(
            listing,
            "Reserved");
    }


    private void MarkSold(
        MarketplaceListing listing)
    {
        ChangeStatus(
            listing,
            "Sold");
    }


    private void MakeAvailable(
        MarketplaceListing listing)
    {
        ChangeStatus(
            listing,
            "Available");
    }


    // =========================================================
    // DELETE
    // =========================================================

    private void DeleteListing(
        MarketplaceListing listing)
    {
        if (!IsOwnListing(listing) ||
            Auth.CurrentUser is null)
        {
            return;
        }


        try
        {
            var deleted =
                ListingService
                    .DeleteListing(
                        listing.Id,
                        Auth.CurrentUser.Id,
                        Auth.CurrentUser.Id);


            if (!deleted)
            {
                ShowError(
                    "The listing could not be deleted.");


                return;
            }


            try
            {
                FileStorage.DeleteImage(
                    "marketplace",
                    listing.Id);
            }
            catch
            {
                // Listing deletion should still succeed even if
                // the image file was already missing.
            }


            statusMessage =
                "Listing deleted.";


            isError =
                false;


            contactListingId =
                null;


            LoadListings();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Marketplace] Delete failed: {ex}");


            ShowError(
                "The listing could not be deleted.");
        }
    }


    // =========================================================
    // CART / REVIEWS / CONTACT SELLER
    // =========================================================

    private void AddToCart(MarketplaceListing listing)
    {
        if (IsOwnListing(listing))
        {
            ShowError("You cannot add your own listing to the cart.");
            return;
        }

        if (Cart.Add(listing))
        {
            statusMessage = Auth.IsGuest
                ? "Added to your guest cart. Sign in before checkout."
                : "Item added to cart.";
            isError = false;
        }
    }

    private List<MarketplaceReview> GetReviews(int listingId)
    {
        if (!reviewCache.TryGetValue(listingId, out var reviews))
        {
            try
            {
                reviews = Orders.GetListingReviews(listingId);
            }
            catch
            {
                reviews = new List<MarketplaceReview>();
            }

            reviewCache[listingId] = reviews;
        }

        return reviews;
    }

    private static string GetRatingText(List<MarketplaceReview> reviews)
    {
        if (reviews.Count == 0) return "New";
        return $"★ {reviews.Average(x => x.Rating):0.0}";
    }

    private void ToggleReviews(int listingId)
    {
        reviewListingId = reviewListingId == listingId ? null : listingId;
    }


