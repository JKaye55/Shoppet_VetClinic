    private bool IsOwnListing(
        MarketplaceListing listing)
    {
        return
            Auth.CurrentUser is not null
            &&
            listing.SellerUserId ==
            Auth.CurrentUser.Id;
    }


    // =========================================================
    // STATUS HELPERS
    // =========================================================

    private bool IsAvailable(
        MarketplaceListing listing)
    {
        return
            string.Equals(
                listing.Status,
                "Available",
                StringComparison.OrdinalIgnoreCase);
    }


    private bool IsReserved(
        MarketplaceListing listing)
    {
        return
            string.Equals(
                listing.Status,
                "Reserved",
                StringComparison.OrdinalIgnoreCase);
    }


    private bool IsSold(
        MarketplaceListing listing)
    {
        return
            string.Equals(
                listing.Status,
                "Sold",
                StringComparison.OrdinalIgnoreCase);
    }


    private string GetStatusClass(
        string status)
    {
        if (string.Equals(
            status,
            "Sold",
            StringComparison.OrdinalIgnoreCase))
        {
            return
                "sc-marketplace-status-sold";
        }


        if (string.Equals(
            status,
            "Reserved",
            StringComparison.OrdinalIgnoreCase))
        {
            return
                "sc-marketplace-status-reserved";
        }


        return
            "sc-marketplace-status";
    }


    // =========================================================
    // SEARCH HELPER
    // =========================================================

    private static bool ContainsIgnoreCase(
        string? value,
        string search)
    {
        return
            !string.IsNullOrWhiteSpace(value)
            &&
            value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }


    // =========================================================
    // INITIALS
    // =========================================================

    private string GetInitials(
        string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "U";
        }


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 0)
        {
            return "U";
        }


        if (parts.Length == 1)
        {
            return
                parts[0]
                    .Substring(
                        0,
                        Math.Min(
                            2,
                            parts[0].Length))
                    .ToUpperInvariant();
        }


        return
            (
                parts[0].Substring(0, 1)
                +
                parts[^1].Substring(0, 1)
            )
            .ToUpperInvariant();
    }


