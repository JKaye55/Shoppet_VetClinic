@page "/marketplace"
@rendermode InteractiveServer
@implements IDisposable

@inject OwnerCareService Care
@inject MarketplaceService ListingService
@inject CommerceService Commerce
@inject FileStorageService FileStorage
@inject AuthService Auth
@inject NavigationManager Nav
@inject MarketplaceCartService Cart
@inject MarketplaceOrderService Orders

<PageTitle>Pre-Loved Marketplace | ShoppetCare</PageTitle>


<div class="sc-marketplace-page">

    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="sc-marketplace-hero">

        <div class="sc-marketplace-shell sc-marketplace-hero-inner">

            <div class="sc-marketplace-hero-copy">

                <span class="sc-marketplace-kicker light">
                    PRE-LOVED PET MARKETPLACE
                </span>

                <h1>
                    Give pet essentials
                    <em>a second home.</em>
                </h1>

                <p>
                    Browse pre-loved pet items from fellow
                    ShoppetCare pet owners in the local community.
                </p>

            </div>


            <div class="sc-marketplace-hero-actions">

                @if (Auth.IsLoggedIn && Auth.IsPetOwner && sellerActive)
                {
                    <button type="button"
                            class="sc-marketplace-sell"
                            @onclick="StartCreating">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        Sell an Item
                    </button>
                }
                else if (Auth.IsLoggedIn && Auth.IsPetOwner)
                {
                    <button type="button"
                            class="sc-marketplace-sell"
                            @onclick="GoToSellerCheckout">
                        <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                        Become a Verified Seller
                    </button>
                }
                else
                {
                    <button type="button"
                            class="sc-marketplace-sell"
                            @onclick="GoToRegister">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                        Sell an Item
                    </button>
                }

            </div>

        </div>

    </section>


    <!-- =========================================================
         GUEST MESSAGE
         ========================================================= -->
    @if (Auth.IsGuest)
    {
        <section class="sc-marketplace-guest">

            <div class="sc-marketplace-shell">

                <div class="sc-marketplace-guest-card">

                    <div class="sc-marketplace-guest-icon">
                        <i class="bi bi-eye-fill"
                           aria-hidden="true"></i>
                    </div>

                    <div class="sc-marketplace-guest-copy">

                        <strong>
                            Browsing as Guest
                        </strong>

                        <span>
                            You can browse listings and add available items to a temporary cart.
                            Create an account or sign in to submit a purchase request,
                            contact a seller, review completed purchases, and earn vouchers.
                        </span>

                    </div>

                    <a href="/register">
                        Create Account
                    </a>

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         STATUS MESSAGE
         ========================================================= -->
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="sc-marketplace-shell">

            <div class="@(isError
                                ? "sc-marketplace-alert error"
                                : "sc-marketplace-alert success")">

                @statusMessage

            </div>

        </div>
    }


    <!-- =========================================================
         CREATE / EDIT FORM
         ========================================================= -->
    @if (showForm)
    {
        <section class="sc-marketplace-form-section">

            <div class="sc-marketplace-shell">

                <div class="sc-marketplace-form-card">

                    <div class="sc-marketplace-form-head">

                        <div>

                            <span class="sc-marketplace-kicker">
                                @(editingId.HasValue
                                    ? "EDIT LISTING"
                                    : "NEW LISTING")
                            </span>

                            <h2>
                                @(editingId.HasValue
                                    ? "Update your item"
                                    : "List a pre-loved item")
                            </h2>

                            <p>
                                Add the important details another pet
                                owner should know about your item.
                            </p>

                        </div>

                        <button type="button"
                                class="sc-marketplace-close"
                                @onclick="CancelForm"
                                aria-label="Close listing form">

                            <i class="bi bi-x-lg"
                               aria-hidden="true"></i>

                        </button>

                    </div>


                    <div class="sc-marketplace-form-grid">

                        <!-- TITLE -->

                        <div class="sc-marketplace-field field-wide">

                            <label>
                                Item Title <span>*</span>
                            </label>

                            <input type="text"
                                   maxlength="150"
                                   @bind="formTitle"
                                   placeholder="Example: Large Pet Carrier" />

                        </div>


                        <!-- CATEGORY -->

                        <div class="sc-marketplace-field">

                            <label>
                                Category <span>*</span>
                            </label>

                            <select @bind="formCategory">

                                <option value="">
                                    Select category
                                </option>

                                @foreach (var category in categories)
                                {
                                    <option value="@category">
                                        @category
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- CONDITION -->

                        <div class="sc-marketplace-field">

                            <label>
                                Condition <span>*</span>
                            </label>

                            <select @bind="formCondition">

                                <option value="">
                                    Select condition
                                </option>

                                <option value="Like New">
                                    Like New
                                </option>

                                <option value="Good">
                                    Good
                                </option>

                                <option value="Fair">
                                    Fair
                                </option>

                            </select>

                        </div>


                        <!-- PRICE -->

                        <div class="sc-marketplace-field">

                            <label>
                                Price <span>*</span>
                            </label>

                            <div class="sc-marketplace-price-input">

                                <span>₱</span>

                                <input type="number"
                                       min="0"
                                       step="0.01"
                                       @bind="formPrice"
                                       placeholder="0.00" />

                            </div>

                        </div>


                        <!-- LOCATION -->

                        <div class="sc-marketplace-field">

                            <label>
                                Location
                            </label>

                            <input type="text"
                                   maxlength="150"
                                   @bind="formLocation"
                                   placeholder="Example: Lipa City" />

                        </div>


                        <!-- DESCRIPTION -->

                        <div class="sc-marketplace-field field-wide">

                            <label>
                                Description
                            </label>

                            <textarea rows="4"
                                      maxlength="1000"
                                      @bind="formDescription"
                                      placeholder="Describe the item, size, usage, or anything the next owner should know.">
                            </textarea>

                        </div>


                        <!-- IMAGE -->

                        <div class="sc-marketplace-field field-wide">

                            <label>
                                Item Photo
                            </label>

                            <div class="sc-marketplace-upload">

                                <InputFile OnChange="HandleImageSelected"
                                           accept=".jpg,.jpeg,.png,.webp" />

                                <small>
                                    JPG, JPEG, PNG or WEBP · Maximum 5 MB
                                </small>

                                @if (selectedImage is not null)
                                {
                                    <strong>
                                        Selected: @selectedImage.Name
                                    </strong>
                                }

                            </div>

                        </div>

                    </div>


                    <div class="sc-marketplace-form-actions">

                        <button type="button"
                                class="sc-marketplace-save"
                                disabled="@isSaving"
                                @onclick="SaveListingAsync">

                            @if (isSaving)
                            {
                                <span>
                                    Saving...
                                </span>
                            }
                            else if (editingId.HasValue)
                            {
                                <span>
                                    Save Changes
                                </span>
                            }
                            else
                            {
                                <span>
                                    Publish Listing
                                </span>
                            }

                        </button>


                        <button type="button"
                                class="sc-marketplace-cancel"
                                disabled="@isSaving"
                                @onclick="CancelForm">

                            Cancel

                        </button>

                    </div>

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         MARKETPLACE
         ========================================================= -->

    <section class="sc-marketplace-content">

        <div class="sc-marketplace-shell">

            @if (Auth.IsLoggedIn && Auth.IsPetOwner)
            {
                <div style="margin-bottom:18px;padding:14px 16px;border:1px solid #DDE7E4;border-radius:14px;background:#FFFFFF;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
                    <div>
                        <strong style="display:block;color:#173D3D;">
                            @(sellerActive ? "Selling is available" : "Browsing as a Pet Owner")
                        </strong>
                        <span style="display:block;margin-top:3px;color:#77857F;font-size:.72rem;">
                            Every Pet Owner can sell pre-loved items. No seller subscription is needed.
                        </span>
                    </div>

                </div>
            }


            <!-- =================================================
                 USER TABS
                 ================================================= -->
            @if (Auth.IsLoggedIn && Auth.IsPetOwner)
            {
                <div class="sc-marketplace-tabs">

                    <button type="button"
                            class="@(!showMyListings ? "active" : "")"
                            @onclick="ShowBrowse">

                        Browse Marketplace

                    </button>

                    <button type="button"
                            class="@(showMyListings ? "active" : "")"
                            @onclick="ShowMine">

                        My Listings

                    </button>

                </div>
            }


            <!-- =================================================
                 FILTERS
                 ================================================= -->

            <div class="sc-marketplace-filters">

                <div class="sc-marketplace-search">

                    <i class="bi bi-search"
                       aria-hidden="true"></i>

                    <input type="search"
                           @bind="searchText"
                           @bind:event="oninput"
                           placeholder="Search pre-loved items..." />

                </div>


                <select @bind="categoryFilter">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category">
                            @category
                        </option>
                    }

                </select>


                <select @bind="conditionFilter">

                    <option value="">
                        Any Condition
                    </option>

                    <option value="Like New">
                        Like New
                    </option>

                    <option value="Good">
                        Good
                    </option>

                    <option value="Fair">
                        Fair
                    </option>

                </select>

            </div>


            <!-- =================================================
                 RESULT HEADER
                 ================================================= -->

            <div class="sc-marketplace-result-head">

                <div>

                    <span class="sc-marketplace-kicker">
                        @(showMyListings
                            ? "YOUR ITEMS"
                            : "COMMUNITY LISTINGS")
                    </span>

                    <h2>
                        @(showMyListings
                            ? "My Listings"
                            : "Find something useful for your pet")
                    </h2>

                </div>

                <span class="sc-marketplace-count">

                    @FilteredListings.Count
                    @(FilteredListings.Count == 1
                        ? "item"
                        : "items")

                </span>

            </div>


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->
            @if (FilteredListings.Count == 0)
            {
                <div class="sc-marketplace-empty">

                    <div class="sc-marketplace-empty-icon">

                        <i class="bi bi-bag-heart"
                           aria-hidden="true"></i>

                    </div>

                    <h3>
                        @(showMyListings
                            ? "You haven't listed anything yet."
                            : "No listings match your search.")
                    </h3>

                    <p>
                        @(showMyListings
                            ? "Give one of your pet items a second home by creating your first listing."
                            : "Try another search, category, or condition.")
                    </p>

                    @if (showMyListings)
                    {
                        <button type="button"
                                class="sc-marketplace-empty-button"
                                @onclick="StartCreating">

                            Create Listing

                        </button>
                    }

                </div>
            }
            else
            {
                <!-- =================================================
                     LISTING GRID
                     ================================================= -->

                <div class="sc-marketplace-grid">

                    @foreach (var listing in FilteredListings)
                    {
                        var reviews = GetReviews(listing.Id);

                        <article class="sc-marketplace-card">


                            <!-- =====================================
                                 IMAGE
                                 ===================================== -->

                            <div class="sc-marketplace-card-image">

                                @if (!string.IsNullOrWhiteSpace(listing.ImageUrl))
                                {
                                    <img src="@listing.ImageUrl"
                                         alt="@listing.Title" />
                                }
                                else
                                {
                                    <div class="sc-marketplace-image-placeholder">

                                        <i class="bi bi-image"
                                           aria-hidden="true"></i>

                                        <span>
                                            No photo
                                        </span>

                                    </div>
                                }


                                <span class="@GetStatusClass(listing.Status)">
                                    @listing.Status
                                </span>

                            </div>


                            <!-- =====================================
                                 INFORMATION
                                 ===================================== -->

                            <div class="sc-marketplace-card-body">

                                <div class="sc-marketplace-card-meta">

                                    <span>
                                        @listing.Category
                                    </span>

                                    <span>
                                        @listing.ItemCondition
                                    </span>

                                </div>


                                <h3>
                                    @listing.Title
                                </h3>


                                <div class="sc-marketplace-price">
                                    ₱@listing.Price.ToString("N2")
                                </div>


                                @if (!string.IsNullOrWhiteSpace(listing.Location))
                                {
                                    <div class="sc-marketplace-location">

                                        <i class="bi bi-geo-alt"
                                           aria-hidden="true"></i>

                                        <span>
                                            @listing.Location
                                        </span>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(listing.Description))
                                {
                                    <p class="sc-marketplace-description">
                                        @listing.Description
                                    </p>
                                }


                                <!-- =================================
                                     SELLER
                                     ================================= -->

                                <div class="sc-marketplace-seller">

                                    <div class="sc-marketplace-seller-avatar">
                                        @GetInitials(listing.SellerName)
                                    </div>

                                    <div>

                                        <span>
                                            Listed by
                                        </span>

                                        <strong>
                                            @listing.SellerName
                                        @if (listing.IsVerifiedSeller)
                                        {
                                            <span style="display:inline-flex;margin-left:6px;padding:3px 7px;border-radius:999px;background:#EAF5F5;color:#267C83;font-size:.58rem;font-weight:900;vertical-align:middle;">
                                                Verified Seller
                                            </span>
                                        }
                                        </strong>

                                    </div>

                                </div>


                                <!-- =================================
                                     OWNER ACTIONS
                                     ================================= -->
                                @if (IsOwnListing(listing))
                                {
                                    <div class="sc-marketplace-owner-label">

                                        <i class="bi bi-person-check-fill"
                                           aria-hidden="true"></i>

                                        Your listing

                                    </div>


                                    <div class="sc-marketplace-owner-actions">

                                        <button type="button"
                                                @onclick="() => EditListing(listing)">

                                            Edit

                                        </button>


                                        @if (!IsReserved(listing))
                                        {
                                            <button type="button"
                                                    @onclick="() => ReserveListing(listing)">

                                                Reserve

                                            </button>
                                        }


                                        @if (!IsSold(listing))
                                        {
                                            <button type="button"
                                                    @onclick="() => MarkSold(listing)">

                                                Mark Sold

                                            </button>
                                        }


                                        @if (!IsAvailable(listing))
                                        {
                                            <button type="button"
                                                    @onclick="() => MakeAvailable(listing)">

                                                Make Available

                                            </button>
                                        }


                                        <button type="button"
                                                class="danger"
                                                @onclick="() => DeleteListing(listing)">

                                            Delete

                                        </button>

                                    </div>
                                }
                                else
                                {
                                    <div class="sc-marketplace-buyer-actions">
                                        <button type="button"
                                                class="sc-marketplace-cart"
                                                disabled="@(!IsAvailable(listing) || Cart.Contains(listing.Id))"
                                                @onclick="() => AddToCart(listing)">
                                            <i class="bi bi-bag-plus" aria-hidden="true"></i>
                                            @(Cart.Contains(listing.Id)
                                                ? "In Cart"
                                                : IsAvailable(listing) ? "Add to Cart" : "Unavailable")
                                        </button>

                                        @if (Auth.IsLoggedIn)
                                        {
                                            <button type="button"
                                                    class="sc-marketplace-contact"
                                                    disabled="@IsSold(listing)"
                                                    @onclick="() => ToggleContact(listing.Id)">
                                                <i class="bi bi-envelope" aria-hidden="true"></i>
                                                @(IsSold(listing) ? "Item Sold" : "Contact Seller")
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="sc-marketplace-contact locked"
                                                    @onclick="GoToLogin">
                                                <i class="bi bi-lock-fill" aria-hidden="true"></i>
                                                Sign in to Contact Seller
                                            </button>
                                        }
                                    </div>

                                    @if (Auth.IsLoggedIn && contactListingId == listing.Id)
                                    {
                                        <div class="sc-marketplace-contact-box">
                                            <span>Seller contact</span>
                                            <a href="@($"/messages?contactId={listing.SellerUserId}&listingId={listing.Id}")">Message seller</a>
                                            @foreach(var social in Care.SellerSocial(listing.SellerUserId)) { <a href="@social.Url" target="_blank" rel="noopener noreferrer">@social.Name</a> }
                                        </div>
                                    }

                                    <div class="sc-marketplace-rating">
                                        <strong>@GetRatingText(reviews)</strong>
                                        <span>@(reviews.Count == 0 ? "No verified reviews yet" : $"{reviews.Count} verified review{(reviews.Count == 1 ? "" : "s")}")</span>
                                        @if (reviews.Count > 0)
                                        {
                                            <button type="button" @onclick="() => ToggleReviews(listing.Id)">
                                                @(reviewListingId == listing.Id ? "Hide Reviews" : "Read Reviews")
                                            </button>
                                        }
                                    </div>

                                    @if (reviewListingId == listing.Id)
                                    {
                                        <div class="sc-marketplace-reviews">
                                            @foreach (var review in reviews)
                                            {
                                                <article>
                                                    <div>
                                                        <strong>@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</strong>
                                                        <span>@review.BuyerName · Verified Purchase</span>
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                                    {
                                                        <p>@review.Comment</p>
                                                    }
                                                    @if (review.RewardIssued)
                                                    {
                                                        <small>Review reward received</small>
                                                    }
                                                </article>
                                            }
                                        </div>
                                    }
                                }

                            </div>

                        </article>
                    }

                </div>
            }

        </div>

    </section>

</div>


<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .sc-marketplace-page {
        min-height: 100vh;
        background: #FAF9F6;
        color: #172A28;
    }


    .sc-marketplace-shell {
        width: min(1320px, calc(100% - 40px));
        margin: 0 auto;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .sc-marketplace-hero {
        padding: 68px 0 58px;
        background: radial-gradient( circle at 86% 16%, rgba(243,210,122,.22), transparent 26% ), linear-gradient( 135deg, #173D3D, #102E2D );
        color: #FFFFFF;
    }


    .sc-marketplace-hero-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 40px;
    }


    .sc-marketplace-hero-copy {
        max-width: 760px;
    }


    .sc-marketplace-kicker {
        display: inline-block;
        color: #2F9098;
        font-size: .66rem;
        font-weight: 900;
        letter-spacing: .11em;
    }


        .sc-marketplace-kicker.light {
            color: #9ADBDD;
        }


    .sc-marketplace-hero h1 {
        max-width: 700px;
        margin: 10px 0 0;
        font-size: clamp( 2.8rem, 5vw, 5rem );
        font-weight: 900;
        line-height: .94;
        letter-spacing: -.055em;
    }


        .sc-marketplace-hero h1 em {
            display: block;
            color: #F3D27A;
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 500;
        }


    .sc-marketplace-hero p {
        max-width: 620px;
        margin: 20px 0 0;
        color: rgba( 255, 255, 255, .66 );
        line-height: 1.65;
    }


    .sc-marketplace-sell {
        min-height: 48px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 0;
        border-radius: 10px;
        background: #F3D27A;
        color: #173D3D;
        font-size: .78rem;
        font-weight: 900;
        cursor: pointer;
        transition: transform .18s ease, background .18s ease;
    }


        .sc-marketplace-sell:hover {
            transform: translateY(-2px);
            background: #F8DF98;
        }


    /* =========================================================
           GUEST MESSAGE
           ========================================================= */

    .sc-marketplace-guest {
        padding-top: 20px;
    }


    .sc-marketplace-guest-card {
        padding: 15px 18px;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 13px;
        border: 1px solid #D6E5E1;
        border-radius: 14px;
        background: #EEF7F5;
    }


    .sc-marketplace-guest-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #FFFFFF;
        color: #2F9098;
    }


    .sc-marketplace-guest-copy strong,
    .sc-marketplace-guest-copy span {
        display: block;
    }


    .sc-marketplace-guest-copy strong {
        color: #173D3D;
        font-size: .77rem;
    }


    .sc-marketplace-guest-copy span {
        margin-top: 3px;
        color: #71807B;
        font-size: .69rem;
        line-height: 1.45;
    }


    .sc-marketplace-guest-card a {
        color: #267C83;
        font-size: .72rem;
        font-weight: 850;
        text-decoration: none;
    }


    /* =========================================================
           ALERT
           ========================================================= */

    .sc-marketplace-alert {
        margin-top: 18px;
        padding: 12px 15px;
        border-radius: 10px;
        font-size: .76rem;
    }


        .sc-marketplace-alert.success {
            border: 1px solid #B8DDCF;
            background: #EFFAF5;
            color: #28664D;
        }


        .sc-marketplace-alert.error {
            border: 1px solid #F2B8B8;
            background: #FFF3F3;
            color: #9B2C2C;
        }


    /* =========================================================
           LISTING FORM
           ========================================================= */

    .sc-marketplace-form-section {
        padding: 22px 0 0;
    }


    .sc-marketplace-form-card {
        padding: 26px;
        border: 1px solid #DDE7E4;
        border-radius: 20px;
        background: #FFFFFF;
        box-shadow: 0 16px 40px rgba(23,61,61,.07);
    }


    .sc-marketplace-form-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
    }


        .sc-marketplace-form-head h2 {
            margin: 6px 0 0;
            color: #173D3D;
            font-size: 1.55rem;
            font-weight: 900;
            letter-spacing: -.025em;
        }


        .sc-marketplace-form-head p {
            margin: 7px 0 0;
            color: #7C8C87;
            font-size: .77rem;
        }


    .sc-marketplace-close {
        width: 39px;
        height: 39px;
        flex: 0 0 39px;
        display: grid;
        place-items: center;
        border: 1px solid #DDE7E4;
        border-radius: 10px;
        background: #FFFFFF;
        color: #66746F;
        cursor: pointer;
    }


    .sc-marketplace-form-grid {
        margin-top: 23px;
        display: grid;
        grid-template-columns: repeat( 2, minmax(0, 1fr) );
        gap: 15px;
    }


    .sc-marketplace-field.field-wide {
        grid-column: 1 / -1;
    }


    .sc-marketplace-field label {
        display: block;
        margin-bottom: 7px;
        color: #173D3D;
        font-size: .71rem;
        font-weight: 850;
    }


        .sc-marketplace-field label span {
            color: #B84A4A;
        }


    .sc-marketplace-field input,
    .sc-marketplace-field select,
    .sc-marketplace-field textarea {
        width: 100%;
        border: 1px solid #C9D9D5;
