@page "/guest-dashboard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.JSInterop

@inject AuthService Auth
@inject ProtectedSessionStorage Session
@inject IJSRuntime JS

<PageTitle>Guest Dashboard | ShoppetCare</PageTitle>

<div class="gd-page">
    <section class="gd-hero">
        <div class="gd-shell gd-hero-inner">
            <div>
                <span class="gd-eyebrow light">GUEST EXPERIENCE</span>
                <h1>Meet your temporary pet.</h1>
                <p>
                    Try the shape of My ShoppetCare without creating an account. Choose a guided pet profile,
                    add a photo, and explore the features that are intentionally available to guests.
                </p>
            </div>

            <div class="gd-status">
                <span>GUEST ACCESS</span>
                <strong>1 temporary pet</strong>
                <small>Browser session only · not saved to an account</small>
            </div>
        </div>
    </section>

    <section class="gd-subnav">
        <div class="gd-shell gd-tabs" aria-label="Guest dashboard">
            <a href="/guest-dashboard" class="active"><i class="bi bi-grid"></i> Overview</a>
            <a href="/clinics"><i class="bi bi-hospital"></i> Clinics</a>
            <a href="/marketplace"><i class="bi bi-bag-heart"></i> Marketplace</a>
            <a href="/community"><i class="bi bi-people"></i> Community</a>

            <span class="gd-tab locked" title="Create an account to unlock">
                <i class="bi bi-lock-fill"></i> Pet ID
            </span>
            <span class="gd-tab locked" title="Create an account to unlock">
                <i class="bi bi-lock-fill"></i> Orders
            </span>
            <span class="gd-tab locked" title="Create an account to unlock">
                <i class="bi bi-lock-fill"></i> Notifications
            </span>
        </div>
    </section>

    <main class="gd-shell gd-content">
        @if (!ready)
        {
            <div class="gd-panel gd-loading">Loading Guest Mode...</div>
        }
        else if (!Auth.IsGuest)
        {
            <section class="gd-panel gd-centered">
                <div class="gd-large-icon"><i class="bi bi-person-heart"></i></div>
                <span class="gd-eyebrow">GUEST DASHBOARD</span>
                <h2>Guest Mode is not active.</h2>
                <p>Enter Guest Mode to try the temporary pet experience.</p>
                <a class="gd-primary link" href="/home?guest=true">Enter Guest Mode</a>
            </section>
        }
        else
        {
            <div class="gd-mode-note">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>This is a preview, not an account.</strong>
                    <span>Your temporary pet and photo disappear when this browser session ends. Nothing here creates a permanent Pet Profile.</span>
                </div>
                <a href="/register">Keep my pet permanently</a>
            </div>

            <section class="gd-grid">
                <article class="gd-panel gd-pet-panel">
                    <div class="gd-panel-head">
                        <div>
                            <span class="gd-eyebrow">TEMPORARY PET</span>
                            <h2>Build your guest pet</h2>
                            <p>Use guided choices instead of typing. Add a photo to experience how a pet profile feels.</p>
                        </div>
                        <span class="gd-limit"><i class="bi bi-clock"></i> SESSION ONLY</span>
                    </div>

                    @if (!hasPet && !showForm)
                    {
                        <div class="gd-empty">
                            <div class="gd-empty-visual">
                                <div class="gd-empty-photo"><i class="bi bi-camera-fill"></i></div>
                                <div class="gd-empty-copy">
                                    <strong>No guest pet yet.</strong>
                                    <span>Choose a sample pet identity and add your own photo. No account is needed.</span>
                                    <button class="gd-primary" @onclick="OpenForm">
                                        <i class="bi bi-plus-lg"></i> Create Guest Pet
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (showForm)
                    {
                        <div class="gd-editor">
                            <section class="gd-photo-column">
                                <div class="gd-photo-preview">
                                    <img @ref="editorPhotoElement"
                                         class="@(!hasPhoto ? "gd-browser-photo hidden" : "gd-browser-photo")"
                                         alt="Guest pet preview" />

                                    @if (!hasPhoto)
                                    {
                                        <div>
                                            <i class="bi bi-camera-fill"></i>
                                            <strong>Add a pet photo</strong>
                                            <span>JPG, PNG or WEBP · maximum 5 MB</span>
                                        </div>
                                    }
                                </div>

                                <label class="gd-photo-button">
                                    <i class="bi bi-upload"></i>
                                    @(hasPhoto ? "Change Photo" : "Choose Photo")
                                    <InputFile @ref="photoInput"
                                               OnChange="HandlePhotoSelected"
                                               accept="image/jpeg,image/png,image/webp" />
                                </label>

                                @if (hasPhoto)
                                {
                                    <button type="button" class="gd-remove-photo" @onclick="RemovePhoto">
                                        Remove photo
                                    </button>
                                }

                                <small class="gd-photo-note">
                                    The guest photo is previewed in this session only. It is not uploaded to a ShoppetCare account.
                                </small>
                            </section>

                            <section class="gd-guided-form">
                                <div class="gd-step">
                                    <span>1</span>
                                    <div>
                                        <strong>Choose a pet name</strong>
                                        <small>Guest Mode uses sample choices so the preview stays quick.</small>
                                    </div>
                                </div>

                                <div class="gd-choice-grid names">
                                    @foreach (var name in PetNames)
                                    {
                                        <button type="button"
                                                class="@(petName == name ? "gd-choice active" : "gd-choice")"
                                                @onclick="() => SelectName(name)">
                                            @name
                                        </button>
                                    }
                                </div>

                                <div class="gd-step">
                                    <span>2</span>
                                    <div>
                                        <strong>Choose the species</strong>
                                        <small>Breed choices update automatically.</small>
                                    </div>
                                </div>

                                <div class="gd-species-grid">
                                    @foreach (var option in SpeciesOptions)
                                    {
                                        <button type="button"
                                                class="@(species == option.Name ? "gd-species active" : "gd-species")"
                                                @onclick="() => SelectSpecies(option.Name)">
                                            <i class="bi @option.Icon"></i>
                                            <span>@option.Name</span>
                                        </button>
                                    }
                                </div>

                                <div class="gd-step">
                                    <span>3</span>
                                    <div>
                                        <strong>Choose a breed</strong>
                                        <small>Only guided choices are used in Guest Mode.</small>
                                    </div>
                                </div>

                                <div class="gd-breed-grid">
                                    @foreach (var option in CurrentBreeds)
                                    {
                                        <button type="button"
                                                class="@(breed == option ? "gd-choice active" : "gd-choice")"
                                                @onclick="() => SelectBreed(option)">
                                            @option
                                        </button>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(message))
                                {
                                    <div class="gd-message">@message</div>
                                }

                                <div class="gd-form-actions">
                                    <button class="gd-primary" @onclick="SavePetAsync">
                                        <i class="bi bi-check-lg"></i> Save Guest Pet
                                    </button>
                                    <button class="gd-secondary" @onclick="CancelForm">Cancel</button>
                                </div>
                            </section>
                        </div>
                    }
                    else
                    {
                        <div class="gd-pet-card">
                            <div class="gd-pet-photo">
                                <img @ref="savedPhotoElement"
                                     class="@(!hasPhoto ? "gd-browser-photo hidden" : "gd-browser-photo")"
                                     alt="@petName" />

                                @if (!hasPhoto)
                                {
                                    <span>@PetInitial</span>
                                }
                            </div>

                            <div class="gd-pet-copy">
                                <span>GUEST PET PROFILE</span>
                                <h3>@petName</h3>
                                <p>@species · @breed</p>
                                <small><i class="bi bi-clock"></i> Temporary · browser session only</small>
                            </div>

                            <button class="gd-secondary" @onclick="OpenForm">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                        </div>

                        <div class="gd-preview-lock">
                            <div class="gd-lock-icon"><i class="bi bi-lock-fill"></i></div>
                            <div>
                                <strong>Digital Pet ID is intentionally locked</strong>
                                <span>Register to create a permanent pet, receive a ShoppetCare Pet ID and open its QR card.</span>
                            </div>
                            <a href="/register">Unlock with Account</a>
                        </div>
                    }
                </article>

                <aside class="gd-panel gd-access-panel">
                    <span class="gd-eyebrow">ACCESS MAP</span>
                    <h2>Know exactly what Guest Mode can do</h2>
                    <p class="gd-access-intro">Available features are clickable. Locked features are muted and never pretend to be active.</p>

                    <div class="gd-section-label available-label">AVAILABLE AS GUEST</div>

                    <a class="gd-access-row available" href="/clinics">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Clinic Directory</strong><span>Browse, search and view clinic information.</span></div>
                        <span class="gd-open">Open <i class="bi bi-arrow-right"></i></span>
                    </a>

                    <a class="gd-access-row available" href="/marketplace">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Marketplace Browsing</strong><span>Browse pre-loved items and keep a session cart.</span></div>
                        <span class="gd-open">Open <i class="bi bi-arrow-right"></i></span>
                    </a>

                    <a class="gd-access-row available" href="/community">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Community</strong><span>Read posts and comment only as <b>Guest</b>.</span></div>
                        <span class="gd-open">Open <i class="bi bi-arrow-right"></i></span>
                    </a>

                    <div class="gd-section-label locked-label">ACCOUNT REQUIRED</div>

                    <div class="gd-access-row locked">
                        <i class="bi bi-lock-fill"></i>
                        <div><strong>Permanent Pet Profile</strong><span>Save pet information to your ShoppetCare account.</span></div>
                        <span class="gd-locked-text">Locked</span>
                    </div>

                    <div class="gd-access-row locked">
                        <i class="bi bi-lock-fill"></i>
                        <div><strong>Digital Pet ID + QR</strong><span>Issue a persistent pet identity and QR card.</span></div>
                        <span class="gd-locked-text">Locked</span>
                    </div>

                    <div class="gd-access-row locked">
                        <i class="bi bi-lock-fill"></i>
                        <div><strong>Marketplace Checkout</strong><span>Submit demo purchase requests and use rewards.</span></div>
                        <span class="gd-locked-text">Locked</span>
                    </div>

                    <div class="gd-access-row locked">
                        <i class="bi bi-lock-fill"></i>
                        <div><strong>Community Posting & Likes</strong><span>Create posts, edit your content and like stories.</span></div>
                        <span class="gd-locked-text">Locked</span>
                    </div>

                    <div class="gd-access-row locked">
                        <i class="bi bi-lock-fill"></i>
                        <div><strong>Clinic Listing & Claims</strong><span>Requests must be attached to an authenticated representative.</span></div>
                        <span class="gd-locked-text">Locked</span>
                    </div>

                    <div class="gd-access-row locked">
                        <i class="bi bi-lock-fill"></i>
                        <div><strong>Notifications & Mobile Sync</strong><span>Keep account activity and pet-care data connected.</span></div>
                        <span class="gd-locked-text">Locked</span>
                    </div>

                    <a class="gd-create" href="/register"><i class="bi bi-person-plus-fill"></i> Create Free Account</a>
                    <a class="gd-signin" href="/login">Already registered? Sign In</a>
                </aside>
            </section>

            <section class="gd-journey">
                <div>
                    <span class="gd-eyebrow">WHAT HAPPENS NEXT?</span>
                    <h2>Guest first. Account when you want to keep it.</h2>
                </div>
                <div class="gd-journey-steps">
                    <article class="current"><span>1</span><div><strong>Guest Preview</strong><small>Try one pet + public features</small></div></article>
                    <i class="bi bi-arrow-right"></i>
                    <article><span>2</span><div><strong>Create Account</strong><small>Unlock permanent identity</small></div></article>
                    <i class="bi bi-arrow-right"></i>
                    <article><span>3</span><div><strong>My ShoppetCare</strong><small>Pets, Pet ID, orders & account</small></div></article>
                </div>
            </section>
        }
    </main>
</div>

