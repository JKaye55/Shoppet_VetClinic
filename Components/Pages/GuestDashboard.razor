    .gd-subnav{border-bottom:1px solid #DDE7E4;background:#FFF}.gd-tabs{min-height:62px;display:flex;align-items:center;gap:7px;overflow:auto}.gd-tabs a{display:inline-flex;align-items:center;gap:7px;padding:9px 12px;border-radius:9px;color:#5F706A;text-decoration:none;font-size:.72rem;font-weight:850;white-space:nowrap}.gd-tabs a.active{background:#E8F4F2;color:#267C83}
    .gd-content{padding:28px 0 65px}.gd-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(310px,.65fr);gap:18px}.gd-panel{padding:26px;border:1px solid #DDE7E4;border-radius:19px;background:#FFF;box-shadow:0 10px 30px rgba(30,45,39,.045)}.gd-panel h2{margin:6px 0 8px;letter-spacing:-.035em}.gd-panel p{margin:0;color:#6E7C76;line-height:1.55}.gd-panel-head{display:flex;justify-content:space-between;gap:18px}.gd-limit{height:max-content;padding:6px 8px;border-radius:999px;background:#FFF4CF;color:#705B15;font-size:.58rem;font-weight:900}.gd-empty{margin-top:22px;padding:38px;text-align:center;border:1px dashed #CAD9D5;border-radius:15px;background:#FAFCFB}.gd-pet-icon{width:54px;height:54px;margin:auto;display:grid;place-items:center;border-radius:15px;background:#EAF5F5;color:#2F9098;font-size:1.35rem}.gd-empty strong,.gd-empty span{display:block}.gd-empty strong{margin-top:11px}.gd-empty span{margin:5px auto 15px;max-width:430px;color:#7B8984;font-size:.73rem}
    .gd-primary,.gd-secondary{min-height:42px;padding:0 14px;border-radius:9px;font-weight:850;cursor:pointer}.gd-primary{border:1px solid #2F9098;background:#2F9098;color:#FFF}.gd-secondary{border:1px solid #CBD9D5;background:#FFF;color:#173D3D}.gd-form{margin-top:22px}.gd-form label{display:block;margin:11px 0 5px;color:#53635E;font-size:.68rem;font-weight:850}.gd-form input,.gd-form select{width:100%;min-height:43px;padding:0 11px;border:1px solid #CBD9D5;border-radius:9px;background:#FFF;color:#173D3D}.gd-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gd-form-actions{display:flex;gap:7px;margin-top:16px}.gd-message{margin-top:10px;padding:10px;border-radius:9px;background:#FFF4E8;color:#8B5B21;font-size:.7rem}
