@page "/guest-dashboard"
@rendermode InteractiveServer

@inject AuthService Auth
@inject IJSRuntime JSRuntime

<PageTitle>Guest Dashboard | ShoppetCare</PageTitle>

<div id="guestDashboardRoot" class="gd-page">
    <section class="gd-hero">
        <div class="gd-shell gd-hero-inner">
            <div>
                <span class="gd-eyebrow light">GUEST EXPERIENCE</span>
                <h1>Meet your temporary pet.</h1>
                <p>
                    Name your pet, choose guided pet details, add a photo, and explore the
                    parts of ShoppetCare that are intentionally available before registration.
                </p>
            </div>

            <div class="gd-status">
                <span>GUEST ACCESS</span>
                <strong>1 temporary pet</strong>
                <small>Browser session only · not saved to an account</small>
            </div>
        </div>
    </section>

    <section class="gd-subnav">
        <div class="gd-shell gd-tabs" aria-label="Guest dashboard">
            <a href="/guest-dashboard" class="active" title="Guest dashboard overview">
                <i class="bi bi-grid"></i> Overview
            </a>

            <a href="/marketplace" title="Browse pre-loved pet items">
                <i class="bi bi-bag-heart"></i> Marketplace
            </a>
            <a href="/community" title="Read public Community posts">
                <i class="bi bi-people"></i> Community
            </a>

            <span class="gd-tab locked" title="Create an account to unlock Digital Pet ID">
                <i class="bi bi-lock-fill"></i> Pet ID
            </span>
            <span class="gd-tab locked" title="Sign in to access marketplace orders">
                <i class="bi bi-lock-fill"></i> Orders
            </span>
            <span class="gd-tab locked" title="Sign in to access notifications">
                <i class="bi bi-lock-fill"></i> Notifications
            </span>
        </div>
    </section>

    <main class="gd-shell gd-content">
        @if (!ready)
        {
            <div class="gd-panel gd-loading">Loading Guest Mode...</div>
        }
        else if (!Auth.IsGuest)
        {
            <section class="gd-panel gd-centered">
                <div class="gd-large-icon"><i class="bi bi-person-heart"></i></div>
                <span class="gd-eyebrow">GUEST DASHBOARD</span>
                <h2>Guest Mode is not active.</h2>
                <p>Enter Guest Mode to try the temporary pet experience.</p>
                <a class="gd-primary gd-link" href="/home?guest=true" title="Enter Guest Mode">
                    Enter Guest Mode
                </a>
            </section>
        }
        else
        {
            <div class="gd-mode-note">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>This is a preview, not an account.</strong>
                    <span>Your guest pet and photo are temporary. Nothing here creates a permanent Pet Profile.</span>
                </div>
                <a href="/register" title="Create a free ShoppetCare account">Keep my pet permanently</a>
            </div>

            <section class="gd-grid">
                <article class="gd-panel gd-pet-panel">
                    <div class="gd-panel-head">
                        <div>
                            <span class="gd-eyebrow">TEMPORARY PET</span>
                            <h2>Build your guest pet</h2>
                            <p>Type the pet name you actually use, then choose species and breed from guided options.</p>
                        </div>
                        <span class="gd-limit"><i class="bi bi-clock"></i> SESSION ONLY</span>
                    </div>

                    <div id="gdEmpty" class="gd-empty">
                        <div class="gd-empty-visual">
                            <div class="gd-empty-photo"><i class="bi bi-camera-fill"></i></div>
                            <div class="gd-empty-copy">
                                <strong>No guest pet yet.</strong>
                                <span>Try the pet-profile experience without creating an account.</span>
                                <button type="button"
                                        class="gd-primary"
                                        onclick="window.shoppetGuestDashboard.openEditor()"
                                        title="Create one temporary Guest pet">
                                    <i class="bi bi-plus-lg"></i> Create Guest Pet
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="gdEditor" class="gd-editor" style="display:none">
                        <section class="gd-photo-column">
                            <div class="gd-photo-preview">
                                <img id="gdEditorPhoto"
                                     class="gd-browser-photo"
                                     style="display:none"
                                     alt="Guest pet preview" />

                                <div id="gdPhotoPlaceholder" class="gd-photo-placeholder">
                                    <i class="bi bi-camera-fill"></i>
                                    <strong>Add a pet photo</strong>
                                    <span>JPG, PNG or WEBP · maximum 5 MB</span>
                                </div>
                            </div>

                            <label class="gd-photo-button" for="gdPhotoInput" title="Choose a temporary pet photo">
                                <i class="bi bi-upload"></i>
                                Choose or Change Photo
                            </label>

                            <input id="gdPhotoInput"
                                   class="gd-native-file"
                                   type="file"
                                   accept="image/jpeg,image/png,image/webp"
                                   onchange="window.shoppetGuestDashboard.previewPhoto(this)" />

                            <button id="gdRemovePhoto"
                                    type="button"
                                    class="gd-remove-photo"
                                    style="display:none"
                                    onclick="window.shoppetGuestDashboard.removePhoto()">
                                Remove photo
                            </button>

                            <small class="gd-photo-note">
                                The photo stays in this browser session. It is not uploaded to your ShoppetCare account.
                            </small>
                        </section>

                        <section class="gd-guided-form">
                            <div class="gd-step">
                                <span>1</span>
                                <div>
                                    <strong>Name your pet</strong>
                                    <small>This is your choice. Enter the name you really use.</small>
                                </div>
                            </div>

                            <div class="gd-field">
                                <label for="gdPetName">Pet name</label>
                                <input id="gdPetName"
                                       type="text"
                                       maxlength="50"
                                       autocomplete="off"
                                       placeholder="e.g., Mochi" />
                                <small>Maximum 50 characters · Guest Mode only</small>
                            </div>

                            <div class="gd-step">
                                <span>2</span>
                                <div>
                                    <strong>Choose the species</strong>
                                    <small>Breed choices update automatically.</small>
                                </div>
                            </div>

                            <input id="gdSpeciesValue" type="hidden" />

                            <div class="gd-species-grid">
                                <button type="button" class="gd-species" data-species="Dog"
                                        onclick="window.shoppetGuestDashboard.selectSpecies('Dog')">
                                    <i class="bi bi-heart-fill"></i><span>Dog</span>
                                </button>
                                <button type="button" class="gd-species" data-species="Cat"
                                        onclick="window.shoppetGuestDashboard.selectSpecies('Cat')">
                                    <i class="bi bi-heart-fill"></i><span>Cat</span>
                                </button>
                                <button type="button" class="gd-species" data-species="Rabbit"
                                        onclick="window.shoppetGuestDashboard.selectSpecies('Rabbit')">
                                    <i class="bi bi-heart"></i><span>Rabbit</span>
                                </button>
                                <button type="button" class="gd-species" data-species="Bird"
                                        onclick="window.shoppetGuestDashboard.selectSpecies('Bird')">
                                    <i class="bi bi-feather"></i><span>Bird</span>
                                </button>
                            </div>

                            <div class="gd-step">
                                <span>3</span>
                                <div>
                                    <strong>Choose a breed</strong>
                                    <small>Guided choices keep the preview simple and consistent.</small>
                                </div>
                            </div>

                            <input id="gdBreedValue" type="hidden" />
                            <div id="gdBreeds" class="gd-breed-grid"></div>

                            <div id="gdMessage" class="gd-message" style="display:none"></div>

                            <div class="gd-form-actions">
                                <button type="button"
                                        class="gd-primary"
                                        onclick="window.shoppetGuestDashboard.save()"
                                        title="Save this temporary Guest pet">
                                    <i class="bi bi-check-lg"></i> Save Guest Pet
                                </button>
                                <button type="button"
                                        class="gd-secondary"
                                        onclick="window.shoppetGuestDashboard.cancelEditor()">
                                    Cancel
                                </button>
                            </div>
                        </section>
                    </div>

                    <div id="gdSaved" style="display:none">
                        <div class="gd-pet-card">
                            <div class="gd-pet-photo">
                                <img id="gdSavedPhoto"
                                     class="gd-browser-photo"
                                     style="display:none"
                                     alt="Guest pet" />
                                <span id="gdSavedFallback">P</span>
                            </div>

                            <div class="gd-pet-copy">
                                <span>GUEST PET PROFILE</span>
                                <h3 id="gdSavedName">Pet</h3>
                                <p id="gdSavedDetails"></p>
                                <small><i class="bi bi-clock"></i> Temporary · browser session only</small>
                            </div>

                            <div class="gd-card-actions">
                                <button type="button"
                                        class="gd-secondary"
                                        onclick="window.shoppetGuestDashboard.openEditor()"
                                        title="Edit the temporary Guest pet">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button type="button"
                                        class="gd-secondary gd-delete-btn"
                                        onclick="window.shoppetGuestDashboard.deletePet()"
                                        title="Delete this temporary Guest pet">
                                    <i class="bi bi-trash3"></i> Delete
                                </button>
                            </div>
                        </div>

                        <div class="gd-preview-lock">
                            <div class="gd-lock-icon"><i class="bi bi-lock-fill"></i></div>
                            <div>
                                <strong>Digital Pet ID is intentionally locked</strong>
                                <span>Register to create a permanent pet, receive a ShoppetCare Pet ID and open its QR card.</span>
                            </div>
                            <a href="/register">Unlock with Account</a>
                        </div>
                    </div>
                </article>

                <aside class="gd-panel gd-access-panel">
                    <span class="gd-eyebrow">ACCESS MAP</span>
                    <h2>Know exactly what Guest Mode can do</h2>
                    <p class="gd-access-intro">Available features are clickable. Locked features stay visibly muted.</p>

                    <div class="gd-section-label available-label">AVAILABLE AS GUEST</div>



                    <a class="gd-access-row available" href="/marketplace">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Marketplace Browsing</strong><span>Browse pre-loved items. Sign in to use your cart.</span></div>
                        <span class="gd-open">Open <i class="bi bi-arrow-right"></i></span>
                    </a>

                    <a class="gd-access-row available" href="/community">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Community</strong><span>Read public posts. Sign in to comment and like.</span></div>
                        <span class="gd-open">Open <i class="bi bi-arrow-right"></i></span>
                    </a>

                    <div class="gd-section-label locked-label">ACCOUNT REQUIRED</div>

                    @foreach (var item in LockedFeatures)
                    {
                        <div class="gd-access-row locked">
                            <i class="bi bi-lock-fill"></i>
                            <div><strong>@item.Title</strong><span>@item.Copy</span></div>
                            <span class="gd-locked-text">Locked</span>
                        </div>
                    }

                    <a class="gd-create" href="/register" title="Create a free account">
                        <i class="bi bi-person-plus-fill"></i> Create Free Account
                    </a>
                    <a class="gd-signin" href="/login" title="Sign in to an existing account">
                        Already registered? Sign In
                    </a>
                </aside>
            </section>
        }
    </main>
</div>

<style>
