    .gd-access-intro{font-size:.7rem}.gd-section-label{margin-top:18px;padding-bottom:7px;border-bottom:1px solid #E7ECEA;font-size:.57rem;font-weight:900;letter-spacing:.1em}.available-label{color:#2F9098}.locked-label{color:#8E9995}.gd-access-row{display:grid;grid-template-columns:24px 1fr auto;gap:8px;align-items:start;padding:11px 4px;border-bottom:1px solid #EDF1EF}.gd-access-row.available{text-decoration:none;color:#1E2D27}.gd-access-row.available:hover{padding-left:8px;background:#FAFCFB}.gd-access-row.available>i{color:#2F9098}.gd-access-row.locked{color:#89948F;background:linear-gradient(90deg,rgba(245,247,246,.8),transparent)}.gd-access-row.locked>i{color:#A5AEAA}.gd-access-row strong,.gd-access-row span{display:block}.gd-access-row strong{font-size:.7rem}.gd-access-row span{margin-top:2px;color:#83908B;font-size:.61rem;line-height:1.4}.gd-open{align-self:center!important;color:#267C83!important;font-weight:900}.gd-locked-text{align-self:center!important;padding:4px 6px;border-radius:999px;background:#ECEFEE;color:#8A9591!important;font-size:.55rem!important;font-weight:900}.gd-create,.gd-signin{display:flex;align-items:center;justify-content:center;gap:7px;min-height:43px;margin-top:14px;border-radius:9px;text-decoration:none;font-size:.7rem;font-weight:900}.gd-create{background:#2F9098;color:#fff}.gd-signin{margin-top:7px;border:1px solid #CBD9D5;color:#173D3D}.gd-centered{max-width:650px;margin:auto;text-align:center}.gd-centered p{margin:auto}.gd-large-icon{width:54px;height:54px;margin:0 auto 12px;display:grid;place-items:center;border-radius:15px;background:#EAF6F4;color:#2F9098;font-size:1.25rem}.gd-loading{text-align:center}
    @@media(max-width:950px){.gd-grid{grid-template-columns:1fr}.gd-hero-inner{align-items:start;flex-direction:column}.gd-status{width:100%}}@@media(max-width:650px){.gd-editor{grid-template-columns:1fr}.gd-photo-column{max-width:260px}.gd-breed-grid{grid-template-columns:repeat(2,1fr)}.gd-species-grid{grid-template-columns:repeat(2,1fr)}.gd-pet-card{grid-template-columns:70px 1fr}.gd-pet-photo{width:70px;height:70px}.gd-card-actions{grid-column:2;flex-wrap:wrap}.gd-preview-lock{grid-template-columns:38px 1fr}.gd-preview-lock>a{grid-column:2}.gd-mode-note{grid-template-columns:auto 1fr}.gd-mode-note>a{grid-column:2}.gd-empty-visual{align-items:flex-start;flex-direction:column}}
</style>

@code {
    private bool ready;

    private readonly (string Title, string Copy)[] LockedFeatures =
    {
        ("Permanent Pet Profile", "Save pet information to your ShoppetCare account."),
        ("Digital Pet ID + QR", "Issue a persistent pet identity and QR card."),
        ("Marketplace Checkout", "Submit demo purchase requests and use rewards."),
        ("Community Posting & Likes", "Create posts, edit your content and like stories."),
        ("Notifications & Mobile Sync", "Keep account activity and pet-care data connected.")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
        ready = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await JSRuntime.InvokeVoidAsync("window.shoppetGuestDashboard.init");
        }
        catch { }
    }
}
