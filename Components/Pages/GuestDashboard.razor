@page "/guest-dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AuthService Auth
@inject ProtectedSessionStorage Session
@inject NavigationManager Nav

<PageTitle>Guest Dashboard | ShoppetCare</PageTitle>

<div class="gd-page">
    <section class="gd-hero">
        <div class="gd-shell gd-hero-inner">
            <div>
                <span class="gd-eyebrow light">GUEST MODE</span>
                <h1>Try My ShoppetCare.</h1>
                <p>
                    Add one temporary pet and explore the public ShoppetCare experience.
                    Create a free account when you want permanent pet data, Digital Pet ID,
                    Marketplace checkout, notifications, and full Community participation.
                </p>
            </div>
            <div class="gd-status">
                <span>GUEST ACCESS</span>
                <strong>1 temporary pet</strong>
                <small>Saved only for this browser session</small>
            </div>
        </div>
    </section>

    <section class="gd-subnav">
        <div class="gd-shell gd-tabs">
            <a href="/guest-dashboard" class="active"><i class="bi bi-grid"></i> Overview</a>
            <a href="/marketplace"><i class="bi bi-bag-heart"></i> Marketplace</a>
            <a href="/community"><i class="bi bi-people"></i> Community</a>
            <a href="/clinics"><i class="bi bi-hospital"></i> Clinics</a>
        </div>
    </section>

    <main class="gd-shell gd-content">
        @if (!ready)
        {
            <div class="gd-panel">Loading Guest Mode...</div>
        }
        else if (!Auth.IsGuest)
        {
            <section class="gd-panel gd-centered">
                <span class="gd-eyebrow">GUEST DASHBOARD</span>
                <h2>Enter Guest Mode to use this preview.</h2>
                <a class="gd-primary" href="/home?guest=true">Enter Guest Mode</a>
            </section>
        }
        else
        {
            <section class="gd-grid">
                <article class="gd-panel gd-pet-panel">
                    <div class="gd-panel-head">
                        <div>
                            <span class="gd-eyebrow">TEMPORARY PET</span>
                            <h2>Your one-pet preview</h2>
                            <p>This pet is not written to the ShoppetCare database and does not receive a permanent Pet ID.</p>
                        </div>
                        <span class="gd-limit">1 PET MAX</span>
                    </div>

                    @if (!hasPet && !showForm)
                    {
                        <div class="gd-empty">
                            <div class="gd-pet-icon"><i class="bi bi-heart"></i></div>
                            <strong>No guest pet yet.</strong>
                            <span>Add one pet to preview how a ShoppetCare pet profile is organized.</span>
                            <button class="gd-primary" @onclick="OpenForm">Add My Guest Pet</button>
                        </div>
                    }
                    else if (showForm)
                    {
                        <div class="gd-form">
                            <label>Pet name</label>
                            <input maxlength="60" @bind="petName" placeholder="e.g. Mochi" />

                            <div class="gd-form-grid">
                                <div>
                                    <label>Species</label>
                                    <select @bind="species">
                                        <option value="">Select species</option>
                                        <option>Dog</option>
                                        <option>Cat</option>
                                        <option>Bird</option>
                                        <option>Rabbit</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                                <div>
                                    <label>Breed</label>
                                    <input maxlength="80" @bind="breed" placeholder="e.g. Shih Tzu" />
                                </div>
                            </div>

                            <div class="gd-form-actions">
                                <button class="gd-primary" @onclick="SavePetAsync">Save Guest Pet</button>
                                <button class="gd-secondary" @onclick="CancelForm">Cancel</button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(message))
                            {
                                <div class="gd-message">@message</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="gd-pet-card">
                            <div class="gd-avatar">@PetInitial</div>
                            <div>
                                <span>GUEST PET PROFILE</span>
                                <h3>@petName</h3>
                                <p>@species@(string.IsNullOrWhiteSpace(breed) ? "" : $" · {breed}")</p>
                            </div>
                            <button class="gd-secondary" @onclick="OpenForm">Edit</button>
                        </div>

                        <div class="gd-preview-lock">
                            <i class="bi bi-qr-code"></i>
                            <div>
                                <strong>Digital Pet ID unlocks after registration</strong>
                                <span>Your registered pet can receive a persistent ShoppetCare identity and QR card.</span>
                            </div>
                            <a href="/register">Create Account</a>
                        </div>
                    }
                </article>

                <aside class="gd-panel">
                    <span class="gd-eyebrow">GUEST ACCESS</span>
                    <h2>What you can use now</h2>

                    <div class="gd-access-row available">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Clinic Directory</strong><span>Browse and search local clinics.</span></div>
                        <a href="/clinics">Open</a>
                    </div>
                    <div class="gd-access-row available">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Marketplace</strong><span>Browse and add items to a session cart.</span></div>
                        <a href="/marketplace">Open</a>
                    </div>
                    <div class="gd-access-row available">
                        <i class="bi bi-check-circle-fill"></i>
                        <div><strong>Community</strong><span>Read posts and leave Guest comments.</span></div>
                        <a href="/community">Open</a>
                    </div>

                    <div class="gd-divider"></div>
                    <span class="gd-eyebrow">UNLOCK WITH FREE ACCOUNT</span>

                    <div class="gd-access-row locked"><i class="bi bi-lock-fill"></i><div><strong>Permanent Pet Profile</strong><span>Keep your pet connected to your account.</span></div></div>
                    <div class="gd-access-row locked"><i class="bi bi-lock-fill"></i><div><strong>Digital Pet ID + QR</strong><span>Issue a persistent pet identity.</span></div></div>
                    <div class="gd-access-row locked"><i class="bi bi-lock-fill"></i><div><strong>Marketplace Checkout</strong><span>Submit demo purchase requests and earn review vouchers.</span></div></div>
                    <div class="gd-access-row locked"><i class="bi bi-lock-fill"></i><div><strong>Community Posting</strong><span>Create, edit and delete your own posts.</span></div></div>
                    <div class="gd-access-row locked"><i class="bi bi-lock-fill"></i><div><strong>Notifications &amp; Mobile Sync</strong><span>Keep account activity and pet-care data connected.</span></div></div>

                    <a class="gd-create" href="/register">Create Free Account</a>
                    <a class="gd-signin" href="/login">Already registered? Sign In</a>
                </aside>
            </section>
        }
    </main>
</div>

