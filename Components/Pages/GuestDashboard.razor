@code {
    private const string GuestPetNameKey = "guestPetName";
    private const string GuestPetSpeciesKey = "guestPetSpecies";
    private const string GuestPetBreedKey = "guestPetBreed";

    private readonly string[] PetNames = { "Mochi", "Buddy", "Luna", "Milo", "Coco", "Max", "Bella", "Oreo", "Ming", "Bantay" };

    private readonly (string Name, string Icon)[] SpeciesOptions =
    {
        ("Dog", "bi-heart-fill"),
        ("Cat", "bi-heart-fill"),
        ("Rabbit", "bi-heart"),
        ("Bird", "bi-feather")
    };

    private readonly Dictionary<string, string[]> BreedOptions = new()
    {
        ["Dog"] = new[] { "Shih Tzu", "Golden Retriever", "Beagle", "Poodle", "Aspin / Mixed Breed", "Other Dog Breed" },
        ["Cat"] = new[] { "Persian", "Siamese", "Domestic Shorthair", "Puspin / Mixed Breed", "British Shorthair", "Other Cat Breed" },
        ["Rabbit"] = new[] { "Holland Lop", "Lionhead", "Mini Rex", "Mixed Breed Rabbit", "Netherland Dwarf", "Other Rabbit Breed" },
        ["Bird"] = new[] { "Lovebird", "Parakeet", "Cockatiel", "Canary", "African Grey", "Other Bird" }
    };

    private bool ready;
    private bool hasPet;
    private bool showForm;
    private string petName = string.Empty;
    private string species = string.Empty;
    private string breed = string.Empty;
    private bool hasPhoto;
    private bool restoreEditorPhoto;
    private bool restoreSavedPhoto;
    private string message = string.Empty;

    private InputFile? photoInput;
    private ElementReference editorPhotoElement;
    private ElementReference savedPhotoElement;

    private string PetInitial =>
        string.IsNullOrWhiteSpace(petName) ? "P" : petName.Trim()[0].ToString().ToUpperInvariant();

    private IEnumerable<string> CurrentBreeds =>
        BreedOptions.TryGetValue(species, out var values) ? values : Array.Empty<string>();

    private void OpenForm()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(petName))
            petName = PetNames[0];

        if (string.IsNullOrWhiteSpace(species))
            species = SpeciesOptions[0].Name;

        if (string.IsNullOrWhiteSpace(breed))
            breed = BreedOptions[species][0];

        showForm = true;
        restoreEditorPhoto = hasPhoto;
    }

    private void CancelForm()
    {
        message = string.Empty;
        showForm = false;
    }

    private void SelectName(string value) => petName = value;

    private void SelectSpecies(string value)
    {
        species = value;
        breed = BreedOptions.TryGetValue(value, out var values) && values.Length > 0
            ? values[0]
            : string.Empty;
    }

    private void SelectBreed(string value) => breed = value;

    private async Task HandlePhotoSelected(InputFileChangeEventArgs args)
    {
        message = string.Empty;
        var file = args.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            message = "Choose a photo smaller than 5 MB.";
            hasPhoto = false;
            return;
        }

        var allowed = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowed.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            message = "Use a JPG, PNG or WEBP pet photo.";
            hasPhoto = false;
            return;
        }

        // Do not read the image into .NET memory. In Interactive Server,
        // turning a multi-megabyte image into a base64 component string can
        // overload the circuit. The browser creates a temporary object URL
        // instead, so the preview stays local to this tab.
        hasPhoto = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (photoInput is not null)
            {
                await JS.InvokeVoidAsync(
                    "shoppetGuestPetPhoto.preview",
                    photoInput.Element,
                    editorPhotoElement);
            }
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[Guest Photo Preview] {ex.Message}");
            hasPhoto = false;
            message = "The photo could not be previewed. Please choose another image.";
        }
    }

    private async Task RemovePhoto()
    {
        hasPhoto = false;
        restoreEditorPhoto = false;
        restoreSavedPhoto = false;

        try
        {
            if (photoInput is not null)
                await JS.InvokeVoidAsync("shoppetGuestPetPhoto.clear", photoInput.Element);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[Guest Photo Clear] {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();

            if (Auth.IsGuest)
            {
                try
                {
                    var name = await Session.GetAsync<string>(GuestPetNameKey);
                    var sp = await Session.GetAsync<string>(GuestPetSpeciesKey);
                    var br = await Session.GetAsync<string>(GuestPetBreedKey);

                    petName = name.Success ? name.Value ?? string.Empty : string.Empty;
                    species = sp.Success ? sp.Value ?? string.Empty : string.Empty;
                    breed = br.Success ? br.Value ?? string.Empty : string.Empty;
                    hasPet = !string.IsNullOrWhiteSpace(petName);
                }
                catch { }
            }

            ready = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            if (restoreEditorPhoto && hasPhoto)
            {
                restoreEditorPhoto = false;
                await JS.InvokeVoidAsync("shoppetGuestPetPhoto.apply", editorPhotoElement);
            }

            if (restoreSavedPhoto && hasPhoto)
            {
                restoreSavedPhoto = false;
                await JS.InvokeVoidAsync("shoppetGuestPetPhoto.apply", savedPhotoElement);
            }
        }
        catch (JSException ex)
        {
            Console.WriteLine($"[Guest Photo Restore] {ex.Message}");
        }
    }

    private async Task SavePetAsync()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(petName) ||
            string.IsNullOrWhiteSpace(species) ||
            string.IsNullOrWhiteSpace(breed))
        {
            message = "Choose a pet name, species and breed before saving.";
            return;
        }

        await Session.SetAsync(GuestPetNameKey, petName);
        await Session.SetAsync(GuestPetSpeciesKey, species);
        await Session.SetAsync(GuestPetBreedKey, breed);

        hasPet = true;
        showForm = false;
        restoreSavedPhoto = hasPhoto;
    }
}
