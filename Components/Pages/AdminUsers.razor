@page "/admin/users"
@page "/admin"
@rendermode InteractiveServer
@inject AuthService Auth
@inject AdminAccountService Accounts

<PageTitle>Admin users | ShoppetCare</PageTitle>

<main class="owner-shell">
    <header class="owner-header">
        <span class="owner-eyebrow">ADMINISTRATION</span>
        <h1>Accounts that connect the community.</h1>
        <p>Create Pet Owner or Admin accounts, update profiles, set active roles, or deactivate an account while preserving its order history. Admin creation is available only to an existing administrator.</p>
    </header>

    @if (!ready)
    {
        <p>Loading users…</p>
    }
    else if (!Auth.IsAdmin)
    {
        <p>Administrator access required.</p>
    }
    else
    {
        <AdminNav />

        @if (message.Length > 0)
        {
            <p class="owner-notice" role="status">@message</p>
        }

        <div class="owner-grid">
            <section class="owner-card">
                <h2>Create account</h2>
                <label>Full name<input @bind="name" maxlength="150" placeholder="Juan Dela Cruz" /></label>
                <small>Max 150 characters</small>
                <label>Email<input type="email" @bind="email" maxlength="254" placeholder="you@example.com" /></label>
                <small>Max 254 characters</small>
                <label>Mobile<input type="tel" @bind="phone" maxlength="30" placeholder="09171234567" /></label>
                <small>Valid 11-digit mobile number</small>
                <label>Role<select @bind="role"><option>Pet Owner</option><option>Admin</option></select></label>
                <label>Initial passphrase<input type="password" @bind="password" maxlength="64" autocomplete="new-password" placeholder="At least 8 chars with letter, number & special char" /></label>
                <small>Must be at least 8 characters and include at least one letter, one number, and one special character. Stored securely with BCrypt.</small>
                <button @onclick="Create">Create account</button>
            </section>

            <section class="owner-card">
                <h2>Account directory</h2>
                <label>Search<input type="search" @bind="search" @bind:event="oninput" placeholder="Name, email, or role" /></label>
                <p>@users.Count accounts · @users.Count(x => x.Disabled) inactive</p>
                <p>Deactivation revokes the Mobile session and blocks future sign-ins. Existing web sessions are checked on reload.</p>
            </section>
        </div>

        @foreach (var x in users.Where(x => string.IsNullOrWhiteSpace(search) || $"{x.Name} {x.Email} {x.Role}".Contains(search, StringComparison.OrdinalIgnoreCase)))
        {
            <section class="owner-card">
                <h2>@x.Name <small>· @(x.Premium ? "Lifetime Premium" : "Free")</small></h2>
                <p>@x.Email · #@x.Id</p>
                @if (x.Id == Auth.CurrentUser?.Id)
                {
                    <p>Your administrator account is protected from role and status changes here.</p>
                }
                else
                {
                    <div class="owner-grid">
                        <label>Name<input @bind="x.Name" maxlength="150" /></label>
                        <label>Mobile<input @bind="x.Phone" maxlength="30" /></label>
                        <label>Role<select @bind="x.Role"><option>Pet Owner</option><option>Admin</option>@if (x.Role is not ("Pet Owner" or "Admin")) { <option value="@x.Role">@x.Role (retired)</option> }</select></label>
                        <label class="owner-check"><input type="checkbox" @bind="x.Disabled" /> Account inactive</label>
                    </div>
                    <button @onclick="() => Save(x)">Save account</button>
                }
            </section>
        }
    }
</main>

@code {
    bool ready;
    string message = "";
    string name = "";
    string email = "";
    string phone = "";
    string password = "";
    string role = "Pet Owner";
    string search = "";
    List<AdminAccount> users = new();

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first)
            return;

        await Auth.InitializeAsync();
        if (Auth.IsAdmin)
        {
            try
            {
                users = Accounts.Users();
            }
            catch (Exception)
            {
                message = "Could not load users. Check the shared database connection.";
            }
        }

        ready = true;
        StateHasChanged();
    }

    void Create()
    {
        try
        {
            message = "";
            Accounts.Create(name, email, phone, password, role);
            password = "";
            name = email = phone = "";
            role = "Pet Owner";
            users = Accounts.Users();
            message = "Account created successfully.";
        }
        catch (Exception ex)
        {
            message = string.IsNullOrWhiteSpace(ex.Message) ? "Could not create this account." : ex.Message;
        }
    }

    void Save(AdminAccount x)
    {
        try
        {
            Accounts.Save(x);
            users = Accounts.Users();
            message = "Account updated. The Mobile session has been revoked.";
        }
        catch (Exception ex)
        {
            message = ex is ArgumentException ? ex.Message : "Could not update this account.";
        }
    }
}