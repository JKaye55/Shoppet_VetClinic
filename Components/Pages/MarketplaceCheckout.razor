@page "/marketplace/checkout"
@page "/marketplace/checkout/{SellerUserId:int}"
@rendermode InteractiveServer
@inject MarketplaceCartService Cart
@inject MarketplaceOrderService Orders
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Demo Marketplace Checkout | ShoppetCare</PageTitle>

<div class="checkout-page">
    <section class="checkout-hero">
        <div class="checkout-shell">
            <span>DEMO MARKETPLACE CHECKOUT</span>
            <h1>Review your pre-loved finds.</h1>
            <p>No real funds are transferred. This checkout demonstrates the e-commerce workflow for the ShoppetCare academic project.</p>
        </div>
    </section>

    <main class="checkout-shell checkout-grid">
        <section class="checkout-card">
            <span class="kicker">ORDER SUMMARY</span>
            @if (SellerItems.Count == 0)
            {
                <h2>No available cart items for this seller.</h2>
                <a class="back-link" href="/marketplace/cart">Return to Cart</a>
            }
            else
            {
                @foreach (var item in SellerItems)
                {
                    <div class="order-item">
                        <div>
                            <strong>@item.Title</strong>
                            <div style="display:flex;align-items:center;gap:6px;margin-top:4px;flex-wrap:wrap;">
                                <span style="background:#FAF5FF;color:#7E22CE;padding:1px 6px;border-radius:4px;font-size:.65rem;font-weight:700;border:1px solid #E9D5FF;">
                                    SKU: SHP-MKT-@item.ListingId.ToString("D4")
                                </span>
                                <span style="background:#ECFDF5;color:#047857;padding:1px 6px;border-radius:4px;font-size:.65rem;font-weight:700;">
                                    In Stock (Qty 1)
                                </span>
                                <span style="color:#6A7B76;font-size:.7rem;">· @item.SellerName</span>
                            </div>
                        </div>
                        <strong>₱@item.Price.ToString("N2")</strong>
                    </div>
                }

                <div class="totals"><span>Subtotal</span><strong>₱@Subtotal.ToString("N2")</strong></div>
                @if (SelectedVoucher is not null)
                {
                    <div class="totals discount"><span>Voucher @SelectedVoucher.Code</span><strong>-₱@Discount.ToString("N2")</strong></div>
                }
                <div class="totals grand"><span>Demo total</span><strong>₱@Total.ToString("N2")</strong></div>
            }
        </section>

        @if (SellerItems.Count > 0)
        {
            <section class="checkout-card">
                <span class="kicker">PAYMENT & REWARD</span>
                <h2>Choose a demo payment method</h2>

                <label>Payment method</label>
                <select @bind="paymentMethod">
                    <option value="Credit Card">Credit / Debit Card (Mock Gateway)</option>
                    <option value="GCash - Demo">GCash - Demo</option>
                    <option value="Maya - Demo">Maya - Demo</option>
                    <option value="Cash on Meet-up">Cash on Meet-up</option>
                </select>

                @if (paymentMethod == "Credit Card")
                {
                    <div style="background:#FAF9F6;border:1px solid #DDE7E4;border-radius:14px;padding:14px;margin:12px 0;">
                        <span style="font-size:.7rem;font-weight:800;color:#2F9098;text-transform:uppercase;letter-spacing:.05em;">🔒 PREDEFINED DEMO CARD SANDBOX</span>
                        <label style="display:block;margin-top:8px;font-size:.78rem;font-weight:700;">Select Predefined Demo Card *</label>
                        <select @bind="selectedDemoCard" disabled="@isSubmitting" style="width:100%;min-height:38px;padding:6px 10px;border:1px solid #CBD9D5;border-radius:8px;background:#fff;font-size:.85rem;">
                            <option value="Demo Visa (•••• 4242)">💳 Demo Visa (•••• 4242) — Pre-approved Sandbox</option>
                            <option value="Demo Mastercard (•••• 5555)">💳 Demo Mastercard (•••• 5555) — Pre-approved Sandbox</option>
                        </select>
                        <div style="margin-top:10px;padding:10px;background:#fff;border:1px solid #E2E8F0;border-radius:8px;font-size:.75rem;color:#4A5568;">
                            <div><strong>Cardholder:</strong> ShoppetCare Demo Tester</div>
                            <div><strong>Card Number:</strong> @(selectedDemoCard.Contains("5555") ? "5555 •••• •••• 5555" : "4242 •••• •••• 4242")</div>
                            <div><strong>Expires:</strong> 12/28 | <strong>CVV:</strong> •••</div>
                            <small style="display:block;margin-top:6px;color:#0D9488;">Academic simulation only. Predefined demo choices replace unrestricted card credentials. No real funds or payment data are handled.</small>
                        </div>
                    </div>
                }

                <label>Simulated outcome</label><select @bind="outcome"><option value="success">Success</option><option value="failure">Failure</option></select>
                
                <!-- PROMO CODE INPUT (RUBRIC CRITERIA 9: MARKETING STRATEGIES) -->
                <div style="margin-top:14px;padding:14px;background:#FAF9F6;border:1px dashed #CBD9D5;border-radius:12px;">
                    <label style="margin:0 0 6px;font-size:.72rem;font-weight:850;color:#173D3D;text-transform:uppercase;letter-spacing:.05em;">
                        🎉 Have a Promo / Marketing Coupon Code?
                    </label>
                    <div style="display:flex;gap:8px;">
                        <input type="text" placeholder="e.g. WELCOME50 or PAWESOME" @bind="promoCodeInput" disabled="@isSubmitting" style="flex:1;min-height:38px;padding:0 10px;border:1px solid #CBD9D5;border-radius:8px;font-size:.85rem;text-transform:uppercase;background:#fff;" />
                        <button type="button" @onclick="ApplyPromoCode" disabled="@isSubmitting" style="min-height:38px;padding:0 14px;border:0;border-radius:8px;background:#173D3D;color:#fff;font-weight:800;font-size:.78rem;cursor:pointer;">
                            Apply
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(promoFeedback))
                    {
                        <small style="display:block;margin-top:6px;font-weight:700;color:@(promoSuccess ? "#059669" : "#DC2626");">@promoFeedback</small>
                    }
                    <small style="color:#6A7B76;margin-top:4px;display:block;">Tip: Try code <strong>WELCOME50</strong> for ₱50 discount or <strong>PAWESOME</strong> for 10% discount!</small>
                </div>

                <label>Select Saved Voucher</label>
                <select @bind="selectedVoucherId">
                    <option value="0">No voucher</option>
                    @foreach (var voucher in vouchers)
                    {
                        <option value="@voucher.Id">@voucher.Code — ₱@voucher.Amount.ToString("N0") off</option>
                    }
                </select>
                <small>Review and promo vouchers are one-time use, valid for 14-30 days, and saved in your account.</small>

                <div class="demo-note">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <strong>Project demo only</strong>
                        <span>GCash and Maya selections are simulated. Do not enter real payment credentials.</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="message @(isError ? "error" : "")">@message</div>
                }

                <button class="place-order" disabled="@isSubmitting" @onclick="PlaceOrderAsync">
                    @(isSubmitting ? "Submitting..." : "Place Demo Order")
                </button>
                <a class="back-link" href="/marketplace/cart">Back to Cart</a>
            </section>
        }
    </main>
</div>

<style>
    .checkout-page{min-height:100vh;background:#FAF9F6;color:#173D3D}.checkout-shell{width:min(1050px,calc(100% - 32px));margin:auto}
    .checkout-hero{padding:52px 0;background:#173D3D;color:#fff}.checkout-hero>div>span,.kicker{font-size:.66rem;font-weight:900;letter-spacing:.12em;color:#F3D27A}
    .checkout-hero h1{margin:8px 0 6px;font-size:clamp(2rem,4vw,3.3rem);letter-spacing:-.04em}.checkout-hero p{margin:0;max-width:760px;color:#D6E4E0}
    .checkout-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;padding:32px 0 70px}.checkout-card{padding:22px;border:1px solid #DDE7E4;border-radius:18px;background:#fff;box-shadow:0 10px 28px rgba(23,61,61,.05)}
    .checkout-card .kicker{color:#2F9098}.checkout-card h2{margin:7px 0 18px;font-size:1.15rem}.order-item,.totals{display:flex;justify-content:space-between;gap:14px;padding:13px 0;border-bottom:1px solid #EDF1EF}.order-item span{display:block;margin-top:4px;color:#879691;font-size:.7rem}
    .totals{font-size:.8rem}.totals.discount{color:#267C83}.totals.grand{font-size:1rem;border-bottom:0}.checkout-card label{display:block;margin:14px 0 6px;font-size:.72rem;font-weight:850}.checkout-card select{width:100%;min-height:44px;padding:0 11px;border:1px solid #CBD9D5;border-radius:9px;background:#fff}.checkout-card small{display:block;margin-top:7px;color:#879691}
    .demo-note{display:flex;gap:10px;margin:18px 0;padding:13px;border-radius:11px;background:#F2F8F6}.demo-note i{color:#2F9098}.demo-note strong,.demo-note span{display:block}.demo-note span{margin-top:3px;color:#6F817B;font-size:.7rem}
    .place-order{width:100%;min-height:46px;border:0;border-radius:9px;background:#2F9098;color:#fff;font-weight:900;cursor:pointer}.back-link{display:inline-block;margin-top:13px;color:#267C83;font-weight:800;text-decoration:none;font-size:.75rem}.message{margin:12px 0;padding:10px;border-radius:9px;background:#EAF7F1;color:#286B4E}.message.error{background:#FFF0F0;color:#9B3E3E}
    @@media(max-width:760px){.checkout-grid{grid-template-columns:1fr}}
</style>

@code {
    [Parameter] public int SellerUserId { get; set; }

    private string outcome="success";
    private string paymentMethod = "Credit Card";
    private int selectedVoucherId;
    private List<MarketplaceVoucher> vouchers = new();
    private string message = string.Empty;
    private bool isError;
    private bool isSubmitting;
    private string selectedDemoCard = "Demo Visa (•••• 4242)";
    private string promoCodeInput = string.Empty;
    private string promoFeedback = string.Empty;
    private bool promoSuccess = false;

    private List<MarketplaceCartItem> SellerItems =>
        Cart.Items.Where(x => x.SellerUserId == SellerUserId).ToList();

    private decimal Subtotal => SellerItems.Sum(x => x.Price);

    private MarketplaceVoucher? SelectedVoucher =>
        vouchers.FirstOrDefault(x => x.Id == selectedVoucherId);

    private decimal Discount =>
        SelectedVoucher is null ? 0m : Math.Min(SelectedVoucher.Amount, Subtotal);

    private decimal Total => Math.Max(0m, Subtotal - Discount);

    private void ApplyPromoCode()
    {
        if (Auth.CurrentUser is null)
        {
            promoFeedback = "Please sign in to apply coupon codes.";
            promoSuccess = false;
            return;
        }

        var code = (promoCodeInput ?? string.Empty).Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code))
        {
            promoFeedback = "Please enter a valid coupon code.";
            promoSuccess = false;
            return;
        }

        try
        {
            decimal amount = 0m;
            if (code == "WELCOME50" || code == "SHOPPET50")
            {
                amount = 50.00m;
            }
            else if (code == "PAWESOME" || code == "PETPERKS10")
            {
                amount = Math.Max(10.00m, Math.Round(Subtotal * 0.10m, 2));
            }
            else
            {
                promoFeedback = "Invalid promo code. Try WELCOME50 for ₱50 off or PAWESOME for 10% off!";
                promoSuccess = false;
                return;
            }

            var claimed = Orders.ClaimPromoCode(Auth.CurrentUser.Id, code, amount);
            vouchers = Orders.GetActiveVouchers(Auth.CurrentUser.Id);
            selectedVoucherId = claimed.Id;
            promoSuccess = true;
            promoFeedback = $"✓ Promo code {claimed.Code} applied! ₱{claimed.Amount:N2} discount has been activated.";
            promoCodeInput = string.Empty;
        }
        catch (Exception ex)
        {
            promoSuccess = false;
            promoFeedback = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.InitializeAsync();

        if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (SellerUserId <= 0)
        {
            var firstItem = Cart.Items.FirstOrDefault();
            if (firstItem is not null)
            {
                SellerUserId = firstItem.SellerUserId;
            }
            else
            {
                Nav.NavigateTo("/marketplace/cart");
                return;
            }
        }

        vouchers = Orders.GetActiveVouchers(Auth.CurrentUser.Id);
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlaceOrderAsync()
    {
        if (Auth.CurrentUser is null || SellerItems.Count == 0) return;

        isError = false;
        if (outcome == "failure")
        {
            isError = true;
            message = "Simulated payment failed. Your cart and listings are unchanged.";
            return;
        }

        isSubmitting = true;
        message = string.Empty;

        try
        {
            // 1.5s simulated loading/processing delay for mock transaction
            await Task.Delay(1500);

            var ids = SellerItems.Select(x => x.ListingId).ToList();
            var reference = Orders.CreateOrder(
                Auth.CurrentUser.Id,
                SellerUserId,
                SellerItems,
                paymentMethod,
                selectedVoucherId == 0 ? null : selectedVoucherId);

            Cart.RemoveMany(ids);
            Nav.NavigateTo($"/marketplace/order-confirmation/{reference}");
        }
        catch (Exception ex)
        {
            isError = true;
            message = ex.Message;
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
