
@page "/"
@layout LandingLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>ShoppetCare | Connected Pet Care</PageTitle>

<div class="sc-landing">

    <!-- =====================================================
         01. HERO — FRONT DOOR
         ===================================================== -->
    <section class="sc-hero">
        <div class="sc-shell-wide sc-hero-grid">

            <div class="sc-hero-copy">
                <span class="sc-eyebrow">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#heart-pulse"></use>
                    </svg>
                    Connected Pet Care Platform
                </span>

                <h1>
                    Everything around your pet,
                    <em>connected in one place.</em>
                </h1>

                <p class="sc-hero-lead">
                    Manage your pets, create a Digital Pet ID, discover veterinary care,
                    and browse pet-owner marketplace listings through one connected experience.
                </p>

                <div class="sc-hero-actions">
                    <button type="button"
                            class="sc-btn sc-btn-primary"
                            @onclick="Register">
                        Create Free Account
                    </button>

                    <button type="button"
                            class="sc-btn sc-btn-secondary"
                            @onclick="Guest">
                        Explore as Guest
                    </button>
                </div>

                <p class="sc-guest-note">
                    Guest Mode is a limited preview. Account-only tools stay clearly locked.
                </p>

                <button type="button"
                        class="sc-discovery-bar"
                        @onclick="Guest"
                        aria-label="Search clinics and marketplace listings in Guest Mode">
                    <span class="sc-discovery-main">
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#search"></use>
                        </svg>
                        <span>
                            <strong>Search clinics &amp; marketplace listings</strong>
                            <small>Preview ShoppetCare before creating an account</small>
                        </span>
                    </span>
                    <span class="sc-discovery-action">Search as Guest</span>
                </button>
            </div>

            <div class="sc-hero-visual">
                <img src="/hero_vet_hd.jpg"
                     alt="Pets receiving veterinary care"
                     class="sc-hero-photo"
                     loading="eager" />

                <div class="sc-hero-note sc-hero-note-market">
                    <img src="/foodprod.png" alt="" aria-hidden="true" />
                    <span>
                        <small>Marketplace</small>
                        <strong>Browse pet-owner listings</strong>
                    </span>
                </div>

                <div class="sc-hero-note sc-hero-note-petid">
                    <img src="/pet_card_virtual.png" alt="" aria-hidden="true" />
                    <span>
                        <small>Digital Pet ID</small>
                        <strong>Basic + Premium</strong>
                    </span>
                </div>
            </div>

        </div>
    </section>

    <!-- =====================================================
         02. START HERE — USER-INTENT DISCOVERY HUB
         ===================================================== -->
    <section class="sc-intent" aria-labelledby="sc-intent-title">
        <div class="sc-shell-wide sc-intent-grid">

            <div class="sc-intent-intro">
                <span class="sc-eyebrow">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#compass"></use>
                    </svg>
                    Start here
                </span>

                <h2 id="sc-intent-title">
                    What would you like
                    <em>to do today?</em>
                </h2>

                <p>
                    Choose a familiar starting point. You can preview care and marketplace
                    discovery in Guest Mode before creating an account.
                </p>

                <span class="sc-intent-helper">
                    Simple paths for first-time and returning pet owners.
                </span>
            </div>

            <div class="sc-intent-actions" aria-label="Choose a ShoppetCare starting point">

                <a href="#pet-id" class="sc-intent-item sc-intent-item-featured">
                    <span class="sc-intent-icon">
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                        </svg>
                    </span>

                    <span class="sc-intent-copy">
                        <small>Digital Pet ID</small>
                        <strong>Create an identity for my pet</strong>
                        <span>Build a QR-enabled pet identity and public profile.</span>
                    </span>
                </a>

                <button type="button"
                        class="sc-intent-item"
                        @onclick="Guest">
                    <span class="sc-intent-icon">
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                        </svg>
                    </span>

                    <span class="sc-intent-copy">
                        <small>Pet Profiles</small>
                        <strong>Manage my pet information</strong>
                        <span>Keep identity and care details organized in one place.</span>
                    </span>
                </button>

                <a href="#clinics" class="sc-intent-item">
                    <span class="sc-intent-icon">
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#hospital"></use>
                        </svg>
                    </span>

                    <span class="sc-intent-copy">
                        <small>Veterinary Care</small>
                        <strong>Find care for my pet</strong>
                        <span>Browse local clinic information and verification indicators.</span>
                    </span>
                </a>

                <a href="#marketplace" class="sc-intent-item sc-intent-item-market">
                    <span class="sc-intent-icon">
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#shop"></use>
                        </svg>
                    </span>

                    <span class="sc-intent-copy">
                        <small>Marketplace</small>
                        <strong>Browse pet-owner listings</strong>
                        <span>Preview useful pet-related items from the community.</span>
                    </span>
                </a>

            </div>

        </div>
    </section>

    <!-- =====================================================
         03. DIGITAL PET ID — SIGNATURE PRODUCT STORY
         ===================================================== -->
    <section class="sc-petid" id="pet-id">
        <div class="sc-shell-wide sc-petid-grid">

            <div class="sc-petid-copy">
                <span class="sc-eyebrow">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#qr-code"></use>
                    </svg>
                    Signature Feature · Digital Pet ID
                </span>

                <h2>
                    An identity made for
                    <em>life with your pet.</em>
                </h2>

                <p>
                    Give your pet a portable QR-enabled identity connected to an
                    owner-controlled public profile.
                </p>

                <div class="sc-petid-options" aria-label="Digital Pet ID options">
                    <div>
                        <strong>Basic Pet ID</strong>
                        <span>Pet details, owner information, Card ID and QR public profile.</span>
                    </div>
                    <div>
                        <strong>Premium Pet ID</strong>
                        <span>More pet profiles, health records, themes and export options.</span>
                    </div>
                </div>

                <button type="button"
                        class="sc-btn sc-btn-primary"
                        @onclick="Register">
                    Create Your Pet ID
                </button>
            </div>

            <div class="sc-petid-visual">
                <div class="sc-petid-halo" aria-hidden="true"></div>

                <img src="/pet_card_virtual.png"
                     alt="ShoppetCare Basic and Premium Digital Pet ID preview" />

                <div class="sc-petid-scan-layer" aria-hidden="true">
                    <span class="sc-petid-scan-line"></span>
                </div>
            </div>

        </div>
    </section>

    <!-- =====================================================
         04. MARKETPLACE — COMMERCE FIRST
         ===================================================== -->
    <section class="sc-marketplace" id="marketplace">
        <div class="sc-shell sc-market-head">
            <div>
                <span class="sc-eyebrow">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#shop"></use>
                    </svg>
                    Pet-owner marketplace
                </span>

                <h2>Find useful pet essentials from fellow pet owners.</h2>
                <p>Preview community listings, then enter Guest Mode to explore the marketplace.</p>
            </div>

            <button type="button"
                    class="sc-btn sc-btn-primary"
                    @onclick="Guest">
                Browse Marketplace
            </button>
        </div>

        <div class="sc-market-products">

            <article class="sc-product-card">
                <div class="sc-product-media">
                    <img src="/foodprod.png" alt="Pet food and supplies listing preview" />
                    <span class="sc-product-badge">Pet-owner listing</span>
                </div>
                <div class="sc-product-content">
                    <span class="sc-product-type">Pet essentials</span>
                    <h3>Pet Food &amp; Supplies</h3>
                    <div class="sc-product-meta">
                        <strong>Owner listing</strong>
                        <span>Community seller</span>
                    </div>
                </div>
            </article>

            <article class="sc-product-card">
                <div class="sc-product-media">
                    <img src="/premiumft.png" alt="Featured pet essentials listing preview" />
                    <span class="sc-product-badge">Featured listing</span>
                </div>
                <div class="sc-product-content">
                    <span class="sc-product-type">Featured</span>
                    <h3>Everyday Pet Essentials</h3>
                    <div class="sc-product-meta">
                        <strong>Browse listing</strong>
                        <span>Community seller</span>
                    </div>
                </div>
            </article>

            <article class="sc-product-card">
                <div class="sc-product-media">
                    <img src="/petvitna.jpg" alt="Community pet listing preview" />
                    <span class="sc-product-badge">Community listing</span>
                </div>
                <div class="sc-product-content">
                    <span class="sc-product-type">Pet care</span>
                    <h3>Owner-to-Owner Listing</h3>
                    <div class="sc-product-meta">
                        <strong>Local discovery</strong>
                        <span>Pet-owner seller</span>
                    </div>
                </div>
            </article>

        </div>

        <div class="sc-shell-wide">
            <aside class="sc-seller-strip">
                <div class="sc-seller-icon">
                    <svg class="sp-icon" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#bag"></use>
                    </svg>
                </div>
                <div class="sc-seller-copy">
                    <strong>Have a pet-related item to list?</strong>
                    <span>Registered pet owners can create marketplace listings for the ShoppetCare community.</span>
                </div>
                <button type="button"
                        class="sc-btn sc-btn-dark"
                        @onclick="Register">
                    Start Selling
                </button>
            </aside>
        </div>
    </section>

    <!-- =====================================================
         05. VERIFIED VETERINARY CARE — EDGE-LED PHOTO SPLIT
         ===================================================== -->
    <section class="sc-care" id="clinics">
        <div class="sc-care-grid">

            <div class="sc-care-visual">
                <img src="/vet_wpets.jpg"
                     alt="Veterinarian caring for pets" />
            </div>

            <div class="sc-care-copy">
                <span class="sc-eyebrow">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#hospital"></use>
                    </svg>
                    Verified Pet Care
                </span>

                <h2>Find veterinary care with clearer information.</h2>

                <p>
                    Browse local pet-care providers, compare useful clinic details,
                    and recognize businesses that have completed ShoppetCare's verification process.
                </p>

                <ul class="sc-care-points">
                    <li>
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#patch-check"></use>
                        </svg>
                        <span>
                            <strong>Verified Clinic indicator</strong>
                            <small>Recognize verified ShoppetCare clinic partners.</small>
                        </span>
                    </li>
                    <li>
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#geo-alt"></use>
                        </svg>
                        <span>
                            <strong>Local care discovery</strong>
                            <small>Find clinic information from one clear directory.</small>
                        </span>
                    </li>
                    <li>
                        <svg class="sp-icon" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#clock"></use>
                        </svg>
                        <span>
                            <strong>Useful clinic details</strong>
                            <small>Review hours, contact information and available services.</small>
                        </span>
                    </li>
                </ul>

                <button type="button"
                        class="sc-btn sc-btn-primary"
                        @onclick="Guest">
                    Find Veterinary Care
                </button>
            </div>

        </div>
    </section>

    <!-- =====================================================
         06. MOBILE — PRODUCT DEMONSTRATION
         ===================================================== -->
    <section class="sc-mobile" id="mobile">
        <div class="sc-shell-wide sc-mobile-grid">

            <div class="sc-mobile-copy">
                <span class="sc-eyebrow sc-eyebrow-light">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#phone"></use>
                    </svg>
                    ShoppetCare Mobile
                </span>

                <h2>Your pet's essentials can move with you.</h2>

                <p>
                    The mobile experience connects to the same pet-management ecosystem,
                    keeping important pet information within reach away from the desktop.
                </p>

                <div class="sc-mobile-benefits">
                    <div>
                        <span class="sc-mobile-benefit-icon">
                            <svg class="sp-icon" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                            </svg>
                        </span>
                        <span class="sc-mobile-benefit-copy">
                            <strong>Same pet profiles</strong>
                            <small>Continue managing your pets across devices.</small>
                        </span>
                    </div>
                    <div>
                        <span class="sc-mobile-benefit-icon">
                            <svg class="sp-icon" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                            </svg>
                        </span>
                        <span class="sc-mobile-benefit-copy">
                            <strong>Digital Pet ID on the go</strong>
                            <small>Keep pet identity accessible when needed.</small>
                        </span>
                    </div>
                    <div>
                        <span class="sc-mobile-benefit-icon">
                            <svg class="sp-icon" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#journal-medical"></use>
                            </svg>
                        </span>
                        <span class="sc-mobile-benefit-copy">
                            <strong>Health information when needed</strong>
                            <small>Reach important pet records from mobile.</small>
                        </span>
                    </div>
                </div>

                <button type="button"
                        class="sc-btn sc-btn-light"
                        @onclick="Register">
                    Create Your Account
                </button>
            </div>

            <div class="sc-phone-stage" role="img" aria-label="ShoppetCare mobile app preview">
                <div class="sc-phone-glow" aria-hidden="true"></div>
                <div class="sc-phone">
                    <div class="sc-phone-status">
                        <span>9:41</span>
                        <span class="sc-phone-island"></span>
                        <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#battery-full"></use>
                        </svg>
                    </div>

                    <div class="sc-phone-brand">
                        <div>
                            <img src="/shoppetlogo.png" alt="" />
                            <span>
                                <strong>ShoppetCare</strong>
                                <small>Hi, Pet Owner</small>
                            </span>
                        </div>
                        <span class="sc-phone-bell">
                            <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#bell"></use>
                            </svg>
                        </span>
                    </div>

                    <div class="sc-phone-pet">
                        <div>
                            <small>MY PET</small>
                            <strong>Buddy</strong>
                            <span>Golden Retriever</span>
                        </div>
                        <span class="sc-phone-id">PET-A1B2C3</span>
                    </div>

                    <div class="sc-phone-actions">
                        <span class="sc-phone-action sc-phone-action-id">
                            <svg class="sp-icon" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code-scan"></use>
                            </svg>
                            Pet ID
                        </span>
                        <span class="sc-phone-action sc-phone-action-clinics">
                            <svg class="sp-icon" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#hospital"></use>
                            </svg>
                            Clinics
                        </span>
                        <span class="sc-phone-action sc-phone-action-market">
                            <svg class="sp-icon" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#shop"></use>
                            </svg>
                            Market
                        </span>
                    </div>

                    <div class="sc-phone-title-row">
                        <span>
                            <strong>Pet care today</strong>
                            <small>Quick access</small>
                        </span>
                        <small>View all</small>
                    </div>

                    <div class="sc-phone-feed">
                        <div>
                            <span>
                                <svg class="sp-icon" aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#calendar2-check"></use>
                                </svg>
                            </span>
                            <p>
                                <strong>Vaccination record</strong>
                                <small>Keep Buddy's records organized.</small>
                            </p>
                        </div>
                        <div>
                            <span>
                                <svg class="sp-icon" aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#patch-check"></use>
                                </svg>
                            </span>
                            <p>
                                <strong>Find verified care</strong>
                                <small>Browse clinics near your area.</small>
                            </p>
                        </div>
                    </div>

                    <div class="sc-phone-nav">
                        <span class="active">
                            <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#house"></use>
                            </svg>
                        </span>
                        <span>
                            <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                            </svg>
                        </span>
                        <span>
                            <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#shop"></use>
                            </svg>
                        </span>
                        <span>
                            <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#person"></use>
                            </svg>
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- =====================================================
     07. FOR VETERINARY CLINICS — OPEN EDITORIAL SPLIT
     ===================================================== -->
    <section class="sc-business" id="clinic-business">
        <div class="sc-shell-wide sc-business-grid">

            <div class="sc-business-photo">
                <img src="/vet_group.png"
                     alt="Veterinary clinic team" />

                <div class="sc-business-credential" aria-hidden="true">
                    <span class="sc-business-credential-check">✓</span>

                    <span class="sc-business-credential-copy">
                        <small>ShoppetCare</small>
                        <strong>Verified Partner</strong>
                    </span>
                </div>
            </div>

            <div class="sc-business-copy">
                <span class="sc-eyebrow">
                    <svg class="sp-icon sp-icon-sm" aria-hidden="true">
                        <use href="/icons/bootstrap-icons.svg#building"></use>
                    </svg>
                    For Veterinary Clinics
                </span>

                <h2>Build a verified presence where pet owners find care.</h2>

                <p>
                    Strengthen clinic visibility through a ShoppetCare Verified Partner presence
                    while keeping the public experience focused on pet owners.
                </p>

                <ul class="sc-business-benefits">
                    <li>Verified Clinic badge</li>
                    <li>Enhanced clinic profile</li>
                    <li>Directory visibility</li>
                </ul>

                <button type="button"
                        class="sc-btn sc-btn-primary"
                        @onclick="Login">
                    Clinic Sign In
                </button>
            </div>
          
        </div>
    </section>
</div>

@code {
    private void Login()
    {
        Nav.NavigateTo("/login");
    }

    private void Register()
    {
        Nav.NavigateTo("/register");
    }

    private void Guest()
    {
        Nav.NavigateTo("/home?guest=true");
    }
}