@code {

    private bool isReady;


    private string ownerPhotoUrl =
        string.Empty;


    private List<PetProfile> pets =
        new();


    private List<ClinicAppointment> appointments =
        new();


    private int healthRecordCount;


    private int activePetIdCount;


    private string FirstName
    {
        get
        {
            var name =
                Auth.CurrentUser?
                    .FullName?
                    .Trim();


            if (string.IsNullOrWhiteSpace(name))
            {
                return "Pet Owner";
            }


            return
                name.Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries)
                    .FirstOrDefault()
                ??
                "Pet Owner";
        }
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await Auth.InitializeAsync();


        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo(
                "/login");

            return;
        }


        if (!Auth.IsPetOwner)
        {
            Nav.NavigateTo(
                Auth.IsAdmin
                    ? "/admin-portal"
                    : "/login");

            return;
        }


        LoadDashboard();


        isReady =
            true;


        await InvokeAsync(
            StateHasChanged);
    }


    private void LoadDashboard()
    {
        var userId =
            Auth.CurrentUser!.Id;


        ownerPhotoUrl =
            FileStorage.GetImageUrl(
                "users",
                userId)
            ??
            string.Empty;


        pets =
            DbService.GetPetsByUser(
                userId)
            ??
            new List<PetProfile>();


        healthRecordCount =
            pets.Sum(
                pet =>
                    DbService
                        .GetHealthRecords(
                            pet.Id)
                        .Count);


        activePetIdCount =
            pets.Count(
                pet =>
                    !string.IsNullOrWhiteSpace(
                        pet.CardId));


        appointments =
            DbService
                .GetAppointments(
                    userId: userId)
                .Where(
                    appointment =>
                        appointment.AppointmentDate >=
                            DateTime.Today
                        &&
                        !string.Equals(
                            appointment.Status,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase))
                .OrderBy(
                    appointment =>
                        appointment.AppointmentDate)
                .Take(3)
                .ToList();
    }


    private string GetPetPhoto(
        int petId)
    {
        return
            FileStorage.GetImageUrl(
                "pets",
                petId)
            ??
            string.Empty;
    }


    private static string GetPetInitial(
        PetProfile pet)
    {
        return
            string.IsNullOrWhiteSpace(
                pet.PetName)
                ? "P"
                : pet.PetName[..1]
                    .ToUpperInvariant();
    }


    private string GetPetFamilyHeadline()
    {
        if (pets.Count == 0)
        {
            return
                "Your pet family starts here.";
        }


        if (pets.Count == 1)
        {
            return
                pets[0].PetName;
        }


        if (pets.Count == 2)
        {
            return
                $"{pets[0].PetName} & {pets[1].PetName}";
        }


        return
            $"{pets[0].PetName}, {pets[1].PetName} + {pets.Count - 2} more";
    }


    private string GetInitials()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        if (string.IsNullOrWhiteSpace(name))
        {
            return "PO";
        }


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return
                parts[0][..Math.Min(
                    2,
                    parts[0].Length)]
                .ToUpperInvariant();
        }


        return
            $"{parts[0][0]}{parts[^1][0]}"
                .ToUpperInvariant();
    }

}