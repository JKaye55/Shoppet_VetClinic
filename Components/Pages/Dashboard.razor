    .msc-main-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:18px;margin-top:18px}.msc-panel{padding:26px;border:1px solid #DDE7E4;border-radius:19px;background:#fff;box-shadow:0 10px 30px rgba(30,45,39,.045)}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:20px}.msc-panel h2{margin:5px 0 7px;font-weight:900;letter-spacing:-.04em}.msc-panel p{margin:0;color:#6E7C76;line-height:1.58}.primary-link,.secondary-link{min-height:43px;padding:0 15px;border-radius:10px;text-decoration:none;font-size:.73rem;font-weight:850;display:inline-flex;align-items:center;justify-content:center}.primary-link{background:#2F9098;color:#fff}.secondary-link{border:1px solid #C9D9D5;background:#fff;color:#173D3D}
