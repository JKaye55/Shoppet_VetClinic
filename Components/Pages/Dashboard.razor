</style>

@code {
    private List<PetProfile> pets = new();
    private readonly Dictionary<int, int> healthByPet = new();
    private int petIdCount;
    private int healthRecordCount;
    private int unreadNotifications;
    private bool ready;
    private bool premiumActive;
    private bool sellerActive;
    private DateTime? premiumExpiresAt;
    private DateTime? sellerExpiresAt;

    private string FirstName =>
        Auth.CurrentUser?.FullName?
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault() ?? "Pet Parent";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.InitializeAsync();

        if (Auth.CurrentUser is not null)
        {
            LoadData();
        }

        ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private void LoadData()
    {
        var user = Auth.CurrentUser;
        if (user is null) return;

        pets = Db.GetPetsByUser(user.Id);
        petIdCount = pets.Count(p => !string.IsNullOrWhiteSpace(p.CardId));

        healthByPet.Clear();
        healthRecordCount = 0;

        foreach (var pet in pets)
        {
            var count = Db.GetHealthRecords(pet.Id).Count;
            healthByPet[pet.Id] = count;
            healthRecordCount += count;
        }

        unreadNotifications = Db.GetUnreadNotificationCount(user.Id);

        var premium =
            Commerce.GetActiveSubscription(
                CommerceService.PremiumType,
                userId: user.Id);

        premiumActive = premium is not null || Auth.IsPremium;
        premiumExpiresAt =
            premium?.ExpiresAt
            ?? user.PremiumActivatedAt?.AddMonths(3);

        var seller =
            Commerce.GetActiveSubscription(
                CommerceService.SellerType,
                userId: user.Id);

        sellerActive = seller is not null;
        sellerExpiresAt = seller?.ExpiresAt;
    }

    private static string GetPetInitial(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? "P"
            : name.Trim()[0].ToString().ToUpperInvariant();
}
