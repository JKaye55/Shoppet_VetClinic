@page "/dashboard"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject DatabaseService DbService
@inject FileStorageService FileStorage
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>My ShoppetCare | Overview</PageTitle>


<div class="ov-page">

    @if (!isReady)
    {
        <div class="ov-loading">
            Loading My ShoppetCare...
        </div>
    }
    else
    {
        <main class="ov-shell">


            <!-- =====================================================
                 HERO
                 ===================================================== -->

            <section class="ov-hero">

                <div class="ov-hero-main">

                    <span class="ov-eyebrow">
                        MY SHOPPETCARE
                    </span>


                    <div class="ov-owner">

                        <div class="ov-owner-photo">

                            @if (!string.IsNullOrWhiteSpace(
                                ownerPhotoUrl))
                            {
                                <img src="@ownerPhotoUrl"
                                     alt="@Auth.CurrentUser?.FullName" />
                            }
                            else
                            {
                                <span>
                                    @GetInitials()
                                </span>
                            }

                        </div>


                        <h1>
                            Welcome back,
                            <em>@FirstName.</em>
                        </h1>

                    </div>


                    <p class="ov-hero-copy">
                        One connected place for your pets,
                        Digital Pet IDs, trusted veterinary care,
                        community, and the ShoppetCare marketplace.
                    </p>


                    <div class="ov-hero-actions">

                        <a href="/my-pets"
                           class="primary">

                            Manage My Pets

                            <span>→</span>

                        </a>


                        <a href="/marketplace"
                           class="secondary">

                            Explore Marketplace

                        </a>

                    </div>

                </div>


                <!-- MEMBERSHIP -->

                <aside class="ov-membership">

                    <span class="ov-membership-label">
                        MEMBERSHIP
                    </span>


                    @if (Auth.IsPremium)
                    {
                        <div class="ov-membership-title">

                            <span class="star">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#star-fill"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    Lifetime Premium
                                </strong>

                                <small>
                                    Active membership
                                </small>

                            </div>

                        </div>


                        <p>
                            Your account has Premium pet-management
                            and Pet ID features enabled.
                        </p>


                        <a href="/account">
                            Manage membership →
                        </a>
                    }
                    else
                    {
                        <strong class="ov-free-plan">
                            Free Plan
                        </strong>

                        <p>
                            Core pet-management tools
                            are ready to use.
                        </p>


                        <a href="/premium">
                            Explore Premium →
                        </a>
                    }

                </aside>

            </section>


            <!-- =====================================================
                 ACCOUNT TODAY
                 ===================================================== -->

            <section class="ov-today">

                <div class="ov-today-title">

                    <span class="ov-eyebrow">
                        ACCOUNT TODAY
                    </span>

                    <h2>
                        The essentials,
                        <em>right away.</em>
                    </h2>

                </div>


                <div class="ov-metrics">


                    <a href="/my-pets"
                       class="ov-metric primary">

                        <span class="metric-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#heart-fill"></use>
                            </svg>

                        </span>


                        <span class="metric-copy">

                            <strong>
                                @pets.Count
                            </strong>

                            <span>
                                Pet Profiles
                            </span>

                            <small>
                                Manage pet family
                            </small>

                        </span>


                        <span class="metric-arrow">
                            →
                        </span>

                    </a>


                    <a href="/my-pets"
                       class="ov-metric">

                        <span class="metric-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#qr-code"></use>
                            </svg>

                        </span>


                        <span class="metric-copy">

                            <strong>
                                @activePetIdCount
                            </strong>

                            <span>
                                Digital Pet IDs
                            </span>

                            <small>
                                Active identities
                            </small>

                        </span>


                        <span class="metric-arrow">
                            →
                        </span>

                    </a>


                    <a href="/my-pets"
                       class="ov-metric">

                        <span class="metric-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#clipboard2-pulse"></use>
                            </svg>

                        </span>


                        <span class="metric-copy">

                            <strong>
                                @healthRecordCount
                            </strong>

                            <span>
                                Health Records
                            </span>

                            <small>
                                Across your pets
                            </small>

                        </span>


                        <span class="metric-arrow">
                            →
                        </span>

                    </a>


                    <a href="/clinics"
                       class="ov-metric">

                        <span class="metric-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#calendar-event"></use>
                            </svg>

                        </span>


                        <span class="metric-copy">

                            <strong>
                                @appointments.Count
                            </strong>

                            <span>
                                Upcoming Visits
                            </span>

                            <small>
                                Veterinary care
                            </small>

                        </span>


                        <span class="metric-arrow">
                            →
                        </span>

                    </a>

                </div>

            </section>


            <!-- =====================================================
                 MAIN BENTO
                 ===================================================== -->

            <section class="ov-bento">


                <!-- PET HUB -->

                <article class="ov-pet-hub">

                    <div class="ov-pet-heading">

                        <div>

                            <span class="ov-eyebrow">
                                PET HUB
                            </span>

                            <h2>
                                Your pet family.
                            </h2>

                            <p>
                                My Pets is the single management
                                workspace for profiles, photos,
                                Digital Pet IDs, and health records.
                            </p>

                        </div>


                        <span class="ov-count">

                            @pets.Count

                            @(pets.Count == 1
                                ? "Pet"
                                : "Pets")

                        </span>

                    </div>


                    @if (pets.Count == 0)
                    {
                        <div class="ov-empty-family">

                            <span class="empty-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#heart"></use>
                                </svg>

                            </span>


                            <div>

                                <strong>
                                    Start your pet family.
                                </strong>

                                <p>
                                    Create your first pet profile
                                    and Digital Pet ID.
                                </p>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="ov-family">

                            <div class="ov-avatar-stack">

                                @foreach (var pet in pets.Take(4))
                                {
                                    var photo =
                                        GetPetPhoto(
                                            pet.Id);


                                    <div class="ov-pet-avatar"
                                         title="@pet.PetName">

                                        @if (!string.IsNullOrWhiteSpace(photo))
                                        {
                                            <img src="@photo"
                                                 alt="@pet.PetName" />
                                        }
                                        else
                                        {
                                            <span>
                                                @GetPetInitial(pet)
                                            </span>
                                        }

                                    </div>
                                }

                            </div>


                            <div class="ov-family-copy">

                                <strong>
                                    @GetPetFamilyHeadline()
                                </strong>

                                <p>
                                    Ready whenever you need
                                    to update a profile,
                                    open an ID card,
                                    or review records.
                                </p>

                            </div>

                        </div>
                    }


                    <div class="ov-capabilities">

                        <div>

                            <span class="cap-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#person-vcard"></use>
                                </svg>

                            </span>

                            <span>

                                <strong>
                                    Profiles
                                </strong>

                                <small>
                                    Identity &amp; details
                                </small>

                            </span>

                        </div>


                        <div>

                            <span class="cap-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#qr-code"></use>
                                </svg>

                            </span>

                            <span>

                                <strong>
                                    Digital Pet ID
                                </strong>

                                <small>
                                    Scannable identity
                                </small>

                            </span>

                        </div>


                        <div>

                            <span class="cap-icon">

                                <svg aria-hidden="true">
                                    <use href="/icons/bootstrap-icons.svg#clipboard2-pulse"></use>
                                </svg>

                            </span>

                            <span>

                                <strong>
                                    Health Records
                                </strong>

                                <small>
                                    Care information
                                </small>

                            </span>

                        </div>

                    </div>


                    <a href="/my-pets"
                       class="ov-open-pets">

                        Open My Pets

                        <span>→</span>

                    </a>

                </article>


                <!-- MARKETPLACE -->

                <a href="/marketplace"
                   class="ov-marketplace">

                    <div class="marketplace-top">

                        <span class="market-icon">

                            <svg aria-hidden="true">
                                <use href="/icons/bootstrap-icons.svg#shop"></use>
                            </svg>

                        </span>

                        <span class="market-pill">
                            PET-OWNER MARKETPLACE
                        </span>

                    </div>


                    <div>

                        <span class="ov-eyebrow">
                            PRE-LOVED MARKETPLACE
                        </span>

                        <h2>
                            Give pet items
                            <em>a second home.</em>
                        </h2>

                        <p>
                            Browse or sell useful pet items
                            directly with fellow pet owners.
                        </p>

                    </div>


                    <span class="ov-card-link">
                        Explore Marketplace →
                    </span>

                </a>


                <!-- CARE -->

                <a href="/clinics"
                   class="ov-small-card care">

                    <span class="small-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#hospital"></use>
                        </svg>

                    </span>


                    <div>

                        <span class="ov-eyebrow">
                            VERIFIED CARE
                        </span>

                        <h3>
                            Find veterinary care.
                        </h3>

                        <p>
                            Discover trusted local clinics.
                        </p>

                    </div>


                    <span class="small-arrow">
                        →
                    </span>

                </a>


                <!-- COMMUNITY -->

                <a href="/community"
                   class="ov-small-card community">

                    <span class="small-icon">

                        <svg aria-hidden="true">
                            <use href="/icons/bootstrap-icons.svg#people-fill"></use>
                        </svg>

                    </span>


                    <div>

                        <span class="ov-eyebrow">
                            COMMUNITY
                        </span>

                        <h3>
                            Share pet moments.
                        </h3>

                        <p>
                            Connect through stories and photos.
                        </p>

                    </div>


                    <span class="small-arrow">
                        →
                    </span>

                </a>

            </section>

        </main>
    }

</div>


<style>

    :root {
        --sc-teal: #2F9098;
        --sc-teal-dark: #267C83;
        --sc-dark: #173D3D;
        --sc-deep: #102E2D;
        --sc-cream: #FBF8F2;
        --sc-yellow: #F3D27A;
        --sc-yellow-soft: #FFF5D6;
        --sc-border: #DDE7E4;
        --sc-muted: #70817B;
        --sc-white: #FFFFFF;
    }


    .ov-page,
    .ov-page *,
    .ov-page *::before,
    .ov-page *::after {
        box-sizing: border-box;
    }


    .ov-page {
        min-height: 100vh;
        padding: 32px 0 76px;
        color: var(--sc-dark);
        background: radial-gradient( circle at 94% 3%, rgba(47,144,152,.10), transparent 22% ), var(--sc-cream);
    }


        .ov-page svg {
            width: 1em;
            height: 1em;
            fill: currentColor;
        }


    .ov-shell,
    .ov-loading {
        width: min( 1480px, calc(100% - 48px) );
        margin: 0 auto;
    }


    .ov-loading {
        padding: 90px 0;
        color: var(--sc-muted);
        text-align: center;
    }


    .ov-eyebrow {
        display: block;
        color: var(--sc-teal);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: .12em;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .ov-hero {
        position: relative;
        overflow: hidden;
        min-height: 320px;
        padding: 45px 50px;
        display: grid;
        grid-template-columns: minmax(0,1.45fr) minmax(300px,.55fr);
        align-items: center;
        gap: 55px;
        border: 1px solid var(--sc-border);
        border-radius: 30px;
        background: radial-gradient( circle at 92% 14%, rgba(47,144,152,.14), transparent 28% ), linear-gradient( 125deg, #FFFDF9, #FBF8F2 53%, #EEF7F5 );
        box-shadow: 0 28px 65px rgba(23,61,61,.08);
    }


        .ov-hero::after {
            content: "";
            position: absolute;
            top: -330px;
            right: -280px;
            width: 520px;
            height: 520px;
            border: 1px solid rgba(47,144,152,.13);
            border-radius: 50%;
        }


    .ov-hero-main,
    .ov-membership {
        position: relative;
        z-index: 2;
    }


    .ov-owner {
        margin-top: 10px;
        display: flex;
        align-items: center;
        gap: 22px;
    }


    .ov-owner-photo {
        width: 90px;
        height: 90px;
        flex: 0 0 90px;
        overflow: hidden;
        display: grid;
        place-items: center;
        border: 4px solid #FFFFFF;
        border-radius: 24px;
        background: linear-gradient( 135deg, var(--sc-teal), var(--sc-dark) );
        color: #FFFFFF;
        font-size: 20px;
        font-weight: 900;
        box-shadow: 0 13px 29px rgba(23,61,61,.15);
    }


        .ov-owner-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .ov-owner h1 {
        margin: 0;
        color: var(--sc-dark);
        font-size: clamp( 44px, 5vw, 72px );
        line-height: .91;
        font-weight: 900;
        letter-spacing: -.055em;
    }


        .ov-owner h1 em {
            display: block;
            color: var(--sc-teal);
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            font-weight: 500;
            letter-spacing: -.035em;
        }


    .ov-hero-copy {
        max-width: 770px;
        margin: 23px 0 0;
        color: #62756E;
        font-size: 15px;
        line-height: 1.7;
    }


    .ov-hero-actions {
        margin-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }


        .ov-hero-actions a {
            min-height: 48px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            border-radius: 11px;
            font-size: 13px;
            font-weight: 850;
            text-decoration: none;
        }


        .ov-hero-actions .primary {
            background: var(--sc-teal);
            color: #FFFFFF;
            box-shadow: 0 9px 22px rgba(47,144,152,.17);
        }


        .ov-hero-actions .secondary {
            border: 1px solid #C8DAD6;
            background: #FFFFFF;
            color: var(--sc-dark);
        }


    /* MEMBERSHIP */

    .ov-membership {
        padding: 24px;
        border: 1px solid #D7E4E0;
        border-radius: 20px;
        background: rgba(255,255,255,.88);
        box-shadow: 0 13px 31px rgba(23,61,61,.07);
    }


    .ov-membership-label {
        color: #9B7418;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .12em;
    }


    .ov-membership-title {
        margin-top: 13px;
        display: flex;
        align-items: center;
        gap: 12px;
    }


        .ov-membership-title .star {
            width: 43px;
            height: 43px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: var(--sc-yellow-soft);
            color: #9B7418;
        }


        .ov-membership-title strong,
        .ov-membership-title small {
            display: block;
        }


        .ov-membership-title strong {
            color: var(--sc-dark);
            font-size: 17px;
        }


        .ov-membership-title small {
            margin-top: 2px;
            color: #9B7418;
            font-size: 11px;
            font-weight: 800;
        }


    .ov-membership p {
        margin: 14px 0 0;
        color: #75867F;
        font-size: 12px;
        line-height: 1.6;
    }


    .ov-membership > a {
        display: inline-block;
        margin-top: 16px;
        color: var(--sc-teal-dark);
        font-size: 12px;
        font-weight: 850;
        text-decoration: none;
    }


    .ov-free-plan {
        display: block;
        margin-top: 11px;
        color: var(--sc-dark);
        font-size: 18px;
    }


    /* =========================================================
           ACCOUNT TODAY
           ========================================================= */

    .ov-today {
        margin-top: 16px;
        padding: 22px 24px;
        display: grid;
        grid-template-columns: 250px minmax(0,1fr);
        align-items: center;
        gap: 26px;
        border: 1px solid var(--sc-border);
        border-radius: 19px;
        background: #FFFFFF;
        box-shadow: 0 10px 29px rgba(23,61,61,.045);
    }


    .ov-today-title h2 {
        margin: 5px 0 0;
        color: var(--sc-dark);
        font-size: 24px;
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: -.035em;
    }


        .ov-today-title h2 em {
            color: var(--sc-teal);
            font-family: Georgia, "Times New Roman", serif;
            font-style: italic;
            font-weight: 500;
        }


    .ov-metrics {
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr) );
        gap: 9px;
    }


    .ov-metric {
        min-height: 94px;
        padding: 14px;
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        align-items: center;
        gap: 11px;
        border: 1px solid #E1E9E6;
        border-radius: 13px;
        background: #FBFCFB;
        color: var(--sc-dark);
        text-decoration: none;
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }


        .ov-metric.primary {
            border-color: #C4DEDA;
            background: linear-gradient( 135deg, #EAF6F5, #FFFFFF );
        }


        .ov-metric:hover {
            transform: translateY(-2px);
            border-color: #BCD8D3;
            box-shadow: 0 9px 21px rgba(23,61,61,.06);
        }


    .metric-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #E4F3F1;
        color: var(--sc-teal);
    }


    .metric-copy {
        min-width: 0;
    }


        .metric-copy strong,
        .metric-copy span,
        .metric-copy small {
            display: block;
        }


        .metric-copy strong {
            color: var(--sc-dark);
            font-size: 20px;
            font-weight: 950;
        }


        .metric-copy > span {
            margin-top: 1px;
            color: #4F655E;
            font-size: 12px;
            font-weight: 850;
        }


        .metric-copy small {
            margin-top: 2px;
            color: #919E99;
            font-size: 10px;
        }


    .metric-arrow {
        color: #9AA9A4;
    }


    /* =========================================================
           BENTO LAYOUT
           ========================================================= */

    .ov-bento {
        margin-top: 26px;
        display: grid;
        grid-template-columns: repeat( 12, minmax(0,1fr) );
        grid-template-rows: repeat( 2, minmax(190px,auto) );
        gap: 12px;
    }


    /* PET HUB */

    .ov-pet-hub {
        grid-column: span 7;
        grid-row: span 2;
        min-height: 500px;
        padding: 30px;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--sc-border);
        border-radius: 22px;
        background: radial-gradient( circle at 90% 9%, rgba(47,144,152,.13), transparent 29% ), #FFFFFF;
        box-shadow: 0 12px 32px rgba(23,61,61,.05);
    }


    .ov-pet-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }


        .ov-pet-heading h2 {
            margin: 6px 0 0;
            color: var(--sc-dark);
            font-size: 32px;
            font-weight: 900;
            letter-spacing: -.04em;
        }


        .ov-pet-heading p {
            max-width: 600px;
            margin: 7px 0 0;
            color: #788984;
            font-size: 13px;
            line-height: 1.55;
        }


    .ov-count {
        min-height: 33px;
        padding: 0 11px;
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background: #EAF5F5;
        color: var(--sc-teal-dark);
        font-size: 11px;
        font-weight: 850;
        white-space: nowrap;
    }


    .ov-family {
        margin-top: 47px;
        display: flex;
        align-items: center;
        gap: 28px;
    }


    .ov-avatar-stack {
        display: flex;
        padding-left: 23px;
    }


    .ov-pet-avatar {
        width: 90px;
        height: 90px;
        margin-left: -23px;
        overflow: hidden;
        display: grid;
        place-items: center;
        border: 4px solid #FFFFFF;
        border-radius: 24px;
        background: linear-gradient( 135deg, var(--sc-teal), var(--sc-dark) );
        color: #FFFFFF;
        font-size: 18px;
        font-weight: 900;
        box-shadow: 0 11px 25px rgba(23,61,61,.14);
    }


        .ov-pet-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .ov-family-copy strong {
        display: block;
        color: var(--sc-dark);
        font-size: 17px;
    }


    .ov-family-copy p {
        max-width: 400px;
        margin: 5px 0 0;
        color: #7D8C87;
        font-size: 12px;
        line-height: 1.5;
    }


    .ov-capabilities {
        margin-top: 37px;
        display: grid;
        grid-template-columns: repeat( 3, minmax(0,1fr) );
        gap: 8px;
    }


        .ov-capabilities > div {
            min-height: 72px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 11px;
            background: #F5F9F8;
        }


    .cap-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: #E2F2EF;
        color: var(--sc-teal);
    }


    .ov-capabilities strong,
    .ov-capabilities small {
        display: block;
    }


    .ov-capabilities strong {
        color: var(--sc-dark);
        font-size: 12px;
    }


    .ov-capabilities small {
        margin-top: 2px;
        color: #899792;
        font-size: 10px;
    }


    .ov-open-pets {
        min-height: 48px;
        margin-top: auto;
        padding: 0 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 10px;
        background: var(--sc-teal);
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 850;
