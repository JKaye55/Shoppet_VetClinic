    }

    .pet-photo-preview {
        width: 82px;
        height: 82px;
        flex-shrink: 0;
    }

    .pet-photo,
    .pet-photo-placeholder {
        width: 82px;
        height: 82px;
        border-radius: 16px;
        object-fit: cover;
    }

    .pet-photo-placeholder {
        background: #DDE9E4;
        color: #547067;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: .7rem;
        font-weight: 800;
    }

    .pet-photo-controls {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .pet-photo-controls strong {
            color: #25362F;
            font-size: .82rem;
        }

        .pet-photo-controls span {
            color: #7C8782;
            font-size: .72rem;
        }

        .pet-photo-controls small {
            color: #5C766D;
            font-size: .65rem;
        }

    .upload-photo-button {
        width: fit-content;
        margin-top: 7px;
        cursor: pointer;
        background: #1E2D27;
        color: white;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: .68rem;
        font-weight: 800;
    }

        .upload-photo-button:hover {
            background: #5C766D;
        }

    .form-actions {
        display: flex;
        gap: 8px;
        margin-top: 16px;
    }

    .cancel-action {
        border: 0;
        background: white;
        color: #44534D;
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 750;
        cursor: pointer;
    }

    .empty-box {
        border: 1px dashed #CBD6D1;
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        color: #7C8782;
    }

        .empty-box strong,
        .empty-box span {
            display: block;
        }

        .empty-box strong {
            color: #34443D;
            margin-bottom: 5px;
        }

    .empty-action {
        display: inline-block;
        margin-top: 13px;
        color: #456157;
        font-size: .76rem;
        font-weight: 850;
        text-decoration: none;
    }

    .pet-list,
    .appointment-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pet-row {
        border: 1px solid #E6EBE8;
        border-radius: 15px;
        padding: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .pet-row-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .pet-list-photo {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 14px;
        overflow: hidden;
        background: #EEF4F1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #456157;
        font-weight: 850;
    }

        .pet-list-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pet-details {
        min-width: 0;
    }

        .pet-details strong,
        .pet-details span,
        .pet-details small {
            display: block;
        }

        .pet-details strong {
            color: #26352F;
        }

        .pet-details span {
            color: #5C766D;
            font-size: .82rem;
            margin-top: 3px;
        }

        .pet-details small {
            color: #7C8782;
            margin-top: 4px;
            font-size: .7rem;
        }

    .pet-row-actions {
        display: flex;
        gap: 5px;
        flex-shrink: 0;
    }

    .edit-pet-button,
    .delete-pet-button {
        border: 0;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .68rem;
        font-weight: 800;
        cursor: pointer;
    }

    .edit-pet-button {
        background: #EEF4F1;
