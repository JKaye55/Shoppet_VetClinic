@page "/dashboard"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject DatabaseService Db
@inject CommerceService Commerce
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>My ShoppetCare | Overview</PageTitle>

<div class="msc-page">
    @if (!ready)
    {
        <div class="msc-loading">Loading My ShoppetCare...</div>
    }
    else if (Auth.IsGuest)
    {
        <main class="msc-shell">
            <section class="msc-panel access-panel">
                <span class="eyebrow">GUEST MODE</span>
                <h1>Open your Guest Dashboard.</h1>
                <p>Try one temporary pet profile, browse Marketplace and Clinics, and comment in Community before creating an account.</p>
                <a class="primary-link" href="/guest-dashboard">Open Guest Dashboard</a>
            </section>
        </main>
    }
    else if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
    {
        <main class="msc-shell">
            <section class="msc-panel access-panel">
                <span class="eyebrow">MY SHOPPETCARE</span>
                <h1>Sign in to open your pet-care hub.</h1>
                <p>Your pets, Digital Pet IDs, subscription status, marketplace access, and connected care summaries live here.</p>
                <a class="primary-link" href="/login">Sign In</a>
            </section>
        </main>
    }
    else
    {
<section class="msc-hero">
            <div class="msc-shell hero-inner">
                <div>
                    <span class="eyebrow light">MY SHOPPETCARE</span>
                    <h1>Welcome back, @FirstName.</h1>
                    <p>
                        Your web hub for Digital Pet IDs, pet-care summaries, local clinic discovery,
                        Community, Marketplace, and ShoppetCare subscriptions.
                    </p>
                </div>

                <div class="membership-card">
                    <span>MEMBERSHIP</span>
                    @if (premiumActive)
                    {
                        <strong><i class="bi bi-star-fill"></i> Premium Active</strong>
                        <small>Until @premiumExpiresAt?.ToString("MMM d, yyyy")</small>
                    }
                    else
                    {
                        <strong>Free Pet Owner</strong>
                        <small>Core ShoppetCare access</small>
                    }
                    <a href="/premium">Manage Premium</a>
                </div>
            </div>
        </section>

        <main class="msc-shell msc-content">
            <section class="metric-grid">
                <a href="/my-pets" class="metric-card">
                    <i class="bi bi-heart-fill"></i>
                    <span>Pet Profiles</span>
                    <strong>@pets.Count</strong>
                    <small>Connected pets</small>
                </a>

                <a href="/my-pets" class="metric-card">
                    <i class="bi bi-qr-code"></i>
                    <span>Digital Pet IDs</span>
                    <strong>@petIdCount</strong>
                    <small>Issued identities</small>
                </a>

                <div class="metric-card">
                    <i class="bi bi-heart-pulse-fill"></i>
                    <span>Synced Care Records</span>
                    <strong>@healthRecordCount</strong>
                    <small>Read from connected pet-care data</small>
                </div>

                <a href="/notifications" class="metric-card">
                    <i class="bi bi-bell-fill"></i>
                    <span>Notifications</span>
                    <strong>@unreadNotifications</strong>
                    <small>Unread updates</small>
                </a>
            </section>

            <div class="msc-main-grid">
                <section class="msc-panel">
                    <div class="panel-head">
                        <div>
                            <span class="eyebrow">YOUR PETS</span>
                            <h2>Pet identity &amp; care overview</h2>
                            <p>
                                Mobile remains the main pet-care management application. Web presents your connected pet identity
                                and selected vaccination or health summaries.
                            </p>
                        </div>
                        <a class="secondary-link" href="/my-pets">Open My Pets</a>
                    </div>

                    @if (pets.Count == 0)
                    {
                        <div class="empty-state">
                            <i class="bi bi-heart"></i>
                            <strong>No pet profiles yet.</strong>
                            <span>Add your first pet to start using a Digital Pet ID.</span>
                            <a class="primary-link" href="/my-pets">Add a Pet</a>
                        </div>
                    }
                    else
                    {
                        <div class="pet-list">
                            @foreach (var pet in pets.Take(4))
                            {
                                var recordCount = healthByPet.TryGetValue(pet.Id, out var count) ? count : 0;

                                <article class="pet-row">
                                    <div class="pet-avatar">@GetPetInitial(pet.PetName)</div>
                                    <div class="pet-copy">
                                        <strong>@pet.PetName</strong>
                                        <span>@pet.Species · @pet.Breed</span>
                                        <small>@recordCount connected care record@(recordCount == 1 ? "" : "s")</small>
                                    </div>
                                    <div class="pet-actions">
                                        <a href="@($"/pet/{pet.Id}")">Overview</a>
                                        <a href="@($"/pet/{pet.Id}/card")">Pet ID</a>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>

                <aside class="msc-panel account-panel">
                    <span class="eyebrow">ACCOUNT STATUS</span>
                    <h2>Your ShoppetCare access</h2>

                    <div class="status-row">
                        <div>
                            <strong>Premium</strong>
                            <span>@(premiumActive ? $"Active until {premiumExpiresAt:MMM d, yyyy}" : "Free plan")</span>
                        </div>
                        <a href="/premium">@(premiumActive ? "Manage" : "Upgrade")</a>
                    </div>

                    <div class="status-row">
                        <div>
                            <strong>Verified Seller</strong>
                            <span>@(sellerActive ? $"Active until {sellerExpiresAt:MMM d, yyyy}" : "Not active")</span>
                        </div>
                        <a href="@(sellerActive ? "/marketplace" : "/checkout/SellerSubscription")">
                            @(sellerActive ? "My Listings" : "Activate")
                        </a>
                    </div>

                    @if (Auth.IsClinicStaff && Auth.CurrentUser.ClinicId.HasValue)
                    {
                        <div class="status-row">
                            <div>
                                <strong>Clinic Access</strong>
                                <span>Clinic account linked</span>
                            </div>
                            <a href="/clinic-portal">Dashboard</a>
                        </div>
                    }

                    <a class="account-link" href="/account">
                        <i class="bi bi-person-circle"></i>
                        Account &amp; Profile
                    </a>
                </aside>
            </div>

            <section class="quick-grid">
                <a href="/clinics" class="quick-card">
                    <i class="bi bi-hospital"></i>
                    <strong>Verified Clinics</strong>
                    <span>Find local veterinary and pet-care providers.</span>
                </a>

                <a href="/marketplace" class="quick-card">
                    <i class="bi bi-bag-heart"></i>
                    <strong>Marketplace</strong>
                    <span>Browse pre-loved pet items or manage seller listings.</span>
                </a>

                <a href="/community" class="quick-card">
                    <i class="bi bi-people-fill"></i>
                    <strong>Community</strong>
                    <span>Share pet stories and manage your own posts.</span>
                </a>

                <a href="/announcements" class="quick-card">
                    <i class="bi bi-megaphone-fill"></i>
                    <strong>Announcements</strong>
                    <span>Read current ShoppetCare updates.</span>
                </a>
            </section>

            <section class="sync-note">
                <i class="bi bi-phone-fill"></i>
                <div>
                    <strong>Mobile is your main pet-care manager.</strong>
                    <span>
                        Vaccinations, health or medical records, Food Tracker, weight and care details are primarily managed
                        in the ShoppetCare Mobile application. The Web application retrieves selected information for summaries,
                        Digital Pet ID views, and eligible Premium features.
                    </span>
                </div>
            </section>
        </main>
    }
</div>

<style>
