@code {

    private string userName = "Pet Owner";
    private string userEmail = string.Empty;
    private string userRole = "Pet Owner";

    private string message = string.Empty;
    private bool messageIsError;

    private bool isCheckingAuth = true;
    private bool isAuthenticated;

    private bool showPetForm;
    private bool isEditingPet;
    private bool isSavingPet;
    private bool showUpgradePrompt;

    private List<PetProfile> pets = new();
    private List<ClinicAppointment> appointments = new();
    private List<ClinicTenant> clinics = new();

    private int inquiryCount;

    private PetProfile petForm = new();

    private string selectedWeight = string.Empty;

    private string profilePhotoPreview = string.Empty;

    private string petPhotoPreview = string.Empty;
    private string selectedPetFileName = string.Empty;

    private IBrowserFile? selectedPetFile;


    // =========================================================
    // BREEDS
    // =========================================================

    private readonly Dictionary<string, List<string>> breedOptions =
        new()
        {
            ["Dog"] = new()
            {
                "Shih Tzu",
                "Labrador Retriever",
                "Golden Retriever",
                "Pomeranian",
                "Beagle",
                "Aspins / Mixed Breed",
                "Other Dog Breed"
            },

            ["Cat"] = new()
            {
                "Persian",
                "Siamese",
                "British Shorthair",
                "Domestic Shorthair",
                "Puspin / Mixed Breed",
                "Other Cat Breed"
            },

            ["Rabbit"] = new()
            {
                "Holland Lop",
                "Lionhead",
                "Netherland Dwarf",
                "Mixed Breed Rabbit",
                "Other Rabbit Breed"
            },

            ["Bird"] = new()
            {
                "Parakeet",
                "Lovebird",
                "Cockatiel",
                "African Grey",
                "Other Bird"
            },

            ["Other"] = new()
            {
                "Other"
            }
        };


    private IEnumerable<string> CurrentBreeds =>
        breedOptions.TryGetValue(
            petForm.Species ?? "Dog",
            out var breeds)
            ? breeds
            : breedOptions["Other"];


    // =========================================================
    // INITIAL LOAD
    // =========================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!Auth.IsLoggedIn || Auth.CurrentUser is null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // 🎯 Redirect admins to their portal
        if (Auth.IsAdmin)
        {
            Nav.NavigateTo("/admin-portal", replace: true);
            return;
        }

        // 🎯 Redirect clinic staff to their portal
        if (Auth.IsClinicStaff)
        {
            Nav.NavigateTo("/clinic-portal", replace: true);
            return;
        }

        isAuthenticated = true;
        isCheckingAuth = false;

        LoadData();

        // Load saved profile photo from wwwroot/uploads/users.
        profilePhotoPreview =
            FileStorage.GetImageUrl(
                "users",
                Auth.CurrentUser.Id)
            ?? string.Empty;

        await InvokeAsync(StateHasChanged);
    }


    private void LoadData()
    {
        if (Auth.CurrentUser is null)
            return;

        var user = Auth.CurrentUser;

        userName =
            user.FullName ?? "Pet Owner";

        userEmail =
            user.Email ?? string.Empty;

        userRole =
            string.IsNullOrWhiteSpace(user.Role)
                ? "Pet Owner"
                : user.Role;

        pets =
            DbService.GetPetsByUser(user.Id);

        inquiryCount =
            DbService.GetInquiryCountByUser(user.Id);

        appointments =
            DbService.GetAppointments(userId: user.Id)
                .Where(a =>
                    a.AppointmentDate >= DateTime.Now)
                .OrderBy(a =>
                    a.AppointmentDate)
                .ToList();

        clinics =
            DbService.GetAllClinics()
            ?? new List<ClinicTenant>();
    }


    // =========================================================
    // PROFILE PHOTO
    // =========================================================

    private async Task HandleProfilePhotoSelected(
        InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file is null || Auth.CurrentUser is null)
            return;

        if (!IsValidImage(file))
        {
            ShowError(
                "Please choose a JPG, PNG, or WEBP image up to 5 MB.");

            return;
        }

        try
        {
            // Show immediate preview.
            profilePhotoPreview =
                await CreatePreview(file);

            await InvokeAsync(StateHasChanged);

            // Persist the image.
            var savedUrl =
                await FileStorage.SaveImageAsync(
                    "users",
                    Auth.CurrentUser.Id,
                    file);

            // Use the actual saved file URL.
            profilePhotoPreview =
                savedUrl;

            ShowSuccess(
                "Profile photo saved successfully.");

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Profile Photo Error] {ex}");

            ShowError(
                $"The profile photo could not be saved. {ex.Message}");

            await InvokeAsync(StateHasChanged);
        }
    }


    private string GetUserInitials()
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "U";

        var parts =
            userName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(
                    0,
                    Math.Min(
                        2,
                        parts[0].Length))
                .ToUpperInvariant();
        }

        return (
            parts[0].Substring(0, 1) +
            parts[^1].Substring(0, 1)
        ).ToUpperInvariant();
    }


    // =========================================================
    // ADD PET
    // =========================================================

    private void OpenAddPetForm()
    {
        message = string.Empty;
        messageIsError = false;
        showUpgradePrompt = false;
        isEditingPet = false;
        isSavingPet = false;

        petForm =
            new PetProfile
            {
                Species = "Dog",
                Breed = "Shih Tzu"
            };

        selectedWeight =
            string.Empty;

        selectedPetFile =
            null;

        petPhotoPreview =
            string.Empty;

        selectedPetFileName =
            string.Empty;

        showPetForm = true;
    }


    // =========================================================
    // EDIT PET
    // =========================================================

    private void OpenEditPetForm(PetProfile pet)
    {
        message = string.Empty;
        messageIsError = false;

        isEditingPet = true;
        isSavingPet = false;

        petForm =
            new PetProfile
            {
                Id = pet.Id,
                UserId = pet.UserId,
                PetName = pet.PetName,
                Species = pet.Species,
                Breed = pet.Breed,
                Age = pet.Age,
                WeightKg = pet.WeightKg,
                Diet = pet.Diet,
                CreatedAt = pet.CreatedAt
            };

        selectedWeight =
            pet.WeightKg.HasValue
                ? pet.WeightKg.Value.ToString("0")
                : string.Empty;

        selectedPetFile =
            null;

        selectedPetFileName =
            string.Empty;

        petPhotoPreview =
            FileStorage.GetImageUrl(
                "pets",
                pet.Id)
            ?? string.Empty;

        showPetForm = true;
    }


    private void SpeciesChanged()
    {
        petForm.Breed =
            CurrentBreeds.FirstOrDefault()
            ?? "Other";
    }


    private void ClosePetForm()
    {
        if (isSavingPet)
            return;

        showPetForm = false;
        isEditingPet = false;

        selectedPetFile =
            null;

        selectedPetFileName =
            string.Empty;

        petPhotoPreview =
            string.Empty;

        petForm =
            new PetProfile();

        selectedWeight =
            string.Empty;
    }


    // =========================================================
    // PET PHOTO
    // =========================================================

    private async Task HandlePetPhotoSelected(
        InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file is null)
            return;

        if (!IsValidImage(file))
        {
            ShowError(
                "Please choose a JPG, PNG, or WEBP image up to 5 MB.");

            return;
        }

        try
        {
            // IMPORTANT:
            // Keep the IBrowserFile so SavePet()
            // can actually save it to disk.
            selectedPetFile =
                file;

            selectedPetFileName =
                file.Name;

            // Immediate browser preview.
            petPhotoPreview =
                await CreatePreview(file);

            ShowSuccess(
                "Pet photo selected. Click Save Pet to upload it.");

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Pet Photo Error] {ex}");

            ShowError(
                "The pet photo could not be loaded.");
        }
    }


    private static bool IsValidImage(
        IBrowserFile file)
    {
        const long maxSize =
            5 * 1024 * 1024;

        var allowedTypes =
            new[]
            {
                "image/jpeg",
                "image/png",
                "image/webp"
            };

        return file.Size <= maxSize
            && allowedTypes.Contains(
                file.ContentType,
                StringComparer.OrdinalIgnoreCase);
    }


    private static async Task<string> CreatePreview(
        IBrowserFile file)
    {
        const long maxSize =
            5 * 1024 * 1024;

        await using var stream =
            file.OpenReadStream(maxSize);

        using var memory =
            new MemoryStream();

        await stream.CopyToAsync(memory);

        return
            $"data:{file.ContentType};base64," +
            Convert.ToBase64String(
                memory.ToArray());
    }


    // =========================================================
    // SAVE PET
    // =========================================================

    private async Task SavePet()
    {
        // Prevent double-click / duplicate records.
        if (isSavingPet)
            return;

        message = string.Empty;
        messageIsError = false;

        if (Auth.CurrentUser is null)
        {
            ShowError(
                "Your session has expired. Please log in again.");

            return;
        }

        if (string.IsNullOrWhiteSpace(petForm.PetName))
        {
            ShowError(
                "Please enter your pet's name.");

            return;
        }

        isSavingPet = true;

        // Store this BEFORE changing isEditingPet.
        bool wasEditing =
            isEditingPet;

        try
        {
            petForm.UserId =
                Auth.CurrentUser.Id;

            // Convert selected weight.
            if (decimal.TryParse(
                selectedWeight,
                out var weight))
            {
                petForm.WeightKg =
                    weight;
            }
            else
            {
                petForm.WeightKg =
                    null;
            }


            int petId;


            // =================================================
            // UPDATE EXISTING PET
            // =================================================

            if (wasEditing)
            {
                bool updated =
                    DbService.UpdatePet(
                        petForm);

                if (!updated)
                {
                    ShowError(
                        "The pet could not be updated. Please try again.");

                    return;
                }

                petId =
                    petForm.Id;
            }


            // =================================================
            // ADD NEW PET
            // =================================================

            else
            {
                petId =
                    DbService.AddPet(
                        petForm);
            }


            // =================================================
            // SAVE PET PHOTO
            // =================================================

            if (selectedPetFile is not null)
            {
                await FileStorage.SaveImageAsync(
                    "pets",
                    petId,
                    selectedPetFile);
            }


            var savedName =
                petForm.PetName;


            // =================================================
            // RESET FORM
            // =================================================

            showPetForm = false;
            isEditingPet = false;

            petForm =
                new PetProfile();

            selectedWeight =
                string.Empty;

            selectedPetFile =
                null;

            selectedPetFileName =
                string.Empty;

            petPhotoPreview =
                string.Empty;


            // Reload actual database data.
            LoadData();


            // Correct message depending on operation.
            if (wasEditing)
            {
                ShowSuccess(
                    $"{savedName} was updated successfully.");
            }
            else
            {
                ShowSuccess(
                    $"{savedName} was saved successfully.");
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException ex)
        {
            // Premium paywall hit — show upgrade prompt
            Console.WriteLine($"[Dashboard SavePet Error] {ex}");

            message = ex.Message;
            messageIsError = true;
            showUpgradePrompt = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard SavePet Error] {ex}");
            ShowError("Something went wrong. Please try again.");
        }
        finally
        {
            isSavingPet = false;
        }
    }


    // =========================================================
    // DELETE PET
    // =========================================================

    private void DeletePet(
        PetProfile pet)
    {
        if (isSavingPet)
            return;

        message = string.Empty;
        messageIsError = false;

        if (Auth.CurrentUser is null)
        {
            ShowError(
                "Your session has expired. Please log in again.");

            return;
        }

        try
        {
            bool deleted =
                DbService.DeletePet(
                    pet.Id,
                    Auth.CurrentUser.Id);

            if (!deleted)
            {
                ShowError(
                    "The pet could not be deleted.");

                return;
            }


            // Delete the corresponding image file.
            FileStorage.DeleteImage(
                "pets",
                pet.Id);


            // Close the edit form if this pet
            // was currently being edited.
            if (petForm.Id == pet.Id)
            {
                ClosePetForm();
            }


            // Reload from SQL Server.
            LoadData();

            ShowSuccess(
                $"{pet.PetName} was deleted successfully.");
        }
        catch (Exception ex)
        {
            // Do NOT use SqlException here.
            // Dashboard does not need Microsoft.Data.SqlClient.
            Console.WriteLine(
                $"[Dashboard DeletePet Error] {ex}");

            ShowError(
                $"The pet could not be deleted. {ex.Message}");
        }
    }


    // =========================================================
    // PET PHOTO DISPLAY
    // =========================================================

    private string GetPetPhoto(
        int petId)
    {
        return
            FileStorage.GetImageUrl(
                "pets",
                petId)
            ?? string.Empty;
    }


    private static string GetPetInitial(
        PetProfile pet)
    {
        if (string.IsNullOrWhiteSpace(
            pet.PetName))
        {
            return "P";
        }

        return pet.PetName
            .Substring(0, 1)
            .ToUpperInvariant();
    }


    // =========================================================
    // APPOINTMENTS
    // =========================================================

    private string GetClinicName(
        int clinicId)
    {
        return clinics
            .FirstOrDefault(
                c => c.Id == clinicId)
            ?.ClinicName
            ?? "Clinic";
    }


    private void CancelAppointment(
        int appointmentId)
    {
        try
        {
            DbService.CancelAppointment(
