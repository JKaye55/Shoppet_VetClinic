    .quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}.quick-card{padding:18px;border:1px solid #DDE7E4;border-radius:16px;background:#fff;color:#1E2D27;text-decoration:none}.quick-card i{color:#2F9098}.quick-card strong,.quick-card span{display:block}.quick-card strong{margin-top:12px}.quick-card span{margin-top:4px;color:#7A8782;font-size:.68rem;line-height:1.45}.sync-note{margin-top:18px;padding:18px;border:1px solid #D6E5E1;border-radius:16px;background:#EEF6F4;display:flex;gap:12px}.sync-note i{font-size:1.4rem;color:#267C83}.sync-note strong,.sync-note span{display:block}.sync-note span{margin-top:4px;color:#5F6F69;font-size:.72rem;line-height:1.55}.access-panel{max-width:720px;margin:70px auto}.access-panel h1{font-size:2.4rem}
