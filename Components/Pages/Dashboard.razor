@page "/dashboard"
@rendermode InteractiveServer
@inject AuthService Auth
<main class="owner-shell"><header class="owner-header"><span class="owner-eyebrow">MY SHOPPETCARE</span><h1>A little care goes a long way.</h1><p>Your pets, your community, your next good find.</p></header>@if(!ready){<p>Loading account…</p>}else if(!Auth.IsPetOwner){<a href="/login">Sign in with your Pet Owner account.</a>}else{<p class="owner-notice">Welcome, @Auth.CurrentUser?.FullName · @(Auth.IsPremium?"Lifetime Premium":"Free account")</p><div class="owner-grid">@foreach(var x in links){<a class="owner-card" href="@x.Url" style="text-decoration:none;color:inherit"><h2>@x.Title →</h2><p>@x.Text</p></a>}</div>}</main>
@code {bool ready;readonly (string Title,string Text,string Url)[] links={ ("My pets","Health records, feeding, and Digital Pet IDs.","/my-pets"),("Marketplace","Buy and sell pre-loved pet essentials.","/marketplace"),("Messages","Keep conversations connected across devices.","/messages"),("Community","Share photos and connect with pet owners.","/community"),("Contacts & care","Emergency contacts, vet reminders, and privacy settings.","/account/care"),("Orders","Purchases, sales, reviews, and rewards.","/marketplace/orders")};protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();ready=true;StateHasChanged();}}
