@page "/dashboard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services
@inject FileStorageService FileStorage
@inject DatabaseService DbService
@inject AuthService Auth
@inject NavigationManager Nav

<div class="dashboard-page">

    @if (isCheckingAuth)
    {
        <div class="container-xl py-5">
            <div class="loading-card">
                Loading your dashboard...
            </div>
        </div>
    }
    else if (isAuthenticated)
    {
        <main class="container-xl py-5">

            @if (!string.IsNullOrWhiteSpace(message) && !showUpgradePrompt)
            {
                <div class="alert @(messageIsError ? "alert-danger" : "alert-success")
                    rounded-4 border-0 shadow-sm mb-4">
                    @message
                </div>
            }
            @if (showUpgradePrompt)
            {
                <div class="alert alert-warning rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3">
                    <div>
                        <strong>Free plan limit reached</strong><br />
                        <span class="small">
                            Upgrade to Pet ID Virtual Card Premium for unlimited pets
                            and unlimited health records.
                        </span>
                    </div>
                    <a href="/premium" class="btn btn-warning rounded-pill fw-bold px-4">
                        <i class="bi bi-star-fill"></i> Upgrade for ₱49
                    </a>
                </div>
            }

            <!-- =====================================================
                 PROFILE HEADER
                 ===================================================== -->

            <section class="profile-card mb-4">

                <div class="profile-photo-area">

                    @if (!string.IsNullOrWhiteSpace(profilePhotoPreview))
                    {
                        <img src="@profilePhotoPreview"
                             class="profile-photo"
                             alt="Profile photo" />
                    }
                    else
                    {
                        <div class="profile-photo-placeholder">
                            @GetUserInitials()
                        </div>
                    }

                    <label class="photo-upload-button">
                        Change Photo

                        <InputFile OnChange="HandleProfilePhotoSelected"
                                   accept="image/png,image/jpeg,image/webp"
                                   class="file-input-hidden" />
                    </label>

                </div>

                <div class="profile-information">

                    <span class="eyebrow">
                        MY ACCOUNT
                    </span>

                    <h1>
                        Welcome, @userName
                    </h1>

                    <p>
                        @userEmail
                    </p>

                    <span class="account-role">
                        @userRole
                    </span>

                </div>

                <div class="profile-actions">

                    <a href="/inquire"
                       class="primary-action">
                        New Inquiry
                    </a>

                    <a href="/clinics"
                       class="secondary-action">
                        Find a Clinic
                    </a>

                </div>

            </section>


            <!-- =====================================================
                 STATISTICS
                 ===================================================== -->

            <div class="row g-4 mb-4">

                <div class="col-md-4">

                    <div class="stat-card">

                        <span>MY PETS</span>

                        <strong>
                            @pets.Count
                        </strong>

                        <small>
                            Saved pet profiles
                        </small>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="stat-card">

                        <span>MY INQUIRIES</span>

                        <strong>
                            @inquiryCount
                        </strong>

                        <small>
                            Front-desk requests
                        </small>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="stat-card">

                        <span>UPCOMING APPOINTMENTS</span>

                        <strong>
                            @appointments.Count
                        </strong>

                        <small>
                            Scheduled clinic visits
                        </small>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <div class="row g-4">

                <!-- =================================================
                     PET PROFILES
                     ================================================= -->

                <div class="col-lg-7">

                    <section class="panel-card h-100">

                        <div class="panel-header">

                            <div>

                                <span class="section-label">
                                    PET MANAGEMENT
                                </span>

                                <h2>
                                    My Pet Profiles
                                </h2>

                                <p>
                                    Save your pets once so you can easily select them
                                    for inquiries and appointments.
                                </p>

                            </div>

                            <button type="button"
                                    class="outline-action"
                                    @onclick="OpenAddPetForm">

                                Add Pet

                            </button>

                        </div>


                        <!-- =================================================
                             PET FORM
                             ================================================= -->
                        @if (showPetForm)
                        {
                            <div class="pet-form">

                                <div class="form-top">

                                    <div>

                                        <div class="form-section-title">
                                            @(isEditingPet
                                                ? "Edit Pet Profile"
                                                : "New Pet Profile")
                                        </div>

                                        <div class="form-section-subtitle">
                                            Add your pet's information and photo.
                                        </div>

                                    </div>

                                </div>


                                <!-- PET PHOTO -->

                                <div class="pet-photo-section">

                                    <div class="pet-photo-preview">

                                        @if (!string.IsNullOrWhiteSpace(petPhotoPreview))
                                        {
                                            <img src="@petPhotoPreview"
                                                 alt="Pet photo"
                                                 class="pet-photo" />
                                        }
                                        else
                                        {
                                            <div class="pet-photo-placeholder">
                                                Pet Photo
                                            </div>
                                        }

                                    </div>

                                    <div class="pet-photo-controls">

                                        <strong>
                                            Pet Photo
                                        </strong>

                                        <span>
                                            Add a clear photo of your pet.
                                        </span>

                                        <label class="upload-photo-button">

                                            Choose Photo

                                            <InputFile OnChange="HandlePetPhotoSelected"
                                                       accept="image/png,image/jpeg,image/webp"
                                                       class="file-input-hidden" />

                                        </label>

                                        @if (!string.IsNullOrWhiteSpace(selectedPetFileName))
                                        {
                                            <small>
                                                @selectedPetFileName
                                            </small>
                                        }

                                    </div>

                                </div>


                                <!-- PET DETAILS -->

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label>
                                            Pet Name
                                        </label>

                                        <input class="form-control"
                                               @bind="petForm.PetName"
                                               placeholder="e.g. Beba" />

                                    </div>


                                    <div class="col-md-6">

                                        <label>
                                            Species
                                        </label>

                                        <select class="form-select"
                                                @bind="petForm.Species"
                                                @bind:after="SpeciesChanged">

                                            <option value="Dog">
                                                Dog
                                            </option>

                                            <option value="Cat">
                                                Cat
                                            </option>

                                            <option value="Rabbit">
                                                Rabbit
                                            </option>

                                            <option value="Bird">
                                                Bird
                                            </option>

                                            <option value="Other">
                                                Other
                                            </option>

                                        </select>

                                    </div>


                                    <div class="col-md-6">

                                        <label>
                                            Breed
                                        </label>

                                        <select class="form-select"
                                                @bind="petForm.Breed">

                                            @foreach (var breed in CurrentBreeds)
                                            {
                                                <option value="@breed">
                                                    @breed
                                                </option>
                                            }

                                        </select>

                                    </div>


                                    <div class="col-md-6">

                                        <label>
                                            Age
                                        </label>

                                        <select class="form-select"
                                                @bind="petForm.Age">

                                            <option value="">
                                                Select age
                                            </option>

                                            <option>
                                                Under 1 year
                                            </option>

                                            <option>
                                                1 year
                                            </option>

                                            <option>
                                                2 years
                                            </option>

                                            <option>
                                                3 years
                                            </option>

                                            <option>
                                                4 years
                                            </option>

                                            <option>
                                                5 years
                                            </option>

                                            <option>
                                                6–8 years
                                            </option>

                                            <option>
                                                9–12 years
                                            </option>

                                            <option>
                                                13+ years
                                            </option>

                                        </select>

                                    </div>


                                    <div class="col-md-6">

                                        <label>
                                            Weight
                                        </label>

                                        <select class="form-select"
                                                @bind="selectedWeight">

                                            <option value="">
                                                Not set
                                            </option>

                                            @for (decimal kg = 1; kg <= 30; kg++)
                                            {
                                                <option value="@kg">
                                                    @kg.ToString("0") kg
                                                </option>
                                            }

                                        </select>

                                    </div>


                                    <div class="col-md-6">

                                        <label>
                                            Diet
                                        </label>

                                        <select class="form-select"
                                                @bind="petForm.Diet">

                                            <option value="">
                                                Not specified
                                            </option>

                                            <option>
                                                Regular Pet Food
                                            </option>

                                            <option>
                                                Royal Canin
                                            </option>

                                            <option>
                                                Hill's
                                            </option>

                                            <option>
                                                Purina
                                            </option>

                                            <option>
                                                Special / Prescription Diet
                                            </option>

                                        </select>

                                    </div>

                                </div>


                                <!-- FORM BUTTONS -->

                                <div class="form-actions">

                                    <button type="button"
                                            class="save-action"
                                            @onclick="SavePet"
                                            disabled="@isSavingPet">

                                        @(isSavingPet
                                            ? "Saving..."
                                            : isEditingPet
                                                ? "Update Pet"
                                                : "Save Pet")

                                    </button>

                                    <button type="button"
                                            class="cancel-action"
                                            @onclick="ClosePetForm"
                                            disabled="@isSavingPet">

                                        Cancel

                                    </button>

                                </div>

                            </div>
                        }


                        <!-- =================================================
                             PET LIST
                             ================================================= -->
                        @if (pets.Count == 0)
                        {
                            <div class="empty-box">

                                <strong>
                                    No saved pets yet.
                                </strong>

                                <span>
                                    Add your first pet above.
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="pet-list">

                                @foreach (var pet in pets)
                                {
                                    <div class="pet-row">

                                        <div class="pet-row-left">

                                            <div class="pet-list-photo">

                                                @{
                                                    var photoUrl = GetPetPhoto(pet.Id);
                                                }

                                                @if (!string.IsNullOrWhiteSpace(photoUrl))
                                                {
                                                    <img src="@photoUrl"
                                                         alt="@pet.PetName" />
                                                }
                                                else
                                                {
                                                    <span>
                                                        @GetPetInitial(pet)
                                                    </span>
                                                }

                                            </div>


                                            <div class="pet-details">

                                                <strong>
                                                    @pet.PetName
                                                </strong>

                                                <span>
                                                    @pet.Species · @pet.Breed
                                                </span>

                                                <small>

                                                    @(string.IsNullOrWhiteSpace(pet.Age)
                                                        ? "Age not set"
                                                        : pet.Age)

                                                    ·

                                                    @(pet.WeightKg.HasValue
                                                        ? $"{pet.WeightKg:0.#} kg"
                                                        : "Weight not set")

                                                    ·

                                                    @(string.IsNullOrWhiteSpace(pet.Diet)
                                                        ? "Diet not set"
                                                        : pet.Diet)

                                                </small>

                                            </div>

                                        </div>


                                        <div class="pet-row-actions">

                                            <button type="button"
                                                    class="edit-pet-button"
                                                    @onclick="() => OpenEditPetForm(pet)"
                                                    disabled="@isSavingPet">

                                                Edit

                                            </button>

                                            <button type="button"
                                                    class="delete-pet-button"
                                                    @onclick="() => DeletePet(pet)"
                                                    disabled="@isSavingPet">

                                                Delete

                                            </button>

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </section>

                </div>


                <!-- =================================================
                     APPOINTMENTS
                     ================================================= -->

                <div class="col-lg-5">

                    <section class="panel-card h-100">

                        <div class="panel-header">

                            <div>

                                <span class="section-label">
                                    SCHEDULE
                                </span>

                                <h2>
                                    Upcoming Appointments
                                </h2>

                                <p>
                                    Your scheduled clinic visits and selected time slots.
                                </p>

                            </div>

                            <a href="/clinics"
                               class="outline-action text-decoration-none">

                                Book

                            </a>

                        </div>


                        @if (appointments.Count == 0)
                        {
                            <div class="empty-box">

                                <strong>
                                    No appointments scheduled.
                                </strong>

                                <span>
                                    Choose a clinic, pet, service, date, and available time.
                                </span>

                                <a href="/clinics"
                                   class="empty-action">

                                    Find Available Clinics

                                </a>

                            </div>
                        }
                        else
                        {
                            <div class="appointment-list">

                                @foreach (var appointment in appointments)
                                {
                                    <div class="appointment-row">

                                        <div class="appointment-date">

                                            <strong>
                                                @appointment.AppointmentDate.ToString("dd")
                                            </strong>

                                            <span>
                                                @appointment.AppointmentDate.ToString("MMM")
                                            </span>

                                        </div>


                                        <div class="appointment-info">

                                            <strong>
                                                @appointment.ServiceType
                                            </strong>

                                            <span>
                                                @appointment.PetName
                                            </span>

                                            <small>
                                                @GetClinicName(appointment.ClinicId)
                                            </small>

                                            <small>
                                                @appointment.AppointmentDate.ToString(
                                                    "dddd, MMM d, yyyy · h:mm tt")
                                            </small>

                                        </div>


                                        <button type="button"
                                                class="cancel-link"
                                                @onclick="() => CancelAppointment(appointment.Id)">

                                            Cancel

                                        </button>

                                    </div>
                                }

                            </div>
                        }

                    </section>

                </div>

            </div>

        </main>
    }

</div>


<style>

    .dashboard-page {
        min-height: 100vh;
        background: #FAF8F5;
        color: #1E2824;
    }

    .loading-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        text-align: center;
        box-shadow: 0 12px 35px rgba(30,40,36,.07);
    }

    .profile-card {
        display: flex;
        align-items: center;
        gap: 24px;
        background: white;
        border: 1px solid #E5E9E6;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(30,40,36,.05);
    }

    .profile-photo-area {
        width: 108px;
        flex-shrink: 0;
        text-align: center;
    }

    .profile-photo,
    .profile-photo-placeholder {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
    }

    .profile-photo-placeholder {
        background: #1E2D27;
        color: white;
        font-size: 1.5rem;
        font-weight: 850;
    }

    .photo-upload-button {
        display: inline-flex;
        margin-top: 9px;
        cursor: pointer;
        background: #EEF4F1;
        color: #3F6256;
        border-radius: 999px;
        padding: 6px 11px;
        font-size: .68rem;
        font-weight: 800;
    }

    .file-input-hidden {
        display: none;
    }

    .profile-information {
        flex: 1;
    }

    .eyebrow,
    .section-label {
        color: #5C766D;
        font-size: .7rem;
        font-weight: 850;
        letter-spacing: .13em;
    }

    .profile-information h1 {
        margin: 5px 0 5px;
        font-size: clamp(1.7rem, 3vw, 2.4rem);
        font-weight: 850;
        letter-spacing: -.04em;
    }

    .profile-information p {
        margin: 0;
        color: #7C8782;
        font-size: .85rem;
    }

    .account-role {
        display: inline-block;
        margin-top: 8px;
        padding: 5px 10px;
        border-radius: 999px;
        background: #EEF4F1;
        color: #3F6256;
        font-size: .67rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .profile-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .primary-action,
    .save-action {
        border: 0;
        background: #F7DD7D;
        color: #2F423B;
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 850;
        text-decoration: none;
        cursor: pointer;
    }

        .primary-action:hover,
        .save-action:hover {
            background: #F2D257;
            color: #2F423B;
        }

        .save-action:disabled,
        .cancel-action:disabled,
        .edit-pet-button:disabled,
        .delete-pet-button:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .secondary-action {
        border: 1px solid #CBD6D1;
        background: white;
        color: #456157;
        border-radius: 999px;
        padding: 11px 18px;
        font-weight: 800;
        text-decoration: none;
    }

        .secondary-action:hover {
            background: #EEF4F1;
            color: #1E2D27;
        }

    .stat-card {
        background: white;
        border: 1px solid #E5E9E6;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(30,40,36,.05);
    }

        .stat-card span {
            display: block;
            color: #7C8782;
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .stat-card strong {
            display: block;
            color: #1E2824;
            font-size: 2.5rem;
            line-height: 1.1;
            margin: 8px 0 4px;
        }

        .stat-card small {
            color: #68746F;
        }

    .panel-card {
        background: white;
        border: 1px solid #E5E9E6;
        border-radius: 22px;
        padding: 26px;
        box-shadow: 0 10px 30px rgba(30,40,36,.05);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 15px;
        margin-bottom: 20px;
    }

        .panel-header h2 {
            margin: 4px 0;
            font-size: 1.35rem;
            font-weight: 850;
        }

        .panel-header p {
            margin: 0;
            color: #7C8782;
            font-size: .82rem;
        }

    .outline-action {
        border: 1px solid #AAB8B2;
        background: white;
        color: #456157;
        border-radius: 999px;
        padding: 8px 15px;
        font-weight: 750;
        white-space: nowrap;
        cursor: pointer;
    }

        .outline-action:hover {
            background: #EEF4F1;
            color: #1E2D27;
        }

    .pet-form {
        background: #EEF4F1;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 18px;
    }

    .form-top {
        margin-bottom: 18px;
    }

    .form-section-title {
        font-weight: 850;
        color: #1E2D27;
    }

    .form-section-subtitle {
        color: #74817B;
        font-size: .78rem;
        margin-top: 3px;
    }

    .pet-form label {
        display: block;
        font-size: .72rem;
        font-weight: 800;
        margin-bottom: 6px;
        color: #4F5D57;
    }

    .pet-form .form-control,
    .pet-form .form-select {
        min-height: 44px;
        border-radius: 11px;
        border: 1px solid #D9E1DD;
    }

    .pet-photo-section {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 15px;
        background: white;
        border: 1px solid #DDE6E1;
