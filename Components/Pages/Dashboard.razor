            ShowSuccess(
                "Appointment cancelled.");

            LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[Dashboard CancelAppointment Error] {ex}");

            ShowError(
                "The appointment could not be cancelled.");
        }
    }


    // =========================================================
    // MESSAGES
    // =========================================================

    private void ShowSuccess(
        string text)
    {
        message = text;
        messageIsError = false;
    }


    private void ShowError(
        string text)
    {
        message = text;
        messageIsError = true;
    }
}