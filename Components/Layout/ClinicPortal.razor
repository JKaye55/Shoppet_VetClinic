@rendermode InteractiveServer

@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject DatabaseService Db
@inject CommerceService Commerce
@inject NavigationManager Nav

<PageTitle>Clinic Dashboard | ShoppetCare</PageTitle>

<div class="clinic-dashboard-page">
    @if (!ready)
    {
        <div class="clinic-state">Loading clinic dashboard...</div>
    }
    else if (!Auth.IsLoggedIn || Auth.CurrentUser is null || !Auth.IsClinicStaff)
    {
        <main class="clinic-shell">
            <section class="clinic-panel access-panel">
                <span class="eyebrow">CLINIC ACCESS</span>
                <h1>Clinic Owner access required.</h1>
                <p>
                    This dashboard is available after a clinic claim is reviewed and approved by the ShoppetCare Super Admin.
                </p>
                <div class="action-row">
                    <a class="primary-link" href="/clinics">Find Your Clinic</a>
                    <a class="secondary-link" href="/list-your-clinic">List Your Clinic</a>
                </div>
            </section>
        </main>
    }
    else if (clinic is null)
    {
        <main class="clinic-shell">
            <section class="clinic-panel access-panel">
                <span class="eyebrow">CLINIC ACCESS</span>
                <h1>No clinic is linked to this account yet.</h1>
                <p>Submit a clinic claim from the directory or request a missing clinic listing.</p>
                <div class="action-row">
                    <a class="primary-link" href="/clinics">Browse Clinics</a>
                    <a class="secondary-link" href="/list-your-clinic">Request Listing</a>
                </div>
            </section>
        </main>
    }
    else
    {
        <header class="clinic-hero">
            <div class="clinic-shell clinic-hero-inner">
                <div>
                    <span class="eyebrow light">CLINIC OWNER DASHBOARD</span>
                    <h1>@clinic.ClinicName</h1>
                    <p>@clinic.Address</p>
                </div>

                <div class="clinic-status-card @(verifiedActive ? "active" : "")">
                    <span>@(verifiedActive ? "VERIFIED CLINIC" : "LISTED CLINIC")</span>
                    <strong>@(verifiedActive ? "Subscription Active" : "Verification Inactive")</strong>
                    <small>
                        @(verifiedActive
                            ? $"Active until {clinicSubscription?.ExpiresAt:MMM d, yyyy}"
                            : "Activate Verified Clinic for ₱50/month")
                    </small>
                </div>
            </div>
        </header>

        <main class="clinic-shell clinic-content">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="status-message @(isError ? "error" : "success")">@message</div>
            }

            <section class="clinic-overview-grid">
                <article class="metric">
                    <span>Listing Status</span>
                    <strong>Listed</strong>
                    <small>Visible in the public directory</small>
                </article>
                <article class="metric">
                    <span>Verification</span>
                    <strong>@(verifiedActive ? "Active" : "Inactive")</strong>
                    <small>@(verifiedActive ? "Verified badge displayed" : "No verified badge")</small>
                </article>
                <article class="metric">
                    <span>Services</span>
                    <strong>@Services.Count</strong>
                    <small>Public service capabilities</small>
                </article>
                <article class="metric">
                    <span>Account Role</span>
                    <strong>@Auth.CurrentUser.Role</strong>
                    <small>Linked clinic representative</small>
                </article>
            </section>

            <div class="clinic-main-grid">
                <section class="clinic-panel">
                    <div class="panel-head">
                        <div>
                            <span class="eyebrow">CLINIC PROFILE</span>
                            <h2>Public listing information</h2>
                        </div>
                        @if (!editingProfile)
                        {
                            <button class="outline-btn" @onclick="BeginEditProfile">Edit Profile</button>
                        }
                    </div>

                    @if (editingProfile)
                    {
                        <div class="form-grid">
                            <div class="field full">
                                <label>Clinic Name</label>
                                <input value="@clinic.ClinicName" disabled />
                                <small>Clinic name changes are locked to protect listing identity.</small>
                            </div>
                            <div class="field">
                                <label>Branch / City</label>
                                <input maxlength="120" @bind="editClinic.Branch" />
                            </div>
                            <div class="field">
                                <label>Facility Type</label>
                                <input maxlength="120" @bind="editClinic.FacilityType" />
                            </div>
                            <div class="field full">
                                <label>Address</label>
                                <input maxlength="250" @bind="editClinic.Address" />
                            </div>
                            <div class="field">
                                <label>Contact Number</label>
                                <input maxlength="50" @bind="editClinic.ContactPhone" />
                            </div>
                            <div class="field">
                                <label>Operating Hours</label>
                                <input maxlength="150" @bind="editClinic.OperatingHours" />
                            </div>
                            <div class="field full">
                                <label>Brands / Diets Carried</label>
                                <input maxlength="500" @bind="editClinic.BrandsCarried" />
                            </div>
                            <div class="field full">
                                <label>Messenger / Contact URL</label>
                                <input maxlength="500" @bind="editClinic.MessengerUrl" />
                            </div>
                        </div>

                        <div class="action-row">
                            <button class="primary-btn" @onclick="SaveProfile">Save Profile</button>
                            <button class="secondary-btn" @onclick="CancelEditProfile">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="profile-view">
                            <div><span>Branch / City</span><strong>@Display(clinic.Branch)</strong></div>
                            <div><span>Facility Type</span><strong>@Display(clinic.FacilityType)</strong></div>
                            <div class="wide"><span>Address</span><strong>@Display(clinic.Address)</strong></div>
                            <div><span>Contact</span><strong>@Display(clinic.ContactPhone)</strong></div>
                            <div><span>Hours</span><strong>@Display(clinic.OperatingHours)</strong></div>
                            <div class="wide"><span>Brands &amp; Diets</span><strong>@Display(clinic.BrandsCarried)</strong></div>
                        </div>
                    }
                </section>

                <aside class="clinic-panel subscription-panel">
                    <span class="eyebrow">VERIFIED CLINIC</span>
                    <h2>₱50 <small>/ month</small></h2>
                    <p>
                        Verified badge, claimed-clinic management access, service management, and a stronger verified appearance in the directory.
                    </p>

                    @if (verifiedActive)
                    {
                        <div class="active-box">
                            <i class="bi bi-patch-check-fill"></i>
                            <div>
                                <strong>Subscription active</strong>
                                <span>Until @clinicSubscription?.ExpiresAt.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                        <a class="primary-link full-link" href="/checkout/ClinicSubscription">Extend Subscription</a>
                    }
                    else
                    {
                        <a class="primary-link full-link" href="/checkout/ClinicSubscription">Activate Verified Clinic</a>
                    }

                    <p class="microcopy">
                        The project checkout is a payment simulation. No real funds are transferred.
                    </p>
                </aside>
            </div>

            <section class="clinic-panel services-panel">
                <div class="panel-head">
                    <div>
                        <span class="eyebrow">SERVICES</span>
                        <h2>Services offered</h2>
                        <p>Manage the service capabilities shown on your public clinic listing.</p>
                    </div>
                </div>

                <div class="service-editor">
                    <div class="service-list">
                        @if (Services.Count == 0)
                        {
                            <div class="empty-service">No services added yet.</div>
                        }
                        else
                        {
                            @foreach (var service in Services)
                            {
                                <div class="service-chip">
                                    <span>@service</span>
                                    <button title="Remove service" @onclick="() => RemoveService(service)">×</button>
                                </div>
                            }
                        }
                    </div>

                    <div class="add-service">
                        <input maxlength="120"
                               @bind="newService"
                               @onkeydown="HandleServiceKey"
                               placeholder="Example: Vaccination" />
                        <button class="primary-btn" @onclick="AddService">Add Service</button>
                    </div>
                </div>
            </section>

            <section class="clinic-panel preview-panel">
                <div>
                    <span class="eyebrow">PUBLIC LISTING PREVIEW</span>
                    <h2>@clinic.ClinicName</h2>
                    <p>@clinic.Address</p>
                    <div class="preview-services">@string.Join(" · ", Services)</div>
                </div>
                <div class="preview-badge @(verifiedActive ? "verified" : "")">
                    @(verifiedActive ? "Verified Clinic" : "Listed Clinic")
                </div>
            </section>
        </main>
    }
</div>

<style>
    .clinic-dashboard-page{min-height:100vh;background:#FAF9F6;color:#1E2D27}.clinic-shell{width:min(1180px,calc(100% - 40px));margin:auto}.clinic-state{padding:90px;text-align:center;color:#6C7A74}
    .clinic-hero{padding:48px 0;background:linear-gradient(145deg,#173D3D,#102E2D);color:#fff}.clinic-hero-inner{display:flex;justify-content:space-between;gap:24px;align-items:end}.eyebrow{color:#2F9098;font-size:.67rem;font-weight:900;letter-spacing:.12em}.eyebrow.light{color:#8ED8D9}.clinic-hero h1{margin:7px 0 6px;font-size:clamp(2.3rem,5vw,4rem);font-weight:900;letter-spacing:-.05em}.clinic-hero p{margin:0;color:rgba(255,255,255,.62)}
    .clinic-status-card{min-width:250px;padding:16px;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(255,255,255,.06)}.clinic-status-card.active{background:rgba(47,144,152,.15)}.clinic-status-card span,.clinic-status-card strong,.clinic-status-card small{display:block}.clinic-status-card span{font-size:.62rem;font-weight:900;letter-spacing:.1em;color:#F3D27A}.clinic-status-card strong{margin-top:5px}.clinic-status-card small{margin-top:4px;color:rgba(255,255,255,.64)}
    .clinic-content{padding:28px 0 60px}.status-message{margin-bottom:18px;padding:12px 14px;border-radius:11px;font-size:.75rem;font-weight:700}.status-message.success{background:#E9F7EE;color:#276840;border:1px solid #BFE3CB}.status-message.error{background:#FFF1F1;color:#982E2E;border:1px solid #F0B9B9}
    .clinic-overview-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}.metric,.clinic-panel{border:1px solid #DDE7E4;border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(30,45,39,.045)}.metric{padding:18px}.metric span,.metric strong,.metric small{display:block}.metric span{color:#7E8B86;font-size:.64rem;text-transform:uppercase;font-weight:850}.metric strong{margin-top:7px;font-size:1.25rem}.metric small{margin-top:3px;color:#8A9691;font-size:.66rem}
    .clinic-main-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);gap:18px}.clinic-panel{padding:26px}.panel-head{display:flex;justify-content:space-between;gap:18px;align-items:start}.clinic-panel h2{margin:5px 0 8px;font-weight:900;letter-spacing:-.035em}.clinic-panel p{margin:0;color:#6A7973;line-height:1.6}.outline-btn,.primary-btn,.secondary-btn{min-height:42px;padding:0 14px;border-radius:10px;font-weight:850;cursor:pointer}.outline-btn,.secondary-btn{border:1px solid #C9D9D5;background:#fff;color:#173D3D}.primary-btn{border:1px solid #2F9098;background:#2F9098;color:#fff}
    .profile-view{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:20px}.profile-view>div{padding:12px;border:1px solid #E5EBE8;border-radius:11px;background:#FBFCFB}.profile-view .wide{grid-column:1/-1}.profile-view span,.profile-view strong{display:block}.profile-view span{font-size:.63rem;color:#84918C;text-transform:uppercase;font-weight:800}.profile-view strong{margin-top:4px;font-size:.78rem}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}.field.full{grid-column:1/-1}.field label{display:block;margin-bottom:5px;font-size:.69rem;font-weight:850}.field input{width:100%;min-height:44px;padding:0 11px;border:1px solid #CBD9D5;border-radius:9px;outline:none}.field small{display:block;margin-top:4px;color:#89958F;font-size:.62rem}.action-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}
    .subscription-panel h2{font-size:2rem}.subscription-panel h2 small{font-size:.8rem;color:#7D8984}.active-box{display:flex;gap:10px;align-items:center;margin:20px 0;padding:13px;border-radius:12px;background:#EAF6EF;color:#286A44}.active-box i{font-size:1.5rem}.active-box strong,.active-box span{display:block}.active-box span{font-size:.68rem}.primary-link,.secondary-link{min-height:44px;padding:0 16px;border-radius:10px;text-decoration:none;font-weight:850;display:inline-flex;align-items:center;justify-content:center}.primary-link{background:#2F9098;color:#fff}.secondary-link{border:1px solid #C9D9D5;background:#fff;color:#173D3D}.full-link{width:100%;margin-top:14px}.microcopy{margin-top:12px!important;font-size:.65rem!important}
    .services-panel,.preview-panel{margin-top:18px}.service-list{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.service-chip{display:inline-flex;align-items:center;gap:7px;padding:8px 10px;border-radius:999px;background:#EEF6F4;color:#245F61;font-size:.72rem;font-weight:800}.service-chip button{border:0;background:transparent;color:#65736D;font-size:1rem;cursor:pointer}.empty-service{color:#85918C;font-size:.75rem}.add-service{display:flex;gap:8px}.add-service input{flex:1;min-height:44px;padding:0 12px;border:1px solid #CBD9D5;border-radius:10px;outline:none}.preview-panel{display:flex;justify-content:space-between;align-items:center;gap:20px}.preview-services{margin-top:10px;color:#73817B;font-size:.72rem}.preview-badge{padding:9px 12px;border-radius:999px;background:#EFF2F1;color:#68756F;font-size:.69rem;font-weight:900}.preview-badge.verified{background:#EAF5F5;color:#267C83}
    .access-panel{max-width:700px;margin:70px auto}.access-panel h1{font-size:2.4rem}.access-panel p{margin-top:8px}
    @@media(max-width:900px){.clinic-overview-grid{grid-template-columns:1fr 1fr}.clinic-main-grid{grid-template-columns:1fr}.clinic-hero-inner{align-items:start;flex-direction:column}.clinic-status-card{width:100%}.profile-view,.form-grid{grid-template-columns:1fr}.profile-view .wide,.field.full{grid-column:auto}}
    @@media(max-width:560px){.clinic-overview-grid{grid-template-columns:1fr}.add-service{flex-direction:column}.preview-panel{align-items:start;flex-direction:column}}
</style>

@code {
    private ClinicTenant? clinic;
    private ClinicTenant editClinic = new();
    private SubscriptionRecord? clinicSubscription;
    private bool ready;
    private bool verifiedActive;
    private bool editingProfile;
    private string newService = string.Empty;
    private string message = string.Empty;
    private bool isError;

    private List<string> Services =>
        (clinic?.ServiceCapabilities ?? string.Empty)
            .Split(new[] { ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.InitializeAsync();
        LoadClinic();

        ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private void LoadClinic()
    {
        if (Auth.CurrentUser is null)
            return;

        clinic = Db.GetClinicForUser(Auth.CurrentUser.Id);

        if (clinic is null)
            return;

        clinicSubscription =
            Commerce.GetActiveSubscription(
                CommerceService.ClinicType,
                clinicId: clinic.Id);

        verifiedActive = clinicSubscription is not null;
    }

    private void BeginEditProfile()
    {
        if (clinic is null) return;

        editClinic = new ClinicTenant
        {
            Id = clinic.Id,
            ClinicName = clinic.ClinicName,
            Branch = clinic.Branch,
            Address = clinic.Address,
            PrcLicenseNo = clinic.PrcLicenseNo,
            PtrNumber = clinic.PtrNumber,
            SubscriptionPlan = clinic.SubscriptionPlan,
            FacilityType = clinic.FacilityType,
            HasClinic = clinic.HasClinic,
            HasPetShop = clinic.HasPetShop,
            ContactPhone = clinic.ContactPhone,
            OperatingHours = clinic.OperatingHours,
            BrandsCarried = clinic.BrandsCarried,
            ServiceCapabilities = clinic.ServiceCapabilities,
            MessengerUrl = clinic.MessengerUrl,
            IsVerified = clinic.IsVerified,
            VerifiedAt = clinic.VerifiedAt,
            VerificationFee = clinic.VerificationFee,
            VerificationReference = clinic.VerificationReference,
            VerificationStatus = clinic.VerificationStatus
        };

        editingProfile = true;
    }

    private void CancelEditProfile()
    {
        editingProfile = false;
        message = string.Empty;
    }

    private void SaveProfile()
    {
        if (clinic is null) return;

        editClinic.ClinicName = clinic.ClinicName;
        editClinic.ServiceCapabilities = clinic.ServiceCapabilities;

        try
        {
            if (!Db.UpdateClinic(editClinic))
            {
                ShowError("The clinic profile could not be updated.");
                return;
            }

            clinic = Db.GetClinicById(clinic.Id);
            editingProfile = false;
            ShowSuccess("Clinic profile updated.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ClinicPortal] {ex}");
            ShowError("The clinic profile could not be updated.");
        }
    }

    private void AddService()
    {
        if (clinic is null) return;

        var value = newService.Trim();

        if (string.IsNullOrWhiteSpace(value))
            return;

        if (Services.Contains(value, StringComparer.OrdinalIgnoreCase))
        {
            ShowError("That service is already listed.");
            return;
        }

        var updated = Services;
        updated.Add(value);

        SaveServices(updated);
        newService = string.Empty;
    }

    private void RemoveService(string service)
    {
        if (clinic is null) return;

        var updated =
            Services
                .Where(x => !string.Equals(x, service, StringComparison.OrdinalIgnoreCase))
                .ToList();

        SaveServices(updated);
    }

    private void SaveServices(List<string> values)
    {
        if (clinic is null) return;

        clinic.ServiceCapabilities =
            string.Join(", ", values.OrderBy(x => x));

        try
        {
            if (!Db.UpdateClinic(clinic))
            {
                ShowError("Services could not be updated.");
                return;
            }

            clinic = Db.GetClinicById(clinic.Id);
            ShowSuccess("Clinic services updated.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ClinicPortal Services] {ex}");
            ShowError("Services could not be updated.");
        }
    }

    private void HandleServiceKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddService();
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private void ShowSuccess(string value)
    {
        message = value;
        isError = false;
    }

    private void ShowError(string value)
    {
        message = value;
        isError = true;
    }
}
