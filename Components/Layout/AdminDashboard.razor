@page "/admin-portal"
@rendermode InteractiveServer
@inject AuthService Auth
@inject IConfiguration Config
<main class="owner-shell"><header class="owner-header"><span class="owner-eyebrow">SHOPPETCARE ADMIN</span><h1>Keep the community thriving.</h1><p>Manage users, marketplace listings, community content, and simulated transactions.</p></header>@if(!ready){<p>Loading administration…</p>}else if(!Auth.IsAdmin){<p>Administrator access required.</p>}else{<AdminNav />@if(error.Length>0){<p role="status" class="owner-notice">@error</p>}<div class="owner-grid">@foreach(var item in links){<a class="owner-card" href="@item.Url" style="text-decoration:none;color:inherit"><h2>@item.Label →</h2><p>@counts.GetValueOrDefault(item.Table) records</p></a>}</div><p>Only Pet Owner and Admin roles are part of the active platform.</p>}</main>
@code {
 bool ready;string error="";readonly Dictionary<string,int> counts=new();readonly (string Label,string Table,string Url)[] links={ ("Users","UserAccounts","/admin/users"),("Marketplace","MarketplaceListings","/admin/marketplace"),("Community","CommunityPosts","/admin/community"),("Transactions","Transactions","/admin/transactions")};
 protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Auth.InitializeAsync();if(Auth.IsAdmin)try{using var c=new Microsoft.Data.SqlClient.SqlConnection(Config.GetConnectionString("ShoppetDb"));c.Open();foreach(var x in links){using var q=new Microsoft.Data.SqlClient.SqlCommand($"SELECT COUNT(*) FROM {x.Table}",c);counts[x.Table]=Convert.ToInt32(q.ExecuteScalar());}}catch(Exception){error="Could not load shared database statistics.";}ready=true;StateHasChanged();}
}
