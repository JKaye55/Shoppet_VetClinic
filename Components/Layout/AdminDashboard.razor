@page "/admin-portal"
@rendermode InteractiveServer

@using Shoppet_VetClinic.Components.Shared
@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject DatabaseService Db
@inject CommerceService Commerce
@inject MarketplaceService Marketplace
@inject CommunityService Community

<PageTitle>Super Admin Dashboard | ShoppetCare</PageTitle>

<div class="admin-page">
    @if (!ready)
    {
        <div class="admin-state">Loading administration...</div>
    }
    else if (!Auth.IsAdmin)
    {
        <main class="admin-shell"><section class="admin-panel access"><h1>Administrator access required.</h1><p>This management console is available only to Super Admin accounts.</p></section></main>
    }
    else
    {
        <AdminNav />

        <header class="admin-hero">
            <div class="admin-shell">
                <span class="eyebrow light">SUPER ADMIN</span>
                <h1>Platform overview &amp; action center.</h1>
                <p>Manage the ShoppetCare directory, users, subscriptions, marketplace, Community, announcements, and project transactions.</p>
            </div>
        </header>

        <main class="admin-shell admin-content">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert-box">@errorMessage</div>
            }

            <section class="metric-grid">
                <a href="/admin/users" class="metric"><span>Users</span><strong>@users.Count</strong><small>Registered accounts</small></a>
                <a href="/admin/clinics" class="metric"><span>Clinics</span><strong>@clinics.Count</strong><small>Directory listings</small></a>
                <a href="/admin/sellers" class="metric"><span>Verified Sellers</span><strong>@activeSellerCount</strong><small>Active subscriptions</small></a>
                <a href="/admin/community" class="metric"><span>Community Posts</span><strong>@communityPosts.Count</strong><small>Recent content loaded</small></a>
                <a href="/admin/marketplace" class="metric"><span>Marketplace</span><strong>@listings.Count</strong><small>Total listings</small></a>
                <a href="/admin/transactions" class="metric revenue"><span>Mock Revenue</span><strong>₱@totalRevenue.ToString("N2")</strong><small>Paid project transactions</small></a>
            </section>

            <div class="admin-grid">
                <section class="admin-panel">
                    <div class="panel-head">
                        <div><span class="eyebrow">NEEDS ATTENTION</span><h2>Pending clinic actions</h2></div>
                        <a href="/admin/clinics">Open Clinic Management</a>
                    </div>

                    <div class="attention-card">
                        <i class="bi bi-inbox-fill"></i>
                        <div>
                            <strong>@pendingClinicRequests pending request@(pendingClinicRequests == 1 ? "" : "s")</strong>
                            <span>Clinic listing requests and claim requests awaiting review.</span>
                        </div>
                    </div>

                    <div class="status-list">
                        <div><span>Active Premium</span><strong>@activePremiumCount</strong></div>
                        <div><span>Active Seller Subscriptions</span><strong>@activeSellerCount</strong></div>
                        <div><span>Active Clinic Subscriptions</span><strong>@activeClinicCount</strong></div>
                    </div>
                </section>

                <section class="admin-panel">
                    <div class="panel-head">
                        <div><span class="eyebrow">RECENT TRANSACTIONS</span><h2>Subscription activity</h2></div>
                        <a href="/admin/transactions">View All</a>
                    </div>

                    @if (transactions.Count == 0)
                    {
                        <div class="empty">No transaction records yet.</div>
                    }
                    else
                    {
                        <div class="transaction-list">
                            @foreach (var transaction in transactions.Take(5))
                            {
                                <div class="transaction-row">
                                    <div><strong>@FriendlyType(transaction.Type)</strong><span>@transaction.Reference</span></div>
                                    <div class="transaction-amount"><strong>₱@transaction.Amount.ToString("N2")</strong><span>@transaction.PaidAt.ToString("MMM d")</span></div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <section class="admin-panel quick-actions">
                <div><span class="eyebrow">ADMINISTRATION</span><h2>Operational modules</h2></div>
                <div class="module-grid">
                    <a href="/admin/clinics"><i class="bi bi-hospital"></i><strong>Clinic Management</strong><span>Directory, listing requests and claims</span></a>
                    <a href="/admin/sellers"><i class="bi bi-patch-check"></i><strong>Seller Management</strong><span>Subscription status and seller access</span></a>
                    <a href="/admin/marketplace"><i class="bi bi-bag"></i><strong>Marketplace Moderation</strong><span>Review and remove inappropriate listings</span></a>
                    <a href="/admin/community"><i class="bi bi-people"></i><strong>Community Moderation</strong><span>Review and remove inappropriate posts</span></a>
                    <a href="/admin/announcements"><i class="bi bi-megaphone"></i><strong>Announcements</strong><span>Create and manage platform notices</span></a>
                    <a href="/admin/transactions"><i class="bi bi-receipt"></i><strong>Transactions</strong><span>Audit Premium, Seller and Clinic payments</span></a>
                </div>
            </section>
        </main>
    }
</div>

<style>
    .admin-page{min-height:100vh;background:#F6F7F5;color:#1E2D27}.admin-shell{width:min(1240px,calc(100% - 36px));margin:auto}.admin-state{padding:90px;text-align:center;color:#6D7A74}.admin-hero{padding:42px 0;background:linear-gradient(145deg,#173D3D,#102E2D);color:#fff}.eyebrow{color:#2F9098;font-size:.65rem;font-weight:900;letter-spacing:.12em}.eyebrow.light{color:#8FD9DA}.admin-hero h1{margin:7px 0 9px;font-size:clamp(2.5rem,5vw,4rem);font-weight:900;letter-spacing:-.05em}.admin-hero p{max-width:780px;margin:0;color:rgba(255,255,255,.66);line-height:1.6}
    .admin-content{padding:24px 0 60px}.metric-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.metric{padding:16px;border:1px solid #DEE6E3;border-radius:15px;background:#fff;color:#1E2D27;text-decoration:none}.metric span,.metric strong,.metric small{display:block}.metric span{color:#78857F;font-size:.6rem;font-weight:850;text-transform:uppercase}.metric strong{margin-top:6px;font-size:1.35rem}.metric small{margin-top:3px;color:#909A96;font-size:.58rem}.metric.revenue{background:#173D3D;color:#fff}.metric.revenue span,.metric.revenue small{color:rgba(255,255,255,.65)}
    .admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px}.admin-panel{padding:24px;border:1px solid #DEE6E3;border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(30,45,39,.035)}.panel-head{display:flex;justify-content:space-between;align-items:start;gap:16px}.admin-panel h2{margin:5px 0 0;font-size:1.25rem;font-weight:900}.panel-head>a{color:#267C83;text-decoration:none;font-size:.67rem;font-weight:850}.attention-card{display:flex;gap:11px;align-items:center;margin-top:18px;padding:14px;border-radius:12px;background:#FFF7D9;color:#6D5917}.attention-card i{font-size:1.4rem}.attention-card strong,.attention-card span{display:block}.attention-card span{margin-top:2px;font-size:.65rem}.status-list{margin-top:12px}.status-list div,.transaction-row{display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-top:1px solid #EDF1EF;font-size:.72rem}.transaction-row div strong,.transaction-row div span{display:block}.transaction-row div span{margin-top:2px;color:#89948F;font-size:.61rem}.transaction-amount{text-align:right}.empty{margin-top:18px;color:#87928D;font-size:.72rem}
    .quick-actions{margin-top:15px}.module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.module-grid a{padding:15px;border:1px solid #E2E9E6;border-radius:12px;color:#173D3D;text-decoration:none}.module-grid i{color:#2F9098}.module-grid strong,.module-grid span{display:block}.module-grid strong{margin-top:9px;font-size:.76rem}.module-grid span{margin-top:3px;color:#84908B;font-size:.62rem;line-height:1.45}.access{max-width:680px;margin:70px auto}.alert-box{margin-bottom:15px;padding:12px;border:1px solid #F0BBBB;border-radius:10px;background:#FFF1F1;color:#963232}
    @@media(max-width:1100px){.metric-grid{grid-template-columns:repeat(3,1fr)}}@@media(max-width:800px){.admin-grid{grid-template-columns:1fr}.module-grid{grid-template-columns:1fr 1fr}}@@media(max-width:560px){.metric-grid,.module-grid{grid-template-columns:1fr}}
</style>

@code {
    private bool ready;
    private string errorMessage = string.Empty;
    private List<UserAccount> users = new();
    private List<ClinicTenant> clinics = new();
    private List<MarketplaceListing> listings = new();
    private List<CommunityPost> communityPosts = new();
    private List<Transaction> transactions = new();
    private int pendingClinicRequests;
    private int activePremiumCount;
    private int activeSellerCount;
    private int activeClinicCount;
    private decimal totalRevenue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.InitializeAsync();

        if (Auth.IsAdmin)
            Load();

        ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private void Load()
    {
        try
        {
            users = Db.GetAllUsers();
            clinics = Db.GetAllClinics();
            listings = Marketplace.GetAllListings();
            communityPosts = Community.GetRecentPosts(200);
            transactions = Db.GetAllTransactions();
            totalRevenue = Db.GetTotalRevenue();
            pendingClinicRequests = Commerce.GetPendingClinicRequestCount();
            activePremiumCount = Commerce.GetSubscriptions(CommerceService.PremiumType).Count(x => x.IsActive);
            activeSellerCount = Commerce.GetSubscriptions(CommerceService.SellerType).Count(x => x.IsActive);
            activeClinicCount = Commerce.GetSubscriptions(CommerceService.ClinicType).Count(x => x.IsActive);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminDashboard] {ex}");
            errorMessage = "Some administrator data could not be loaded. Apply the final database migration and refresh.";
        }
    }

    private static string FriendlyType(string type) =>
        type switch
        {
            CommerceService.PremiumType => "Premium",
            CommerceService.SellerType => "Verified Seller",
            CommerceService.ClinicType => "Verified Clinic",
            "PremiumUpgrade" => "Premium",
            "BusinessVerification" => "Clinic Verification",
            _ => type
        };
}
