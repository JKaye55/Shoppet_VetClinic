<dialog id="components-reconnect-modal"
        class="sc-reconnect">

    <div class="sc-reconnect-card">

        <div class="sc-reconnect-spinner"></div>

        <h3>
            Reconnecting to ShoppetCare
        </h3>

        <p class="sc-reconnect-message">
            The connection to the server was interrupted.
            You can wait for ShoppetCare to reconnect or reload immediately.
        </p>

        <div class="sc-reconnect-status">

            <span>
                Retry attempt:
            </span>

            <strong id="components-reconnect-current-attempt">
                0
            </strong>

            <span>
                /
            </span>

            <strong id="components-reconnect-max-retries">
                0
            </strong>

        </div>

        <p class="sc-reconnect-wait">
            Trying again in
            <strong id="components-seconds-to-next-attempt">
                0
            </strong>
            seconds.
        </p>

        <div class="sc-reconnect-actions">

            <button type="button"
                    class="sc-reconnect-primary"
                    onclick="window.location.reload();">
                Reload Now
            </button>

            <a href="/"
               data-enhance-nav="false"
               class="sc-reconnect-secondary">
                Back to Landing Page
            </a>

        </div>

        <small class="sc-reconnect-note">
            During development, this usually appears after the app is rebuilt or restarted.
        </small>

    </div>

</dialog>
