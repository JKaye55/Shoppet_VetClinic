@inherits LayoutComponentBase
@implements IDisposable
@inject FileStorageService FileStorage
@using Shoppet_VetClinic.Services
@inject MarketplaceCartService Cart

@inject AuthService Auth
@inject NavigationManager Nav

<style>

    :root {
        --sp-sage: #5C766D;
        --sp-sage-dark: #1E2D27;
        --sp-sage-light: #EEF4F1;

        --sp-cream: #FAF9F6;

        --sp-yellow: #F7DD7D;

        --sp-text: #34423C;

        --sp-muted: #7B8882;

        --sp-border: #E7EBE9;

        --sp-teal: #2F9098;

        --sp-teal-dark: #267C83;

        --sp-teal-soft: #EAF5F5;
    }


    * {
        box-sizing: border-box;
    }


    html,
    body {
        margin: 0;
        padding: 0;
    }


    body {
        background: var(--sp-cream);

        color: var(--sp-text);

        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            Helvetica,
            Arial,
            sans-serif;
    }


    /* =========================================================
       LAYOUT
       ========================================================= */

    .sp-layout {
        min-height: 100vh;

        display: flex;
        flex-direction: column;

        background:
            linear-gradient(
                180deg,
                #FFFFFF 0%,
                #FAF9F6 100%
            );
    }


    /* =========================================================
       INFO BAR
       ========================================================= */

    .sp-info-bar {
        min-height: 34px;

        background:
            var(--sp-sage-dark);

        color: #E8EFEC;

        font-size: .72rem;

        font-weight: 500;

        letter-spacing: .01em;
    }


    .sp-info-inner {
        max-width: 1380px;

        min-height: 34px;

        margin: 0 auto;

        padding: 0 28px;

        display: flex;

        align-items: center;

        justify-content:
            space-between;

        gap: 20px;
    }


    .sp-info-left {
        opacity: .95;
    }


    .sp-info-right {
        opacity: .78;
    }


    .sp-info-guest {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        color: #F7E6A5;

        font-weight: 700;

        opacity: 1;
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    .sp-navigation {
        position: sticky;

        top: 0;

        z-index: 1000;

        background:
            rgba(
                255,
                255,
                255,
                .97
            );

        border-bottom:
            1px solid
            var(--sp-border);

        backdrop-filter:
            blur(16px);

        -webkit-backdrop-filter:
            blur(16px);

        box-shadow:
            0 3px 18px
            rgba(30,45,39,.045);
    }


    .sp-navigation-inner {
        max-width: 1380px;

        min-height: 82px;

        margin: 0 auto;

        padding: 0 28px;

        display: flex;

        align-items: center;

        gap: 25px;
    }


    /* =========================================================
       BRAND
       ========================================================= */

    .sp-brand {
        display: flex;

        align-items: center;

        gap: 11px;

        flex-shrink: 0;

        text-decoration: none;
    }


    .sp-logo {
        width: 54px;
        height: 54px;

        object-fit: contain;
    }


    .sp-brand-content {
        display: flex;

        flex-direction: column;

        line-height: 1;
    }


    .sp-brand-name {
        color:
            var(--sp-sage-dark);

        font-size: 1.16rem;

        font-weight: 800;

        letter-spacing: -.035em;
    }


    .sp-brand-subtitle {
        margin-top: 5px;

        color: var(--sp-muted);

        font-size: .62rem;

        font-weight: 500;

        letter-spacing: .035em;

        text-transform: uppercase;
    }


    /* =========================================================
       MENU
       ========================================================= */

    .sp-menu {
        flex: 1;
        min-width: 0;

        height: 100%;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 5px;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .sp-menu::-webkit-scrollbar {
        display: none;
    }


    .sp-menu-link {
        position: relative;

        height: 82px;

        padding: 0 12px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        color: #596760;

        text-decoration: none;

        font-size: .82rem;

        font-weight: 600;

        white-space: nowrap;

        transition:
            color .2s ease,
            background .2s ease;
    }


    .sp-menu-link::after {
        content: "";

        position: absolute;

        left: 12px;
        right: 12px;

        bottom: 0;

        height: 3px;

        border-radius:
            3px 3px 0 0;

        background: transparent;

        transition:
            background .2s ease,
            transform .2s ease;
    }


    .sp-menu-link:hover {
        color:
            var(--sp-sage-dark);
    }


    .sp-menu-link:hover::after {
        background: #D8E4DF;
    }


    .sp-menu-link.active {
        color: var(--sp-sage);

        font-weight: 700;
    }


    .sp-menu-link.active::after {
        background: var(--sp-sage);
    }


    .sp-menu-link-premium {
        color: #B8860B;

        font-weight: 700;
    }


    .sp-menu-link-premium.active::after {
        background: #F7DD7D;
    }


    /* =========================================================
       RIGHT ACTIONS
       ========================================================= */

    .sp-actions,
    .sp-user-area,
    .sp-guest-area {
        display: flex;

        align-items: center;

        gap: 8px;

        flex-shrink: 0;
    }


    .sp-contact {
        min-height: 38px;

        padding: 0 16px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 9px;

        background: var(--sp-sage);

        color: #FFFFFF;

        text-decoration: none;

        font-size: .78rem;

        font-weight: 700;

        box-shadow:
            0 4px 12px
            rgba(92,118,109,.15);

        transition:
            background .2s ease,
            transform .2s ease;
    }


    .sp-contact:hover {
        transform:
            translateY(-1px);

        background:
            var(--sp-sage-dark);

        color: #FFFFFF;
    }



    .sp-contact-locked {
        gap: 6px;
        background: #EEF1F0;
        color: #8A9591;
        box-shadow: none;
        cursor: not-allowed;
        user-select: none;
    }

    .sp-contact-locked:hover {
        transform: none;
        background: #EEF1F0;
        color: #8A9591;
    }


    .sp-btn-login,
    .sp-btn-register,
    .sp-btn-exit-preview,
    .sp-btn-portal,
    .sp-btn-signout {
        min-height: 38px;

        padding: 0 14px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 9px;

        text-decoration: none;

        font-size: .76rem;

        font-weight: 750;

        transition:
            background .2s ease,
            color .2s ease,
            border-color .2s ease,
            transform .2s ease;
    }


    .sp-btn-login {
        border:
            1px solid
            var(--sp-border);

        background: #FFFFFF;

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-login:hover {
        background:
            var(--sp-sage-light);

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-register {
        border:
            1px solid
            var(--sp-teal);

        background:
            var(--sp-teal);

        color: #FFFFFF;
    }


    .sp-btn-register:hover {
        transform:
            translateY(-1px);

        border-color:
            var(--sp-teal-dark);

        background:
            var(--sp-teal-dark);

        color: #FFFFFF;
    }


    .sp-btn-exit-preview,
    .sp-btn-signout {
        border:
            1px solid
            var(--sp-border);

        background: transparent;

        color: #6B7772;

        cursor: pointer;
    }


    .sp-btn-exit-preview:hover {
        background: #F5F7F6;

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-signout:hover {
        background: #FEE2E2;

        color: #991B1B;

        border-color: #FCA5A5;
    }


    /* =========================================================
       GUEST
       ========================================================= */

    .sp-guest-pill {
        min-height: 38px;

        padding: 0 12px;

        display: inline-flex;

        align-items: center;

        gap: 7px;

        border:
            1px solid #D6E4E1;

        border-radius: 999px;

        background: #F1F7F5;

        color:
            var(--sp-teal-dark);

        font-size: .72rem;

        font-weight: 850;

        white-space: nowrap;
    }


    /* =========================================================
       LOGGED IN USER
       ========================================================= */

    .sp-user-profile {
        min-height: 42px;

        padding:
            4px 11px 4px 6px;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        border:
            1px solid
            var(--sp-border);

        border-radius: 12px;

        background: #FFFFFF;

        text-decoration: none;

        transition: all .2s ease;
    }


    .sp-user-profile:hover {
        transform:
            translateY(-1px);

        background:
            var(--sp-sage-light);

        border-color: #D2DED9;
    }


    .sp-user-avatar {
        width: 31px;
        height: 31px;

        flex: 0 0 31px;

        display: grid;

        place-items: center;

        border-radius: 50%;

        background:
            var(--sp-sage-dark);

        color: #FFFFFF;

        font-size: .72rem;

        font-weight: 800;
    }

    .sp-user-avatar {
        overflow: hidden;
    }

        .sp-user-avatar.has-photo {
            padding: 0;
        }

        .sp-user-avatar img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

    .sp-user-info {
        display: flex;

        flex-direction: column;

        justify-content: center;

        line-height: 1.1;
    }


    .sp-user-name {
        max-width: 145px;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

        color:
            var(--sp-sage-dark);

        font-size: .76rem;

        font-weight: 750;
    }


    .sp-user-role {
        margin-top: 3px;

        color: var(--sp-muted);

        font-size: .61rem;

        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: .035em;
    }


    .sp-btn-portal {
        border:
            1px solid #D9E4E0;

        background:
            var(--sp-sage-light);

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-portal:hover {
        background: #DCE9E4;

        color:
            var(--sp-sage-dark);
    }


    /* =========================================================
       CONTENT
       ========================================================= */

    .sp-content {
        flex: 1 1 auto;

        min-width: 0;

        background:
            linear-gradient(
                180deg,
                #FAF9F6 0%,
                #F7F5EF 100%
            );
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .sp-navigation-inner {
            gap: 15px;

            padding: 0 15px;
        }


        .sp-menu-link {
            padding: 0 8px;

            font-size: .76rem;
        }


        .sp-user-name {
            max-width: 105px;
        }

    }


    @@media (max-width: 1050px) {

        .sp-guest-pill,
        .sp-contact {
            display: none;
        }

    }


    @@media (max-width: 950px) {

        .sp-info-right {
            display: none;
        }


        .sp-navigation-inner {
            gap: 10px;
        }


        .sp-menu {
            justify-content:
                flex-start;
        }


        .sp-menu-link {
            padding: 0 7px;

            font-size: .72rem;
        }


        .sp-user-role {
            display: none;
        }

    }


    .sp-hamburger {
        display: none;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        border: 1px solid var(--sp-border);
        background: #FFFFFF;
        color: var(--sp-sage-dark);
        font-size: 1.25rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        transition: all .2s ease;
    }

    .sp-hamburger:hover {
        background: var(--sp-sage-light);
    }

    .sp-cart-btn {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 9px;
        border: 1px solid var(--sp-border);
        background: #FFFFFF;
        color: var(--sp-sage-dark);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1.1rem;
        transition: all .2s ease;
    }

    .sp-cart-btn:hover {
        background: var(--sp-sage-light);
        color: var(--sp-teal);
    }

    .sp-cart-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        border-radius: 999px;
        background: var(--sp-teal);
        color: #FFFFFF;
        font-size: .62rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sp-badge-tier {
        display: inline-flex;
        align-items: center;
        padding: 2px 7px;
        border-radius: 6px;
        font-size: .58rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        line-height: 1.1;
        margin-left: 4px;
    }

    .sp-badge-tier.premium {
        background: #FEF3C7;
        color: #B45309;
        border: 1px solid #F59E0B;
    }

    .sp-badge-tier.free {
        background: #E5E7EB;
        color: #4B5563;
        border: 1px solid #D1D5DB;
        cursor: pointer;
    }

    .sp-badge-tier.free:hover {
        background: #D1D5DB;
    }

    /* Mobile Drawer */
    .sp-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(17, 24, 39, 0.45);
        backdrop-filter: blur(4px);
        z-index: 2000;
    }

    .sp-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(340px, 86vw);
        background: #FFFFFF;
        z-index: 2001;
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 32px rgba(0,0,0,.15);
        overflow-y: auto;
    }

    .sp-drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--sp-border);
    }

    .sp-drawer-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 800;
        color: var(--sp-sage-dark);
        font-size: 1.05rem;
    }

    .sp-drawer-close {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid var(--sp-border);
        background: #FAF9F6;
        color: #4B5563;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1rem;
    }

    .sp-drawer-user {
        padding: 14px 18px;
        background: #FAF9F6;
        border-bottom: 1px solid var(--sp-border);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sp-drawer-promo {
        margin: 10px 14px;
        padding: 12px 14px;
        border-radius: 12px;
        background: linear-gradient(135deg, #FEF3C7, #FDE68A);
        border: 1px solid #F59E0B;
        color: #92400E;
        font-size: .78rem;
        cursor: pointer;
    }

    .sp-drawer-promo strong {
        display: block;
        font-size: .84rem;
        margin-bottom: 2px;
    }

    .sp-drawer-links {
        display: flex;
        flex-direction: column;
        padding: 8px 10px;
        gap: 2px;
    }

    .sp-drawer-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: #374151;
        font-size: .86rem;
        font-weight: 600;
        transition: all .15s ease;
    }

    .sp-drawer-link:hover, .sp-drawer-link.active {
        background: var(--sp-sage-light);
        color: var(--sp-sage-dark);
    }

    .sp-drawer-link i {
        font-size: 1.1rem;
        color: var(--sp-sage);
        width: 22px;
        text-align: center;
    }

    .sp-drawer-footer {
        margin-top: auto;
        padding: 14px 18px;
        border-top: 1px solid var(--sp-border);
        background: #FAF9F6;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* Modal for Premium Upgrade Prompt */
    .sp-upgrade-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .sp-upgrade-modal {
        background: #FFFFFF;
        width: min(440px, 100%);
        border-radius: 20px;
        padding: 28px 24px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    @@media (max-width: 991px) {
        .sp-menu {
            display: none !important;
        }

        .sp-hamburger {
            display: inline-flex;
        }

        .sp-user-name, .sp-user-role {
            display: none;
        }
    }

    @@media (max-width: 600px) {
        .sp-brand-subtitle {
            display: none;
        }
    }

</style>


<div class="sp-layout">

    <!-- =====================================================
         INFO BAR
         ===================================================== -->

    <div class="sp-info-bar">

        <div class="sp-info-inner">

            <span class="sp-info-left">

                Trusted Pet Care in
                Lipa City &amp; Tanauan

            </span>


            @if (Auth.IsGuest)
            {
                <span class="sp-info-right
                             sp-info-guest">

                    <i class="bi bi-eye-fill"
                       aria-hidden="true">
                    </i>

                    Guest Mode · Public browsing enabled

                </span>
            }
            else
            {
                <span class="sp-info-right">

                    Pet Care

                    &nbsp;•&nbsp;

                    Pet Supplies

                    &nbsp;•&nbsp;

                    ShoppetCare

                </span>
            }

        </div>

    </div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <header class="sp-navigation">

        <div class="sp-navigation-inner">

            <!-- BRAND -->

            <a href="@(Auth.IsLoggedIn ? "/home" : "/")"
               class="sp-brand"
               data-enhance-nav="false"
               title="@(Auth.IsLoggedIn ? "ShoppetCare Home" : "ShoppetCare Landing")">

                <img src="/shoppetlogo.png"
                     alt="ShoppetCare"
                     class="sp-logo" />


                <div class="sp-brand-content">

                    <span class="sp-brand-name">
                        ShoppetCare
                    </span>

                    <span class="sp-brand-subtitle">
                        Pet Care Directory
                    </span>

                </div>

            </a>


            <!-- MENU -->

            <!-- MENU -->
            <nav class="sp-menu">
                <a href="/home"
                   title="Open ShoppetCare Home"
                   class="sp-menu-link @(IsActive("/home") ? "active" : "")">
                    Home
                </a>

                <a href="/marketplace"
                   title="Browse the pre-loved pet Marketplace"
                   class="sp-menu-link @(IsActive("/marketplace") ? "active" : "")">
                    Marketplace
                </a>

                <a href="/community"
                   title="Open the ShoppetCare Community"
                   class="sp-menu-link @(IsActive("/community") ? "active" : "")">
                    Community
                </a>

                <a href="/announcements"
                   title="View ShoppetCare announcements"
                   class="sp-menu-link @(IsActive("/announcements") ? "active" : "")">
                    Announcements
                </a>

                @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                {
                    <a href="/my-pets" class="sp-menu-link @(IsActive("/my-pets") ? "active" : "")">My Pets</a>
                    <a href="/messages" class="sp-menu-link @(IsActive("/messages") ? "active" : "")">Messages</a>
                }
            </nav>

            <!-- RIGHT ACTIONS -->
            <div class="sp-actions">
                <a href="/marketplace/cart" class="sp-cart-btn" title="Marketplace Cart">
                    <i class="bi bi-cart3" aria-hidden="true"></i>
                    @if (CartCount > 0)
                    {
                        <span class="sp-cart-badge">@CartCount</span>
                    }
                </a>

                @if (Auth.IsLoggedIn)
                {
                    <div class="sp-user-area">
                        <NotificationBell />

                        <a href="@GetProfileDestination()"
                           class="sp-user-profile"
                           title="Open Account & Profile">
                            @if (!string.IsNullOrWhiteSpace(GetUserProfilePhotoUrl()))
                            {
                                <span class="sp-user-avatar has-photo">
                                    <img src="@GetUserProfilePhotoUrl()" alt="@GetUserDisplayName()" />
                                </span>
                            }
                            else
                            {
                                <span class="sp-user-avatar">
                                    @GetUserInitials()
                                </span>
                            }

                            <span class="sp-user-info">
                                <span class="sp-user-name">
                                    @GetUserDisplayName()
                                </span>
                                <span class="sp-user-role">
                                    @GetUserRole()
                                    @if (Auth.IsPremium)
                                    {
                                        <span class="sp-badge-tier premium" title="Premium Member">🏅 Premium</span>
                                    }
                                    else
                                    {
                                        <span class="sp-badge-tier free" title="Click to upgrade" @onclick:preventDefault="true" @onclick:stopPropagation="true" @onclick="PromptUpgrade">Free</span>
                                    }
                                </span>
                            </span>
                        </a>

                        @if (Auth.IsAdmin)
                        {
                            <a href="/admin-portal"
                               class="sp-btn-portal"
                               title="Open Super Admin dashboard">
                                Admin Portal
                            </a>
                        }

                        <button type="button"
                                class="sp-btn-signout"
                                title="Sign out of ShoppetCare"
                                @onclick="LogoutAsync">
                            Sign Out
                        </button>
                    </div>
                }
                else if (Auth.IsGuest)
                {
                    <div class="sp-guest-area">
                        <a href="/guest-dashboard"
                           class="sp-guest-pill"
                           title="Open your Guest Dashboard"
                           style="text-decoration:none;">
                            <i class="bi bi-person-heart" aria-hidden="true"></i>
                            Guest
                        </a>

                        <a href="/login" class="sp-btn-login" title="Sign in">
                            Sign In
                        </a>

                        <a href="/register" class="sp-btn-register" title="Create account">
                            Register
                        </a>

                        <button type="button"
                                class="sp-btn-exit-preview"
                                title="Exit Guest Mode and return to Landing"
                                @onclick="ExitGuestModeAsync">
                            Exit
                        </button>
                    </div>
                }
                else
                {
                    <a href="/login" class="sp-btn-login" title="Sign in to ShoppetCare">
                        Sign In
                    </a>

                    <a href="/register" class="sp-btn-register" title="Create a free ShoppetCare account">
                        Register
                    </a>
                }

                <button type="button" class="sp-hamburger" @onclick="ToggleMobileDrawer" aria-label="Toggle navigation menu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>

        </div>

    </header>

    <!-- MOBILE / TABLET RESPONSIVE DRAWER -->
    @if (isMobileMenuOpen)
    {
        <div class="sp-drawer-backdrop" @onclick="CloseMobileDrawer"></div>
        <aside class="sp-drawer">
            <div class="sp-drawer-header">
                <div class="sp-drawer-brand">
                    <img src="/shoppetlogo.png" alt="ShoppetCare" style="width:28px;height:28px;object-fit:contain;" />
                    <span>ShoppetCare</span>
                </div>
                <button type="button" class="sp-drawer-close" @onclick="CloseMobileDrawer" aria-label="Close menu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            @if (Auth.IsLoggedIn)
            {
                <div class="sp-drawer-user">
                    @if (!string.IsNullOrWhiteSpace(GetUserProfilePhotoUrl()))
                    {
                        <span class="sp-user-avatar has-photo" style="width:38px;height:38px;flex:0 0 38px;">
                            <img src="@GetUserProfilePhotoUrl()" alt="@GetUserDisplayName()" />
                        </span>
                    }
                    else
                    {
                        <span class="sp-user-avatar" style="width:38px;height:38px;flex:0 0 38px;font-size:.85rem;">
                            @GetUserInitials()
                        </span>
                    }
                    <div>
                        <strong style="display:block;font-size:.88rem;color:var(--sp-sage-dark);">@GetUserDisplayName()</strong>
                        <div style="display:flex;align-items:center;gap:6px;margin-top:2px;">
                            <span style="font-size:.7rem;color:var(--sp-muted);">@GetUserRole()</span>
                            @if (Auth.IsPremium)
                            {
                                <span class="sp-badge-tier premium">🏅 Premium</span>
                            }
                            else
                            {
                                <span class="sp-badge-tier free" @onclick="PromptUpgrade">Free Plan</span>
                            }
                        </div>
                    </div>
                </div>

                @if (!Auth.IsPremium)
                {
                    <div class="sp-drawer-promo" @onclick="PromptUpgrade">
                        <strong>✨ Upgrade to Premium</strong>
                        <span>₱150 for 2 months — Unlimited listings &amp; digital pet cards.</span>
                    </div>
                }
            }

            <nav class="sp-drawer-links">
                <a href="/home" class="sp-drawer-link @(IsActive("/home") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-house-door"></i> Home
                </a>
                <a href="/marketplace" class="sp-drawer-link @(IsActive("/marketplace") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-shop"></i> Marketplace
                </a>
                <a href="/marketplace/cart" class="sp-drawer-link @(IsActive("/marketplace/cart") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-cart3"></i> Cart @(CartCount > 0 ? $"({CartCount})" : "")
                </a>
                <a href="/community" class="sp-drawer-link @(IsActive("/community") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-chat-square-heart"></i> Community &amp; Rankings
                </a>
                @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                {
                    <a href="/my-pets" class="sp-drawer-link @(IsActive("/my-pets") ? "active" : "")" @onclick="CloseMobileDrawer">
                        <i class="bi bi-heart-pulse"></i> My Pets
                    </a>
                    <a href="/messages" class="sp-drawer-link @(IsActive("/messages") ? "active" : "")" @onclick="CloseMobileDrawer">
                        <i class="bi bi-chat-dots"></i> Messages
                    </a>
                    <a href="/dashboard" class="sp-drawer-link @(IsActive("/dashboard") ? "active" : "")" @onclick="CloseMobileDrawer">
                        <i class="bi bi-speedometer2"></i> My ShoppetCare
                    </a>
                }
                <a href="/announcements" class="sp-drawer-link @(IsActive("/announcements") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-megaphone"></i> Announcements
                </a>
                <a href="/clinics" class="sp-drawer-link @(IsActive("/clinics") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-hospital"></i> Verified Clinics
                </a>
                <a href="/about" class="sp-drawer-link @(IsActive("/about") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-info-circle"></i> About Us
                </a>
                <a href="/help" class="sp-drawer-link @(IsActive("/help") ? "active" : "")" @onclick="CloseMobileDrawer">
                    <i class="bi bi-question-circle"></i> Help Center
                </a>
                @if (Auth.IsLoggedIn)
                {
                    <a href="@GetProfileDestination()" class="sp-drawer-link @(IsActive("/account") ? "active" : "")" @onclick="CloseMobileDrawer">
                        <i class="bi bi-person-gear"></i> Account Settings
                    </a>
                }
            </nav>

            <div class="sp-drawer-footer">
                @if (Auth.IsLoggedIn)
                {
                    @if (Auth.IsAdmin)
                    {
                        <a href="/admin-portal" class="sp-btn-portal" style="text-align:center;" @onclick="CloseMobileDrawer">Admin Portal</a>
                    }
                    <button type="button" class="sp-btn-signout" style="width:100%;" @onclick="LogoutAsync">Sign Out</button>
                }
                else if (Auth.IsGuest)
                {
                    <a href="/login" class="sp-btn-login" style="text-align:center;" @onclick="CloseMobileDrawer">Sign In</a>
                    <a href="/register" class="sp-btn-register" style="text-align:center;" @onclick="CloseMobileDrawer">Create Account</a>
                    <button type="button" class="sp-btn-exit-preview" style="width:100%;" @onclick="ExitGuestModeAsync">Exit Guest Mode</button>
                }
                else
                {
                    <a href="/login" class="sp-btn-login" style="text-align:center;" @onclick="CloseMobileDrawer">Sign In</a>
                    <a href="/register" class="sp-btn-register" style="text-align:center;" @onclick="CloseMobileDrawer">Register</a>
                }
            </div>
        </aside>
    }

    <!-- UPGRADE PROMPT MODAL -->
    @if (showUpgradePrompt)
    {
        <div class="sp-upgrade-modal-backdrop" @onclick="CloseUpgradePrompt">
            <div class="sp-upgrade-modal" @onclick:stopPropagation="true">
                <div style="font-size:2.4rem;margin-bottom:8px;">🏅</div>
                <h3 style="font-size:1.35rem;font-weight:800;color:var(--sp-sage-dark);margin:0 0 8px;">Upgrade to Premium</h3>
                <p style="font-size:.85rem;color:var(--sp-muted);line-height:1.5;margin:0 0 20px;">
                    Unlock the full power of ShoppetCare for only <strong>₱150 for 2 months</strong>.<br />
                    Enjoy unlimited marketplace listings, full digital pet passport cards, and a recognized community rank badge.
                </p>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <button type="button" class="sp-contact" style="width:100%;border:none;cursor:pointer;font-size:.88rem;padding:12px;" @onclick="GoToUpgrade">
                        Upgrade Now · ₱150 / 2 Months
                    </button>
                    <button type="button" class="sp-btn-exit-preview" style="width:100%;padding:10px;" @onclick="CloseUpgradePrompt">
                        Maybe Later
                    </button>
                </div>
            </div>
        </div>
    }

    <MyShoppetCareNav />

    <!-- =====================================================
         GUEST PREVIEW
         ===================================================== -->

    @if (
        Auth.IsGuest
        &&
        IsHomePage()
    )
    {
        <GuestPreviewPanel />
    }


    <!-- =====================================================
         PAGE
         ===================================================== -->

    <main class="sp-content">
        @Body
    </main>


    <SiteFooter />

</div>


@code {
    private bool isMobileMenuOpen;
    private bool showUpgradePrompt;
    private int CartCount => Cart.Count;

    /* =========================================================
       START LISTENER
       ========================================================= */

    protected override void OnInitialized()
    {
        Auth.RegisterListener(
            OnAuthStateChanged);
        Cart.Changed += OnCartChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void ToggleMobileDrawer() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileDrawer() => isMobileMenuOpen = false;
    private void PromptUpgrade() { isMobileMenuOpen = false; showUpgradePrompt = true; }
    private void CloseUpgradePrompt() => showUpgradePrompt = false;
    private void GoToUpgrade() { showUpgradePrompt = false; Nav.NavigateTo("/premium"); }
    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        isMobileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }


    /* =========================================================
       INITIAL SESSION
       ========================================================= */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await Auth.InitializeAsync();


        await EnterGuestModeFromLandingAsync();


        await InvokeAsync(
            StateHasChanged);
    }


    /* =========================================================
       GUEST QUERY
       ========================================================= */

    private async Task EnterGuestModeFromLandingAsync()
    {
        var absoluteUri =
            Nav.ToAbsoluteUri(
                Nav.Uri);


        var hasGuestQuery =
            absoluteUri
                .Query
                .TrimStart('?')
                .Split(
                    '&',
                    StringSplitOptions.RemoveEmptyEntries)
                .Any(
                    pair =>
                        string.Equals(
                            pair,
                            "guest=true",
                            StringComparison.OrdinalIgnoreCase));


        if (!hasGuestQuery)
            return;


        if (!Auth.IsLoggedIn)
        {
            await Auth.EnterGuestModeAsync();
        }


        // Guest mode is now stored in session,
        // so remove ?guest=true from the URL.

        Nav.NavigateTo(
            "/home",
            replace: true);
    }


    /* =========================================================
       AUTH CHANGES
       ========================================================= */

    private void OnAuthStateChanged()
    {
        _ =
            InvokeAsync(
                StateHasChanged);
    }


    /* =========================================================
       ACTIVE NAV
       ========================================================= */

    private bool IsActive(
        string path)
    {
        var current =
            Nav.ToBaseRelativePath(
                Nav.Uri);


        current =
            "/"
            +
            current.TrimStart('/');


        if (path == "/")
            return current == "/";


        return
            current.StartsWith(
                path,
                StringComparison.OrdinalIgnoreCase);
    }


    private bool IsHomePage()
    {
        var current =
            Nav.ToBaseRelativePath(
                Nav.Uri);


        return
            current.StartsWith(
                "home",
                StringComparison.OrdinalIgnoreCase);
    }


    /* =========================================================
       ACCOUNT DESTINATION
       ========================================================= */

    private string GetProfileDestination()
    {
        if (Auth.IsAdmin)
        {
            return "/admin-portal";
        }


        return "/account";
    }
    private string GetUserProfilePhotoUrl()
    {
        if (Auth.CurrentUser is null)
        {
            return string.Empty;
        }


        return
            FileStorage.GetImageUrl(
                "users",
                Auth.CurrentUser.Id)
            ??
            string.Empty;
    }
    /* =========================================================
       DISPLAY NAME
       ========================================================= */

    private string GetUserDisplayName()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        return
            string.IsNullOrWhiteSpace(name)
                ? "Account"
                : name;
    }


    private string GetUserRole()
    {
        var role =
            Auth.CurrentUser?
                .Role?
                .Trim();


        return
            string.IsNullOrWhiteSpace(role)
                ? "Account"
                : role;
    }


    private string GetUserInitials()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        if (string.IsNullOrWhiteSpace(name))
            return "U";


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return
                parts[0]
                    .Substring(
                        0,
                        Math.Min(
                            2,
                            parts[0].Length))
                    .ToUpperInvariant();
        }


        return
            (
                parts[0].Substring(0,1)
                +
                parts[^1].Substring(0,1)
            )
            .ToUpperInvariant();
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();


        Nav.NavigateTo("/");
    }


    /* =========================================================
       EXIT GUEST
       ========================================================= */

    private async Task ExitGuestModeAsync()
    {
        await Auth.ExitGuestModeAsync();


        Nav.NavigateTo("/");
    }


    /* =========================================================
       DISPOSE
       ========================================================= */

    public void Dispose()
    {
        Auth.UnregisterListener(
            OnAuthStateChanged);
        Cart.Changed -= OnCartChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

}
