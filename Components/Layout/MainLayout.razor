@inherits LayoutComponentBase
@implements IDisposable
@inject FileStorageService FileStorage
@using Shoppet_VetClinic.Services

@inject AuthService Auth
@inject NavigationManager Nav

<style>

    :root {
        --sp-sage: #5C766D;
        --sp-sage-dark: #1E2D27;
        --sp-sage-light: #EEF4F1;

        --sp-cream: #FAF9F6;

        --sp-yellow: #F7DD7D;

        --sp-text: #34423C;

        --sp-muted: #7B8882;

        --sp-border: #E7EBE9;

        --sp-teal: #2F9098;

        --sp-teal-dark: #267C83;

        --sp-teal-soft: #EAF5F5;
    }


    * {
        box-sizing: border-box;
    }


    html,
    body {
        margin: 0;
        padding: 0;
    }


    body {
        background: var(--sp-cream);

        color: var(--sp-text);

        font-family:
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            Helvetica,
            Arial,
            sans-serif;
    }


    /* =========================================================
       LAYOUT
       ========================================================= */

    .sp-layout {
        min-height: 100vh;

        display: flex;
        flex-direction: column;

        background:
            linear-gradient(
                180deg,
                #FFFFFF 0%,
                #FAF9F6 100%
            );
    }


    /* =========================================================
       INFO BAR
       ========================================================= */

    .sp-info-bar {
        min-height: 34px;

        background:
            var(--sp-sage-dark);

        color: #E8EFEC;

        font-size: .72rem;

        font-weight: 500;

        letter-spacing: .01em;
    }


    .sp-info-inner {
        max-width: 1380px;

        min-height: 34px;

        margin: 0 auto;

        padding: 0 28px;

        display: flex;

        align-items: center;

        justify-content:
            space-between;

        gap: 20px;
    }


    .sp-info-left {
        opacity: .95;
    }


    .sp-info-right {
        opacity: .78;
    }


    .sp-info-guest {
        display: inline-flex;

        align-items: center;

        gap: 7px;

        color: #F7E6A5;

        font-weight: 700;

        opacity: 1;
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    .sp-navigation {
        position: sticky;

        top: 0;

        z-index: 1000;

        background:
            rgba(
                255,
                255,
                255,
                .97
            );

        border-bottom:
            1px solid
            var(--sp-border);

        backdrop-filter:
            blur(16px);

        -webkit-backdrop-filter:
            blur(16px);

        box-shadow:
            0 3px 18px
            rgba(30,45,39,.045);
    }


    .sp-navigation-inner {
        max-width: 1380px;

        min-height: 82px;

        margin: 0 auto;

        padding: 0 28px;

        display: flex;

        align-items: center;

        gap: 25px;
    }


    /* =========================================================
       BRAND
       ========================================================= */

    .sp-brand {
        display: flex;

        align-items: center;

        gap: 11px;

        flex-shrink: 0;

        text-decoration: none;
    }


    .sp-logo {
        width: 54px;
        height: 54px;

        object-fit: contain;
    }


    .sp-brand-content {
        display: flex;

        flex-direction: column;

        line-height: 1;
    }


    .sp-brand-name {
        color:
            var(--sp-sage-dark);

        font-size: 1.16rem;

        font-weight: 800;

        letter-spacing: -.035em;
    }


    .sp-brand-subtitle {
        margin-top: 5px;

        color: var(--sp-muted);

        font-size: .62rem;

        font-weight: 500;

        letter-spacing: .035em;

        text-transform: uppercase;
    }


    /* =========================================================
       MENU
       ========================================================= */

    .sp-menu {
        flex: 1;

        height: 100%;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 5px;
    }


    .sp-menu-link {
        position: relative;

        height: 82px;

        padding: 0 12px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        color: #596760;

        text-decoration: none;

        font-size: .82rem;

        font-weight: 600;

        white-space: nowrap;

        transition:
            color .2s ease,
            background .2s ease;
    }


    .sp-menu-link::after {
        content: "";

        position: absolute;

        left: 12px;
        right: 12px;

        bottom: 0;

        height: 3px;

        border-radius:
            3px 3px 0 0;

        background: transparent;

        transition:
            background .2s ease,
            transform .2s ease;
    }


    .sp-menu-link:hover {
        color:
            var(--sp-sage-dark);
    }


    .sp-menu-link:hover::after {
        background: #D8E4DF;
    }


    .sp-menu-link.active {
        color: var(--sp-sage);

        font-weight: 700;
    }


    .sp-menu-link.active::after {
        background: var(--sp-sage);
    }


    .sp-menu-link-premium {
        color: #B8860B;

        font-weight: 700;
    }


    .sp-menu-link-premium.active::after {
        background: #F7DD7D;
    }


    /* =========================================================
       RIGHT ACTIONS
       ========================================================= */

    .sp-actions,
    .sp-user-area,
    .sp-guest-area {
        display: flex;

        align-items: center;

        gap: 8px;

        flex-shrink: 0;
    }


    .sp-contact {
        min-height: 38px;

        padding: 0 16px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 9px;

        background: var(--sp-sage);

        color: #FFFFFF;

        text-decoration: none;

        font-size: .78rem;

        font-weight: 700;

        box-shadow:
            0 4px 12px
            rgba(92,118,109,.15);

        transition:
            background .2s ease,
            transform .2s ease;
    }


    .sp-contact:hover {
        transform:
            translateY(-1px);

        background:
            var(--sp-sage-dark);

        color: #FFFFFF;
    }



    .sp-contact-locked {
        gap: 6px;
        background: #EEF1F0;
        color: #8A9591;
        box-shadow: none;
        cursor: not-allowed;
        user-select: none;
    }

    .sp-contact-locked:hover {
        transform: none;
        background: #EEF1F0;
        color: #8A9591;
    }


    .sp-btn-login,
    .sp-btn-register,
    .sp-btn-exit-preview,
    .sp-btn-portal,
    .sp-btn-signout {
        min-height: 38px;

        padding: 0 14px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        border-radius: 9px;

        text-decoration: none;

        font-size: .76rem;

        font-weight: 750;

        transition:
            background .2s ease,
            color .2s ease,
            border-color .2s ease,
            transform .2s ease;
    }


    .sp-btn-login {
        border:
            1px solid
            var(--sp-border);

        background: #FFFFFF;

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-login:hover {
        background:
            var(--sp-sage-light);

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-register {
        border:
            1px solid
            var(--sp-teal);

        background:
            var(--sp-teal);

        color: #FFFFFF;
    }


    .sp-btn-register:hover {
        transform:
            translateY(-1px);

        border-color:
            var(--sp-teal-dark);

        background:
            var(--sp-teal-dark);

        color: #FFFFFF;
    }


    .sp-btn-exit-preview,
    .sp-btn-signout {
        border:
            1px solid
            var(--sp-border);

        background: transparent;

        color: #6B7772;

        cursor: pointer;
    }


    .sp-btn-exit-preview:hover {
        background: #F5F7F6;

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-signout:hover {
        background: #FEE2E2;

        color: #991B1B;

        border-color: #FCA5A5;
    }


    /* =========================================================
       GUEST
       ========================================================= */

    .sp-guest-pill {
        min-height: 38px;

        padding: 0 12px;

        display: inline-flex;

        align-items: center;

        gap: 7px;

        border:
            1px solid #D6E4E1;

        border-radius: 999px;

        background: #F1F7F5;

        color:
            var(--sp-teal-dark);

        font-size: .72rem;

        font-weight: 850;

        white-space: nowrap;
    }


    /* =========================================================
       LOGGED IN USER
       ========================================================= */

    .sp-user-profile {
        min-height: 42px;

        padding:
            4px 11px 4px 6px;

        display: inline-flex;

        align-items: center;

        gap: 9px;

        border:
            1px solid
            var(--sp-border);

        border-radius: 12px;

        background: #FFFFFF;

        text-decoration: none;

        transition: all .2s ease;
    }


    .sp-user-profile:hover {
        transform:
            translateY(-1px);

        background:
            var(--sp-sage-light);

        border-color: #D2DED9;
    }


    .sp-user-avatar {
        width: 31px;
        height: 31px;

        flex: 0 0 31px;

        display: grid;

        place-items: center;

        border-radius: 50%;

        background:
            var(--sp-sage-dark);

        color: #FFFFFF;

        font-size: .72rem;

        font-weight: 800;
    }

    .sp-user-avatar {
        overflow: hidden;
    }

        .sp-user-avatar.has-photo {
            padding: 0;
        }

        .sp-user-avatar img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

    .sp-user-info {
        display: flex;

        flex-direction: column;

        justify-content: center;

        line-height: 1.1;
    }


    .sp-user-name {
        max-width: 145px;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

        color:
            var(--sp-sage-dark);

        font-size: .76rem;

        font-weight: 750;
    }


    .sp-user-role {
        margin-top: 3px;

        color: var(--sp-muted);

        font-size: .61rem;

        font-weight: 600;

        text-transform: uppercase;

        letter-spacing: .035em;
    }


    .sp-btn-portal {
        border:
            1px solid #D9E4E0;

        background:
            var(--sp-sage-light);

        color:
            var(--sp-sage-dark);
    }


    .sp-btn-portal:hover {
        background: #DCE9E4;

        color:
            var(--sp-sage-dark);
    }


    /* =========================================================
       CONTENT
       ========================================================= */

    .sp-content {
        flex: 1 1 auto;

        min-width: 0;

        background:
            linear-gradient(
                180deg,
                #FAF9F6 0%,
                #F7F5EF 100%
            );
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .sp-navigation-inner {
            gap: 15px;

            padding: 0 15px;
        }


        .sp-menu-link {
            padding: 0 8px;

            font-size: .76rem;
        }


        .sp-user-name {
            max-width: 105px;
        }

    }


    @@media (max-width: 1050px) {

        .sp-guest-pill,
        .sp-contact {
            display: none;
        }

    }


    @@media (max-width: 950px) {

        .sp-info-right {
            display: none;
        }


        .sp-navigation-inner {
            gap: 10px;
        }


        .sp-menu {
            justify-content:
                flex-start;
        }


        .sp-menu-link {
            padding: 0 7px;

            font-size: .72rem;
        }


        .sp-user-role {
            display: none;
        }

    }


    @@media (max-width: 760px) {

        .sp-navigation-inner {
            min-height: 70px;

            padding: 0 12px;

            flex-wrap: wrap;
        }


        .sp-brand {
            min-height: 70px;
        }


        .sp-menu {
            order: 3;

            width: 100%;

            flex-basis: 100%;

            min-height: 45px;

            justify-content:
                flex-start;

            overflow-x: auto;
        }


        .sp-menu-link {
            height: 45px;
        }


        .sp-actions {
            margin-left: auto;
        }


        .sp-user-info,
        .sp-btn-portal,
        .sp-btn-exit-preview {
            display: none;
        }


        .sp-user-profile {
            padding: 4px;
        }

    }

</style>


<div class="sp-layout">

    <!-- =====================================================
         INFO BAR
         ===================================================== -->

    <div class="sp-info-bar">

        <div class="sp-info-inner">

            <span class="sp-info-left">

                Trusted Pet Care in
                Lipa City &amp; Tanauan

            </span>


            @if (Auth.IsGuest)
            {
                <span class="sp-info-right
                             sp-info-guest">

                    <i class="bi bi-eye-fill"
                       aria-hidden="true">
                    </i>

                    Guest Mode · Public browsing enabled

                </span>
            }
            else
            {
                <span class="sp-info-right">

                    Veterinary Care

                    &nbsp;•&nbsp;

                    Pet Supplies

                    &nbsp;•&nbsp;

                    ShoppetCare

                </span>
            }

        </div>

    </div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <header class="sp-navigation">

        <div class="sp-navigation-inner">

            <!-- BRAND -->

            <a href="/"
               class="sp-brand"
               data-enhance-nav="false"
               title="Return to the ShoppetCare landing page">

                <img src="/shoppetlogo.png"
                     alt="ShoppetCare"
                     class="sp-logo" />


                <div class="sp-brand-content">

                    <span class="sp-brand-name">
                        ShoppetCare
                    </span>

                    <span class="sp-brand-subtitle">
                        Pet Care Directory
                    </span>

                </div>

            </a>


            <!-- MENU -->

            <nav class="sp-menu">

                <a href="/home"
                   title="Open ShoppetCare Home"
                   class="sp-menu-link
                   @(IsActive("/home")
                       ? "active"
                       : "")">

                    Home

                </a>


                <a href="/services"
                   title="Explore ShoppetCare services"
                   class="sp-menu-link
                   @(IsActive("/services")
                       ? "active"
                       : "")">

                    Services

                </a>


                <a href="/clinics"
                   title="Find veterinary clinics"
                   class="sp-menu-link
                   @(IsActive("/clinics")
                       ? "active"
                       : "")">

                    Verified Clinics

                </a>
                <a href="/marketplace"
                   title="Browse the pre-loved pet Marketplace"
                   class="sp-menu-link @(IsActive("/marketplace") ? "active" : "")">
                    Marketplace
                </a>

                <a href="/marketplace/cart"
                   title="Open your Marketplace cart"
                   class="sp-menu-link @(IsActive("/marketplace/cart") ? "active" : "")">
                    Cart
                </a>


                <a href="/community"
                   title="Open the ShoppetCare Community"
                   class="sp-menu-link
                   @(IsActive("/community")
                       ? "active"
                       : "")">

                    Community

                </a>


                <a href="/announcements"
                   title="View ShoppetCare announcements"
                   class="sp-menu-link
                   @(IsActive("/announcements")
                       ? "active"
                       : "")">

                    Announcements

                </a>

                <a href="/about"
                   title="Learn about ShoppetCare"
                   class="sp-menu-link @(IsActive("/about") ? "active" : "")">
                    About
                </a>

                <a href="/help"
                   title="Search the ShoppetCare Help Center"
                   class="sp-menu-link @(IsActive("/help") ? "active" : "")">
                    Help
                </a>


                @if (Auth.IsLoggedIn && Auth.IsPetOwner)
                {
                    <a href="/dashboard"
                       class="sp-menu-link @(IsActive("/dashboard") ? "active" : "")">

                        My ShoppetCare

                    </a>
                
                }

            </nav>


            <!-- =================================================
                 RIGHT SIDE
                 ================================================= -->

            <div class="sp-actions">

                @if (Auth.IsGuest)
                {
                    <span class="sp-contact sp-contact-locked"
                          title="Locked: create an account or sign in to request a clinic listing">

                        <i class="bi bi-lock-fill"
                           aria-hidden="true"></i>

                        List Your Clinic

                    </span>
                }
                else
                {
                    <a href="/list-your-clinic"
                       class="sp-contact"
                       title="Request a clinic listing">

                        List Your Clinic

                    </a>
                }


                @if (Auth.IsLoggedIn)
                {
                    <!-- =========================================
                         REAL ACCOUNT
                         ========================================= -->

                    <div class="sp-user-area">

                        <NotificationBell />

                        <a href="@GetProfileDestination()"
                           class="sp-user-profile"
                           title="Open Account & Profile">

                            @if (!string.IsNullOrWhiteSpace(
                                GetUserProfilePhotoUrl()))
                            {
                                <span class="sp-user-avatar has-photo">

                                    <img src="@GetUserProfilePhotoUrl()"
                                         alt="@GetUserDisplayName()" />

                                </span>
                            }
                            else
                            {
                                <span class="sp-user-avatar">

                                    @GetUserInitials()

                                </span>
                            }


                            <span class="sp-user-info">

                                <span class="sp-user-name">
                                    @GetUserDisplayName()
                                </span>


                                <span class="sp-user-role">
                                    @GetUserRole()
                                </span>

                            </span>

                        </a>

                        @if (Auth.IsAdmin)
                        {
                            <a href="/admin-portal"
                               class="sp-btn-portal"
                               title="Open Super Admin dashboard">

                                Admin Portal

                            </a>
                        }
                        else if (Auth.IsClinicStaff)
                        {
                            <a href="/clinic-portal"
                               class="sp-btn-portal"
                               title="Open Clinic dashboard">

                                Clinic Portal

                            </a>
                        }


                        <button type="button"
                                class="sp-btn-signout"
                                title="Sign out of ShoppetCare"
                                @onclick="LogoutAsync">

                            Sign Out

                        </button>

                    </div>
                }
                else if (Auth.IsGuest)
                {
                    <!-- =========================================
                         GUEST MODE
                         ========================================= -->

                    <div class="sp-guest-area">

                        <a href="/guest-dashboard"
                           class="sp-guest-pill"
                           title="Open your Guest Dashboard"
                           style="text-decoration:none;">

                            <i class="bi bi-person-heart"
                               aria-hidden="true">
                            </i>

                            Guest Dashboard

                        </a>


                        <a href="/login"
                           class="sp-btn-login"
                           title="Sign in to ShoppetCare">

                            Sign In

                        </a>


                        <a href="/register"
                           class="sp-btn-register"
                           title="Create a free ShoppetCare account">

                            Create Account

                        </a>


                        <button type="button"
                                class="sp-btn-exit-preview"
                                title="Exit Guest Mode and return to Landing"
                                @onclick="ExitGuestModeAsync">

                            Exit

                        </button>

                    </div>
                }
                else
                {
                    <!-- =========================================
                         SIGNED OUT
                         ========================================= -->

                    <a href="/login"
                       class="sp-btn-login"
                       title="Sign in to ShoppetCare">

                        Sign In

                    </a>


                    <a href="/register"
                       class="sp-btn-register"
                       title="Create a free ShoppetCare account">

                        Register

                    </a>
                }

            </div>

        </div>

    </header>

    <MyShoppetCareNav />

    <!-- =====================================================
         GUEST PREVIEW
         ===================================================== -->

    @if (
        Auth.IsGuest
        &&
        IsHomePage()
    )
    {
        <GuestPreviewPanel />
    }


    <!-- =====================================================
         PAGE
         ===================================================== -->

    <main class="sp-content">
        @Body
    </main>


    <SiteFooter />

</div>


@code {

    /* =========================================================
       START LISTENER
       ========================================================= */

    protected override void OnInitialized()
    {
        Auth.RegisterListener(
            OnAuthStateChanged);
    }


    /* =========================================================
       INITIAL SESSION
       ========================================================= */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        await Auth.InitializeAsync();


        await EnterGuestModeFromLandingAsync();


        await InvokeAsync(
            StateHasChanged);
    }


    /* =========================================================
       GUEST QUERY
       ========================================================= */

    private async Task EnterGuestModeFromLandingAsync()
    {
        var absoluteUri =
            Nav.ToAbsoluteUri(
                Nav.Uri);


        var hasGuestQuery =
            absoluteUri
                .Query
                .TrimStart('?')
                .Split(
                    '&',
                    StringSplitOptions.RemoveEmptyEntries)
                .Any(
                    pair =>
                        string.Equals(
                            pair,
                            "guest=true",
                            StringComparison.OrdinalIgnoreCase));


        if (!hasGuestQuery)
            return;


        if (!Auth.IsLoggedIn)
        {
            await Auth.EnterGuestModeAsync();
        }


        // Guest mode is now stored in session,
        // so remove ?guest=true from the URL.

        Nav.NavigateTo(
            "/home",
            replace: true);
    }


    /* =========================================================
       AUTH CHANGES
       ========================================================= */

    private void OnAuthStateChanged()
    {
        _ =
            InvokeAsync(
                StateHasChanged);
    }


    /* =========================================================
       ACTIVE NAV
       ========================================================= */

    private bool IsActive(
        string path)
    {
        var current =
            Nav.ToBaseRelativePath(
                Nav.Uri);


        current =
            "/"
            +
            current.TrimStart('/');


        if (path == "/")
            return current == "/";


        return
            current.StartsWith(
                path,
                StringComparison.OrdinalIgnoreCase);
    }


    private bool IsHomePage()
    {
        var current =
            Nav.ToBaseRelativePath(
                Nav.Uri);


        return
            current.StartsWith(
                "home",
                StringComparison.OrdinalIgnoreCase);
    }


    /* =========================================================
       ACCOUNT DESTINATION
       ========================================================= */

    private string GetProfileDestination()
    {
        if (Auth.IsAdmin)
        {
            return "/admin-portal";
        }


        if (Auth.IsClinicStaff)
        {
            return "/clinic-portal";
        }


        return "/account";
    }
    private string GetUserProfilePhotoUrl()
    {
        if (Auth.CurrentUser is null)
        {
            return string.Empty;
        }


        return
            FileStorage.GetImageUrl(
                "users",
                Auth.CurrentUser.Id)
            ??
            string.Empty;
    }
    /* =========================================================
       DISPLAY NAME
       ========================================================= */

    private string GetUserDisplayName()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        return
            string.IsNullOrWhiteSpace(name)
                ? "Account"
                : name;
    }


    private string GetUserRole()
    {
        var role =
            Auth.CurrentUser?
                .Role?
                .Trim();


        return
            string.IsNullOrWhiteSpace(role)
                ? "Account"
                : role;
    }


    private string GetUserInitials()
    {
        var name =
            Auth.CurrentUser?
                .FullName?
                .Trim();


        if (string.IsNullOrWhiteSpace(name))
            return "U";


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return
                parts[0]
                    .Substring(
                        0,
                        Math.Min(
                            2,
                            parts[0].Length))
                    .ToUpperInvariant();
        }


        return
            (
                parts[0].Substring(0,1)
                +
                parts[^1].Substring(0,1)
            )
            .ToUpperInvariant();
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();


        Nav.NavigateTo("/");
    }


    /* =========================================================
       EXIT GUEST
       ========================================================= */

    private async Task ExitGuestModeAsync()
    {
        await Auth.ExitGuestModeAsync();


        Nav.NavigateTo("/");
    }


    /* =========================================================
       DISPOSE
       ========================================================= */

    public void Dispose()
    {
        Auth.UnregisterListener(
            OnAuthStateChanged);
    }

}