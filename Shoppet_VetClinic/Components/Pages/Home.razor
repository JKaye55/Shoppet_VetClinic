                        <span class="fw-bold fs-5" style="color: var(--pb-sage-dark);">ShoppetCare</span>
                    </div>
                    <p class="small text-muted mb-3" style="max-width: 320px;">
                        Lipa City's partner for clinical veterinary consultations, verified practitioner listings, and counter supply pickup.
                    </p>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3 small text-uppercase" style="color: var(--pb-text-title);">Navigation</h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><a href="javascript:void(0)" @onclick='() => currentTab = "clinics"'>Partner Clinics</a></li>
                        <li class="mb-2"><a href="javascript:void(0)" @onclick='() => currentTab = "shop"'>Clinical Supplies</a></li>
                        <li class="mb-2"><a href="javascript:void(0)" @onclick='() => currentTab = "appointments"'>Consultation Booking</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold mb-3 small text-uppercase" style="color: var(--pb-text-title);">Standards</h6>
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2">PRC Board of Veterinary Medicine</li>
                        <li class="mb-2">RA 11967 Counter Pickup Standard</li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold mb-3 small text-uppercase" style="color: var(--pb-text-title);">Lipa Central Hub</h6>
                    <p class="small text-muted mb-1">📍 Ayala Highway & Marawoy Crossroads</p>
                    <p class="small text-muted mb-0">🕒 Mon - Sat: 8:00 AM - 6:00 PM</p>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-muted">
                <span>© 2026 Shoppet Care Systems. All rights reserved.</span>
                <span>Role Scope: <strong>Consumer / Pet Parent</strong></span>
            </div>
        </div>
    </footer>

    <!-- PROFESSIONAL AUTHENTICATION MODAL (SIGN IN / REGISTER) -->
    @if (showAuthModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(30, 40, 36, 0.65); backdrop-filter: blur(6px); z-index: 1200;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4 bg-white text-dark overflow-hidden">
                    <div class="p-4 text-white text-center position-relative" style="background: linear-gradient(135deg, var(--pb-sage-dark) 0%, var(--pb-sage) 100%);">
                        <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" @onclick="() => showAuthModal = false"></button>
                        <div class="fs-1 mb-1">🐾</div>
                        <h4 class="fw-bold mb-1">Shoppet<span style="color: var(--pb-butter);">Care</span> Security Node</h4>
                        <p class="small opacity-75 mb-0">@(isRegisterMode ? "Create your verified portal account" : "Sign in to access your dashboard")</p>
                    </div>

                    <div class="p-4 p-md-5">
                        @if (!string.IsNullOrEmpty(authErrorMessage))
                        {
                            <div class="alert alert-danger py-2 small rounded-3 mb-3 border-0 bg-danger bg-opacity-10 text-danger fw-semibold">
                                ⚠️ @authErrorMessage
                            </div>
                        }

                        @if (isRegisterMode)
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Full Name *</label>
                                <input class="form-control rounded-3 py-2" @bind="regName" placeholder="Juan Dela Cruz" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Email Address (Domain Restricted) *</label>
                                <input class="form-control rounded-3 py-2" @bind="regEmail" placeholder="name@shoppet.com or name@gmail.com" />
                                <small class="text-muted" style="font-size: 0.72rem;">Allowed domains: @string.Join(", ", allowedDomains)</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Password (Min. 6 chars) *</label>
                                <input type="password" class="form-control rounded-3 py-2" @bind="regPassword" placeholder="••••••••" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Confirm Password *</label>
                                <input type="password" class="form-control rounded-3 py-2" @bind="regConfirmPassword" placeholder="••••••••" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted mb-1">Assigned Portal Role</label>
                                <select class="form-select rounded-3 py-2" @bind="regRole">
                                    <option value="Pet Owner">Pet Owner / Customer</option>
                                    <option value="Clinic Staff">Clinic Staff / Reception</option>
                                    <option value="Admin">Platform Administrator</option>
                                </select>
                            </div>

                            <button class="btn-pb-yellow w-100 py-3 fw-bold shadow-sm mb-3" @onclick="HandleRegister">
                                Register Verified Account
                            </button>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-1">Email Address *</label>
                                <input class="form-control rounded-3 py-2" @bind="regEmail" placeholder="name@example.com" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted mb-1">Password *</label>
                                <input type="password" class="form-control rounded-3 py-2" @bind="regPassword" placeholder="••••••••" />
                            </div>

                            <button class="btn-pb-yellow w-100 py-3 fw-bold shadow-sm mb-3" @onclick="HandleLogin">
                                Sign In to Portal
                            </button>
                        }

                        <div class="text-center pt-2 border-top">
                            <button class="btn btn-sm btn-link text-decoration-none text-muted fw-semibold" @onclick="() => { isRegisterMode = !isRegisterMode; authErrorMessage = string.Empty; }">
                                @(isRegisterMode ? "Already registered? Sign in here" : "Don't have an account? Create one")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- CART MODAL -->
    @if (showCartModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(30, 40, 36, 0.5); backdrop-filter: blur(4px); z-index: 1100;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg p-4 rounded-4 bg-white text-dark">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" style="color: var(--pb-sage-dark);">Click-and-Collect Reservation</h5>
                        <button type="button" class="btn-close" @onclick="CloseReceipt"></button>
                    </div>

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(issuedClaimToken))
                        {
                            <div class="text-center py-3">
                                <div class="badge p-3 rounded-circle mb-3 fs-4" style="background: var(--pb-sage-soft); color: var(--pb-sage);">✓</div>
                                <h5 class="fw-bold mb-1">Reservation Authorized</h5>
                                <p class="small text-muted mb-4">Present this digital code at the clinic counter or share with your rider.</p>

                                <div class="p-3 rounded-3 border mb-3 font-monospace" style="background: var(--pb-cream);">
                                    <small class="text-muted d-block text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Counter Claim Token</small>
                                    <h3 class="fw-bold mb-0" style="color: var(--pb-sage-dark);">@issuedClaimToken</h3>
                                </div>

                                <small class="text-muted d-block mb-3">Legal Point of Handoff: Partner Clinic Counter</small>
                                <button class="btn-pb-sage w-100 py-2" @onclick="CloseReceipt">Done</button>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3" style="max-height: 180px; overflow-y: auto;">
                                @if (!CartItems.Any())
                                {
                                    <p class="text-muted text-center py-4 small">Your reservation basket is empty.</p>
                                }
                                else
                                {
                                    @foreach (var item in CartItems)
                                    {
                                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom small">
                                            <div>
                                                <span class="fw-bold">@item.Name</span>
                                                <div class="text-muted">₱@item.Price.ToString("N2") × @item.Quantity</div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-bold" style="color: var(--pb-sage);">₱@item.Subtotal.ToString("N2")</span>
                                                <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" @onclick="() => RemoveFromCart(item.ProductId)">✕</button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            @if (CartItems.Any())
                            {
                                <div class="mb-2">
                                    <label class="form-label small fw-bold text-muted mb-1">Pet Owner Full Name *</label>
                                    <input class="form-control form-control-sm rounded-3" @bind="checkoutCustomerName" placeholder="Juan Dela Cruz" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold text-muted mb-1">Contact Number (GCash/Maya) *</label>
                                    <input class="form-control form-control-sm rounded-3" @bind="checkoutContact" placeholder="0917XXXXXXX" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted mb-1">Dispensation Method</label>
                                    <select class="form-select form-select-sm rounded-3" @bind="selectedFulfillment">
                                        <option value="In-Store Pickup">In-Store Counter Pickup (Self)</option>
                                        <option value="Buyer-Arranged Courier">Buyer-Arranged Courier (Grab / Lalamove)</option>
                                    </select>
                                </div>

                                <div class="p-3 rounded-3 small mb-3 border" style="background: var(--pb-cream);">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Supplies Subtotal:</span>
                                        <span class="fw-bold">₱@CartTotal.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Gateway Fee:</span>
                                        <span class="fw-bold">₱20.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between fw-bold pt-2 border-top">
                                        <span>Total Payable:</span>
                                        <span style="color: var(--pb-sage);">₱@((CartTotal + 20.00m).ToString("N2"))</span>
                                    </div>
                                </div>

                                <button class="btn-pb-yellow w-100 py-2 shadow-sm"
                                        disabled="@(string.IsNullOrWhiteSpace(checkoutCustomerName) || string.IsNullOrWhiteSpace(checkoutContact))"
                                        @onclick="ExecuteClickAndCollectCheckout">
                                    Authorize Reservation & Get Claim Token
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string currentTab = "home";
    private string selectedServiceTab = "Vet";
    private bool showUserMenu = false;
    private bool showAuthModal = false;
    private bool isRegisterMode = false;
    private bool showCartModal = false;

    private string regName = string.Empty;
    private string regEmail = string.Empty;
    private string regPassword = string.Empty;
    private string regConfirmPassword = string.Empty;
    private string regRole = "Pet Owner";
    private string authErrorMessage = string.Empty;

    private readonly string[] allowedDomains = { "shoppet.com", "gmail.com", "yahoo.com", "outlook.com", "nu.edu.ph" };

    private int CartCount => CartItems.Sum(x => x.Quantity);
    private decimal CartTotal => CartItems.Sum(x => x.Subtotal);

    private List<ClinicTenant> clinics = new();
    private List<PetProduct> allProducts = new();
    private List<CartItem> CartItems = new();
    private ClinicAppointment newAppointment = new() { ClinicId = 1, ServiceType = "General Checkup / Consultation" };
    private bool appointmentSubmitted = false;

    private string searchQuery = string.Empty;
    private string selectedCategory = string.Empty;
    private string selectedTier = string.Empty;
    private readonly string[] petTiers = { "All", "Small Pets", "Medium Pets", "Large Pets" };

    private string checkoutCustomerName = string.Empty;
    private string checkoutContact = string.Empty;
    private string selectedFulfillment = "In-Store Pickup";
    private string issuedClaimToken = string.Empty;

    protected override void OnInitialized()
    {
        Auth.RegisterListener(() => InvokeAsync(StateHasChanged));
        clinics = DbService.GetAllClinics();
        allProducts = DbService.GetAllProducts();
        CartItems = DbService.GetCartItems();
    }

    public void Dispose() => Auth.UnregisterListener(() => InvokeAsync(StateHasChanged));

    private void HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(regEmail) || string.IsNullOrWhiteSpace(regPassword))
        {
            authErrorMessage = "Please enter both email and password.";
            return;
        }

        var user = DbService.AuthenticateUser(regEmail, regPassword);
        if (user != null)
        {
            Auth.Login(user);
            showAuthModal = false;
            authErrorMessage = string.Empty;
            regEmail = string.Empty;
            regPassword = string.Empty;
        }
        else
        {
            authErrorMessage = "Invalid credentials. Try: user@shoppet.com / user123";
        }
    }

    private void HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(regName) || string.IsNullOrWhiteSpace(regEmail) ||
            string.IsNullOrWhiteSpace(regPassword) || string.IsNullOrWhiteSpace(regConfirmPassword))
        {
            authErrorMessage = "All registration fields are required.";
            return;
        }

        if (regPassword.Length < 6)
        {
            authErrorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (regPassword != regConfirmPassword)
        {
            authErrorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            var emailParts = regEmail.Split('@');
            if (emailParts.Length != 2)
            {
                authErrorMessage = "Invalid email format.";
                return;
            }
            string domain = emailParts[1].Trim().ToLower();
            if (!allowedDomains.Contains(domain))
            {
                authErrorMessage = $"Email domain '@{domain}' is not permitted. Allowed: {string.Join(", ", allowedDomains)}";
                return;
            }
        }
        catch
        {
            authErrorMessage = "Please enter a valid email address.";
            return;
        }

        var newUser = DbService.RegisterUser(regName, regEmail, regPassword, regRole);
        if (newUser != null)
        {
            Auth.Login(newUser);
            showAuthModal = false;
            authErrorMessage = string.Empty;
            regName = string.Empty;
            regEmail = string.Empty;
            regPassword = string.Empty;
            regConfirmPassword = string.Empty;
        }
        else
        {
            authErrorMessage = "This email address is already registered in the database.";
        }
    }

    private void PerformLogout()
    {
        Auth.Logout();
        showUserMenu = false;
        Nav.NavigateTo("/");
    }

    private void HandleWidgetSearch()
    {
        if (selectedServiceTab == "Food" || selectedServiceTab == "Pharmacy")
        {
            selectedCategory = selectedServiceTab == "Food" ? "Food" : "Health";
            currentTab = "shop";
        }
        else
        {
            newAppointment.ServiceType = selectedServiceTab switch
            {
                "Vaccine" => "Core Vaccination (Anti-Rabies / DHPP)",
                "Grooming" => "Medicated Grooming & Skin Care",
                _ => "General Checkup / Consultation"
            };
            currentTab = "appointments";
        }
    }

    private void DirectBookService(string serviceType)
    {
        newAppointment.ServiceType = serviceType;
        currentTab = "appointments";
    }

    private void FilterShopByCategory(string cat)
    {
        selectedCategory = cat;
        currentTab = "shop";
    }

    private IEnumerable<PetProduct> FilteredProducts =>
        allProducts.Where(p =>
            (string.IsNullOrEmpty(selectedCategory) || p.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedTier) || selectedTier == "All" || p.PetSize.Equals(selectedTier, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(searchQuery) ||
             p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
             p.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    private void SetActiveTier(string tier) => selectedTier = tier == "All" ? string.Empty : tier;

    private void ToggleCategoryFilter(string cat)
    {
        selectedCategory = selectedCategory.Equals(cat, StringComparison.OrdinalIgnoreCase) ? string.Empty : cat;
    }

    private void ResetAllFilters()
    {
        searchQuery = string.Empty;
        selectedCategory = string.Empty;
        selectedTier = string.Empty;
    }

    private void AddToCart(int productId)
    {
        DbService.AddOrIncrementCart(productId);
        CartItems = DbService.GetCartItems();
    }

    private void RemoveFromCart(int productId)
    {
        DbService.RemoveFromCart(productId);
        CartItems = DbService.GetCartItems();
    }

    private void ExecuteClickAndCollectCheckout()
    {
        if (!CartItems.Any() || string.IsNullOrWhiteSpace(checkoutCustomerName)) return;

        issuedClaimToken = DbService.CreateClickAndCollectOrder(1, checkoutCustomerName, checkoutContact, selectedFulfillment, CartItems);
        CartItems = DbService.GetCartItems();
    }

    private void CloseReceipt()
    {
        issuedClaimToken = string.Empty;
        showCartModal = false;
        checkoutCustomerName = string.Empty;
        checkoutContact = string.Empty;
    }

    private void SubmitAppointment()
    {
        DbService.BookAppointment(newAppointment);
        appointmentSubmitted = true;
        newAppointment = new ClinicAppointment { ClinicId = 1, ServiceType = "General Checkup / Consultation" };
    }
}