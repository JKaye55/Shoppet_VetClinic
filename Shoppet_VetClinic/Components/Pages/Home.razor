@page "/"
@using Shoppet_VetClinic.Models
@using Shoppet_VetClinic.Services
@inject DatabaseService DbService
@inject AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer

<style>
    :root {
        --pb-sage: #5C766D;
        --pb-sage-dark: #1E2D27;
        --pb-sage-soft: #EEF4F1;
        --pb-butter: #F7DD7D;
        --pb-butter-hover: #F2D257;
        --pb-cream: #FAF9F6;
        --pb-cream-alt: #F3EFEA;
        --pb-text-title: #1E2824;
        --pb-text-body: #4A5650;
        --pb-text-muted: #7E8C85;
        --pb-border: #E6EAE8;
        --pb-radius-pill: 9999px;
        --pb-radius-card: 20px;
        --pb-shadow-soft: 0 12px 32px -6px rgba(47, 66, 59, 0.08);
    }

    .shoppet-viewport {
        background: linear-gradient(180deg, #F5F8F6 0%, #FAF9F6 40%, #F5F3ED 100%);
        color: var(--pb-text-body);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .pb-topstrip {
        background-color: var(--pb-sage-dark);
        border-bottom: 2px solid var(--pb-butter);
        font-size: 0.8rem;
        padding: 7px 0;
        color: #E2ECE7;
    }

    .pb-navbar {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--pb-border);
        padding: 0.85rem 0;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .pb-nav-btn {
        background: transparent;
        border: none;
        color: var(--pb-text-body);
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.5rem 1.1rem;
        border-radius: var(--pb-radius-pill);
        transition: all 0.15s ease;
        cursor: pointer;
    }

        .pb-nav-btn:hover {
            background-color: var(--pb-sage-soft);
            color: var(--pb-sage-dark);
        }

        .pb-nav-btn.active {
            background-color: var(--pb-sage);
            color: #FFFFFF !important;
        }

    .pb-hero-chamber {
        position: relative;
        background-color: #1a2923;
        background-image: linear-gradient(90deg, rgba(20, 32, 27, 0.94) 0%, rgba(24, 38, 32, 0.88) 42%, rgba(24, 38, 32, 0.20) 65%, rgba(0, 0, 0, 0.0) 80% ), url('/hero_vet_hd.jpg');
        background-size: cover;
        background-position: center right;
        background-repeat: no-repeat;
        padding: 5rem 0 5.5rem 0;
        min-height: 560px;
        color: #FFFFFF;
        box-shadow: inset 0 -20px 30px -10px rgba(0, 0, 0, 0.25);
    }

    .pb-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(247, 221, 125, 0.18);
        border: 1.5px solid var(--pb-butter);
        color: var(--pb-butter);
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.4rem 1.1rem;
        border-radius: var(--pb-radius-pill);
        margin-bottom: 1.25rem;
    }

    .pb-hero-h1 {
        font-size: 2.85rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.15;
        color: #FFFFFF;
        margin-bottom: 1rem;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
    }

    .pb-hero-p {
        font-size: 1.08rem;
        color: #E0EAE5;
        line-height: 1.55;
        margin-bottom: 2rem;
    }

    .pb-concierge-card-glass {
        background: rgba(255, 255, 255, 0.90) !important;
        backdrop-filter: blur(16px);
        border: 1.5px solid rgba(255, 255, 255, 0.8);
        border-radius: 24px;
        box-shadow: 0 24px 48px -10px rgba(0, 0, 0, 0.4);
        padding: 1.5rem;
        text-align: left;
        color: var(--pb-text-title);
    }

    .pb-tab-bar {
        display: flex;
        gap: 0.5rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        padding-bottom: 1rem;
        margin-bottom: 1.25rem;
        overflow-x: auto;
    }

    .pb-tab-item {
        background: rgba(255, 255, 255, 0.65);
        border: 1px solid rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--pb-text-body);
        font-size: 0.86rem;
        font-weight: 700;
        padding: 0.5rem 0.95rem;
        border-radius: var(--pb-radius-pill);
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
    }

        .pb-tab-item:hover {
            background: var(--pb-sage-soft);
            color: var(--pb-sage-dark);
        }

        .pb-tab-item.active {
            background: var(--pb-sage) !important;
            color: #FFFFFF !important;
        }

    .color-grid-unit {
        border-radius: var(--pb-radius-card);
        border: 1px solid transparent;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        cursor: pointer;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        background: #FFFFFF;
    }

        .color-grid-unit:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 32px -6px rgba(47, 66, 59, 0.14);
        }

    .cg-photo-header {
        height: 130px;
        width: 100%;
        overflow: hidden;
        position: relative;
        background-color: var(--pb-cream);
    }

        .cg-photo-header img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .color-grid-unit:hover .cg-photo-header img {
        transform: scale(1.08);
    }

    .cg-sage {
        background: #F4F8F6;
        border-color: #DCE7E2;
    }

    .cg-butter {
        background: #FEFBEE;
        border-color: #F8EFC8;
    }

    .cg-blue {
        background: #F3F7FA;
        border-color: #DCE7F2;
    }

    .cg-rose {
        background: #FBF4F4;
        border-color: #F2DEDE;
    }

    .cg-lavender {
        background: #F7F4FB;
        border-color: #E6DCF5;
    }

    .cg-amber {
        background: #FAF5F0;
        border-color: #F2E4D5;
    }

    .btn-pb-yellow {
        background-color: var(--pb-butter);
        color: #2F423B;
        font-weight: 800;
        border: none;
        border-radius: var(--pb-radius-pill);
        padding: 0.65rem 1.6rem;
        transition: all 0.15s ease;
        box-shadow: 0 4px 14px rgba(247, 221, 125, 0.45);
        cursor: pointer;
    }

        .btn-pb-yellow:hover {
            background-color: var(--pb-butter-hover);
            transform: translateY(-1px);
        }

    .btn-pb-sage {
        background-color: var(--pb-sage);
        color: #FFFFFF;
        font-weight: 700;
        border: none;
        border-radius: var(--pb-radius-pill);
        padding: 0.55rem 1.3rem;
        transition: all 0.15s ease;
        cursor: pointer;
    }

        .btn-pb-sage:hover {
            background-color: var(--pb-sage-dark);
            color: #FFFFFF;
        }

    .pb-clean-card {
        background: #FFFFFF;
        border: 1px solid var(--pb-border);
        border-radius: var(--pb-radius-card);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        overflow: hidden;
    }

        .pb-clean-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--pb-shadow-soft);
            border-color: var(--pb-sage);
        }

    .pb-img-box {
        height: 190px;
        background: var(--pb-cream);
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid var(--pb-border);
        padding: 1.25rem;
    }

        .pb-img-box img {
            max-height: 85%;
            max-width: 85%;
            object-fit: contain;
        }

    .pb-band-tinted {
        background: linear-gradient(180deg, #F3EFEA 0%, #FAF9F6 100%);
        border-top: 1px solid var(--pb-border);
        border-bottom: 1px solid var(--pb-border);
        padding: 4.5rem 0;
    }

    .trust-photo-card {
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(47, 66, 59, 0.16);
        border: 4px solid #FFFFFF;
        height: 380px;
    }

        .trust-photo-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pb-pillar-card {
        background: #FFFFFF;
        border: 1px solid var(--pb-border);
        border-radius: 18px;
        padding: 1.75rem 1.5rem;
        height: 100%;
        box-shadow: 0 4px 16px rgba(47, 66, 59, 0.04);
        border-left: 4px solid var(--pb-sage);
    }

    .pb-partner-banner {
        background: linear-gradient(135deg, var(--pb-sage-dark) 0%, var(--pb-sage) 100%);
        border-radius: 28px;
        color: #FFFFFF;
        padding: 3.5rem 3rem;
        box-shadow: 0 24px 48px -12px rgba(47, 66, 59, 0.35);
        overflow: hidden;
    }

    .team-photo-container {
        border-radius: 20px;
        overflow: hidden;
        border: 4px solid rgba(255, 255, 255, 0.25);
        box-shadow: 0 16px 36px rgba(0,0,0,0.3);
        height: 280px;
    }

        .team-photo-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
        }

    .pb-filter-pill {
        border: 1px solid var(--pb-border);
        background: #FFFFFF;
        color: var(--pb-text-muted);
        font-size: 0.84rem;
        font-weight: 600;
        padding: 0.4rem 1.15rem;
        border-radius: var(--pb-radius-pill);
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .pb-filter-pill:hover {
            background: var(--pb-sage-soft);
            color: var(--pb-sage-dark);
        }

        .pb-filter-pill.active {
            background: var(--pb-sage);
            color: #FFFFFF;
            border-color: var(--pb-sage);
        }

    .community-photo-card {
        border-radius: 16px;
        overflow: hidden;
        height: 200px;
        position: relative;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        border: 2px solid #FFFFFF;
    }

        .community-photo-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .community-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(0deg, rgba(30, 45, 39, 0.9) 0%, transparent 100%);
        padding: 0.75rem;
        color: #FFFFFF;
        font-size: 0.75rem;
    }

    .pb-footer {
        background-color: var(--pb-cream-alt);
        border-top: 1px solid var(--pb-border);
        padding: 4rem 0 2rem 0;
        color: var(--pb-text-muted);
        font-size: 0.88rem;
        margin-top: auto;
    }

        .pb-footer a {
            color: var(--pb-text-body);
            text-decoration: none;
        }

            .pb-footer a:hover {
                color: var(--pb-sage);
            }
</style>

<div class="shoppet-viewport">

    <!-- TOP COMPLIANCE STRIP -->
    <div class="pb-topstrip">
        <div class="container-xl d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span>🐾 <strong>ShoppetCare Lipa</strong> • Verified Partner of Licensed Veterinary Practitioners</span>
            </div>
            <div class="d-none d-md-flex align-items-center gap-3 small">
                <span>In-Store & Courier Pickup (RA 11967)</span>
                <span class="badge" style="background: var(--pb-butter); color: #1E2D27; font-weight: 700;">LIPA HUB</span>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <nav class="pb-navbar">
        <div class="container-xl d-flex justify-content-between align-items-center">
            <a class="d-flex align-items-center gap-2 text-decoration-none" href="/" @onclick='() => currentTab = "home"'>
                <img src="/shoppetlogo.png" alt="Shoppet" style="height: 38px; width: auto; object-fit: contain;" />
                <div class="d-flex flex-column">
                    <span class="fw-bold fs-5 tracking-tight" style="color: var(--pb-sage-dark); line-height: 1;">Shoppet<span style="color: #427AB5;">Care</span></span>
                    <span class="fw-bold" style="color: var(--pb-sage); font-size: 0.62rem; letter-spacing: 0.5px;">HAPPY PETS, NO REGRETS</span>
                </div>
            </a>

            <!-- Navigation Center -->
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="pb-nav-btn @(currentTab == "home" ? "active" : "")" @onclick='() => currentTab = "home"'>Services</button>
                <button type="button" class="pb-nav-btn @(currentTab == "clinics" ? "active" : "")" @onclick='() => currentTab = "clinics"'>Verified Clinics</button>
                <button type="button" class="pb-nav-btn @(currentTab == "shop" ? "active" : "")" @onclick='() => currentTab = "shop"'>Pharmacy & Food</button>
                <button type="button" class="pb-nav-btn @(currentTab == "appointments" ? "active" : "")" @onclick='() => currentTab = "appointments"'>Book Consult</button>
                <button type="button" class="pb-nav-btn @(currentTab == "forclinics" ? "active" : "")" @onclick='() => currentTab = "forclinics"'>For Clinics</button>
            </div>

            <!-- Professional Authentication & Cart Controls -->
            <div class="d-flex align-items-center gap-3">
                @if (Auth.IsLoggedIn)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm rounded-pill px-3 fw-bold dropdown-toggle d-flex align-items-center gap-2 shadow-sm" style="background: var(--pb-sage-soft); color: var(--pb-sage-dark); border: 1px solid #DCE7E2;" type="button" @onclick="() => showUserMenu = !showUserMenu">
                            <span style="width: 26px; height: 26px; background: var(--pb-sage); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;">👤</span>
                            <span>@Auth.CurrentUser?.FullName</span>
                            <span class="badge bg-white text-dark border ms-1" style="font-size: 0.65rem;">@Auth.CurrentUser?.Role</span>
                        </button>
                        @if (showUserMenu)
                        {
                            <div class="dropdown-menu dropdown-menu-end show shadow-lg border-0 mt-2 p-2 rounded-4" style="min-width: 220px;">
                                <div class="px-3 py-2 border-bottom mb-1">
                                    <span class="d-block small text-muted">Signed in as</span>
                                    <strong class="text-dark text-truncate d-block" style="font-size: 0.85rem;">@Auth.CurrentUser?.Email</strong>
                                </div>
                                @if (Auth.CurrentUser?.Role == "Clinic Staff" || Auth.CurrentUser?.Role == "Admin")
                                {
                                    <button class="dropdown-item py-2 small fw-semibold rounded-3 d-flex align-items-center gap-2" @onclick='() => Nav.NavigateTo("/clinic-portal")'>
                                        <span>🏥</span> Clinic Reception Desk
                                    </button>
                                }
                                @if (Auth.CurrentUser?.Role == "Admin")
                                {
                                    <button class="dropdown-item py-2 small fw-semibold rounded-3 d-flex align-items-center gap-2" @onclick='() => Nav.NavigateTo("/admin-portal")'>
                                        <span>🛡️</span> Platform Admin Console
                                    </button>
                                }
                                <div class="dropdown-divider my-1"></div>
                                <button class="dropdown-item py-2 small fw-bold text-danger rounded-3 d-flex align-items-center gap-2" @onclick="PerformLogout">
                                    <span>🚪</span> Sign Out
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <button class="btn btn-sm rounded-pill px-4 fw-bold shadow-sm py-2" style="background: var(--pb-sage-dark); color: #FFFFFF; transition: all 0.2s;" @onclick="() => { showAuthModal = true; isRegisterMode = false; authErrorMessage = string.Empty; }">
                        🔒 Sign In / Register
                    </button>
                }

                <button class="btn-pb-yellow btn-sm" @onclick="() => showCartModal = true">
                    🛒 Cart @(CartCount > 0 ? $"({CartCount})" : "")
                </button>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">

        @if (currentTab == "home")
        {
            <!-- HERO -->
            <section class="pb-hero-chamber">
                <div class="container-xl">
                    <div class="row align-items-center">
                        <div class="col-xl-6 col-lg-7 col-md-9 text-start">
                            <div class="pb-hero-tag">
                                <span>🛡️</span>
                                <span>PRC-Verified Veterinary & Clinical Pharmacy Network</span>
                            </div>
                            <h1 class="pb-hero-h1">
                                Find Trusted Veterinary Clinics & Supplies in Lipa City
                            </h1>
                            <p class="pb-hero-p">
                                Connect with accredited veterinarians, schedule checkups, and reserve prescription pet diets for seamless counter pickup.
                            </p>

                            <div class="pb-concierge-card-glass">
                                <div class="pb-tab-bar">
                                    <button type="button" class="pb-tab-item @(selectedServiceTab == "Vet" ? "active" : "")" @onclick='() => selectedServiceTab = "Vet"'>
                                        <span>🩺</span>
                                        <span>Vet Consult</span>
                                    </button>
                                    <button type="button" class="pb-tab-item @(selectedServiceTab == "Vaccine" ? "active" : "")" @onclick='() => selectedServiceTab = "Vaccine"'>
                                        <span>💉</span>
                                        <span>Vaccinations</span>
                                    </button>
                                    <button type="button" class="pb-tab-item @(selectedServiceTab == "Food" ? "active" : "")" @onclick='() => selectedServiceTab = "Food"'>
                                        <span>🍲</span>
                                        <span>Prescription Diets</span>
                                    </button>
                                    <button type="button" class="pb-tab-item @(selectedServiceTab == "Grooming" ? "active" : "")" @onclick='() => selectedServiceTab = "Grooming"'>
                                        <span>✂️</span>
                                        <span>Medicated Grooming</span>
                                    </button>
                                    <button type="button" class="pb-tab-item @(selectedServiceTab == "Pharmacy" ? "active" : "")" @onclick='() => selectedServiceTab = "Pharmacy"'>
                                        <span>💊</span>
                                        <span>Pharmacy</span>
                                    </button>
                                </div>

                                <div class="row g-3 align-items-center">
                                    <div class="col-md-5">
                                        <label class="form-label small fw-bold text-muted mb-1">Clinic District</label>
                                        <select class="form-select form-select-sm rounded-3 bg-white">
                                            <option>Ayala Highway (Main District)</option>
                                            <option>Marawoy Crossroads</option>
                                            <option>Tambo / Banay-banay</option>
                                            <option>Sabang Area</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold text-muted mb-1">Pet Type / Size</label>
                                        <select class="form-select form-select-sm rounded-3 bg-white" @bind="selectedTier">
                                            <option value="">All Pet Sizes</option>
                                            <option value="Small Pets">Small Pets (1-10kg)</option>
                                            <option value="Medium Pets">Medium Pets (11-25kg)</option>
                                            <option value="Large Pets">Large Pets (26kg+)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3 text-end pt-3">
                                        <button class="btn-pb-yellow w-100 py-2" @onclick="HandleWidgetSearch">
                                            Find Care →
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-5 d-none d-lg-block"></div>
                    </div>
                </div>
            </section>

            <!-- 6-SERVICE COLOR & PHOTO GRID -->
            <section class="container-xl py-5">
                <div class="text-center mb-4">
                    <h4 class="fw-bold mb-1" style="color: var(--pb-text-title);">Care & Supplies for Every Need</h4>
                    <p class="text-muted small">Select a service to instantly route your appointment or reserve counter supplies</p>
                </div>

                <div class="row row-cols-1 row-cols-md-3 g-4">
                    <div class="col">
                        <div class="color-grid-unit cg-sage shadow-sm" @onclick='() => DirectBookService("General Checkup / Consultation")'>
                            <div class="cg-photo-header"><img src="/vet_consult.png" alt="Vet Examination" /></div>
                            <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                                <div>
                                    <span class="badge mb-2 px-2 py-1 small" style="background:#E2ECE7;color:var(--pb-sage-dark);">🩺 In-Clinic</span>
                                    <h6 class="fw-bold mb-1" style="color: var(--pb-sage-dark);">Veterinary Consultation</h6>
                                    <p class="text-muted small mb-0">Routine physical exams, diagnostic consultations, and comprehensive clinical checkups.</p>
                                </div>
                                <div class="pt-3 mt-3 d-flex justify-content-between align-items-center border-top">
                                    <span class="small fw-bold" style="color: var(--pb-sage);">Book slot →</span>
                                    <span class="small text-muted">From ₱350</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="color-grid-unit cg-butter shadow-sm" @onclick='() => DirectBookService("Core Vaccination (Anti-Rabies / DHPP)")'>
                            <div class="cg-photo-header"><img src="/premiumft.png" alt="Pet Vaccinations" /></div>
                            <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                                <div>
                                    <span class="badge mb-2 px-2 py-1 small" style="background:#FBF3D5;color:#8C6D00;">💉 Preventative</span>
                                    <h6 class="fw-bold mb-1" style="color: #8C6D00;">Core Vaccinations</h6>
                                    <p class="text-muted small mb-0">Anti-Rabies, 5-in-1 DHPP, kennel cough, and verified PRC pet health cards.</p>
                                </div>
                                <div class="pt-3 mt-3 d-flex justify-content-between align-items-center border-top">
                                    <span class="small fw-bold" style="color: #8C6D00;">Schedule visit →</span>
                                    <span class="small text-muted">From ₱450</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="color-grid-unit cg-blue shadow-sm" @onclick='() => FilterShopByCategory("Food")'>
                            <div class="cg-photo-header"><img src="/foodprod.png" alt="Prescription Diets" /></div>
                            <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                                <div>
                                    <span class="badge mb-2 px-2 py-1 small" style="background:#E2EDF8;color:#2A5885;">🍲 Nutrition</span>
                                    <h6 class="fw-bold mb-1" style="color: #2A5885;">Prescription Diets</h6>
                                    <p class="text-muted small mb-0">Clinically formulated renal, gastrointestinal, weight management, and specialized kibble.</p>
                                </div>
